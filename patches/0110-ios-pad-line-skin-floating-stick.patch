+    [self setNeedsLayout];
+}
+- (void)editSliderDone:(UISlider *)s {   // the slider's touch is up: save the size
+    (void)s;
+    [self saveLineLayout];
+}
+- (CGPoint)editCentre:(int)e {   // a movable control's centre where it is now (with its stored offset)
+    switch (e) {
+        case E_A: return [self facePos:B_A]; case E_B: return [self facePos:B_B]; case E_Y: return [self facePos:B_Y];
+        case E_ZL: return [self dropCenter:B_ZL]; case E_L: return [self dropCenter:B_L];
+        case E_MINUS: { CGRect r = [self pillRect:B_MINUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
+        case E_PLUS: { CGRect r = [self pillRect:B_PLUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
+        case E_JUMP: return [self jumpCenter]; default: return [self photoCenter];
+    }
+}
+- (CGFloat)editRadius:(int)e {   // a movable control's hit radius, in points
+    switch (e) {
+        case E_A: case E_B: case E_Y: return self.faceHitR;
+        case E_ZL: return [self dropR:B_ZL]; case E_L: return [self dropR:B_L];
+        case E_MINUS: case E_PLUS: return [self linePillR];
+        default: return self.extraR;   // jump and photo
+    }
+}
+- (int)lineEditControlAt:(CGPoint)p {   // the movable control under a point, or -1
+    for (int e = 0; e < E_N; e++) if (dist(p, [self editCentre:e]) <= MAX([self editRadius:e], 24)) return e;
+    return -1;
+}
+- (void)editTouchBegan:(UITouch *)t at:(CGPoint)p {
