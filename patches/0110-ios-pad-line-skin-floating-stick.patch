+    hint.text = @"拖动图标可以移动位置"; hint.textColor = UIColor.whiteColor; hint.font = [UIFont systemFontOfSize:12]; hint.textAlignment = NSTextAlignmentCenter;
+    [_editBar addSubview:hint];
+    [self addSubview:_editBar];
+}
+- (void)layoutEditBar {   // the bar's top row (title, size label, slider, Done), the hint below, centred at the top
+    if (!_editBar) return;
+    CGFloat w = fmin(self.bounds.size.width * 0.8, 480), h = 62;
+    _editBar.frame = CGRectMake((self.bounds.size.width - w) / 2, self.safeAreaInsets.top + 8, w, h);
+    CGFloat x = 12, doneW = 48;
+    UIView *title = [_editBar viewWithTag:301]; title.frame = CGRectMake(x, 8, 80, 24); x += 88;
+    UIView *size = [_editBar viewWithTag:302]; size.frame = CGRectMake(x, 8, 32, 24); x += 36;
+    _editSlider.frame = CGRectMake(x, 10, w - x - doneW - 24, 20);
+    UIView *done = [_editBar viewWithTag:303]; done.frame = CGRectMake(w - doneW - 12, 8, doneW, 24);
+    UIView *hint = [_editBar viewWithTag:304]; hint.frame = CGRectMake(0, 36, w, 18);
+}
+- (void)openPadSettings {   // the in-game menu's "按键设置": hide the gear (it cannot be tapped now), show the editor
+    if (_padOff || _editing) return;
+    [self reset];   // release every key and touch first, as the menu does
+    _editing = YES;
+    [self updateControlVisibility];
+    _editBar.hidden = NO;
+    _editSlider.value = _lineScale;
+    [self setNeedsLayout];
+}
+- (void)closePadSettings {   // Done: save the layout and go back to playing
+    if (!_editing) return;
+    _editing = NO;
+    _editTouch = nil;
+    [self saveLineLayout];
+    [self updateControlVisibility];
+    _editBar.hidden = YES;
+    [self setNeedsLayout];
+}
+- (void)editSliderChanged:(UISlider *)s {   // the size slider: resize the icons live
+    _lineScale = s.value;
