+        default: return self.extraR;   // jump and photo
+    }
+}
+- (int)lineEditControlAt:(CGPoint)p {   // the movable control under a point, or -1
+    for (int e = 0; e < E_N; e++) if (dist(p, [self editCentre:e]) <= MAX([self editRadius:e], 24)) return e;
