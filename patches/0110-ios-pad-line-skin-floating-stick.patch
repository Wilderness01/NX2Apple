+    _editing = YES;
+    [self updateControlVisibility];
+    _editBar.hidden = NO;
+    _editSlider.value = _lineScale;
+    [self setNeedsLayout];
+}
+- (void)closePadSettings {   // Done: save the layout and go back to playing
+    if (!_editing) return;
+    _editing = NO;
+    _editTouch = nil;
+    [self saveLineLayout];
+    [self updateControlVisibility];
+    _editBar.hidden = YES;
+    [self setNeedsLayout];
+}
+- (void)editSliderChanged:(UISlider *)s {   // the size slider: resize the icons live
+    _lineScale = s.value;
