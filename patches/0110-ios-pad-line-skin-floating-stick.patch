+}
+- (CGPoint)editCentre:(int)e {   // a movable control's centre where it is now (with its stored offset)
+    switch (e) {
+        case E_A: return [self facePos:B_A]; case E_B: return [self facePos:B_B]; case E_Y: return [self facePos:B_Y];
+        case E_ZL: return [self dropCenter:B_ZL]; case E_L: return [self dropCenter:B_L];
+        case E_MINUS: { CGRect r = [self pillRect:B_MINUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
+        case E_PLUS: { CGRect r = [self pillRect:B_PLUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
