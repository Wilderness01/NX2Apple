From 52573a1998fd71bdc9399b86bb836ee5dafa35f7 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Tue, 17 Nov 2026 11:55:32 +0000
Subject: [PATCH] 0173: launcher title-screen background, unified Mario style
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The launcher now looks like the game's title screen: the red world-map
background (red map, Mario and Cappy, Odyssey logo) behind the 0171
liquid-glass panels, gold icons and red Start button, and the settings
list's section headers in title-screen white — one consistent Mario
style across the game card and the settings list. No row, text, control
or function changes; visuals only.

The art is a frame of the title screen itself (the map is a 3D scene in
the game, so there is no flat title-background texture to ship;
TextureWorldMap.szs holds the globe model, not the composed screen):
1560x720 video frame, touch buttons cropped out (1200x655), bundled as
Sources/LauncherBackground/launcher_title_bg.jpg and found through the
Sources glob at the app bundle root (the PadIcons precedent). Two
layers — the same art blurred to fill the screen (its own red tones at
the edges, no flat bars on iPhone 19.5:9 or iPad 4:3) with the sharp art
fitted on top — under a 0.40 black scrim for legibility. If the art is
ever missing from the bundle, the 0171 navy-and-glows backdrop is the
fallback, so the launcher never shows a bare screen.
---
 dm/ios/Sources/Launcher.swift                 |  30 +++++++++++++++---
 .../LauncherBackground/launcher_title_bg.jpg  | Bin 0 -> 154679 bytes
 2 files changed, 25 insertions(+), 5 deletions(-)
 create mode 100644 dm/ios/Sources/LauncherBackground/launcher_title_bg.jpg

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index dbc9774..5da34a0 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -170,7 +170,7 @@ private func dmSettingIcon(_ env: String) -> String? {
     }
 }
 
-/// Liquid Glass for the launcher's panels (0171): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the backdrop is a deep navy-black base with two soft colour glows (Mario red top-left, coin gold bottom-right), subtle on purpose — the text is white on dark glass, and a loud backdrop would fight it.
+/// Liquid Glass for the launcher's panels (0171): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the title-screen art (0173) — red world map, Mario — dimmed by a scrim, so the glass has colour to work with and the white text stays legible.
 private extension View {
     @ViewBuilder func dmGlassCard(cornerRadius: CGFloat = 32) -> some View {
         Group {
@@ -191,12 +191,32 @@ private extension View {
     }
 }
 
+/// The title-screen art for the backdrop (0173): the game's own title screen — red world map, Mario and Cappy, Odyssey logo. The map is a 3D scene in the game, so there is no flat title-background texture to ship (TextureWorldMap.szs holds the globe model, not the composed screen); the art is a frame of the title screen itself (1560x720 video) with the touch buttons cropped out (1200x655), bundled as Sources/LauncherBackground/launcher_title_bg.jpg. The launcher is compiled into the app (DmIOS target), so the art lives in the app bundle: Bundle(for:) on LauncherModel (same module) names it in both the one-game app and the shell. UIImage(named:) finds the file the Sources glob bundles at the bundle root.
+private func dmLauncherTitleImage() -> UIImage? {
+    UIImage(named: "launcher_title_bg", in: Bundle(for: LauncherModel.self), compatibleWith: nil)
+}
+
+/// The title-screen backdrop (0173): the art above, two layers — the same art blurred to fill the screen (its own red tones at the edges, so no flat bars on any aspect: iPhone 19.5:9, iPad 4:3) with the sharp art fitted on top — under a dark scrim, so the whole launcher speaks the title screen's language instead of the 0171 plain navy. If the art is ever missing from the bundle, the 0171 navy-and-glows backdrop is the fallback — the launcher never shows a bare screen.
 private struct LauncherBackdrop: View {
     var body: some View {
         ZStack {
-            Color(red: 0.04, green: 0.06, blue: 0.11)
-            RadialGradient(colors: [odysseyRed.opacity(0.30), .clear], center: .topLeading, startRadius: 0, endRadius: 620)
-            RadialGradient(colors: [Color(red: 0.95, green: 0.75, blue: 0.30).opacity(0.24), .clear], center: .bottomTrailing, startRadius: 0, endRadius: 680)
+            if let art = dmLauncherTitleImage() {
+                Image(uiImage: art)
+                    .resizable()
+                    .scaledToFill()
+                    .scaleEffect(1.1)   // blurred fill: overscan so the blur's edge fringe stays off-screen
+                    .blur(radius: 20)
+                    .brightness(-0.18)
+                    .ignoresSafeArea()
+                Image(uiImage: art)
+                    .resizable()
+                    .scaledToFit()
+                Color.black.opacity(0.40)   // scrim: the art is bright red; the white-on-glass text needs the darkening
+            } else {
+                Color(red: 0.04, green: 0.06, blue: 0.11)
+                RadialGradient(colors: [odysseyRed.opacity(0.30), .clear], center: .topLeading, startRadius: 0, endRadius: 620)
+                RadialGradient(colors: [Color(red: 0.95, green: 0.75, blue: 0.30).opacity(0.24), .clear], center: .bottomTrailing, startRadius: 0, endRadius: 680)
+            }
         }
         .ignoresSafeArea()
     }
@@ -232,7 +252,7 @@ private struct LauncherView: View {
                     ForEach(m.sections, id: \.self) { section in
                         let rows = m.rows(in: section)
                         if !rows.isEmpty {
-                            Section(header: Text(LauncherText.sectionName(section))) {
+                            Section(header: Text(LauncherText.sectionName(section)).foregroundStyle(.white)) {   // (0173) title-screen white, not system grey — the list reads like the title menu
                                 ForEach(rows) { row in
                                     if let icon = dmSettingIcon(row.env) {
                                         HStack(spacing: 12) {
