From b4aaeeec4e2618a9ff451eeba81e61ae6f1a603b Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sun, 15 Nov 2026 14:38:21 +0000
Subject: [PATCH] 0149: HUD overlay: menu/map fullscreen, hint hide,
 CounterLife Appear 732

- dm/romfs-overlay: add Menu, MapBG, CommonBgParts, FooterParts,
  MenuGuide, MapFooter (.szs rebuilt in place, 12 panes w 1280->1560,
  .bflan untouched) and PlayGuideMenu (TxtGuide/TxtGuideSh hidden:
  the in-game '+ menu / - map' hint, pane centre (1336,140) matches the
  measured glyph box centre (1334,139); the Menu layout never loads in
  the probe sessions, so this instance is live during gameplay).
- CounterLife.szs: Appear 0xc0 728.0 -> 732.0 (0143 wrote 728; the
  Appear start must be 592+140=732 to meet 0xcc 696).
- main.m: log 'boot: romfs-overlay missing: ...' when the overlay
  folder is absent instead of silently skipping it.
- build_ipa.sh: die 'romfs-overlay missing' when the folder is absent
  and list the copied overlay files after the copy.
---
 dm/ios/Sources/main.m                         |   3 ++-
 dm/ios/tools/build_ipa.sh                     |   6 +++++-
 dm/romfs-overlay/LayoutData/CommonBgParts.szs | Bin 0 -> 3572409 bytes
 dm/romfs-overlay/LayoutData/CounterLife.szs   | Bin 104218 -> 104218 bytes
 dm/romfs-overlay/LayoutData/FooterParts.szs   | Bin 0 -> 39877 bytes
 dm/romfs-overlay/LayoutData/MapBG.szs         | Bin 0 -> 37546 bytes
 dm/romfs-overlay/LayoutData/MapFooter.szs     | Bin 0 -> 11914 bytes
 dm/romfs-overlay/LayoutData/Menu.szs          | Bin 0 -> 52234 bytes
 dm/romfs-overlay/LayoutData/MenuGuide.szs     | Bin 0 -> 21274 bytes
 dm/romfs-overlay/LayoutData/PlayGuideMenu.szs | Bin 0 -> 30058 bytes
 10 files changed, 7 insertions(+), 2 deletions(-)
 create mode 100644 dm/romfs-overlay/LayoutData/CommonBgParts.szs
 create mode 100644 dm/romfs-overlay/LayoutData/FooterParts.szs
 create mode 100644 dm/romfs-overlay/LayoutData/MapBG.szs
 create mode 100644 dm/romfs-overlay/LayoutData/MapFooter.szs
 create mode 100644 dm/romfs-overlay/LayoutData/Menu.szs
 create mode 100644 dm/romfs-overlay/LayoutData/MenuGuide.szs
 create mode 100644 dm/romfs-overlay/LayoutData/PlayGuideMenu.szs

diff --git a/dm/ios/Sources/main.m b/dm/ios/Sources/main.m
index 07e8bfe..978e083 100644
--- a/dm/ios/Sources/main.m
+++ b/dm/ios/Sources/main.m
@@ -311,9 +311,10 @@ static int boot_env(void) {
     if (per_game && [fm fileExistsAtPath:per_game_msl]) msl = per_game_msl;
     setenv("DM_MSL_DIR", msl.fileSystemRepresentation, 0);
     setenv("DM_FONT_DIR", [[res stringByAppendingPathComponent:@"dm"] stringByAppendingPathComponent:@"font"].fileSystemRepresentation, 0);   // Shared-font stand-ins (standard.ttf / nintendo_ext.ttf): iOS lacks the macOS font path
-    // HUD .bflyt overlay (0136): when the bundle carries dm/romfs-overlay, its files replace the same RomFS paths at load (hle_fs.c DM_ROMFS_OVERLAY), so the HUD layouts are created at their edge-aligned positions from the modified .bflyt data itself -- no Pane::Calculate hook, no per-frame rewrite. The overlay holds only the six HUD layouts; everything else still comes from the RomFS image.
+    // HUD .bflyt overlay (0136): when the bundle carries dm/romfs-overlay, its files replace the same RomFS paths at load (hle_fs.c DM_ROMFS_OVERLAY), so the HUD layouts are created at their edge-aligned positions from the modified .bflyt data itself -- no Pane::Calculate hook, no per-frame rewrite. The overlay holds the HUD layouts, the menu/map fullscreen layouts and the hint layout (0149); everything else still comes from the RomFS image.
     NSString *romfs_overlay = [[res stringByAppendingPathComponent:@"dm"] stringByAppendingPathComponent:@"romfs-overlay"];
     if ([fm fileExistsAtPath:romfs_overlay]) setenv("DM_ROMFS_OVERLAY", romfs_overlay.fileSystemRepresentation, 0);
+    else fprintf(stderr, "boot: romfs-overlay missing: %s (HUD overlay not applied)\n", romfs_overlay.fileSystemRepresentation);
     // Add-on content beside the game data: the launcher's games/<id>/aoc/ holds <index>.img (the layout hle_fs.c aoc_dir reads), because a slim IPA does not carry it. Taken before
     // Documents/aoc and <App>/aoc (aoc_locate, seedds/nxnative#486) and never over an explicit DM_AOC_DIR: aoc_locate only fills DM_AOC_DIR when this did not.
     NSString *per_game_aoc = [gdir stringByAppendingPathComponent:@"aoc"];
diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index 77617ee..ad7db44 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -179,7 +179,11 @@ if [ -n "${DM_ENV_FILE:-}" ]; then cp "$DM_ENV_FILE" Gen/dm/env.txt || die "copy
 # lives in the repo at dm/romfs-overlay (committed as data, not code); without
 # this copy the 0136 env setup finds nothing and the overlay silently does
 # not apply -- the HUD stays at its 16:9 defaults.
-if [ -d "$DM/romfs-overlay" ]; then cp -R "$DM/romfs-overlay" Gen/dm/romfs-overlay || die "copy romfs-overlay"; t "romfs-overlay: $(find Gen/dm/romfs-overlay -type f | wc -l) files"; fi
+if [ -d "$DM/romfs-overlay" ]; then
+  cp -R "$DM/romfs-overlay" Gen/dm/romfs-overlay || die "copy romfs-overlay"
+  t "romfs-overlay: $(find Gen/dm/romfs-overlay -type f | wc -l) files"
+  find Gen/dm/romfs-overlay -type f | sort | while read -r f; do t "romfs-overlay: $f"; done
+else die "romfs-overlay missing"; fi
 # The shader libraries go into the archive as DmIOS.app/msl/<folder>, or an NVN game's as the file DmIOS.app/msl/<folder>.img (main.m sets DM_MSL_DIR to msl)
 if [ "$GFXAPI" = vulkan ]; then MSLDIR=vk; elif [ "$GFXAPI" = gl ]; then MSLDIR=gl; else MSLDIR=b-$V; fi
 # Shared-font stand-ins: standard = macOS's Arial Unicode (absent on iOS), Nintendo extension = button icons generated by make_ext_font.py (needs fontTools; FONT_PY names a python that has it)
diff --git a/dm/romfs-overlay/LayoutData/CommonBgParts.szs b/dm/romfs-overlay/LayoutData/CommonBgParts.szs
new file mode 100644
