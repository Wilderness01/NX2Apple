From f0c4cb0b367855e0fdedc631bd5f9fc3f65ecd8f Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sat, 14 Nov 2026 03:34:29 +0000
Subject: [PATCH] 0130: fix the coin/regional numbers vanishing on device
 (log-36/37)

A static leaf pane's +0x70 matrix is never composed by the game
(Calculate's +0x13c cut skips it), so the stored original's translation
was (0,0) and the offset was written as an absolute position: the coin
number landed at final_m3 = tdx exactly (-124/-140, off-screen left),
and the regional panes were pushed further off-screen by the parent
subtraction in hud_edge_unparent. The fix rebuilds the stored
original's translation from the pane's local transform (+0x30) plus its
parent's layout when the live matrix was never composed (its translation
is still (0,0)); the parent subtraction is kept, because a dynamic
child's matrix does carry its parent's move (removing it would put
TxtGuide01 at 1063, not 795); and the 'same transform' early return is
gated on the child actually having inherited the parent's move, so a
static child sharing its parent's transform is still moved.

Verified on the host: saved values give TxtCounter 139/68, TxtTotalShine
-75/-35, PicIconSh -182/-25, Counter 153/169; reset gives TxtCounter
123/71, TxtTotalShine -85/0, Counter -140/0; PicStrap 1248 and Life
728.8 are unchanged; TxtGuide01 stays 795; 30 frames, no drift; the
0128 repro (16/16) and the 0129 probe test (40/40) still pass.
---
 dm/games/0100000000010000/hud_edge.c |  94 +++++++++++++++++++---
 dm/games/0100000000010000/patches.py | 115 +++++++++++++++------------
 2 files changed, 146 insertions(+), 63 deletions(-)

diff --git a/dm/games/0100000000010000/hud_edge.c b/dm/games/0100000000010000/hud_edge.c
index 7375646..326ebb9 100644
--- a/dm/games/0100000000010000/hud_edge.c
+++ b/dm/games/0100000000010000/hud_edge.c
@@ -1,4 +1,4 @@
-// hud_edge.c -- Super Mario Odyssey HUD edge anchor + launcher manual settings (0118 + 0119 + 0120 + 0123 + 0126 + 0127).
+// hud_edge.c -- Super Mario Odyssey HUD edge anchor + launcher manual settings (0118 + 0119 + 0120 + 0123 + 0126 + 0127 + 0130).
 //
 // The game's HUD (coins, moons, compass, lives, hints) is laid out for a 1280x720
 // (16:9) screen, so on a wider screen (iPhone 19.5:9) it sits inset from the
@@ -88,8 +88,8 @@
 // still follows the aspect (as the editor does). An old saved setting (recorded
 // as a drag from the edge) is now read correctly with no migration.
 //
-// Parent compensation (0123): some matched panes are CHILDREN of other
-// matched panes -- the moon icon (PicIconSh / PicIcon) and its number
+// Parent compensation (0123, revised 0130): some matched panes are CHILDREN
+// of other matched panes -- the moon icon (PicIconSh / PicIcon) and its number
 // (TxtTotalShine, when its parent is a Counter) sit inside the moons
 // 'Counter' group, and the hints text (TxtGuide01) sits inside the compass
 // 'PicStrap' strip -- so a child's game-computed global matrix already
@@ -103,12 +103,21 @@
 //     g_unmod = S_C(1/k_m) * T(-dx_m,-dy_m) * g,  mod = D_child * g_unmod
 // (exact: a translate, then a scale about C; when the parent's transform is
 // the identity the undo is skipped, so the common case is untouched, and
-// when the parent and the child want the SAME transform the two cancel
-// exactly and the child's matrix is left bit-identical). A hidden parent is
-// undone too (its +10000 off-screen push is subtracted as well), so hiding
-// the parent does not hide the child. The parent's applied transform is
-// read from its own table entry, never from a walk. A pane whose parent is
-// not matched is unaffected.
+// when the parent and the child want the SAME transform -- and the child
+// actually inherited the parent's move -- the two cancel exactly and the
+// child's matrix is left bit-identical). A hidden parent is undone too (its
+// +10000 off-screen push is subtracted as well), so hiding the parent does
+// not hide the child.
+// (0130) The undo above is exact only for a DYNAMIC child, whose +0x70 was
+// composed by the game and carries its parent's move. A STATIC child's +0x70
+// never carried it, so the subtraction is spurious for it -- but the stored
+// original's translation is then rebuilt from the pane's own local transform
+// (+0x30) plus its parent's layout, which discards the spurious subtraction
+// before it reaches the modified matrix. Removing the subtraction instead
+// would double-count the parent's move for dynamic children (TxtGuide01
+// would land at 1063, not 795). The parent's applied transform is read from
+// its own table entry, never from a walk. A pane whose parent is not
+// matched is unaffected.
 //
 // What this patch does NOT do (deliberately): no map-camera widen, no
 // settings/map code, no guide-text hiding, no root stretch. The camera icon
@@ -321,6 +330,14 @@ static inline __attribute__((always_inline)) char *hud_edge_find_entry(void *tab
 // matrix was pushed +10000 off-screen, so the undo also translates by
 // -HUD_HIDE_DX (a hidden parent is never the identity, whatever its stored
 // dx/dy/k say).
+// (0130) The translation subtraction is exact for a DYNAMIC child, whose
+// +0x70 was composed by the game and carries its parent's move. For a
+// STATIC child it is spurious -- its +0x70 never carried the move -- but
+// the 0130 fallback in hud_edge rebuilds the stored original's translation
+// from the pane's local transform plus its parent's layout, discarding the
+// spurious subtraction before it reaches the modified matrix, so the
+// subtraction stays: removing it would double-count the parent's move for
+// dynamic children (TxtGuide01 would land at 1063, not 795).
 // Returns 1 when a non-identity parent transform was undone, 0 when there
 // is nothing to undo (no parent entry, the parent's stored transform is
 // stale, or the parent applied the identity): out is then just g.
@@ -349,11 +366,20 @@ static inline __attribute__((always_inline)) int hud_edge_unparent(void *pane, c
     if (!*pm_hidden && dx_m == 0.0f && dy_m == 0.0f && k_m == 1.0f) return 0;   // identity: nothing to undo
     // Translate out by (-dx_m, -dy_m) (the rows are untouched: a pure
     // translation left-multiplied onto the matrix only moves its translation).
+    // (0130) This subtraction is CORRECT for a dynamic child, whose +0x70
+    // matrix was composed by the game and does carry its parent's move
+    // (TxtGuide01: g 923 = layout 655 + parent 268). For a static child
+    // it is spurious -- its +0x70 never carried the move -- but the 0130
+    // fallback in hud_edge overwrites the stored original's translation
+    // from the pane's local transform plus its parent's layout, so the
+    // spurious subtraction is discarded there and never reaches the
+    // modified matrix.
     out[3] -= dx_m;
     out[7] -= dy_m;
     // A hidden parent was pushed off-screen on top of its (identity) stored
     // transform: undo that too, so the child's original is its own layout
-    // position and hiding the parent does not hide the child.
+    // position and hiding the parent does not hide the child. (Same note
+    // as above: for a static child the 0130 fallback overwrites it.)
     if (*pm_hidden) out[3] -= HUD_HIDE_DX;
     if (k_m != 1.0f) {
         // Scale about the parent's (unmodified) centre C by 1/k_m.
@@ -639,7 +665,46 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // layout's own matrix and does not depend on what the parent did, so a
     // later change to the parent alone cannot corrupt it. When there is no
     // matched parent, g_unmod is just g (the undo is the identity).
+    // (0130) A static leaf pane's +0x70 matrix was never composed by the
+    // game (Calculate's +0x13c cut skips it), so the stored original's
+    // translation is not its layout -- it is (0,0) for a parentless pane,
+    // or (0,0) minus a spurious parent subtraction for a child -- and the
+    // offset is then written as an absolute position, landing the pane
+    // off-screen (log-36/37: TxtCounter final_m3 = tdx exactly, -124/-140;
+    // the regional panes were pushed further off-screen by the spurious
+    // subtraction). The layout lives in the pane's own local transform
+    // (+0x30), so when the pane's LIVE matrix was never composed (its
+    // translation is still (0,0)) and the local translation is non-zero,
+    // rebuild the original's translation from the parent's layout plus
+    // the local translation (exact: no rotation, parent scale 1). The
+    // parent's layout is its stored original when it is matched (its entry
+    // is valid), else its current +0x70 -- an unmatched parent is never
+    // modified, so its +0x70 is the layout. A container whose local
+    // translation is (0,0) (the moons Counter) keeps its (0,0) original,
+    // and a dynamic pane (PicStrap, Life, TxtGuide01) keeps its fresh
+    // +0x70 -- its live matrix is non-zero, so the fallback does not
+    // trigger and the parent subtraction above stays correct for it.
     if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g_unmod[i];
+    if (g[3] == 0.0f && g[7] == 0.0f) {
+        float lx = *(const float *)((const char *)pane + 0x30);
+        float ly = *(const float *)((const char *)pane + 0x34);
+        if (lx != 0.0f || ly != 0.0f) {
+            float pox = 0.0f, poy = 0.0f;
+            void *parent = *(void **)((const char *)pane + 0x18);
+            if (parent && !((uintptr_t)parent & 7u)) {
+                char *pe = hud_edge_find_entry(table, parent);
+                if (pe && *(const float *)(pe + 104) != 1e30f) {
+                    pox = *(const float *)(pe + 8 + 12);
+                    poy = *(const float *)(pe + 8 + 28);
+                } else {
+                    pox = *(const float *)((const char *)parent + 0x70 + 12);
+                    poy = *(const float *)((const char *)parent + 0x70 + 28);
+                }
+            }
+            e_orig[3] = pox + lx;
+            e_orig[7] = poy + ly;
+        }
+    }
     if (!recomputed && *e_dx == tdx && *e_dy == tdy && *e_k == tk && *e_hidden == (u32)hidden) return;   // already correct: nothing to do
 
     // The parent and this pane want the SAME transform (the common case for
@@ -651,7 +716,14 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // the dirty-mark, which is correct: nothing moved. (A hidden parent
     // never takes this path: its effective transform is the +10000 hide, not
     // its stored (0,0,1), so "the same transform" does not hold for it.)
-    if (!hidden && has_parent && !pm_hidden && tdx == pm_dx && tdy == pm_dy && tk == pm_k) {
+    // (0130) Only take this path when the child actually inherited the
+    // parent's move: a static child's matrix never did (its g is still its
+    // layout), so taking it would leave the child unmoved at its layout
+    // (log-37: the Counter and the regional panes share tdx -140 and were
+    // left unmoved). The check is exact (layout coordinates are integers,
+    // so the float subtraction is exact).
+    if (!hidden && has_parent && !pm_hidden && tdx == pm_dx && tdy == pm_dy && tk == pm_k
+        && (g[3] - e_orig[3]) == pm_dx && (g[7] - e_orig[7]) == pm_dy) {
         for (int i = 0; i < 12; i++) e_mod[i] = g[i];
         *e_dx = tdx;
         *e_dy = tdy;
