--- a/dm/games/0100000000010000/hud_runtime.c
+++ b/dm/games/0100000000010000/hud_runtime.c
@@ -60,15 +60,48 @@
 //
 // The hook runs from the same two rewriter cuts as the old 0113
 // (Pane::Calculate main+0x909494: the entry cut at +0x20 and the +0x13c cut
-// at +0x13c), because one cut misses static panes (see the old hud_calc.c
-// header: the skip path over the +0x13c site). It matches the five HUD
-// widgets by pane name only -- no subtree walk, no tree search, no
+// at +0x13c), PLUS a third cut (0151) in the forced-recompute recursion
+// 0x909d4c at +0x150 (see the 0151 note below), because one cut misses
+// static panes (see the old hud_calc.c header: the skip path over the
+// +0x13c site). It matches the five HUD widgets by pane name only -- no subtree walk, no tree search, no
 // guide/root classification, no camera widening, no log. The only walk is the
 // dirty-mark for a moved container's children (hud_edge_mark_dirty), which
 // only sets a flag and uses the v8 single struct-array (no second base
 // register, so the log-27 sdepth/x18 fault class is structurally absent);
 // it never reads a pane name and never decides a match.
 //
+// (0151) The #66 partial failure (REPORT-HUD-66-PARTIAL.md): only the
+// compass moved, hide->show was dead, and the compass's red needle never
+// hid. Three separate causes, three fixes in this file and patches.py:
+//   S1 -- the game refreshes the four counter layouts' transform AFTER the
+//   +0x13c hook and BEFORE Draw, every frame: the per-frame layout driver
+//   (0xa1cb80) calls Pane::Calculate (both hook cuts run), then the
+//   animation/game code restores the All pane's +0x30 (and local matrix)
+//   to its base, then the driver calls the forced recursive recompute
+//   0x9036cc -> 0x909d4c (the ONLY +0x70 recompute in the binary outside
+//   Pane::Calculate; its only caller is the driver at 0xa1cdf8, force=1),
+//   which recomposes +0x70 from the restored base and bypasses both hook
+//   cuts entirely. Neither in-Calculate recompute path can do this: both
+//   run BEFORE the +0x13c cut and recompose from the hook's own shifted
+//   values (disassembly: bit-5 path 0x909558, dirty path via
+//   CalculateLocalMatrix 0x9096d0, which writes only +0x70/+0x90, never
+//   +0xa0). The fix is a third cut in patches.py at 0x909da0, inside
+//   0x909d4c after its own recompute (bl CalculateLocalMatrix at 0x909d9c)
+//   and before its children loop: the same hud_edge re-applies the shift
+//   there, so the children recompose from the shifted parent and Draw
+//   renders the shift. No hud_edge logic change was needed for S1.
+//   S2 -- hide->show deadlock (PROVEN): a hidden pane's Calculate
+//   early-exits (0x90969c/0x9096a4) and clears bit 7, so the old bit-7 guard
+//   above the matcher skipped the pane forever and the bit-0 show write
+//   never ran. The guard moved to AFTER the matcher (below): a matched
+//   pane always gets its bit-0 set/clear applied even when bit 7 is clear.
+//   It still skips a pane that never calculated AND has no table entry
+//   (first frame: +0x70 still zero, e_mod would capture a zero global).
+//   S3 -- the red needle is PicView in the separate MapMiniPlayer layout
+//   (no needle pane exists in MapMini); the matcher now takes an All with
+//   a PicView DIRECT child as compass (idx 0). MapPlayer's PicView sits
+//   under Icon00, so the full-screen map does not match.
+//
 // (0137) Runtime HUD control for the in-game editor: the DISPLAYED
 // position is moved by writing the pane's GLOBAL matrix (+0x70) directly,
 // not by shifting the local and hoping the game recomposes it. 0135 proved
@@ -312,6 +345,13 @@ typedef unsigned long uintptr_t;
 // "PicMap": "PicM", "ap\0\0".
 #define HUD_E_PICMAP0 0x4d636950u
 #define HUD_E_PICMAP1 0x00007061u
+// (0151) "PicView": "PicV", "iew\0" -- the red view-cone arc in the
+// MapMiniPlayer layout (the compass's separate layout; MapMini itself has
+// no needle pane). Only MapMiniPlayer's All has a PicView DIRECT child;
+// MapPlayer's PicView sits under Icon00, so the direct-child check below
+// does not match the full-screen map.
+#define HUD_E_PICVIEW0 0x56636950u
+#define HUD_E_PICVIEW1 0x00776569u
 // "Shine": "Shin", "e\0\0\0".
 #define HUD_E_SHINE0 0x6e696853u
 #define HUD_E_SHINE1 0x00000065u
@@ -401,10 +441,15 @@ typedef struct { void *pane; unsigned char depth; } hud_edge_stack_ent;
 // This is the ONLY subtree walk in this patch, and it only sets a flag: it
 // never reads a pane name and never decides a match. The parent-changed flag
 // the game passes to children is 0 on the skip path, so without this a static
-// container's children never recompute and never follow it. The flag is the
-// game's own signal (Pane::Calculate sets it when a parent changed and
-// clears it on recompute), so the game's next Calculate on each descendant
-// recomputes from the moved parent. Bounded (64 visits, 32 children per
+// container's children never recompute and never follow it. (0151) What bit
+// 4 actually does: the next Pane::Calculate on a dirty pane takes the dirty
+// path through CalculateLocalMatrix (0x9096d0), which recomposes +0x70 from
+// the pane's OWN local components (+0x30/+0x48) and its parent's global --
+// it does NOT route through the bit-5 path (global = parent_global x the
+// +0xa0 local matrix). That is why the hook writes the shift into the local
+// components AND the local matrix AND the global: a dirty child recomposes
+// from its components, a bit-5 child from its matrix, and either alone
+// would leave the other path unshifted. Bounded (64 visits, 32 children per
 // pane, depth 3); the pane itself is never marked here -- hud_edge marks it separately
 // after writing its local, so the game recomputes this pane's +0x70 from the
 // shifted local in the same Calculate call. Only called when the hook
@@ -538,8 +583,19 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // this pane has ever calculated. On a pane's very first frame its matrix
     // is still zero; skip it (the +0x13c cut catches it after the game
     // computes it, and the entry cut catches it from the next frame on).
+    // (0151) S2: this guard used to sit BEFORE the matcher, so a hidden
+    // pane was skipped forever: Calculate early-exits on a hidden pane
+    // (0x90969c/0x9096a4) and clears bit 7, the guard returned, and the
+    // bit-0 show write below never ran (the #66 hide->show deadlock: the
+    // hidden mask cleared in log-53 line 2179 but the compass never came
+    // back). The guard now runs AFTER the matcher, so a matched pane always
+    // gets its flags bit-0 set/clear applied even when bit 7 is clear.
+    // It still skips a pane that has never calculated AND has no table
+    // entry (its very first frame: +0x70 is still zero, so e_mod would
+    // capture a zero global and the write would land at the raw target
+    // instead of base+target). A pane WITH an entry has calculated before
+    // -- its stored originals are valid -- so it is never skipped here.
     unsigned short pflags = *(const unsigned short *)((const char *)pane + 0x58);
-    if (!(pflags & 0x80u)) return;
 
     const char *name = (const char *)pane + 0xb8;
     const u32 *nw = (const u32 *)name;
@@ -553,6 +609,12 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // (R2: 'Counter' was the moon tower, 'PicStrap' the BootLoading strip).
     // The layout is identified by the All container's DIRECT children:
     //   0 compass: a 'PicMap' child (MapMini only, of all 215 layouts).
+    //      (0151) Or a 'PicView' child (MapMiniPlayer, the compass's
+    //      separate layout: its All carries the red view-cone arc PicView
+    //      and PicPlayer; MapMini itself has no needle pane, so the needle
+    //      never hid or followed the drag in #66. MapPlayer's PicView sits
+    //      under Icon00, not directly under its All, so the full-screen map
+    //      does not match.)
     //   1 lives: a 'Life' child (CounterLife / CounterLifeKids /
     //      CounterLifeUp, the same element in three states).
     //   3 moons: a 'Shine' child whose own child is 'TxtShine'
@@ -568,7 +630,14 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // hidden in the overlay and are never moved by this runtime.
     int idx = -1;
     if (nw[0] == HUD_E_ALL0) {
-        if (hud_edge_child_named(pane, HUD_E_PICMAP0, HUD_E_PICMAP1, 0, 0, 2)) idx = 0;
+        // (0151) 0 compass: a 'PicMap' child (MapMini) OR a 'PicView' child
+        // (MapMiniPlayer, the compass's separate layout: its All carries the
+        // red view-cone arc PicView and PicPlayer, and no needle pane exists
+        // in MapMini itself -- that is why the needle never hid in #66).
+        // MapPlayer's PicView is NOT a direct child of its All (it sits
+        // under Icon00), so the full-screen map does not match here.
+        if (hud_edge_child_named(pane, HUD_E_PICMAP0, HUD_E_PICMAP1, 0, 0, 2) ||
+            hud_edge_child_named(pane, HUD_E_PICVIEW0, HUD_E_PICVIEW1, 0, 0, 2)) idx = 0;
         else if (hud_edge_child_named(pane, HUD_E_LIFE0, 0, 0, 0, 1)) idx = 1;
         else if (hud_edge_child_child_named(pane, HUD_E_SHINE0, HUD_E_SHINE1, HUD_E_TSH0, HUD_E_TSH1)) idx = 3;
         else if (hud_edge_child_named(pane, HUD_E_ADD0, 0, 0, 0, 1)) {
@@ -587,6 +656,11 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     }
     if (idx < 0) return;   // not a HUD element: leave it alone
 
+    // (0151) S2, continued: the bit-7 guard, moved here from above the
+    // matcher. Unmatched panes already returned; a matched pane with an
+    // entry is never skipped, so a hidden pane can be re-shown.
+    if (!(pflags & 0x80u) && !hud_edge_find_entry(table, pane)) return;
+
     // What this element should be, this frame. (0137) The runtime applies
     // ONLY the editor's manual adjustments on top of whatever base the
     // layout already has. The auto-edge base positions come from the 0136
