 # (0137) The in-game editor runtime: same two Pane::Calculate cuts as
-# 0135 (entry +0x20 at 0x9094b4, +0x13c at 0x9095d0), but the called code is
-# hud_runtime.c, not hud_edge.c. hud_runtime writes the pane GLOBAL matrix
+# 0135 (entry +0x20 at 0x9094b4, +0x13c at 0x9095d0), PLUS a third cut
+# (0151) in the forced-recompute recursion 0x909d4c at +0x150 (0x909da0),
+# but the called code is hud_runtime.c, not hud_edge.c. hud_runtime writes the pane GLOBAL matrix
 # (+0x70) directly at the +0x13c cut (after the game finalises it) and the
 # local as fallback; hide is a TRUE hide (flags bit 0 cleared), not +10000.
 # It applies ONLY the editor manual deltas from the state page (+0x200) on
@@ -131,11 +146,41 @@ def _hud_runtime_frame_step(ctx):
     emit(0x7940b268)                          # ldrh w8, [x19, #0x58] (the replaced instruction)
     emit(B(here(), 0x9094b8))                 # back to the hook site + 4
     fs_put(0x9094b4, [B(0x9094b4, estart)], 'Pane::Calculate entry: the in-game HUD editor runtime, so static panes are hooked too (hud_runtime.c)')
+    # (0151) The recompute cut: `add x22, x21, #0x20` at 0x909da0, inside the
+    # forced-recompute recursion 0x909d4c, after its own recompute (bl
+    # CalculateLocalMatrix at 0x909d9c) and before its children loop. The
+    # per-frame layout driver (0xa1cb80) calls Pane::Calculate (both cuts
+    # above run), then the animation / game code restores a counter All
+    # pane's +0x30 and local matrix to base, then the driver calls the
+    # forced recompute 0x9036cc -> 0x909d4c (its only caller is the driver
+    # at 0xa1cdf8, force=1), which recomposes +0x70 from the restored base
+    # and bypasses both hook cuts -- that is the #66 S1 wipe (only the
+    # compass moved). This cut re-applies the shift at the last
+    # transform-finalising point, before the children recompose from the
+    # shifted parent. x21 is the pane here (mov x21, x0 at 0x909d60);
+    # x19 (the parent-matrix arg), w20 (the force flag) and w23 (the
+    # flags byte) are live across the site and are saved/restored; x22 is
+    # written by the replaced instruction, so it needs no save. The stub
+    # calls the same hud_edge with the same arguments as the other two.
+    fs_site(0x909da0, 'b6820091')
+    rstart = here()
+    emit(STP_PRE(19, 20, 31, -16))             # stp x19, x20, [sp, #-16]! (live: parent-matrix arg, force flag)
+    emit(STP_PRE(21, 23, 31, -16))             # stp x21, x23, [sp, #-16]! (live: the pane, the flags byte)
+    emit(0xaa1503e0)                           # mov x0, x21 (the pane)
+    emit(ADRP(1, here(), FS_STATE_OFF)); emit(ADDI(1, 1, 0x58))    # x1 = state + 0x58 (the aspect)
+    emit(ADRP(2, here(), FS_STATE_OFF)); emit(ADDI(2, 2, 0x300))   # x2 = state + 0x300 (table)
+    emit(ADRP(3, here(), FS_STATE_OFF)); emit(ADDI(3, 3, 0x200))   # x3 = state + 0x200 (the manual params)
+    emit(B(here(), hud_code) | 0x80000000)     # bl hud_runtime
+    emit(LDP_POST(21, 23, 31, 16))             # ldp x21, x23, [sp], #16
+    emit(LDP_POST(19, 20, 31, 16))             # ldp x19, x20, [sp], #16
+    emit(0x910082b6)                           # add x22, x21, #0x20 (the replaced instruction)
+    emit(B(here(), 0x909da4))                  # back to the hook site + 4
+    fs_put(0x909da0, [B(0x909da0, rstart)], 'Forced recompute 0x909d4c +0x150: the in-game HUD editor runtime, re-applied after the game\'s post-Calculate refresh (hud_runtime.c)')
 
