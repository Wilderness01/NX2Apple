 // --- direct-write (DmIOS 0x83714 wrapper + 0x83880) ---
 static void uw_direct_write(void) {
     if (!g_st.inited) return;
-    // The hook owns the aspect only once it has actually run (tramp_n > 0). V1.3.0 installed the hook on garbage, so the trampoline never
-    // ran (tramp_n stayed 0) while this early return still suppressed direct-write — the camera never widened. Direct-write is the primary
-    // path until the hook proves itself; both write the same widened aspect, so running both is idempotent. (tramp_n is read from the
-    // present thread while the trampoline increments it on the render thread: a 32-bit aligned read is single-copy on ARM64, and a stale
-    // 0 only means direct-write runs one frame longer.)
-    if (g_st.hooked && g_st.tramp_n > 0) {
-        atomic_store_explicit(&g_st.active,
-            (uint32_t)(g_st.enabled && g_st.aspect != 0.0f), memory_order_release);
-        return;
-    }
+    // Active: the widened aspect is in effect when UW is enabled and either the hook has run (the trampoline widens during calcMatrix)
+    // or direct-write has widened the object (its aspect reads the target).
+    atomic_store_explicit(&g_st.active,
+        (uint32_t)(g_st.enabled && g_st.aspect != 0.0f && (g_st.tramp_n > 0 || g_st.written)), memory_order_release);
     if (g_st.scan) {      // DM_UW_SCAN: one-shot diagnostic scan (log only)
         g_st.scan = 0;
         uintptr_t lo = g_st.scan_lo, hi = g_st.scan_hi;
@@ -283,37 +405,38 @@ static void uw_direct_write(void) {
             }
         }
     }
-    uintptr_t obj;
+    // The object: DM_UW_PROJ wins (an explicit offset); otherwise the most recent trampoline-seen 16:9 projection object (A3). CAM[0]
+    // is no longer used: [CAM[0]] holds the vtable address itself, not a projection object (log-7), so the old [base + CAM[0]] + 56 model
+    // read inside the vtable and never reached a real object. CAM[0]/CAM[2] are still parsed (and logged by uw_init) for compatibility,
+    // but they no longer pick the object. Until the trampoline has seen a 16:9 projection there is no object to write, and the hook
+    // widens it meanwhile — direct-write waits instead of writing to a bogus address.
+    uintptr_t obj = 0;
     if (g_st.proj) {
         obj = g_st.mod_base + g_st.proj;
+    } else if (g_st.last_proj) {
