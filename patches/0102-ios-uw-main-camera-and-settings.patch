+// --- hooked calcMatrix slots (0102 A2/A3) ---
+// Every vtable slot the hook replaced (the primary's, then the scan's). Direct-write (A3) checks a projection object's vtable against
+// this set: one of its first 64 slots must be a hooked calcMatrix slot, so a stale or wrong object is never written to.
+static uintptr_t g_hooked_slots[UW_VT_MAX];
+static int g_hooked_slots_n;
+static void uw_record_hook_slot(uintptr_t slot) {
+    for (int i = 0; i < g_hooked_slots_n; i++) if (g_hooked_slots[i] == slot) return;
+    if (g_hooked_slots_n < UW_VT_MAX) g_hooked_slots[g_hooked_slots_n++] = slot;
+}
+static int uw_vt_has_hooked_slot(uintptr_t vt) {
+    if (!vt || (vt & 7)) return 0;
+    for (int i = 0; i < g_hooked_slots_n; i++) {
+        uintptr_t q = g_hooked_slots[i];
+        if (q >= vt && q < vt + 64 * 8 && (q - vt) % 8 == 0) return 1;
+    }
+    return 0;
+}
