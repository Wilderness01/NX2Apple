 // --- vtable hook install (DmIOS 0x832a4) ---
@@ -190,6 +249,40 @@ static int uw_slot_valid(uintptr_t orig) {
     return orig >= g_st.mod_base && orig < g_st.mod_base + g_st.mod_size;
 }
 
+// Write a function pointer into a vtable slot (0102: shared by the primary hook and the .rodata scan). The original queries the current
+// protection through a Mach wrapper and restores it afterwards; the engine uses plain mprotect (probe.c:418). The vtable lives in the
+// game's rodata/data, which the loader leaves PROT_READ|PROT_WRITE (loader.c maps the whole image RW and only the text goes RX) — NOT RX.
+// Restoring to PROT_READ|PROT_EXEC failed on device ([RED] hook: mprotect restore failed, V1.3.0): iOS will not add PROT_EXEC to a data
+// page. Query the real protection and restore exactly that; fall back to RW (the loader's data protection) when the query fails. A slot
+// on an executable page is never written: that is game code, not a vtable, and writing a pointer into it would corrupt it.
+static int uw_write_slot(void **slot, void *value) {
+    long ps = sysconf(_SC_PAGESIZE);
+    if (ps <= 0) ps = 0x4000;
+    uintptr_t page = (uintptr_t)slot & ~((uintptr_t)ps - 1);
+    vm_address_t ra = (vm_address_t)page; vm_size_t rs = 0;
+    vm_region_basic_info_data_64_t vi; mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64; mach_port_t obj = MACH_PORT_NULL;
+    int restore_prot = PROT_READ | PROT_WRITE;
+    if (vm_region_64(mach_task_self(), &ra, &rs, VM_REGION_BASIC_INFO_64, (vm_region_info_t)&vi, &cnt, &obj) == KERN_SUCCESS) {
+        if (vi.protection & VM_PROT_EXECUTE) {
+            UW_LOG("[RED] hook: slot %p is on an executable page (game code, not a vtable), not writing", (void *)slot);
+            return -1;
+        }
+        restore_prot = 0;
+        if (vi.protection & VM_PROT_READ) restore_prot |= PROT_READ;
+        if (vi.protection & VM_PROT_WRITE) restore_prot |= PROT_WRITE;
+        if (vi.protection & VM_PROT_EXECUTE) restore_prot |= PROT_EXEC;
+    }
+    if (mprotect((void *)page, (size_t)ps, PROT_READ | PROT_WRITE) != 0) {
+        UW_LOG("[RED] hook: mprotect RW failed (%p), vtable hook unavailable", (void *)page);
+        return -1;
+    }
+    *slot = value;
+    sys_icache_invalidate(slot, sizeof *slot);
+    if (mprotect((void *)page, (size_t)ps, restore_prot) != 0)
+        UW_LOG("[RED] hook: mprotect restore failed (wanted %#x)", restore_prot);
+    return 0;
+}
+
 static int uw_install_hook(void) {
