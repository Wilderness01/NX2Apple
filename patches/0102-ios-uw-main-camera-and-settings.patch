 }
 
+// --- first-frame scan: hook every vtable that calls calcMatrix (0102 A2) ---
+// The main camera's projection may use a different vtable than CAM[1]'s (log-7: the trampoline only ever saw a 4:3 projection, and the
+// main camera stayed 16:9). calcMatrix lives at mod_base + UW_CALC_MATRIX_OFF; any vtable whose calcMatrix slot holds that address is a
+// projection vtable, whatever its address. Scan the module for that pointer value; a hit only counts when it sits in a run of
+// pointer-sized entries (at least two of its four neighbours are valid in-module pointers), so a stray literal in .text cannot hook a
+// wrong slot, and uw_write_slot refuses executable pages in any case. The primary vtable is already hooked by then, so its slot holds the
+// trampoline and is naturally skipped; if the primary hook failed, the scan hooks it too (and sets orig_fn, which the trampoline needs).
+static int uw_is_vtable_entry(uintptr_t v) {
+    return v && !(v & 7) && v >= g_st.mod_base && v < g_st.mod_base + g_st.mod_size;
+}
+
+static int uw_scan_hook_calcmatrix(void) {
+    if (!g_st.mod_base || !g_st.mod_size) return 0;
+    uintptr_t calc = g_st.mod_base + UW_CALC_MATRIX_OFF;
+    uintptr_t lo = g_st.mod_base, hi = g_st.mod_base + g_st.mod_size;
+    int found = 0, hooked = 0;
+    for (uintptr_t p = lo; p + 8 <= hi; p += 8) {
+        if (*(uintptr_t *)p != calc) continue;
+        found++;
+        // Neighbour check: at least two of the four adjacent slots must be valid in-module pointers (a vtable is a run of them).
+        int good = 0;
+        if (p - lo >= 8 && uw_is_vtable_entry(*(uintptr_t *)(p - 8))) good++;
+        if (p - lo >= 16 && uw_is_vtable_entry(*(uintptr_t *)(p - 16))) good++;
+        if (p + 16 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 8))) good++;
+        if (p + 24 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 16))) good++;
+        if (good < 2) {
+            UW_LOG("calcMatrix scan: slot %p ignored (only %d/4 pointer neighbours)", (void *)p, good);
+            continue;
+        }
+        // Walk back over valid pointers to the table's start, for the slot index in the log. Tables can sit contiguously, so the
+        // start (and the index) is approximate when the run is longer than 64 slots; the slot address itself is what gets hooked.
+        uintptr_t start = p;
+        int back = 0;
+        while (start > lo && back < 64 && uw_is_vtable_entry(*(uintptr_t *)(start - 8))) { start -= 8; back++; }
+        if (hooked >= UW_SCAN_MAX) {
+            UW_LOG("calcMatrix scan: slot %p (table %p, slot %llu) skipped, scan cap %d reached",
+                   (void *)p, (void *)start, (unsigned long long)((p - start) / 8), UW_SCAN_MAX);
+            continue;
+        }
+        if (*(uintptr_t *)p != calc) continue;   // re-read: it must still hold calcMatrix
+        if (uw_write_slot((void **)p, (void *)uw_trampoline) != 0) {
+            UW_LOG("[RED] calcMatrix scan: hook failed at slot %p", (void *)p);
+            continue;
+        }
+        uw_record_hook_slot(p);
+        hooked++;
+        UW_LOG("calcMatrix vtable: hooked slot %llu at %p (table %p, calcMatrix %#llx)",
+               (unsigned long long)((p - start) / 8), (void *)p, (void *)start, (unsigned long long)calc);
+    }
+    if (hooked > 0) {
+        g_st.hooked = 1;
+        if (!g_st.orig_fn) g_st.orig_fn = (void *)calc;   // the primary hook did not install, so nothing set it yet
+    }
+    UW_LOG("calcMatrix vtables: %d slots hold calcMatrix, %d hooked (primary %s)",
+           found, hooked, g_st.hooked ? "installed" : "not installed");
+    return hooked;
+}
