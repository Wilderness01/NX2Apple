-// (0132) Walk the full parent chain and sum the local translations
-// (+0x30/+0x34), giving the pane's layout position in the root's space.
-// A static pane's +0x70 is never composed by the game, so the stored
-// original cannot come from it; and the 0130 single-parent fallback is
-// insufficient -- it only ran when the pane's own local was non-zero, and
-// it read only the immediate parent's layout, so it missed a layout that
-// lives further up the chain (log-41: TxtCounter's local is (0,0), so
-// 0130 never ran for it; and the regional panes' live matrix is non-zero,
-// so 0130 never triggered for them either). The chain sum is the layout
-// whenever the layout is in the +0x30 chain at all (a plain sum: no
-// rotation, parent scale 1 -- the scales in the HUD chains are 1, and the
-// origin effect is a few units at most, so the sum is exact to within a
-// few units). It never reads any +0x70 (a stale cache for a static pane,
-// and a moved matrix for a matched parent). It stops at the root (no
-// parent) or after 8 levels, and never follows a NULL or unaligned parent
-// (the same guards hud_edge_unparent uses). A pane named 'All' is a
-// genuinely positioned container when its local is non-zero (log-41:
-// Life's parent 'All' is at (585.7,284)), so the walk does NOT stop at
-// it -- it sums its local like any other ancestor.
-static inline __attribute__((always_inline)) void hud_edge_chain_origin(void *pane, float *ox, float *oy) {
-    float x = 0.0f, y = 0.0f;
-    void *p = pane;
-    for (int i = 0; i < 8 && p && !((uintptr_t)p & 7u); i++) {
-        x += *(const float *)((const char *)p + 0x30);
-        y += *(const float *)((const char *)p + 0x34);
-        p = *(void **)((const char *)p + 0x18);
-    }
-    *ox = x;
-    *oy = y;
-}
-
-// Undo a matched parent's applied transform from a child's current global
-// matrix, giving the child's UNMODIFIED global matrix in out. The parent's
-// applied (dx_m, dy_m, k_m) come from the parent's table entry (its stored
-// applied transform, +104/+108/+112); the parent's centre C comes from the
-// parent's stored ORIGINAL matrix (the parent's entry +8) and the parent
-// pane's size/origin -- C is the centre the parent's own transform scaled
-// about, i.e. in the unmodified frame, so the undo is:
-//     out = S_C(1/k_m) * T(-dx_m,-dy_m) * g
-// (a translate, then a scale about C; when k_m == 1 the scale is skipped --
-// it is the identity -- so the undo is exact, with no rounding at all).
-// A HIDDEN parent is undone too: its stored dx/dy/k are (0,0,1) but its
-// matrix was pushed +10000 off-screen, so the undo also translates by
-// -HUD_HIDE_DX (a hidden parent is never the identity, whatever its stored
-// dx/dy/k say).
-// (0130, 0132) The translation subtraction is exact for a DYNAMIC child, whose
-// +0x70 was composed by the game and carries its parent's move. For a
-// STATIC child it is spurious -- its +0x70 never carried the move -- but
-// the 0132 chain-walk in hud_edge rebuilds the stored original's
-// translation from the full parent chain, discarding the spurious
-// subtraction before it reaches the modified matrix, so the subtraction
-// stays: removing it would double-count the parent's move for dynamic
-// children (TxtGuide01 would land at 1063, not 795).
-// Returns 1 when a non-identity parent transform was undone, 0 when there
-// is nothing to undo (no parent entry, the parent's stored transform is
-// stale, or the parent applied the identity): out is then just g.
-// The parent's applied transform is also written to *pm_dx / *pm_dy / *pm_k
-// (the identity when there is no parent entry), and whether the parent is
-// hidden to *pm_hidden, so the caller can tell whether the child wants
-// exactly its parent's transform. The stored transform is stale when the
-// entry was only just created (the 1e30f sentinel in e_dx: the entry exists
-// but no transform has been applied through it yet) or when k_m is not a
-// usable number.
-static inline __attribute__((always_inline)) int hud_edge_unparent(void *pane, const float *g, void *table,
-                      float *out, float *pm_dx, float *pm_dy, float *pm_k, int *pm_hidden) {
-    for (int i = 0; i < 12; i++) out[i] = g[i];
-    *pm_dx = 0.0f; *pm_dy = 0.0f; *pm_k = 1.0f; *pm_hidden = 0;
-    void *parent = *(void **)((const char *)pane + 0x18);
-    if (!parent || ((uintptr_t)parent & 7u)) return 0;
-    char *pe = hud_edge_find_entry(table, parent);
-    if (!pe) return 0;
-    float dx_m = *(const float *)(pe + 104);
-    float dy_m = *(const float *)(pe + 108);
-    float k_m = *(const float *)(pe + 112);
-    if (dx_m == 1e30f) return 0;   // the parent's entry is fresh: no transform applied yet
-    if (k_m == 0.0f || k_m != k_m) return 0;
-    *pm_dx = dx_m; *pm_dy = dy_m; *pm_k = k_m;
-    *pm_hidden = *(const u32 *)(pe + 116) != 0;
-    if (!*pm_hidden && dx_m == 0.0f && dy_m == 0.0f && k_m == 1.0f) return 0;   // identity: nothing to undo
-    // Translate out by (-dx_m, -dy_m) (the rows are untouched: a pure
-    // translation left-multiplied onto the matrix only moves its translation).
-    // (0130, 0132) This subtraction is CORRECT for a dynamic child, whose +0x70
-    // matrix was composed by the game and does carry its parent's move
-    // (TxtGuide01: g 923 = layout 655 + parent 268). For a static child
-    // it is spurious -- its +0x70 never carried the move -- but the 0132
-    // chain-walk in hud_edge overwrites the stored original's translation
-    // from the full parent chain, so the spurious subtraction is discarded
-    // there and never reaches the modified matrix.
-    out[3] -= dx_m;
-    out[7] -= dy_m;
-    // A hidden parent was pushed off-screen on top of its (identity) stored
-    // transform: undo that too, so the child's original is its own layout
-    // position and hiding the parent does not hide the child. (Same note
-    // as above: for a static child the 0132 chain-walk overwrites it.)
-    if (*pm_hidden) out[3] -= HUD_HIDE_DX;
-    if (k_m != 1.0f) {
-        // Scale about the parent's (unmodified) centre C by 1/k_m.
-        float pw = *(const float *)((const char *)parent + 0x50);
-        float ph = *(const float *)((const char *)parent + 0x54);
-        unsigned char porigin = *(const unsigned char *)((const char *)parent + 0x5b);
-        float cx, cy;
-        hud_edge_centre((const float *)(pe + 8), pw, ph, porigin, &cx, &cy);
-        float s = 1.0f / k_m;
-        float tmp[12];
-        hud_edge_xform_c(out, tmp, 0.0f, 0.0f, s, s, cx, cy);
-        for (int i = 0; i < 12; i++) out[i] = tmp[i];
-    }
-    return 1;
-}
