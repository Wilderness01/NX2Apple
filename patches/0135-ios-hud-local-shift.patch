-// The centre of a pane, in global layout units: its origin plus half its
-// size towards the middle (the layout is y-up, the origin at the parent's
-// centre, so a top origin's centre is half the height below it, a left
-// origin's half the width to its right). A pane with no usable size is
-// centred on its translation. The origin byte is at +0x5b (confirmed by
-// disassembly of the local matrix helper at main+0x9096d0: bits 4-5 the
-// horizontal origin, 1 left, 2 right; bits 6-7 the vertical origin, 1 top,
-// 2 bottom; 0 is the centre either way); the size is at +0x50 / +0x54.
-static inline __attribute__((always_inline)) void hud_edge_centre(const float *m, float w, float h,
-                      unsigned char origin, float *cx, float *cy) {
-    if (w > 0.0f && w < 100000.0f && h > 0.0f && h < 100000.0f) {
-        float ox = ((origin >> 4) & 3) == 1 ? w * 0.5f : ((origin >> 4) & 3) == 2 ? -w * 0.5f : 0.0f;
-        float oy = ((origin >> 6) & 3) == 1 ? -h * 0.5f : ((origin >> 6) & 3) == 2 ? h * 0.5f : 0.0f;
-        *cx = m[0] * ox + m[1] * oy + m[3];
-        *cy = m[4] * ox + m[5] * oy + m[7];
-    } else {
-        *cx = m[3];
-        *cy = m[7];
-    }
-}
-
-// Scale orig about the given centre (cx, cy), then move by (dx, dy) in
-// layout units, into mod. sx scales the x row, sy the y row (a HUD widget
-// passes sx == sy == k). The third row (depth) is left alone: this is a 2D
-// widget, and scaling its depth would change its draw order. (From the old
-// hud_calc.c, unchanged.)
-static inline __attribute__((always_inline)) void hud_edge_xform_c(const float *orig, float *mod, float dx, float dy,
-                      float sx, float sy, float cx, float cy) {
-    for (int i = 0; i < 3; i++) { mod[i] = orig[i] * sx; mod[4 + i] = orig[4 + i] * sy; }
-    mod[3] = cx + (orig[3] - cx) * sx + dx;
-    mod[7] = cy + (orig[7] - cy) * sy + dy;
-    for (int i = 8; i < 12; i++) mod[i] = orig[i];
-}
-
-// Scale orig about the pane's own centre, then move by (dx, dy).
-static inline __attribute__((always_inline)) void hud_edge_xform(const float *orig, float *mod, float dx, float dy,
-                      float sx, float sy, float w, float h, unsigned char origin) {
-    float cx, cy;
-    hud_edge_centre(orig, w, h, origin, &cx, &cy);
-    hud_edge_xform_c(orig, mod, dx, dy, sx, sy, cx, cy);
-}
