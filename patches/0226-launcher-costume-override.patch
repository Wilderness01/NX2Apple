+// ---------- 0226: launcher costume override (host per-frame write) ----------
+// The launcher pick (DM_CHAR_CAP / DM_CHAR_CLOTHES, set by CharSelectPersist.m
+// from DmCharSelect.cap / .clothes) is written into the game's equipped-costume
+// fields every presented frame, so the outfit the launcher picked is the outfit
+// the game loads -- no shop visit needed. This replaces the 0225/0225b/0225c/
+// 0225d read-only probes (deleted here) and the DM_FS=1 workflow env (deleted
+// from the workflow): the SaveData object is pinned, the probes are done.
+//
+// Pinned layout (constructor disassembly REPORT-SAVEDATA-CONSTRUCTOR-DISASM.md,
+// confirmed live by log-105's 0225d MATCH -- 20 candidates, 1 match):
+//   clothes field SaveData+0x718, cap field SaveData+0x770; each a string
+//   object {+0x00 vtable, +0x08 buffer, +0x10 s32 capacity}; buffers INLINE
+//   (clothes O+0x72c, cap O+0x784); capacity exactly 0x40 (64); both fields'
+//   vtable = [main+0x1360748]+0x10 (the global is 0 in the file, read live).
+//   Load (NSO 0x4c3c04) writes the buffers from the save file; commit (NSO
+//   0x4d1978) re-reads them and writes them back, so a host write persists to
+//   the save on the next commit without the host ever touching the file.
+//   The fields are plain strings: a pool-external name (Happi, Doctor,
+//   Gunman, 64) writes fine; whether the model lookup accepts it is decided
+//   by the device test (first round: pick a pool-external name).
+//
+// Location -- the gap the probes left: the object holds the SAVE's equipped
+// names at scan time, and the launcher pick is usually different, so the scan
+// cannot use the env names. It reads the save file instead: the host parses
+// save:/File1.bin (proper key-table walk -- the keys CurrentCapName /
+// CurrentClothName are resolved through the 180-entry key table, the value
+// entries are found by key index, the string is decoded through the pool;
+// REPORT-SAVEFILE-COSTUME-FIELD.md) and scans the heap for THOSE names. If
+// the save cannot be read or parsed (or a slot is empty), it falls back to
+// the env names (the launcher==save case the probes used). The scan starts
+// when the game opens save:/File1.bin for reading (hle_fs.c sets a flag on
+// that open -- the load fills the buffers right after it, and the costume
+// files are not opened until the kingdom load, ~30 s later, so there is
+// ample margin) and retries until it finds exactly one full match or a
+// 150 s deadline, with frame 600 as a backstop trigger if the flag never
+// fires. 0 or >=2 full matches means log and write nothing. The heap holds
+// at least three SaveData-shaped objects (log-105: two decoys pass every
+// check except name content), so the scan requires BOTH buffers to hold the
+// current names plus the full strict signature, tests every candidate, and
+// never trusts a single name or heap-address proximity.
+//
+// Write: every presented frame, once located, the launcher pick is copied as
+// name+NUL into the EXISTING inline buffers (clamped to capacity-1 = 63
+// chars), clothes and cap both; buffer pointers are never replaced, the save
+// file is never touched. Env semantics (CharSelectPersist.m): unset = follow
+// the save (do not write); "default" = the character's own default part,
+// which in the save's Mario namespace is the bare name "Mario" (the redirect
+// serves the character's own default file for it); otherwise a costume name
+// from the launcher's lists (validated against the whitelist below -- an
+// unknown value is logged and not written).
+// Only Super Mario Odyssey (program 0x0100000000010000) runs this: the
+// layout is that game's binary.
+#define COSTUME_SMO_PROGRAM   0x0100000000010000ull   // Super Mario Odyssey title ID
+#define COSTUME_OFF_CLOTHES   0x718   // clothes string object in SaveData
+#define COSTUME_OFF_CAP       0x770   // cap string object in SaveData
+#define COSTUME_BUF_CLOTHES   0x72c   // inline clothes buffer (field +0x14)
+#define COSTUME_BUF_CAP       0x784   // inline cap buffer (field +0x14)
+#define COSTUME_CAPACITY      0x40    // capacity pinned by the ctor (both fields)
+#define COSTUME_NAME_MAX      63      // capacity-1: longest name written
+#define COSTUME_VT_GLOBAL     0x1360748ull   // .data global: capacity-0x40 string-class vtable base
+#define COSTUME_HEAP_HIT_MAX  256     // string hits collected per name (the full count is still logged)
+#define COSTUME_LOCATE_NS     (150ull * 1000000000ull)   // locate-thread deadline: 150 s from its start
+#define COSTUME_FRAME_BACKSTOP 600     // start the locate thread at this presented frame at the latest
+
+static _Atomic uint64_t g_costume_obj;       // SaveData object address once located (0 = not yet)
+static _Atomic int g_costume_started;        // the locate thread was started (never restarted)
+static _Atomic int g_costume_locating;       // a locate thread is running now
+static _Atomic int g_costume_smo = -1;       // -1 unknown, 0 not Odyssey, 1 Odyssey
+
+// The launcher's costume ids (dm/ios/Sources/Launcher.swift dmOutfitCaps /
+// dmOutfitClothes, generated from there -- keep in sync). A pick that is not
+// in its slot's list is never written: a stale or mistyped UserDefaults value
+// must not reach the game's model lookup.
+static const char *costume_cap_names[50] = {
+    "Mario64", "Mario64Metal", "MarioAloha", "MarioArmor", "MarioArmorWestern", "MarioBandman",
+    "MarioBatter", "MarioClown", "MarioColorClassic", "MarioColorGold", "MarioColorLuigi", "MarioColorWaluigi",
+    "MarioColorWario", "MarioConductor", "MarioCook", "MarioDiddyKong", "MarioDoctor", "MarioDot3d",
+    "MarioExplorer", "MarioFootball", "MarioGolf", "MarioGunman", "MarioHappi", "MarioHariet",
+    "MarioKoopa", "MarioMaker", "MarioMechanic", "MarioNew3DS", "MarioPainter", "MarioPeach",
+    "MarioPilot", "MarioPirate", "MarioPoncho", "MarioPrimitiveMan", "MarioRacer", "MarioRango",
+    "MarioSailor", "MarioSanta", "MarioSatellite", "MarioScientist", "MarioShopman", "MarioSnowSuit",
+    "MarioSpaceSuit", "MarioSpewart", "MarioSuit", "MarioSunshine", "MarioSwimwear", "MarioTailCoat",
+    "MarioTopper", "MarioZombie",
+};
+static const char *costume_clothes_names[52] = {
+    "Mario64", "Mario64Metal", "MarioAloha", "MarioArmor", "MarioArmorWestern", "MarioBandman",
+    "MarioBatter", "MarioBone", "MarioClown", "MarioColorClassic", "MarioColorGold", "MarioColorLuigi",
+    "MarioColorWaluigi", "MarioColorWario", "MarioConductor", "MarioCook", "MarioDiddyKong", "MarioDoctor",
+    "MarioExplorer", "MarioFootball", "MarioGolf", "MarioGunman", "MarioHakama", "MarioHappi",
+    "MarioHariet", "MarioKoopa", "MarioMaker", "MarioMechanic", "MarioNew3DS", "MarioPainter",
+    "MarioPeach", "MarioPilot", "MarioPirate", "MarioPoncho", "MarioPrimitiveMan", "MarioRacer",
+    "MarioRango", "MarioSailor", "MarioSanta", "MarioSatellite", "MarioScientist", "MarioShopman",
+    "MarioSnowSuit", "MarioSpaceSuit", "MarioSpewart", "MarioSuit", "MarioSunshine", "MarioSwimwear",
+    "MarioTailCoat", "MarioTopper", "MarioUnderwear", "MarioZombie",
+};
+
+static int costume_name_ok(const char *name, int is_cap) {
+    if (!name || !*name) return 0;
+    // The bare name "Mario" is the default outfit for both slots (the
+    // "default" pick maps to it, and a save holding the default holds it).
+    // It is not a launcher list entry, so it is accepted here, not in the
+    // arrays below (which mirror Launcher.swift exactly).
+    if (!strcmp(name, "Mario")) return 1;
+    const char **list = is_cap ? costume_cap_names : costume_clothes_names;
+    size_t n = is_cap ? sizeof costume_cap_names / sizeof *costume_cap_names
+                      : sizeof costume_clothes_names / sizeof *costume_clothes_names;
+    for (size_t i = 0; i < n; i++) if (!strcmp(name, list[i])) return 1;
+    return 0;
+}
+
+// ---------- save file: the object's current names ----------
+// File1.bin format (REPORT-SAVEFILE-COSTUME-FIELD.md, read-only here -- the
+// host never writes the file): [CRC32(bytes[4..]) @0x00][version=1 @0x04]
+// [size @0x08][key table: 180 u32 @0x24, each a string offset relative to
+// 0x20][string pool][value entries: 8 bytes [key:u24][type:u8][value:u32],
+// type 0xa0 = string, value = pool index - 176, 0 = empty]. The pool is
+// stored as TWO runs of NUL-terminated strings, not one contiguous run:
+// the key names right after the key table (179 strings), then -- after a
+// binary offset table -- the value strings (232 strings). The pool index
+// counts across both runs in file order, and the value strings start two
+// strings into the second run (the run's first two strings sort before the
+// pool's value strings), so a string value v decodes to the second run's
+// (v-1)-th string. Verified against four anchors on the real save:
+// value 16 -> ForestWorldHomeStage, 25 -> Mario, 27 -> MarioExplorer,
+// 28 -> MarioHakama. The parser walks the key table by NAME (never by
+// assumed key index or file offset -- the value offsets 0x59b4/0x59bc from
+// the report are this save's, not the format's), finds each value entry by
+// key index, and decodes the string through the value run. A decoded name
+// must be a valid costume name for its slot, or the parse fails (a wrong
+// run or index decodes to some other game string, never a costume name).
+// Returns 1 when both names were resolved (each may be "" = empty slot).
+//
+// Find the value-string run: the second maximal run of back-to-back
+// NUL-terminated printable strings (each 1..64 chars) in the file. The
+// first run is the key names; the second is the value strings. Returns 1
+// and fills *start (file offset of the run's first string) and *count.
+static int costume_find_value_run(const uint8_t *data, size_t len, size_t *start, size_t *count) {
+    size_t runs[4][2]; int nruns = 0;
+    size_t i = 0;
+    while (i < len) {
+        size_t k = i, c = 0;
+        while (k < len) {
+            if (data[k] < 0x20 || data[k] > 0x7e) break;   // NUL or non-printable ends the run
+            size_t j = k;
+            while (j < len && j - k < 64 && data[j] >= 0x20 && data[j] <= 0x7e) j++;
+            if (j >= len || data[j] != 0) break;   // no NUL terminator within 64 bytes
+            c++;
+            k = j + 1;
+        }
+        if (c >= 3 && nruns < 4) { runs[nruns][0] = i; runs[nruns][1] = c; nruns++; }
+        i = k > i ? k : i + 1;
+    }
+    if (nruns < 2) return 0;
+    *start = runs[1][0]; *count = runs[1][1];
+    return 1;
+}
+
+// Decode a string value to its name through the value-string run.
+// value 0 = empty (not decoded here); a value above 232 cannot be a pool
+// index (the pool has 409 strings, value = pool index - 176, so the largest
+// value string is 409 - 176 = 232). Returns 1 on success.
+static int costume_value_string(const uint8_t *data, size_t len, uint32_t value, char *out, size_t outn) {
+    if (value == 0 || value > 232) return 0;
+    size_t start, count;
+    if (!costume_find_value_run(data, len, &start, &count)) return 0;
+    size_t idx = (size_t)value - 1;   // the run starts two strings before the pool's value section
+    if (idx >= count) return 0;
+    size_t p = start;
+    for (size_t i = 0; i < idx; i++) {   // walk to the idx-th string in the run
+        while (p < len && data[p]) p++;
+        if (p >= len) return 0;
+        p++;
+    }
+    if (p >= len || !data[p]) return 0;
+    size_t k = 0;
+    while (p < len && data[p] && k + 1 < outn) out[k++] = (char)data[p++];
+    out[k] = 0;
+    if (p >= len || data[p]) return 0;   // ran off the end, or the string did not fit
+    return 1;
+}
+
+static int costume_save_key_index(const uint8_t *data, size_t len, const char *want) {
+    if (len < 0x24 + 180u * 4u) return -1;
+    for (int i = 0; i < 180; i++) {
+        uint32_t off;
+        memcpy(&off, data + 0x24 + (size_t)i * 4, 4);
+        size_t at = 0x20 + (size_t)off;   // key-name offsets are relative to 0x20
+        if (at >= len) continue;
+        size_t k = 0;
+        while (want[k] && at + k < len && data[at + k] == (uint8_t)want[k]) k++;
+        if (!want[k] && at + k < len && !data[at + k]) return i;
+    }
+    return -1;
+}
+
+static int costume_save_entry_value(const uint8_t *data, size_t len, int key, uint32_t *value) {
+    // Find the value entry for `key`: 8 bytes [key:u24 LE][type:u8][value:u32 LE].
+    // The entries live after the string pool, but their segment offset is not
+    // part of the format's fixed skeleton, so they are found by scanning for
+    // the key+type pattern (one byte at a time -- the entries are 8-byte
+    // aligned from the file start, but the scan does not assume it). There
+    // must be exactly one string entry per key with a plausible value (0 =
+    // empty, 1..232 = a pool index): a second one, or a value outside that
+    // range, means the file is not shaped like the parsed format.
+    uint8_t pat[4] = { (uint8_t)(key & 0xff), (uint8_t)((key >> 8) & 0xff),
+                       (uint8_t)((key >> 16) & 0xff), 0xa0 };
+    int found = 0; uint32_t v = 0;
+    if (len < 8) return 0;
+    for (size_t i = 0; i + 8 <= len; i++) {
+        if (!memcmp(data + i, pat, 4)) {
+            uint32_t val; memcpy(&val, data + i + 4, 4);
+            if (val > 232) continue;   // not a plausible string value: a chance pattern, not an entry
+            if (found) return 0;
+            found = 1; v = val;
+        }
+    }
+    if (!found) return 0;
+    *value = v;
+    return 1;
+}
+
+static int costume_save_parse(const uint8_t *data, size_t len, char *cap, size_t capn, char *clothes, size_t clothesn) {
+    if (len < 0x24 + 180u * 4u) return 0;
+    uint32_t version; memcpy(&version, data + 4, 4);
+    if (version != 1) return 0;
+    int ki_cap = costume_save_key_index(data, len, "CurrentCapName");
+    int ki_clothes = costume_save_key_index(data, len, "CurrentClothName");
+    if (ki_cap < 0 || ki_clothes < 0) return 0;
+    uint32_t v_cap, v_clothes;
+    if (!costume_save_entry_value(data, len, ki_cap, &v_cap)) return 0;
+    if (!costume_save_entry_value(data, len, ki_clothes, &v_clothes)) return 0;
+    // Value 0 = empty slot. Otherwise decode through the value-string run
+    // and require a valid costume name for the slot: a wrong run or index
+    // decodes to some other game string, which the whitelist rejects.
+    cap[0] = 0; clothes[0] = 0;
+    if (v_cap) {
+        if (!costume_value_string(data, len, v_cap, cap, capn)) return 0;
+        if (!costume_name_ok(cap, 1)) return 0;
+    }
+    if (v_clothes) {
+        if (!costume_value_string(data, len, v_clothes, clothes, clothesn)) return 0;
+        if (!costume_name_ok(clothes, 0)) return 0;
+    }
+    return 1;
+}
+
+// Read save:/File1.bin through the host path the game itself reads (the
+// transactional work directory, not the committed one) and parse it.
+// Returns 1 when both equipped names were resolved.
+static int costume_save_read(char *cap, size_t capn, char *clothes, size_t clothesn) {
+    char host[1024];
+    if (!dm_fs_host_path("save:/File1.bin", host, sizeof host)) return 0;
+    FILE *f = fopen(host, "rb");
+    if (!f) return 0;
+    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return 0; }
+    long end = ftell(f);
+    if (end <= 0 || end > (long)(4u << 20)) { fclose(f); return 0; }   // a save file is ~2 MB
+    size_t len = (size_t)end;
+    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return 0; }
+    uint8_t *data = malloc(len);
+    if (!data) { fclose(f); return 0; }
+    size_t got = fread(data, 1, len, f);
+    fclose(f);
+    int ok = got == len && costume_save_parse(data, len, cap, capn, clothes, clothesn);
+    free(data);
+    return ok;
+}
+
+// ---------- location: heap scan for the SaveData object ----------
+// The strict signature (0225d's, unchanged in substance): O is the SaveData
+// object iff both buffer pointers are exactly the inline offsets, both
+// buffers hold the expected names, both capacities are exactly 0x40, and
+// both vtables equal the runtime-read [main+0x1360748]+0x10. The fields are
+// reported back for the MATCH log line.
+typedef struct {
+    uint64_t vt_c, buf_c, vt_p, buf_p;
+    int32_t cap_c, cap_p;
+    char str_c[64], str_p[64];
+} costume_fields_t;
+
+static int costume_buf_read(uint64_t buf, char *out, size_t outn) {
+    uint8_t win[COSTUME_CAPACITY];
+    if (guest_page_read(buf, win, sizeof win) != 0) return 0;
+    size_t k = 0;
+    while (k < sizeof win && win[k]) k++;
+    if (k >= sizeof win) return 0;   // no NUL in the whole buffer: not a costume name
+    size_t n = k < outn - 1 ? k : outn - 1;
+    memcpy(out, win, n); out[n] = 0;
+    return 1;
+}
+
+static int costume_object_test(uint64_t o, const char *exp_c, const char *exp_p, uint64_t exp_vt, costume_fields_t *f) {
+    uint64_t v = 0;
+    memset(f, 0, sizeof *f);
+    int r_vt_c = mem_read(o + COSTUME_OFF_CLOTHES, 8, &f->vt_c) == 0;
+    int r_buf_c = mem_read(o + COSTUME_OFF_CLOTHES + 8, 8, &f->buf_c) == 0;
+    int r_cap_c = mem_read(o + COSTUME_OFF_CLOTHES + 0x10, 4, &v) == 0;
+    if (r_cap_c) f->cap_c = (int32_t)(uint32_t)v;
+    int r_vt_p = mem_read(o + COSTUME_OFF_CAP, 8, &f->vt_p) == 0;
+    int r_buf_p = mem_read(o + COSTUME_OFF_CAP + 8, 8, &f->buf_p) == 0;
+    int r_cap_p = mem_read(o + COSTUME_OFF_CAP + 0x10, 4, &v) == 0;
+    if (r_cap_p) f->cap_p = (int32_t)(uint32_t)v;
+    int ptr_c = r_buf_c && f->buf_c == o + COSTUME_BUF_CLOTHES;
+    int ptr_p = r_buf_p && f->buf_p == o + COSTUME_BUF_CAP;
+    int eq_c = ptr_c && costume_buf_read(f->buf_c, f->str_c, sizeof f->str_c) && !strcmp(f->str_c, exp_c);
+    int eq_p = ptr_p && costume_buf_read(f->buf_p, f->str_p, sizeof f->str_p) && !strcmp(f->str_p, exp_p);
+    int cap_ok = r_cap_c && r_cap_p && f->cap_c == COSTUME_CAPACITY && f->cap_p == COSTUME_CAPACITY;
+    int vt_ok = r_vt_c && r_vt_p && f->vt_c == exp_vt && f->vt_p == exp_vt;
+    return ptr_c && ptr_p && eq_c && eq_p && cap_ok && vt_ok;
+}
+
+// One heap scan pass: find both expected names in the guest heap, derive a
+// candidate object from each hit, test the strict signature. Returns the
+// number of full matches (0, 1, or more; -1 when there is no heap yet);
+// when exactly 1, *match is the object address. The same chunk machine as
+// the 0225d probe (1 MB chunks, 15-byte overhang so a name straddling a
+// boundary is still found), without its 16-hit cap: every NUL-terminated
+// hit is collected (up to the per-name cap) and the full count is logged.
+static int costume_heap_scan(const char *exp_c, const char *exp_p, uint64_t exp_vt,
+                             uint64_t *match, int *tested) {
+    *match = 0; *tested = 0;
+    uint64_t hb = 0; size_t hopen = 0;
+    dm_guest_heap_range(&hb, &hopen);
+    if (!hb || !hopen) return -1;
+    const size_t CH = 1u << 20, OV = 15;
+    uint8_t *chunk = malloc(CH + OV);
+    if (!chunk) return -1;
+    uint64_t hits[2][COSTUME_HEAP_HIT_MAX];
+    int nhit[2] = { 0, 0 }, total[2] = { 0, 0 };
+    for (int s = 0; s < 2; s++) {
+        const char *name = s == 0 ? exp_c : exp_p; size_t nl = strlen(name);
+        for (size_t off = 0; off < hopen; off += CH) {
+            size_t n = hopen - off < CH ? hopen - off : CH;
+            size_t want = n + OV < hopen - off ? n + OV : hopen - off;
+            vm_size_t got = 0;
+            if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)want, (vm_address_t)(uintptr_t)chunk, &got) || got != want) {
+                if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)n, (vm_address_t)(uintptr_t)chunk, &got) || got != n)
+                    continue;   // unmapped chunk (heap grew/shrank): skip it
+                want = n;
+            }
+            for (size_t i = 0; i + nl + 1 <= want && i < n; ) {
+                uint8_t *p = memchr(chunk + i, (unsigned char)name[0], want - i);
+                if (!p) break;
+                i = (size_t)(p - chunk);
+                if (i < n && i + nl + 1 <= want && !memcmp(p, name, nl) && p[nl] == 0) {
+                    total[s]++;
+                    if (nhit[s] < COSTUME_HEAP_HIT_MAX) hits[s][nhit[s]++] = hb + off + i;
+                    i += nl + 1;
+                } else i++;
+            }
+        }
+        if (total[s] > nhit[s])
+            LOG("[dm] costume: locate: \"%s\": %d hit(s) (collection capped at %d, hits beyond the cap untested)",
+                name, total[s], nhit[s]);
+    }
+    uint64_t seen[2 * COSTUME_HEAP_HIT_MAX]; int nseen = 0, nmatch = 0;
+    uint64_t first = 0;
+    for (int s = 0; s < 2; s++) {
+        for (int i = 0; i < nhit[s]; i++) {
+            uint64_t o = hits[s][i] - (s == 0 ? COSTUME_BUF_CLOTHES : COSTUME_BUF_CAP);
+            int dup = 0;
+            for (int k = 0; k < nseen; k++) if (seen[k] == o) { dup = 1; break; }
+            if (dup) continue;   // reached from both its strings: test once
+            if (nseen < 2 * COSTUME_HEAP_HIT_MAX) seen[nseen++] = o;
+            costume_fields_t f;
+            (*tested)++;
+            if (costume_object_test(o, exp_c, exp_p, exp_vt, &f)) {
+                nmatch++;
+                if (!first) first = o;
+                LOG("[dm] costume: locate: MATCH O=%#llx vt_c=%#llx buf_c=%#llx \"%s\" cap_c=%d vt_p=%#llx buf_p=%#llx \"%s\" cap_p=%d exp_vt=%#llx",
+                    (unsigned long long)o, (unsigned long long)f.vt_c, (unsigned long long)f.buf_c, f.str_c, f.cap_c,
+                    (unsigned long long)f.vt_p, (unsigned long long)f.buf_p, f.str_p, f.cap_p, (unsigned long long)exp_vt);
+            }
+        }
+    }
+    LOG("[dm] costume: locate: \"%s\" %d hit(s), \"%s\" %d hit(s); tested %d candidate(s), %d match(es)",
+        exp_c, total[0], exp_p, total[1], *tested, nmatch);
+    if (nmatch == 1) *match = first;
+    free(chunk);
+    return nmatch;
+}
+
+// Resolve one env value to a scannable name: "default" is the bare name
+// "Mario"; a whitelisted costume name is itself; unset (or an unknown
+// value) resolves to nothing. Used only by the locate fallback.
+static int costume_env_to_name(const char *env, int is_cap, char *out, size_t outn) {
+    if (!env || !*env) return 0;
+    if (!strcmp(env, "default")) { snprintf(out, outn, "Mario"); return 1; }
+    if (!costume_name_ok(env, is_cap)) return 0;
+    snprintf(out, outn, "%s", env);
+    return 1;
+}
+
+// Resolve the two names to scan for this pass. Returns 1 when both are
+// known. Source 1 is the save file (the object's actual contents); source
+// 2 is the env (the launcher pick; "default" means the bare name "Mario").
+// A slot with no known name blocks the scan -- a single name is not enough
+// (log-105's decoys: one holds the current clothes name with an empty cap,
+// the other the current cap name with a different clothes name).
+static int costume_expected_names(char *exp_c, size_t exp_cn, char *exp_p, size_t exp_pn, const char **src) {
+    char save_cap[64] = "", save_clothes[64] = "";
+    if (costume_save_read(save_cap, sizeof save_cap, save_clothes, sizeof save_clothes)
+        && save_cap[0] && save_clothes[0]) {
+        snprintf(exp_c, exp_cn, "%s", save_clothes);
+        snprintf(exp_p, exp_pn, "%s", save_cap);
+        *src = "save";
+        return 1;
+    }
+    char rc[64], rp[64];
+    if (!costume_env_to_name(getenv("DM_CHAR_CLOTHES"), 0, rc, sizeof rc)) return 0;
+    if (!costume_env_to_name(getenv("DM_CHAR_CAP"), 1, rp, sizeof rp)) return 0;
+    snprintf(exp_c, exp_cn, "%s", rc);
+    snprintf(exp_p, exp_pn, "%s", rp);
+    *src = "env";
+    return 1;
+}
+
+// Background locate thread: retry the heap scan until exactly one full
+// match is found or the deadline passes. arg is the main module base
+// (passed as a pointer-sized integer). The object does not move within a
+// session, so one MATCH is enough; the address is cached and the thread
+// never runs again.
+static void *costume_locate_thread(void *arg) {
+    uint64_t base = (uint64_t)(uintptr_t)arg;
+    uint64_t deadline = now_ns() + COSTUME_LOCATE_NS;
+    int pass = 0;
+    char last_src[16] = "";
+    for (;;) {
+        pass++;
+        char exp_c[64], exp_p[64]; const char *src = NULL;
+        if (!costume_expected_names(exp_c, sizeof exp_c, exp_p, sizeof exp_p, &src)) {
+            if (pass == 1)
+                LOG("[dm] costume: locate: no scannable names yet (save unreadable or a slot empty, env unset/invalid); retrying");
+            if (now_ns() >= deadline) break;
+            usleep(1000000);
+            continue;
+        }
+        if (strcmp(src, last_src)) {
+            snprintf(last_src, sizeof last_src, "%s", src);
+            LOG("[dm] costume: locate: expected clothes=\"%s\" cap=\"%s\" (from %s)", exp_c, exp_p, src);
+        }
+        uint64_t g748 = 0;
+        if (mem_read(base + COSTUME_VT_GLOBAL, 8, &g748) || !g748) {
+            if (pass == 1) LOG("[dm] costume: locate: vtable global unreadable/zero; retrying");
+            if (now_ns() >= deadline) break;
+            usleep(1000000);
+            continue;
+        }
+        uint64_t exp_vt = g748 + 0x10;
+        uint64_t match = 0; int tested = 0;
+        int nmatch = costume_heap_scan(exp_c, exp_p, exp_vt, &match, &tested);
+        if (nmatch < 0) {
+            if (pass == 1) LOG("[dm] costume: locate: no heap yet; retrying");
+        } else if (nmatch == 1) {
+            atomic_store(&g_costume_obj, match);
+            LOG("[dm] costume: located SaveData object %#llx (clothes=\"%s\" cap=\"%s\", tested %d candidate(s))",
+                (unsigned long long)match, exp_c, exp_p, tested);
+            break;
+        } else {
+            LOG("[dm] costume: locate: %d match(es) (tested %d) -- not writing", nmatch, tested);
+        }
+        if (now_ns() >= deadline) break;
+        usleep(1000000);
+    }
+    if (!atomic_load(&g_costume_obj))
+        LOG("[dm] costume: locate: deadline reached, object not located; no writes this session");
+    atomic_store(&g_costume_locating, 0);
+    return NULL;
+}
+
+// Start the locate thread on a background thread (a full-heap scan must not
+// stall the presenting thread). Runs at most once per launch.
+static void costume_locate_start(uint64_t base) {
+    if (atomic_load(&g_costume_started)) return;
+    atomic_store(&g_costume_started, 1);
+    if (atomic_exchange(&g_costume_locating, 1)) return;
+    pthread_t th; pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setdetachstate(&a, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&th, &a, costume_locate_thread, (void *)(uintptr_t)base)) {
+        LOG("[RED] costume: cannot start locate thread");
+        atomic_store(&g_costume_locating, 0);
+    }
+    pthread_attr_destroy(&a);
+}
+
+// ---------- write: the launcher pick, every presented frame ----------
+// Resolve one env value to a write target. Returns 1 and fills `out` when
+// the value says to write a name; 0 when unset (follow the save) or invalid
+// (logged once per distinct bad value, never written).
+static int costume_pick_target(const char *env, int is_cap, char *out, size_t outn) {
+    static char bad_cap[64], bad_clothes[64];   // last invalid value logged per slot
+    if (!env || !*env) return 0;   // unset: follow the save
+    if (!strcmp(env, "default")) { snprintf(out, outn, "Mario"); return 1; }
+    if (!costume_name_ok(env, is_cap)) {
+        char *bad = is_cap ? bad_cap : bad_clothes;
+        if (strcmp(env, bad)) {
+            snprintf(bad, sizeof bad_cap, "%s", env);
+            LOG("[dm] costume: ignoring unknown %s pick \"%s\" (not a costume name); following the save",
+                is_cap ? "cap" : "clothes", env);
+        }
+        return 0;
+    }
+    snprintf(out, outn, "%s", env);
+    return 1;
+}
+
+// Copy name+NUL into the inline buffer at `buf` (capacity COSTUME_CAPACITY,
+// clamped to capacity-1). The write itself runs every presented frame; the
+// log fires once per distinct value written.
+static void costume_write_buf(uint64_t buf, const char *name, int is_cap) {
+    static char wrote_cap[64], wrote_clothes[64];   // last value written per slot
+    static int write_failed_logged;
+    char *wrote = is_cap ? wrote_cap : wrote_clothes;
+    size_t nl = strlen(name);
+    if (nl > COSTUME_NAME_MAX) nl = COSTUME_NAME_MAX;   // clamp to capacity-1 (63)
+    char tmp[COSTUME_CAPACITY];
+    memcpy(tmp, name, nl); tmp[nl] = 0;
+    if (guest_page_write(buf, tmp, nl + 1) != 0) {
+        if (!write_failed_logged) {
+            write_failed_logged = 1;
+            LOG("[RED] costume: write to %#llx failed", (unsigned long long)buf);
+        }
+        return;
+    }
+    write_failed_logged = 0;
+    if (strcmp(name, wrote)) {
+        snprintf(wrote, sizeof wrote_cap, "%s", name);
+        LOG("[dm] costume: wrote %s \"%s\" into %#llx", is_cap ? "cap" : "clothes", name, (unsigned long long)buf);
+    }
+}
+
+static void costume_override_write(uint64_t obj) {
+    char want_c[64], want_p[64];
+    if (costume_pick_target(getenv("DM_CHAR_CLOTHES"), 0, want_c, sizeof want_c))
+        costume_write_buf(obj + COSTUME_BUF_CLOTHES, want_c, 0);
+    if (costume_pick_target(getenv("DM_CHAR_CAP"), 1, want_p, sizeof want_p))
+        costume_write_buf(obj + COSTUME_BUF_CAP, want_p, 1);
+}
+
+// Per presented frame (called from dm_cheats_present, replacing the 0225d
+// probe): start the locate thread once the save has been read (or at the
+// frame-600 backstop), then apply the launcher pick every frame once the
+// object is located. Runs for Odyssey only.
+static void costume_override_present(void) {
+    int smo = atomic_load(&g_costume_smo);
+    if (smo < 0) {
+        smo = dm_profile() && dm_profile()->program_id == COSTUME_SMO_PROGRAM ? 1 : 0;
+        atomic_store(&g_costume_smo, smo);
+        if (!smo) return;
+    } else if (!smo) return;
+    static uint64_t frame;
+    frame++;
+    uint64_t obj = atomic_load(&g_costume_obj);
+    if (!obj) {
+        if (!atomic_load(&g_costume_started) &&
+            (dm_fs_save_file1_read_seen() || frame >= COSTUME_FRAME_BACKSTOP)) {
+            uint64_t base = 0;
+            if (g_main_mod) base = (uint64_t)(uintptr_t)g_main_mod->base;
+            if (base) costume_locate_start(base);
+        }
+        return;
+    }
+    costume_override_write(obj);
+}
+
