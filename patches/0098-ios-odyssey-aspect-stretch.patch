From 1e53c6d7935c5fab96e77ba1c5078739d702515b Mon Sep 17 00:00:00 2001
From: Wilderness01 <140787484+Wilderness01@users.noreply.github.com>
Date: Mon, 9 Nov 2026 08:05:02 +0800
Subject: [PATCH] Odyssey: fix the ~22% horizontal stretch (projection width
 divisor follows the host layout width)


Upstream-Status: fork-only
Reason: The 0097 widescreen stubs make the game render 1560x720 handheld and 1950x900 docked, but the picture comes out stretched ~22% wider (tested 2026-11-08): the camera aspect does not follow the display rectangle, it is computed per frame from a hardcoded 1280/720 scale in main+0x73c160. This adds a fifth FRAME_STEP stub at main+0x73c6f0 that makes the scale width divisor follow the host layout width (state +0x44; 0 = 1280), so the width/height ratio becomes 2.167 and the stretch is gone. The docked black screen (swap-chain texture stays 1600x900 while the crop is 1950x900) is NOT fixed by this patch: its creation point was not located by static analysis and needs runtime verification.
Issue: Wilderness01/NX2Apple#1
---
 dm/games/0100000000010000/patches.py | 29 ++++++++++++++++++++++++++--
 1 file changed, 27 insertions(+), 2 deletions(-)

diff --git a/dm/games/0100000000010000/patches.py b/dm/games/0100000000010000/patches.py
index 515cee3..e3a581a 100644
--- a/dm/games/0100000000010000/patches.py
+++ b/dm/games/0100000000010000/patches.py
@@ -10,10 +10,15 @@ from nso_asm import ADRP, B
 # The docked layout is 900 tall, so its width is the 720 layout width scaled by 900/720 = 5/4, giving 1950x900 (the same 19.5:9 ratio, and more
 # pixels than the original 1600x900, so the resolution does not drop). The widths stay, so the 3D views grow in width too, and
 # sead::PerspectiveProjection's aspect (+0xb0) follows the wider rectangle (its set(rect) computes aspect from the rectangle; the fovy stays, so
-# the horizontal field of view widens by about 22% and the vertical one does not change). No fovy, aspect, culling or viewport stub is needed for
-# the wider screen: the projection, the culling tests and the viewport all read the display size or the projection's stored fields. x16 is free at
+# the horizontal field of view widens by about 22% and the vertical one does not change). No fovy, culling or viewport stub is needed for
+# the wider screen: the culling tests and the viewport read the display size or the projection's stored fields. x16 is free at
 # all four sites: the mode switch's registers are the display object and the size being set; the initial setting's are the sizes and the arguments
 # of the call that follows
+# The projection's aspect does NOT follow the display rectangle in practice (tested 2026-11-08: handheld fullscreen but Mario stretched ~22% wider):
+# the camera does not read the display rectangle (its getter main+0x94d240 has a single call site, the agl viewport computation), and the projection
+# is rebuilt per frame from a 1280/720 scale computed in main+0x73c160 (0xa3c160). So a fifth stub patches that scale's width divisor: main+0x73c6f0
+# calls the 1280 getter (bl #0xa4f150); the stub reads the host's layout width (state +0x44; 0 = 1280) instead, the height divisor (720) stays, so the
+# width/height ratio becomes 2.167 and the stretch is gone. x16 is free in main+0x73c160
 def frame_step(ctx):
     here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
 
@@ -41,6 +46,22 @@ def frame_step(ctx):
     wider_docked(0x4e27bc, '03c88052', 0x2a1003e3, 'docked display width 1600 -> the host\'s layout width * 5/4 (state +0x44; 0 = the game\'s own)')
     wider_docked(0x4bf34c, '04c88052', 0x2a1003e4, 'initial docked width 1600 -> the host\'s layout width * 5/4 (state +0x44; 0 = the game\'s own)')
 
+    def aspect_wide(site, orig, why):
+        # The projection scale's width divisor: main+0x73c6f0 calls the 1280 getter (bl #0xa4f150, orig 984a0094). Replace it with a stub that
+        # reads the host's layout width (state +0x44; 0 = 1280, the game's own) so the width/height ratio becomes 2.167 instead of 1.778.
+        # The height divisor at main+0x73c70c (720) stays. x16 is free in main+0x73c160.
+        fs_site(site, orig)
+        start = here()
+        emit(ADRP(16, here(), FS_STATE_OFF))
+        # ldr w16,[x16,#0x44]; cbnz w16,+0x0c (non-zero: use the layout width); mov w0,#0x500 (1280, the fallback); b site+4; mov w0,w16; b site+4
+        for w in (0xb9404610, 0x35000070, 0x5280a000):
+            emit(w)
+        emit(B(here(), site + 4))
+        emit(0x2a1003e0)
+        emit(B(here(), site + 4))
+        fs_put(site, [B(site, start)], why)
+    aspect_wide(0x73c6f0, '984a0094', 'projection width divisor 1280 -> the host\'s layout width (state +0x44; 0 = 1280, the game\'s own)')
+
 
 # How general this patch is and could be (dm/tools/docs_patches.py "Binding", listed in docs/agents/game-patches.md)
 BINDING = [
@@ -48,6 +69,10 @@ BINDING = [
      'now': 'build', 'goal': 'unreviewed', 'purpose': 'rendering',
      'why': "the stubs patch fixed offsets in this build's main (the display-mode switch and the initial display setting, handheld and docked); the switch function has not been fingerprinted for other builds",
      'checked': 'the 1.4.1 main (build b424be150a8e7d78701cbe7a439d9ebf): all four sites verified byte-for-byte against the binary, the stubs verified instruction-for-instruction with capstone, 2026-11-08'},
+    {'what': "projection width divisor 1280 -> the host's layout width (fixes the ~22% horizontal stretch: the camera's aspect does not follow the display rectangle)",
+     'now': 'build', 'goal': 'unreviewed', 'purpose': 'rendering',
+     'why': "the stub patches a fixed offset in this build's main (main+0x73c6f0, the 1280 getter call in the projection scale function main+0x73c160); that function's identity as the main camera is not 100% confirmed (no direct call sites, likely virtual), so the fix is verified by testing: if the handheld stretch is gone with no other picture anomaly, it is confirmed",
+     'checked': 'the 1.4.1 main (build b424be150a8e7d78701cbe7a439d9ebf): the site verified byte-for-byte against the binary (bl #0xa4f150 = 984a0094), the stub verified instruction-for-instruction with capstone, 2026-11-09'},
 ]
 
 FRAME_STEP = {'b424be150a8e7d78701cbe7a439d9ebf': frame_step}
