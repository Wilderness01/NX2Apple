@@ -1,83 +0,0 @@
-// char_select.c -- the title-menu character/costume picker stubs (0157).
-//
-// Compiled to a word table like hud_runtime.c
-// (aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin -fno-stack-protector
-// -fno-jump-tables -fno-unwind-tables -fno-asynchronous-unwind-tables -c,
-// objcopy -O binary --only-section=.text; never plain -O binary, see the
-// 0131 .eh_frame lesson). The rewriter's FRAME_STEP trampolines call these;
-// all game addresses are passed in as arguments, so this file holds no
-// absolute address and no literal pool.
-//
-// State page slots (hud_manual.c, the host frame tick):
-//   +0x260: u32 char-select flag. The switch stub sets it to 1 when the
-//   player picks the title menu's "角色选择" row; the host's per-present
-//   frame tick reads it, clears it, and opens the picker (CharSelectEditor).
-//   +0x264: u32 diagnostic, the full action id of the last switch call.
-//   +0x268: u32 diagnostic, sel | (row << 8) | (ret << 24) of the last call.
-//   +0x26c: u32 diagnostic, switch-call counter (the tick logs when it changes).
-//   All in the free zone +0x250..+0x300 (the HUD masks end at +0x250,
-//   the HUD table starts at +0x300).
-//
-// The diagnostics exist because #72 proved the stub can run and still be
-// wrong: its trampoline passed the table PAGE (0xec8000) instead of the
-// table (0xec8270/0xec8288), so the stub read string data as the action
-// table, never saw action 6, and always returned 0 -- the row-3 tap went
-// to VR and log-57 had zero [char] lines. The tick logs every switch
-// invocation from these slots, so the next device run proves what the
-// hook sees (sel, row, action, ret) instead of leaving it to inference.
-//
-// Why the "角色选择" row is the VR row, not a 7th row (verified 2026-11-16):
-// the title menu's List is built for exactly 7 actions (0-6) -- the ctor
-// (0x1d6610, called once from 0x495504 with w5 = 7) allocates the pane
-// array as count * 8 = 56 bytes (7 entries, indices 0-6), and the layout
-// (Menu.bflyt) has exactly 7 row panes (ParList00-06). Table A has 6
-// entries [0,1,2,6,3,5]; Table B starts right after it (0xec8288),
-// so there is no Table A[6] -- writing 7 there would break the pause menu's
-// Continue row. There is no 8th action, no 8th pane and no 8th layout row,
-// so a 7th menu row cannot be added through the table. The VR row (title
-// row 3, action 6, pane ParList06) is repurposed instead: VR on iPhone is
-// barely usable, the pause menu keeps its own VR row (Table B[2] = 6),
-// and the stub below tells the two apart by the table selector
-// ([list+0x58]: 1 = title Table A, 0 = pause Table B).
-#include <stdint.h>
-
-#define CHAR_SELECT_FLAG_OFF 0x260
-#define CHAR_SELECT_DIAG_ACTION_OFF 0x264
-#define CHAR_SELECT_DIAG_MISC_OFF 0x268
-#define CHAR_SELECT_COUNT_OFF 0x26c
-
-// The confirm-switch cut (0x1d7290): the switch at 0x1d7290 is the real
-// confirm dispatcher -- it reads [obj+0x58] (table selector) and
-// [obj+0x1c] (selected row), computes action = table[row] and jump-tables
-// to the action handler; its action-6 case (0x1d7334) is the only path to
-// the VR transition (0x1d7740). Decide (0x1d7800) was the first version's
-// hook site and was wrong: it has no BL caller and never runs the VR
-// action (it only special-cases action 0), which is why #71 showed the VR
-// screen and no [char] log line. Recompute the action id the way the
-// switch does -- [obj+0x58] selects the table (0 = pause Table B,
-// nonzero = title Table A), [obj+0x1c] is the selected row -- and, for
-// action 6 on the title menu (the repurposed VR row), set the host flag
-// so the picker opens. Other actions, and the pause menu's VR, are left
-// alone (the trampoline falls through to the switch). Returns 1 when the
-// flag was set, 0 otherwise; the trampoline returns to the caller on 1
-// (skipping the VR action) and falls through to the switch on 0.
-int char_select_decide_vr(void *menu, uint8_t *state, const int32_t *tableA, const int32_t *tableB) {
-    uint8_t sel = *(volatile uint8_t *)((char *)menu + 0x58);
-    int32_t row = *(volatile int32_t *)((char *)menu + 0x1c);
-    const int32_t *table = (sel == 0) ? tableB : tableA;
-    int32_t action = table[row];
-    int ret = (sel != 0 && action == 6) ? 1 : 0;
-    if (ret) {
-        *(volatile uint32_t *)(state + CHAR_SELECT_FLAG_OFF) = 1;
-    }
-    // Diagnostic (see the state-page comment above): record every switch
-    // invocation so the host tick can log it. Written unconditionally,
-    // not only when the flag is set -- a Confirm that computes the wrong
-    // action is exactly what the log needs to show.
-    *(volatile uint32_t *)(state + CHAR_SELECT_DIAG_ACTION_OFF) = (uint32_t)action;
-    *(volatile uint32_t *)(state + CHAR_SELECT_DIAG_MISC_OFF) =
-        (uint32_t)sel | ((uint32_t)(row & 0xff) << 8) | ((uint32_t)ret << 24);
-    *(volatile uint32_t *)(state + CHAR_SELECT_COUNT_OFF) =
-        *(volatile uint32_t *)(state + CHAR_SELECT_COUNT_OFF) + 1;
-    return ret;
-}
