-// ---- The game's font (dm/font/standard.ttf, registered from DM_FONT_DIR) ----
-static NSString *charSelectFontName(void) {
-    static NSString *name = nil;
-    static dispatch_once_t once;
-    dispatch_once(&once, ^{
-        const char *dir = getenv("DM_FONT_DIR");
-        NSString *path = nil;
-        if (dir) path = [[NSString stringWithUTF8String:dir] stringByAppendingPathComponent:@"standard.ttf"];
-        if (path && [[NSFileManager defaultManager] fileExistsAtPath:path]) {
-            NSURL *url = [NSURL fileURLWithPath:path];
-            CFArrayRef descs = CTFontManagerCreateFontDescriptorsFromURL((CFURLRef)url);
-            if (descs && CFArrayGetCount(descs) > 0) {
-                CTFontDescriptorRef desc = CFArrayGetValueAtIndex(descs, 0);
-                CFStringRef ps = CTFontDescriptorCopyAttribute(desc, kCTFontNameAttribute);
-                if (ps) { name = [(__bridge NSString *)ps copy]; CFRelease(ps); }
-                CFRelease(descs);
-            }
-            if (name) {
-                CFErrorRef err = NULL;
-                if (!CTFontManagerRegisterFontsForURL((CFURLRef)url, kCTFontManagerScopeProcess, &err)) {
-                    if (err) CFRelease(err);
-                    name = nil;
-                }
-            }
-        }
-    });
-    return name;
-}
-static UIFont *charSelectFont(CGFloat size, BOOL bold) {
-    NSString *name = charSelectFontName();
-    if (name) {
-        UIFont *f = [UIFont fontWithName:name size:size];
-        if (f) return f;
-    }
-    return bold ? [UIFont boldSystemFontOfSize:size] : [UIFont systemFontOfSize:size];
-}
-static UIColor *charSelectColor(uint32_t rgb) {
-    return [UIColor colorWithRed:((rgb >> 16) & 0xFF) / 255.0 green:((rgb >> 8) & 0xFF) / 255.0 blue:(rgb & 0xFF) / 255.0 alpha:1];
-}
