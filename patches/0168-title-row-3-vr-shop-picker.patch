-// ---- Saved settings ----
-static NSString *charSelectKey(NSString *what) { return [NSString stringWithFormat:@"DmCharSelect.%@", what]; }
-// A costume value: nil = follow the save (no key, no env var),
-// @"default" = the character's own default part, otherwise a costume name.
-static NSString *charSelectLoadCostume(NSString *what) {
-    return [[NSUserDefaults standardUserDefaults] stringForKey:charSelectKey(what)];
-}
-static void charSelectSaveCostume(NSString *what, NSString *value) {
-    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
-    if (value) [d setObject:value forKey:charSelectKey(what)];
-    else [d removeObjectForKey:charSelectKey(what)];
-}
-
-// ---- Live channel (the host fs redirect re-reads getenv on every open) ----
-static void charSelectApplyLive(NSString *character, NSString *cap, NSString *clothes) {
-    setenv("DM_CHAR_SELECT", character.UTF8String, 1);
-    if (cap) setenv("DM_CHAR_CAP", cap.UTF8String, 1); else unsetenv("DM_CHAR_CAP");
-    if (clothes) setenv("DM_CHAR_CLOTHES", clothes.UTF8String, 1); else unsetenv("DM_CHAR_CLOTHES");
-}
-
-// ---- Costume display text: MSBT name + description, or a cleaned fallback ----
-// Returns the Chinese name for a costume key (nil = "跟随存档", "default" =
-// "默认"); the description goes into *descOut ("" when there is none).
-// Never returns a raw internal name like "ColorWario".
-static NSString *charCostumeName(const char *key, BOOL isCap, NSString **descOut) {
-    if (descOut) *descOut = @"";
-    if (!key) return @"跟随存档";
-    if (!strcmp(key, "default")) return @"默认";
-    const CharCostumeText *table = isCap ? kCharCapText : kCharClothText;
-    size_t n = isCap ? sizeof kCharCapText / sizeof *kCharCapText
-                     : sizeof kCharClothText / sizeof *kCharClothText;
-    for (size_t i = 0; i < n; i++) {
-        if (!strcmp(table[i].key, key)) {
-            if (descOut) *descOut = [NSString stringWithUTF8String:table[i].desc];
-            return [NSString stringWithUTF8String:table[i].name];
-        }
-    }
-    for (size_t i = 0; i < sizeof kCharWarioFallbackText / sizeof *kCharWarioFallbackText; i++) {
-        if (!strcmp(kCharWarioFallbackText[i].key, key)) {
-            if (descOut) *descOut = [NSString stringWithUTF8String:kCharWarioFallbackText[i].desc];
-            return [NSString stringWithUTF8String:kCharWarioFallbackText[i].name];
-        }
-    }
-    // No MSBT name: the cleaned internal name (strip the "Mario" prefix).
-    if (!strncmp(key, "Mario", 5)) return [NSString stringWithUTF8String:key + 5];
-    return [NSString stringWithUTF8String:key];
-}
-// The description for the "默认" / "跟随存档" cards.
-static NSString *charSpecialDesc(const char *key, BOOL isCap) {
-    if (!key) return isCap ? @"使用存档里的帽子" : @"使用存档里的服装";
-    if (!strcmp(key, "default")) return isCap ? @"角色的默认帽子" : @"角色的默认服装";
-    return @"";
-}
-// The emblem character: the first character of the display name.
-static NSString *charEmblemChar(NSString *name) {
-    if (name.length == 0) return @"?";
-    return [name substringToIndex:1];
-}
-// The pre-rendered preview image for an item (nil when no render exists).
-// Names in dm/ios/Sources/CharPreviews: char_<id>.png (the character in its
-// default outfit), cap_<id>_<Costume>.png (the hat alone),
-// clothes_<id>_<Costume>.png (the character wearing the outfit). The
-// "default" card shows the character in its default outfit; follow-the-save
-// (nil) has no specific item, so it has no image.
-static UIImage *charPreviewImage(int character, BOOL isCap, const char *costume) {
-    if (!costume) return nil;
-    NSString *charId = kCharIds[character];
-    NSString *name = nil;
-    if (!strcmp(costume, "default")) {
-        name = [NSString stringWithFormat:@"char_%@", charId];
-    } else {
-        name = [NSString stringWithFormat:@"%@_%@_%s", isCap ? @"cap" : @"clothes", charId, costume];
-    }
-    return [UIImage imageNamed:name inBundle:[NSBundle bundleForClass:[CharSelectEditor class]] compatibleWithTraitCollection:nil];
-}
