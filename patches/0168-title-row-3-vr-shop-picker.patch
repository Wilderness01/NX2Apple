diff --git a/dm/ios/Sources/CharSelectPersist.m b/dm/ios/Sources/CharSelectPersist.m
new file mode 100644
index 0000000..4469884
--- /dev/null
+++ b/dm/ios/Sources/CharSelectPersist.m
@@ -0,0 +1,38 @@
+// CharSelectPersist.m -- the character selection persistence (0168).
+//
+// Moved here from CharSelectEditor.m when the title-menu picker was
+// removed (0168): the in-game shop picker replaces it, and the shop
+// write-back (0166, not yet implemented) writes through this same
+// channel. The launcher calls dm_char_select_apply_saved at startup;
+// the live channel is setenv/unsetenv DM_CHAR_SELECT / DM_CHAR_CAP /
+// DM_CHAR_CLOTHES (the host fs redirect re-reads getenv on every open).
+//
+// Persistence: NSUserDefaults DmCharSelect.character ("mario" | "luigi" |
+// "wario"), DmCharSelect.cap and DmCharSelect.clothes (a costume name,
+// "default", or unset = follow the save).
+#import <Foundation/Foundation.h>
+#import <stdlib.h>
+
+// ---- Saved settings ----
+static NSString *charSelectKey(NSString *what) { return [NSString stringWithFormat:@"DmCharSelect.%@", what]; }
+// A costume value: nil = follow the save (no key, no env var),
+// @"default" = the character's own default part, otherwise a costume name.
+static NSString *charSelectLoadCostume(NSString *what) {
+    return [[NSUserDefaults standardUserDefaults] stringForKey:charSelectKey(what)];
+}
+
+// ---- Live channel (the host fs redirect re-reads getenv on every open) ----
+static void charSelectApplyLive(NSString *character, NSString *cap, NSString *clothes) {
+    setenv("DM_CHAR_SELECT", character.UTF8String, 1);
+    if (cap) setenv("DM_CHAR_CAP", cap.UTF8String, 1); else unsetenv("DM_CHAR_CAP");
+    if (clothes) setenv("DM_CHAR_CLOTHES", clothes.UTF8String, 1); else unsetenv("DM_CHAR_CLOTHES");
+}
+
+void dm_char_select_apply_saved(void) {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    NSString *ch = [d stringForKey:charSelectKey(@"character")];
+    if (!ch) ch = @"mario";
+    NSString *cap = charSelectLoadCostume(@"cap");
+    NSString *clothes = charSelectLoadCostume(@"clothes");
+    charSelectApplyLive(ch, cap, clothes);
+}
