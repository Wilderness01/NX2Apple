-// ---- Saved settings / live channel ----
-- (void)loadSaved {
-    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
-    NSString *ch = [d stringForKey:charSelectKey(@"character")];
-    _character = 0;
-    for (int i = 0; i < 3; i++) if ([kCharIds[i] isEqualToString:ch]) { _character = i; break; }
-    _cap = charSelectLoadCostume(@"cap");
-    _clothes = charSelectLoadCostume(@"clothes");
-    // Clamp a saved costume that is not on this character's list (e.g. the
-    // character changed since it was saved): fall back to Default.
-    if (![self costume:_cap isCap:YES validFor:_character]) _cap = @"default";
-    if (![self costume:_clothes isCap:NO validFor:_character]) _clothes = @"default";
-    _descIsCap = YES; _descKey = _cap;
-}
-- (void)save {
-    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
-    [d setObject:kCharIds[_character] forKey:charSelectKey(@"character")];
-    charSelectSaveCostume(@"cap", _cap);
-    charSelectSaveCostume(@"clothes", _clothes);
-    fputs("char editor: saved DmCharSelect.* (角色选择已保存)\n", stderr);
-}
-- (void)applyLive {
-    charSelectApplyLive(kCharIds[_character], _cap, _clothes);
-}
-- (void)openEditor {
-    [self loadSaved];
-    [self applyLive];
-    [self refresh];
-}
-- (void)closeEditor {
-    [self save];
-    [self applyLive];
-    [self removeFromSuperview];
-    g_editor = nil;
-}
-- (void)closeWithoutSaving {
-    // 返回: discard this session's picks -- restore the saved settings to
