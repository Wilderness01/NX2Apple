-    if ([value isEqualToString:@"default"]) return YES;
-    // Check the value is in this character's list.
-    const char *list[64]; int n = 0;
-    if (isCap) {
-        if (character == 0) { for (size_t i = 0; i < sizeof kCharCapMario / sizeof *kCharCapMario; i++) list[n++] = kCharCapMario[i]; }
-        else if (character == 2) { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) list[n++] = kCharWario[i]; }
-    } else {
-        if (character == 0) { for (size_t i = 0; i < sizeof kCharClothesMario / sizeof *kCharClothesMario; i++) list[n++] = kCharClothesMario[i]; }
-        else if (character == 1) { for (size_t i = 0; i < sizeof kCharClothesLuigi / sizeof *kCharClothesLuigi; i++) list[n++] = kCharClothesLuigi[i]; }
-        else { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) list[n++] = kCharWario[i]; }
-    }
