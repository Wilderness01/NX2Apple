+    for (int e = 0; e < E_N; e++) if (_lineHidden[e]) h[k_lineEditKeys[e]] = @(YES);
+    NSDictionary *d = @{@"scale": @(_lineScale), @"sizes": z, @"offsets": o, @"hidden": h};
     [NSUserDefaults.standardUserDefaults setObject:d forKey:k_line_layout_key];
 }
 
@@ -1000,6 +1028,10 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
     [_editSlider addTarget:self action:@selector(editSliderChanged:) forControlEvents:UIControlEventValueChanged];
