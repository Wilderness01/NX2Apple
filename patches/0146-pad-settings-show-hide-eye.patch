             if (extra == 2) { [_owner setObject:@(C_BTN | (uint64_t)B_DOWN << 8) forKey:t]; continue; }
         }
         DmPadHit hit = dm_pad_hit(self.geo, _full, _layout.separated, _tap, !_stick[0], p);   // the same geometry the controls are drawn with (the menu button took its own touches, menuTakes)
-        BOOL lineOff = hit.kind == DM_PAD_HIT_KEY && (lockedKey(hit.key) == B_ZR || lockedKey(hit.key) == B_R || lockedKey(hit.key) == B_LS || lockedKey(hit.key) == B_RS);   // ZR, R, L3 and R3 are hidden and disabled
+        BOOL lineOff = hit.kind == DM_PAD_HIT_KEY && (lockedKey(hit.key) == B_ZR || lockedKey(hit.key) == B_R || lockedKey(hit.key) == B_LS || lockedKey(hit.key) == B_RS || [self keyUserHidden:lockedKey(hit.key)]);   // ZR, R, L3 and R3 are hidden and disabled; a key the player hid in the button settings is too (0146)
         if (hit.kind == DM_PAD_HIT_KEY && !lineOff) { [_owner setObject:@(C_BTN | (uint64_t)lockedKey(hit.key) << 8) forKey:t]; continue; }
         if (_tap) { game |= [self gameBegin:t]; continue; }
         int kind = hit.kind == DM_PAD_HIT_FACE ? C_FACE : hit.kind == DM_PAD_HIT_DPAD ? C_DPAD : hit.kind == DM_PAD_HIT_STICK ? C_STICK : C_NONE, idx = 0;
@@ -821,9 +840,9 @@ static BOOL g_hintShown;   // once per launch
 // their radii are their own sizes.
 - (CGPoint)jumpCenter { CGPoint f = self.faceCenter; CGFloat g = self.faceGap, r = self.faceR * _lineSizes[E_Y]; CGPoint o = [self lineOffset:@"jump"]; return CGPointMake(f.x - g - 2 * r - 12 * self.u + o.x, f.y + o.y); }
 - (CGPoint)photoCenter { CGPoint f = self.faceCenter; CGFloat g = self.faceGap, r = self.faceR * _lineSizes[E_Y]; CGPoint o = [self lineOffset:@"photo"]; return CGPointMake(f.x - 2 * g - 4 * r - 24 * self.u + o.x, f.y + o.y); }
