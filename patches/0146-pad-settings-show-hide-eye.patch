     (void)s;
     [self saveLineLayout];
 }
+// 0146: the eye toggle for the selected icon: eye (shown) or eye.slash (hidden, red);
+// the menu (gear) is never hideable, so the eye is disabled and dimmed for it.
+- (void)updateEditEye {
+    if (!_editEye) return;
+    BOOL menu = _editSelected == E_MENU;
+    BOOL hidden = !menu && _lineHidden[_editSelected];
+    [_editEye setImage:[UIImage systemImageNamed:hidden ? @"eye.slash" : @"eye"] forState:UIControlStateNormal];
+    _editEye.tintColor = hidden ? UIColor.systemRedColor : UIColor.whiteColor;
+    _editEye.enabled = !menu;
+    _editEye.alpha = menu ? 0.35 : 1;
+}
+- (void)editEyeTapped:(UIButton *)b {   // 0146: hide / show the selected icon
+    (void)b;
+    if (_editSelected == E_MENU) return;   // the menu is never hideable
+    _lineHidden[_editSelected] = !_lineHidden[_editSelected];
+    [self saveLineLayout];
+    [self applyLayout];   // the icon hides at once, or shows dimmed so it stays tappable
+    [self updateEditEye];
+    [self selectEditControl:_editSelected];   // refreshes the hint (now shows 已隐藏) and the highlight
+}
 - (void)glassSliderChanged:(UISlider *)s {   // the glass slider: the effect's strength, live
     _glassOpacity = s.value / 100;
     [self applyGlassOpacity];
@@ -1082,8 +1137,9 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
