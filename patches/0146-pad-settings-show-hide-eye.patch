+    for (int e = 0; e < E_N; e++) {
+        if (e == E_MENU) continue;
+        CALayer *ly = [self editLayer:e];
+        if (!ly || ly.hidden) continue;   // layout-hidden: leave it hidden
+        if (_lineHidden[e]) {
+            if (_editing) { ly.hidden = NO; ly.opacity = 0.35; }
+            else ly.hidden = YES;
+        } else ly.opacity = 1;
+    }
     [CATransaction commit];
     [self syncGlassVisibility];   // the glass follows its control: hidden with it in the Tap layout
 }
