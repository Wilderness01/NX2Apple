+    if (_lineHidden[E_B]) face &= ~(1ull << B_B);
+    if (_lineHidden[E_Y]) face &= ~(1ull << B_Y);
     dpad = 0;
     btn &= ~((1ull << B_ZR) | (1ull << B_R) | (1ull << B_LS) | (1ull << B_RS));
     int32_t ax[4] = {0};
