+    hint.text = [NSString stringWithFormat:@"当前：%@%@ · 拖动图标可以移动位置 · 拖动面板可以移动面板\n玻璃 %.0f%% 是现在的效果，100%% 最深", k_lineEditNames[e], _lineHidden[e] ? @" · 已隐藏" : @"", k_glassAnchor * 100];   // 0146: a hidden icon says so
     [self layoutEditHighlight];
 }
 - (void)layoutEditHighlight {   // the ring around the selected icon while the editor is open
@@ -1098,6 +1154,27 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
     setPath(_editHighlight, circlePath(CGPointMake(r, r), r - 1));
     [CATransaction commit];
 }
+// 0146: the layer for a movable control (the same mapping as editIconHidden), so the
+// user-hidden state can hide it; nil for nothing (every E_* has a layer).
+- (CALayer *)editLayer:(int)e {
+    switch (e) {
+        case E_A: return _key[B_A]; case E_B: return _key[B_B]; case E_Y: return _key[B_Y];
+        case E_ZL: return _key[B_ZL]; case E_L: return _key[B_L];
+        case E_MINUS: return _key[B_MINUS]; case E_PLUS: return _key[B_PLUS];
+        case E_JUMP: return _jump; case E_MENU: return _menu; default: return _photo;
+    }
+}
+// 0146: whether a game key (B_*) is hidden by the player in the button settings
+// (the editable controls only; the hardcoded-hidden keys X/ZR/R/L3/R3 and the D-pad
+// are handled by the layout, not here).
+- (BOOL)keyUserHidden:(int)b {
+    switch (b) {
+        case B_A: return _lineHidden[E_A]; case B_B: return _lineHidden[E_B]; case B_Y: return _lineHidden[E_Y];
+        case B_ZL: return _lineHidden[E_ZL]; case B_L: return _lineHidden[E_L];
+        case B_MINUS: return _lineHidden[E_MINUS]; case B_PLUS: return _lineHidden[E_PLUS];
+        default: return NO;
+    }
+}
 - (BOOL)editIconHidden:(int)e {   // the icon's layer is hidden (the Tap layout hides jump and photo, and every key)
     switch (e) {
         case E_A: return _key[B_A].hidden; case E_B: return _key[B_B].hidden; case E_Y: return _key[B_Y].hidden;
