     BOOL _panelDragging[1];                        // a bar is being dragged now: the layout leaves its frame alone (0116)
@@ -413,6 +415,20 @@ static void glassDiscSetOpacity(CAGradientLayer *disc, CGFloat p) {   // the fal
     for (int b = 0; b < B_N; b++) _key[b].hidden = _tap || (fullOnly(b) && !_full) || b == B_X || b == B_ZR || b == B_R || b == B_LS || b == B_RS || b >= B_LEFT;
     _ring.hidden = _knob.hidden = YES;   // the floating stick is drawn only while a finger holds it (refresh)
