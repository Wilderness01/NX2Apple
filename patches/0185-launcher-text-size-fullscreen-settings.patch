 =?UTF-8?q?n=20settings=20=E2=80=94=20fix=20the=20adaptive=20scale=20(geo.?=
 =?UTF-8?q?size=20is=20in=20points,=20not=20pixels:=20divide=20by=20932,?=
 =?UTF-8?q?=20not=202796;=20the=20old=20divisor=20shrank=20all=20text=20to?=
