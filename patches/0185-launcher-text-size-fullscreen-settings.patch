---
 dm/ios/Sources/Launcher.swift | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index 680925b..7d079d9 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -277,9 +277,9 @@ private struct LauncherView: View {
     @State private var category: LauncherCategory?
 
     var body: some View {
-        // Adaptive (0182): sizes scale with the screen — the reference is the iPhone 15 Pro Max landscape canvas (2796x1290); on an iPad (4:3) the same scale keeps the title, button and settings row in proportion, and the poster fills by cropping (scaledToFill).
+        // Adaptive (0182): sizes scale with the screen — the reference is the iPhone 15 Pro Max landscape canvas in POINTS (932x430), not pixels: geo.size is in points, so dividing by the pixel width 2796 shrank everything to a third. On an iPad (4:3) the same scale keeps the title, button and settings row in proportion, and the poster fills by cropping (scaledToFill).
         GeometryReader { geo in
-        let s = min(max(geo.size.width / 2796, 0.5), 1.6)
+        let s = min(max(geo.size.width / 932, 0.5), 1.6)
         ZStack {
             // The poster (0182): the Odyssey key art, full-bleed. The navy backdrop behind it is the fallback if the art is missing.
             if let art = dmLauncherTitleImage() {
@@ -330,7 +330,8 @@ private struct LauncherView: View {
         }
         }
         .preferredColorScheme(.dark)
-        .sheet(item: $category) { c in
+        // Full-screen settings page (0185): a sheet presents as a side card on this screen, the user wants the settings page full-screen.
+        .fullScreenCover(item: $category) { c in
             LauncherCategorySheet(category: c, m: m)
         }
     }
