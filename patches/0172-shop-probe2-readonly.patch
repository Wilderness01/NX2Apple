+# `adrp x1`), x21 is not needed (the stub recomputes list+0x20 from the
+# list), x2 is saved because the stub uses x2 as its third argument
+# (the callees after the site take only (x0, x1)), and the stub
+# preserves the callee-saved registers it uses, so the game's own
+# confirm flow is untouched: the stub returns void, writes only the
+# probe buffer at state +0x3300, and never suppresses the buy.
+# One-time diagnostic: delete after the device run reads the row; never ship.
+def _shop_probe2_frame_step(ctx):
+    here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
+    probe_code = here()
+    hx = ''.join(SHOP_PROBE2_WORDS)
+    for i in range(0, len(hx), 8):
+        emit(int(hx[i:i + 8], 16))
+    fs_site(0x2e8dfc, 'f60300aa')
+    start = here()
+    emit(STP_PRE(0, 30, 31, -16))              # stp x0, x30, [sp, #-16]! (live: the 0x50a5c0 return, the return address)
+    emit(STP_PRE(2, 19, 31, -16))              # stp x2, x19, [sp, #-16]! (x2: the stub's third argument; x19: the list)
+    emit(0xaa0003e2)                           # mov x2, x0 (x22 -> probe arg 2)
+    emit(0xaa1303e0)                           # mov x0, x19 (the list -> probe arg 0)
+    emit(ADRP(1, here(), FS_STATE_OFF))        # x1 = the state page (probe arg 1)
+    emit(B(here(), probe_code) | 0x80000000)   # bl shop_probe2
+    emit(LDP_POST(2, 19, 31, 16))              # ldp x2, x19, [sp], #16
+    emit(LDP_POST(0, 30, 31, 16))              # ldp x0, x30, [sp], #16
+    emit(0xaa0003f6)                           # mov x22, x0 (the replaced instruction)
+    emit(B(here(), 0x2e8e00))                  # back to the hook site + 4
+    fs_put(0x2e8dfc, [B(0x2e8dfc, start)], 'List NrvDecide confirm: one-time read-only probe, dumps the list memory to state +0x3300 (shop_probe2.c)')
+
 def _frame_step_141(ctx):
     _hud_runtime_frame_step(ctx)
+    _shop_probe2_frame_step(ctx)
 
