+// The 0172 shop probe buffer (one-time read-only diagnostic): the
+// rewriter's shop_probe2 stub dumps, on each list confirm, the list
+// memory into the frame-step state page at +0x3300. Layout, matching
+// shop_probe2.c:
+//   +0x00: u32 magic ("SH72"), +0x04: u32 reserved (dm_hud_probe_tick
+//     writes 0 here every present -- 0164 put its len there and its
+//     dump would have been zeroed before the drain read it),
+//   +0x08: u32 len (0 = empty), +0x0C: u32 fire count;
+//   +0x10: the dump, 0x3e8 bytes: a 0x40-byte pointer block (list,
+//     list+0x20, x22, A, [A+0x68], [A+0x70] float bits, reserved,
+//     [list+0x38], reserved), then byte windows: the list's 0x70 bytes
+//     at +0x40, A's 0x1b8 bytes at +0xb0, the [list+0x38] container's
+//     0x60 bytes at +0x268, the [A+0x68] sub-object's 0xa0 bytes at
+//     +0x2c8, x22's 0x80 bytes at +0x368.
+// One [shop] line set per confirm, with the fire sequence number, so
+// the user can confirm the three character rows (BYML 0/1/2, Price 0)
+// in separate shop visits and the dumped values can be compared across
+// confirms -- the field that reads 0/1/2, or changes per row, is the
+// cursor/row index the 0166 write-back needs. The stub only writes
+// while len is 0 and the host resets len after logging, so a dump is
+// logged exactly once and never torn. Delete after use; never ship.
+#define SHOP_PROBE2_OFF 0x3300
+#define SHOP_PROBE2_MAGIC 0x32374853u   // "SH72"
+#define SHOP_PROBE2_DUMP_LEN 0x3e8
+
+static void dm_shop_probe2_tick(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    uint8_t *pb = st + SHOP_PROBE2_OFF;
+    uint32_t *hdr = (uint32_t *)pb;
+    if (hdr[0] != SHOP_PROBE2_MAGIC) return;   // the stub has not initialised yet
+    uint32_t len = hdr[2];   // +0x08: NOT hdr[1] -- dm_hud_probe_tick writes 0 to +0x04 every present
+    if (len == 0) return;
+    if (len > SHOP_PROBE2_DUMP_LEN) len = SHOP_PROBE2_DUMP_LEN;
+    uint32_t fire = hdr[3];
+    const uint8_t *d = pb + 0x10;
+    uint64_t list, list_arg, x22, a, a68, list38;
+    uint32_t a70;
+    memcpy(&list, d + 0x00, 8); memcpy(&list_arg, d + 0x08, 8);
+    memcpy(&x22, d + 0x10, 8); memcpy(&a, d + 0x18, 8);
+    memcpy(&a68, d + 0x20, 8); memcpy(&a70, d + 0x28, 4);
+    memcpy(&list38, d + 0x30, 8);
+    float a70f;
+    memcpy(&a70f, &a70, 4);
+    LOG("[shop] probe2 #%u list=%#llx list+0x20=%#llx x22=%#llx A=%#llx A68=%#llx A70=%g (0x%08x) list38=%#llx",
+        fire, (unsigned long long)list, (unsigned long long)list_arg, (unsigned long long)x22,
+        (unsigned long long)a, (unsigned long long)a68, (double)a70f, a70, (unsigned long long)list38);
+    // The byte windows, in 64-byte chunks so no log line is over-long.
+    // The hex is the raw bytes in memory order, so a u32 row index
+    // prints little-endian (2 as 02000000) -- grep for that.
+    static const struct { const char *name; int off; int n; } wins[] = {
+        {"list", 0x40, 0x70}, {"A", 0xb0, 0x1b8}, {"c38", 0x268, 0x60},
+        {"a68", 0x2c8, 0xa0}, {"x22", 0x368, 0x80},
+    };
+    for (int w = 0; w < 5; w++) {
+        for (int off = 0; off < wins[w].n; off += 64) {
+            int n = wins[w].n - off; if (n > 64) n = 64;
+            char hex[129];
+            for (int k = 0; k < n; k++) {
+                unsigned char b = d[wins[w].off + off + k];
+                hex[2 * k] = "0123456789abcdef"[b >> 4];
+                hex[2 * k + 1] = "0123456789abcdef"[b & 0xf];
+            }
+            hex[2 * n] = '\0';
+            LOG("[shop] probe2 #%u %s+0x%x hex=%s", fire, wins[w].name, off, hex);
+        }
+    }
+    hdr[2] = 0;   // reset len; the stub writes again from 0
+}
