+// shop_probe2.c -- diagnostic probe (0172). Adds logging only; changes no game behavior.
+//
+// One-time read-only probe, user-approved 2026-11-17 18:39 ("特批只读探针一次，
+// 确认时读列表内存"). It does NOT lift the general probe ban: 0164 was
+// cancelled 2026-11-17 16:55 ("别探针了，探针太难用了") and deleted from
+// series; this patch is deleted from series after the device run reads the
+// row. Static tracing has exhausted every route to the confirmed row:
+// Object B has no list->Object B offset (attached by name to layout
+// elements), the price field offset is unpinned (no price read on the
+// confirm path), the cursor is not in the 0x70-byte list object, the
+// static-init code does not exist (the vtable pointer is filled by a
+// loader RELATIVE relocation), and the [list+0x38] container is a
+// layout/animation registry with no cursor field (REPORT-V1-STATIC-INIT.md).
+// The last unproven lead is the [list+0x30] layout object's [A+0x70]
+// float, the 0x50a5c0 selection gate (< 0 means no selection) -- nobody
+// has found who writes it or whether it is a row number. This probe dumps,
+// at list-confirm time, the list memory and the layout object so the
+// field that moves with the cursor can be read out of the device log.
+//
+// Hook site: list NrvDecide at 0x2e8dfc (NSO vaddr), `mov x22, x0`
+// (original word 0xaa0003f6, verified byte-for-byte). At that point x19
+// is the list object, x0 is the 0x50a5c0 return (the selected-item data,
+// non-NULL -- the cbz at 0x2e8df8 skipped), and x21 is list+0x20. The
+// trampoline (patches.py) saves x0 (the 0x50a5c0 return), x30, x2 and x19,
+// passes (list, state page, x22) to this stub, restores, re-executes the
+// replaced `mov x22, x0` and returns to 0x2e8e00. The game's own confirm
+// flow is untouched: the stub returns void, writes only the probe buffer,
+// and never suppresses the buy. This is NOT the broken 0164 hook
+// (0x442664 required the name to be exactly "ectionMap", which never
+// happens at a real buy -- that is why 0164 never fired; 0x442664 is not
+// reused here).
+//
+// What is dumped (see the host drain in hud_manual.c, dm_shop_probe2_tick):
+//   list (x19), list_arg = list+0x20, x22 (0x50a5c0 return, passed in),
+//   A = vtable[0](list_arg) (the [list+0x30] layout object; the getter
+//     0x2e9040 returns [arg+0x10]),
+//   [A+0x68] (the 0xa0-byte sub-object the selection depends on),
+//   [A+0x70] as raw float bits (the selection gate),
+//   [list+0x38] (the 0x60-byte layout/animation registry container),
+//   byte windows: 0x70 bytes of the list, 0x1b8 bytes of A, 0x60 bytes of
+//     the container, 0xa0 bytes of the [A+0x68] sub-object, 0x80 bytes of
+//     x22 (pointer values resolve offline against the NSO's tables).
+// Every pointer is NULL-guarded before it is dereferenced; a NULL anywhere
+// yields a zero field / zero-filled window, never a fault. The stub fires
+// once per list confirm (any CommonHorizontalList, not only the shop --
+// the shop filter is the reader's job: the three character rows are the
+// only rows whose confirm dumps a list whose [list+0x30] windows differ
+// per row 0/1/2 in the same shop); if the host has not drained the
+// previous dump (len != 0) the call returns without writing, so a dump is
+// never torn.
+//
+// Header layout note: +0x04 is RESERVED, not len. dm_hud_probe_tick
+// (the 0129 HUD probe drain) writes its enabled flag to state+0x3304
+// every present, even when DM_HUD_PROBE is unset -- 0164 put its len
+// there, so a fired 0164 dump would have been zeroed by the HUD tick
+// before the shop drain read it (a latent bug in 0164, never observed
+// because its hook never fired). This probe puts len at +0x08 and fire
+// at +0x0C, so the HUD tick's write lands on the sacrificial reserved
+// word and never touches len. The HUD tick keys on its own magic "PRBE",
+// this drain keys on "SH72", so the two never interact.
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-unwind-tables
+//   -fno-asynchronous-unwind-tables -c,
+//   objcopy -O binary --only-section=.text (never plain -O binary: the
+//   0131 .eh_frame lesson). The function takes everything through its
+//   arguments -- no static data, no literal pool, no external calls
+//   except the vtable[0] getter (a 2-instruction leaf) via blr -- so the
+//   emitted words are position-independent and relocation-free and can
+//   be dropped into the rewriter's patch area verbatim:
+//   x0 = the list (x19 at the hook site), x1 = the state page,
+//   x2 = x22 (the 0x50a5c0 return at the hook site).
+//   Delete after use; never ship.
+
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef unsigned long uintptr_t;
+
+// The probe buffer (state + 0x3300, 0x3f8 bytes: the frame-step state page
+// is 0x4000 bytes and the hud_edge table ends at +0x3060, so +0x3300 is
+// past it; the HUD probe buffer lives at the same offset, but its stub is
+// not in this build and its drain keys on its own magic "PRBE" and only
+// ever writes the +0x04 word, which this layout reserves -- see above).
+// Header 16 bytes, dump 0x3e8 bytes: 0x3f8 total.
+#define SHOP_PROBE2_OFF 0x3300
+#define SHOP_PROBE2_MAGIC 0x32374853u   // "SH72"
+#define SHOP_PROBE2_DUMP_LEN 0x3e8
+// Header offsets (relative to probe_buf).
+#define SP2_MAGIC 0
+#define SP2_RESERVED 4
+#define SP2_LEN 8
+#define SP2_FIRE 12
+// Dump offsets (relative to probe_buf + 0x10).
+#define SP2_D_LIST 0x00
+#define SP2_D_LIST_ARG 0x08
+#define SP2_D_X22 0x10
+#define SP2_D_A 0x18
+#define SP2_D_A68 0x20
+#define SP2_D_A70 0x28        // u32 float bits
+#define SP2_D_RESERVED 0x2c
+#define SP2_D_LIST38 0x30
+#define SP2_D_RESERVED2 0x38
+#define SP2_D_LIST_BYTES 0x40       // 0x70 bytes
+#define SP2_D_A_BYTES 0xb0          // 0x1b8 bytes
+#define SP2_D_C38_BYTES 0x268       // 0x60 bytes
+#define SP2_D_A68_BYTES 0x2c8       // 0xa0 bytes
+#define SP2_D_X22_BYTES 0x368       // 0x80 bytes
+#define SP2_D_LIST_LEN 0x70
+#define SP2_D_A_LEN 0x1b8
+#define SP2_D_C38_LEN 0x60
+#define SP2_D_A68_LEN 0xa0
+#define SP2_D_X22_LEN 0x80
+
+// Store a u64 / u32 into the probe buffer (volatile: one access, exactly
+// as written -- no vectorising, no combining; the buffer is shared with
+// the host, which sets nothing here but drains the dump).
+static inline __attribute__((always_inline)) void sp2_put_u64(volatile char *base, int off, u64 v) {
+    *(volatile u64 *)(base + off) = v;
+}
+static inline __attribute__((always_inline)) void sp2_put_u32(volatile char *base, int off, u32 v) {
+    *(volatile u32 *)(base + off) = v;
+}
+
+// Copy n bytes from game memory into the probe buffer, one byte at a time
+// (volatile on both sides: no vectorising, no widening, no reading past
+// the window). A NULL source fills with zeros.
+static inline __attribute__((always_inline)) void sp2_copy_bytes(volatile char *dst, const void *src, int n) {
+    const volatile unsigned char *s = (const volatile unsigned char *)src;
+    for (int i = 0; i < n; i++) dst[i] = src ? s[i] : 0;
+}
+
+// A = vtable[0](list_arg): the [list+0x30] layout object. This is the
+// first step 0x50a5c0 takes (ldr x8,[x0]; ldr x8,[x8]; blr x8); the getter
+// is 0x2e9040 (`ldr x0, [x0, #0x10]; ret`). Every pointer is guarded; a
+// NULL anywhere yields NULL, never a fault.
+static inline __attribute__((always_inline)) void *sp2_get_a(void *list_arg) {
+    if (!list_arg) return 0;
+    void *vt = (void *)*(volatile void **)list_arg;
+    if (!vt) return 0;
+    typedef void *(*get_t)(void *);
+    get_t f = *(volatile get_t *)vt;
+    if (!f) return 0;
+    return f(list_arg);
+}
+
+void shop_probe2(void *list, unsigned char *state, void *x22) {
+    if (!list || !state) return;
+    volatile char *buf = (volatile char *)state + SHOP_PROBE2_OFF;
+    volatile u32 *hdr = (volatile u32 *)buf;
+    // Initialise the header the first time (the state page starts zeroed).
+    if (hdr[SP2_MAGIC / 4] != SHOP_PROBE2_MAGIC) {
+        hdr[SP2_MAGIC / 4] = SHOP_PROBE2_MAGIC;
+        hdr[SP2_RESERVED / 4] = 0;
+        hdr[SP2_LEN / 4] = 0;
+        hdr[SP2_FIRE / 4] = 0;
+    }
+    // The host has not drained the previous dump yet: return without
+    // writing, so a dump is never torn or overwritten mid-read.
+    if (hdr[SP2_LEN / 4] != 0) return;
+    volatile char *d = buf + 0x10;
+
+    void *list_arg = (char *)list + 0x20;
+    void *a = sp2_get_a(list_arg);
+    void *a68 = a ? (void *)*(volatile void **)((char *)a + 0x68) : 0;
+    u32 a70 = a ? *(volatile u32 *)((char *)a + 0x70) : 0;
+    void *c38 = (void *)*(volatile void **)((char *)list + 0x38);
+
+    // Pointer block.
+    sp2_put_u64(d, SP2_D_LIST, (u64)(uintptr_t)list);
+    sp2_put_u64(d, SP2_D_LIST_ARG, (u64)(uintptr_t)list_arg);
+    sp2_put_u64(d, SP2_D_X22, (u64)(uintptr_t)x22);
+    sp2_put_u64(d, SP2_D_A, (u64)(uintptr_t)a);
+    sp2_put_u64(d, SP2_D_A68, (u64)(uintptr_t)a68);
+    sp2_put_u32(d, SP2_D_A70, a70);
+    sp2_put_u32(d, SP2_D_RESERVED, 0);
+    sp2_put_u64(d, SP2_D_LIST38, (u64)(uintptr_t)c38);
+    sp2_put_u64(d, SP2_D_RESERVED2, 0);
+    // Byte windows (NULL sources fill with zeros).
+    sp2_copy_bytes(d + SP2_D_LIST_BYTES, list, SP2_D_LIST_LEN);
+    sp2_copy_bytes(d + SP2_D_A_BYTES, a, SP2_D_A_LEN);
+    sp2_copy_bytes(d + SP2_D_C38_BYTES, c38, SP2_D_C38_LEN);
+    sp2_copy_bytes(d + SP2_D_A68_BYTES, a68, SP2_D_A68_LEN);
+    sp2_copy_bytes(d + SP2_D_X22_BYTES, x22, SP2_D_X22_LEN);
+    // Publish: fire count first, length last -- the host only reads the
+    // dump once len is non-zero, so it can never see a partial dump.
+    hdr[SP2_FIRE / 4] = hdr[SP2_FIRE / 4] + 1;
+    hdr[SP2_LEN / 4] = SHOP_PROBE2_DUMP_LEN;
+}
