+    private func dmCartridgeSide() -> some View {
+        ZStack {
+            Rectangle()
+                .fill(
+                    LinearGradient(
+                        gradient: Gradient(stops: [
+                            .init(color: Color(red: 0.698, green: 0.204, blue: 0.188), location: 0),
+                            .init(color: Color(red: 0.576, green: 0.157, blue: 0.141), location: 0.3),
+                            .init(color: Color(red: 0.455, green: 0.125, blue: 0.114), location: 0.6),
+                            .init(color: Color(red: 0.322, green: 0.086, blue: 0.075), location: 1),
+                        ]),
+                        startPoint: .leading, endPoint: .trailing)
+                )
+            HStack(spacing: 8 * u) {
+                ForEach(0..<4, id: \.self) { _ in
+                    Rectangle()
+                        .fill(Color.black.opacity(0.16))
+                        .frame(width: 2 * u)
+                }
+            }
+            .frame(maxWidth: .infinity, maxHeight: .infinity)
+        }
+        .frame(width: 40 * u, height: cardHeight)
+        .rotation3DEffect(.degrees(-90), axis: (x: 0, y: 1, z: 0), anchor: .leading, perspective: 0.85)
+        .offset(x: cardWidth / 2 + 20 * u)
+    }
+
+    /// The cartridge interior (0227): revealed when the lid opens —
+    /// dark red, the outfit render, the Chinese name, the English code
+    /// and the gold "已选择" pill. It sits just behind the lid, so it
+    /// is hidden while the lid is closed.
+    @ViewBuilder
+    private func dmCartridgeInterior(_ item: DeckItem) -> some View {
+        ZStack {
+            RoundedRectangle(cornerRadius: 13 * u)
+                .fill(
+                    LinearGradient(
+                        gradient: Gradient(colors: [Color(red: 0.341, green: 0.114, blue: 0.102), Color(red: 0.200, green: 0.071, blue: 0.059)]),
+                        startPoint: UnitPoint(x: 0.4, y: 0), endPoint: UnitPoint(x: 0.6, y: 1))
+                )
+                .overlay(
+                    RoundedRectangle(cornerRadius: 13 * u)
+                        .stroke(Color(red: 1, green: 0.667, blue: 0.588).opacity(0.16), lineWidth: 2 * u)
+                )
+            VStack(spacing: 4 * u) {
+                if let img = item.image.flatMap(dmOutfitImage) {
+                    Image(uiImage: img)
+                        .resizable()
+                        .scaledToFit()
+                        .frame(width: cardWidth * 0.74, height: 96 * u)
+                }
+                Text(item.name)
+                    .font(.system(size: 19 * u, weight: .heavy))
+                    .foregroundStyle(Color(red: 0.965, green: 0.910, blue: 0.847))
+                Text(dmOutfitENCode(item.id))
+                    .font(.system(size: 8.5 * u, weight: .bold))
+                    .tracking(8.5 * u * 0.22)
+                    .foregroundStyle(Color(red: 0.812, green: 0.604, blue: 0.553))
+                Text("\u{5df2}\u{9009}\u{62e9}")
+                    .font(.system(size: 11 * u, weight: .bold))
+                    .foregroundStyle(Color(red: 0.910, green: 0.784, blue: 0.467))
+                    .padding(EdgeInsets(top: 4 * u, leading: 11 * u, bottom: 4 * u, trailing: 11 * u))
+                    .background(Color(red: 0.431, green: 0.314, blue: 0.039).opacity(0.28))
+                    .clipShape(Capsule())
+                    .overlay(
+                        Capsule()
+                            .stroke(Color(red: 0.910, green: 0.784, blue: 0.467).opacity(0.55), lineWidth: 1 * u)
+                    )
+                    .padding(.top, 7 * u)
+            }
+            .padding(10 * u)
+        }
+        .frame(width: cardWidth, height: cardHeight)
+    }
+
+    /// The reflection below a card (0227): a flipped copy of the
+    /// front face, faded and darkened, clipped to a short strip.
+    /// Only rendered near the center (see cartridgeCard).
+    private func dmCartridgeReflection(_ item: DeckItem, index: Int, d: CGFloat) -> some View {
+        dmCartridgeFront(item, index: index)
+            .scaleEffect(x: 1, y: -1)
+            .frame(height: 24 * u, alignment: .top)
+            .clipped()
+            .mask(
+                LinearGradient(
+                    gradient: Gradient(stops: [
+                        .init(color: .white.opacity(0.95), location: 0),
+                        .init(color: .white.opacity(0.5), location: 0.26),
+                        .init(color: .clear, location: 0.56),
+                        .init(color: .clear, location: 1),
+                    ]),
+                    startPoint: .top, endPoint: .bottom)
+            )
+            .opacity(max(0, 0.32 - abs(d) * 0.07))
+            .saturation(0.55)
+            .brightness(-0.28)
+    }
+}
