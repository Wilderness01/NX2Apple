+/// The grain tile for the cartridge's matte finish (0227, v4 prototype):
+/// a 140x140 noise image bundled in LauncherBackground as
+/// dm_grain_noise.png (mid-grey, so an overlay blend is neutral and a
+/// multiply blend only darkens a little). Returns nil when the tile is
+/// missing — the cartridge then renders flat, which is still the v4 look
+/// minus grain.
+private func dmGrainImage() -> UIImage? {
+    UIImage(named: "dm_grain_noise", in: Bundle(for: LauncherModel.self), compatibleWith: nil)
+}
+
 // Caps (50)
 private let dmOutfitCaps: [(id: String, name: String)] = [
     ("Mario64", "64"),
@@ -390,6 +400,15 @@ private func dmOutfitImageName(character: String, id: String) -> String {
     return "of_\(character)_" + base
 }
 
+/// The outfit's English code for the cartridge (0227, v4 prototype):
+/// the spine's vertical text and the label's typewriter subtitle, e.g.
+/// "MARIO HAKAMA"; "MARIO DEFAULT" for the default card.
+private func dmOutfitENCode(_ id: String) -> String {
+    if id == "default" { return "MARIO DEFAULT" }
+    let bare = id.hasPrefix("Mario") ? String(id.dropFirst(5)) : id
+    return "MARIO " + bare.uppercased()
+}
+
 /// The grid's list for a character and a slot (0194, 0201, 0226). The first entry is always "default". Mario gets all 50 caps + 52 clothes; Luigi gets Mario's full set too (0226: he is a 28-bone Mario-skeleton reskin -- Mario body geometry + Luigi head -- so the Mario renders and the Mario body reskins serve him, and the host write makes the pick stick); Wario gets his 8 costumes in each slot; Peach, Pauline and Toad get default only for now. The card image is the real render of_<character>_<id>.png; the default card uses of_<character>_default (only Mario's exists — the rest fall back to a text-only card).
 private func dmDeckItems(character: String, caps: Bool) -> [DeckItem] {
     var items: [DeckItem] = [DeckItem(id: "default", image: "of_\(character)_default", name: "\u{9ed8}\u{8ba4}")]
@@ -573,11 +592,515 @@ private struct OutfitGridView: View {
     }
 }
 
+/// The grain tile as a view (0227): the noise image at a low opacity
+/// with a blend mode. The caller clips it to its shape.
+private struct DmGrain: View {
+    let opacity: Double
+    let blendMode: BlendMode
+
+    var body: some View {
+        if let img = dmGrainImage() {
+            Image(uiImage: img)
+                .resizable()
+                .scaledToFill()
+                .opacity(opacity)
+                .blendMode(blendMode)
+        }
+    }
+}
+
+/// The cartridge cover-flow picker (0227, v4 prototype): the same outfits
+/// as the classic grid, but each card is a retro matte game cartridge in
+/// 3D — brick-red shell, sticker render, aged-paper label, gold fingers —
+/// in a cover-flow that tilts with scroll position, reflects below, and
+/// opens its lid on tap. The classic grid stays as the default; this is
+/// the "cartridge" style, chosen by DmLauncherUIStyle. The lid is UI
+/// state only: tapping wears the outfit (onSelect) and toggles the lid;
+/// a second tap on the same card closes it, a tap on another card moves
+/// the open lid there.
+private struct CartridgeCoverFlowView: View {
+    let characterId: String
+    let characterName: String
+    let scale: CGFloat
+    let onSelect: (DeckItem) -> Void
+    let onOpenChange: (Bool) -> Void
+    @State private var capsMode: Bool = true
+    @State private var cap: String = UserDefaults.standard.string(forKey: "DmCharSelect.cap") ?? "default"
+    @State private var clothes: String = UserDefaults.standard.string(forKey: "DmCharSelect.clothes") ?? "default"
+    @State private var centeredId: String? = nil
+    @State private var openId: String? = nil
+
+    private var items: [DeckItem] { dmDeckItems(character: characterId, caps: capsMode) }
+    private var selectedId: String { capsMode ? cap : clothes }
+    private var effectiveSelectedId: String {
+        items.contains { $0.id == selectedId } ? selectedId : "default"
+    }
+    private var effectiveItem: DeckItem {
+        items.first(where: { $0.id == effectiveSelectedId }) ?? items[0]
+    }
+    // The cartridge card is 110pt wide at scale 1 (the prototype's
+    // 150px card scaled to the launcher's picker, so the flow fits the
+    // same vertical budget as the classic grid); u converts prototype
+    // px to points. Card 150u x 212u, 40u deep; the flow adds a 5u gap
+    // and a 24u reflection below the card.
+    private var u: CGFloat { scale * 110 / 150 }
+    private var cardWidth: CGFloat { 150 * u }
+    private var cardHeight: CGFloat { 212 * u }
+    private var flowHeight: CGFloat { (212 + 5 + 24) * u }
+
+    private func select(_ item: DeckItem) {
+        if capsMode {
+            cap = item.id
+            UserDefaults.standard.set(item.id, forKey: "DmCharSelect.cap")
+        } else {
+            clothes = item.id
+            UserDefaults.standard.set(item.id, forKey: "DmCharSelect.clothes")
+        }
+        onSelect(item)
+    }
+
+    private func tap(_ item: DeckItem) {
+        select(item)
+        let willOpen = openId != item.id
+        openId = willOpen ? item.id : nil
+        onOpenChange(willOpen)
+        withAnimation(.spring(response: 0.55, dampingFraction: 0.72)) {
+            centeredId = item.id
+        }
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8 * scale) {
+            // Header: title + subtitle + cap/clothes switch (same as classic).
+            HStack(alignment: .firstTextBaseline) {
+                VStack(alignment: .leading, spacing: 2 * scale) {
+                    Text(characterName + "\u{7684}\u{670d}\u{88c5}")
+                        .font(.system(size: 20 * scale, weight: .bold))
+                        .foregroundStyle(.white)
+                    Text("\u{53ea}\u{663e}\u{793a}" + characterName + "\u{80fd}\u{7a7f}\u{7684}\u{8863}\u{670d}")
+                        .font(.system(size: 13 * scale))
+                        .foregroundStyle(.white.opacity(0.7))
+                }
+                Spacer()
+                Picker("", selection: $capsMode) {
+                    Text("\u{5e3d}\u{5b50}").tag(true)
+                    Text("\u{8863}\u{670d}").tag(false)
+                }
+                .pickerStyle(.segmented)
+                .frame(width: 130 * scale)
+            }
+            // Cover-flow: the cartridge cards tilt in 3D with scroll
+            // position; the nearest card snaps to the center
+            // (.scrollPosition + .viewAligned). The pitch is the
+            // prototype's spacing() — clamp(width/6.4, 74, 112) in
+            // prototype px — so adjacent cards overlap like a real
+            // cover-flow; the padding centers the first and last cards.
+            GeometryReader { outer in
+                let pitch = max(74 * u, min(112 * u, outer.size.width / 6.4))
+                ScrollView(.horizontal, showsIndicators: false) {
+                    LazyHStack(spacing: pitch - cardWidth) {
+                        ForEach(Array(items.enumerated()), id: \.element.id) { index, item in
+                            cartridgeCard(item, index: index, centerX: outer.size.width / 2, pitch: pitch)
+                                .id(item.id)
+                        }
+                    }
+                    .scrollTargetLayout()
+                    .padding(.horizontal, max(0, outer.size.width / 2 - cardWidth / 2))
+                }
+                .scrollPosition(id: $centeredId, anchor: .center)
+                .scrollTargetBehavior(.viewAligned)
+                .coordinateSpace(name: "cartridgeflow")
+                .onAppear { centeredId = effectiveSelectedId }
+            }
+            .frame(height: flowHeight)
+        }
+        .onChange(of: capsMode) { _, _ in
+            openId = nil
+            onOpenChange(false)
+            onSelect(effectiveItem)
+            centeredId = effectiveSelectedId
+        }
+        .onChange(of: characterId) { _, _ in
+            openId = nil
+            onOpenChange(false)
+            onSelect(effectiveItem)
+            centeredId = effectiveSelectedId
+        }
+        .onAppear { onSelect(effectiveItem) }
+    }
+
+    private func cartridgeCard(_ item: DeckItem, index: Int, centerX: CGFloat, pitch: CGFloat) -> some View {
+        let isOpen = openId == item.id
+        return GeometryReader { geo in
+            // Distance from the scroll view's center in card pitches:
+            // the tilt, shrink, fade and reflection all follow it.
+            // A card to the right faces left (toward the center) and
+            // vice versa, as in the classic grid.
+            let d = (geo.frame(in: .named("cartridgeflow")).midX - centerX) / max(pitch, 1)
+            let angle = max(-68, min(68, d * 50))
+            let shrink = max(0.6, 1 - abs(d) * 0.145)
+            let fade: CGFloat = abs(d) <= 2.7 ? 1 : max(0, 1 - (abs(d) - 2.7) * 0.75)
+            VStack(spacing: 5 * u) {
+                Button {
+                    tap(item)
+                } label: {
+                    cartridgeBox(item, index: index, isOpen: isOpen)
+                }
+                .buttonStyle(.plain)
+                // Reflection: a flipped copy of the front face, faded
+                // and darkened; only near the center, so 52 cards do
+                // not all render twice (LazyHStack already drops far
+                // cards from the hierarchy).
+                if abs(d) <= 3 {
+                    dmCartridgeReflection(item, index: index, d: d)
+                }
+            }
+            .rotation3DEffect(.degrees(angle), axis: (x: 0, y: 1, z: 0), perspective: 0.85)
+            .scaleEffect(shrink)
+            .opacity(fade)
+            .zIndex(Double(200 - Int(round(abs(d) * 10)) + (isOpen ? 50 : 0)))
+            .allowsHitTesting(abs(d) <= 3.6)
+        }
+        .frame(width: cardWidth, height: flowHeight)
+    }
+
+    private func cartridgeBox(_ item: DeckItem, index: Int, isOpen: Bool) -> some View {
+        ZStack {
+            // Interior (revealed when the lid opens): just behind the lid.
+            dmCartridgeInterior(item)
+            // Left spine and right side (the 40u extrusion).
+            dmCartridgeSpine(item)
+            dmCartridgeSide()
+            // Lid (the front face), hinged on the left edge.
+            cartridgeLid(item, index: index, isOpen: isOpen)
+        }
+        .frame(width: cardWidth, height: cardHeight)
+        .shadow(color: .black.opacity(0.35), radius: 10 * u, x: 0, y: 8 * u)
+    }
+
+    /// The lid (0227): the cartridge's front face on a hinge at its
+    /// left edge. Closed it is the front; open (103 degrees, past
+    /// perpendicular, with an overshoot ease) it swings out to the
+    /// left and shows its plain dark-red back, revealing the interior.
+    /// The back has no text, so showing it mirrored is harmless; it
+    /// crossfades with the front as the lid swings.
+    private func cartridgeLid(_ item: DeckItem, index: Int, isOpen: Bool) -> some View {
+        ZStack {
+            RoundedRectangle(cornerRadius: 13 * u)
+                .fill(
+                    LinearGradient(
+                        gradient: Gradient(colors: [Color(red: 0.431, green: 0.137, blue: 0.122), Color(red: 0.259, green: 0.071, blue: 0.059)]),
+                        startPoint: UnitPoint(x: 0.33, y: 0), endPoint: UnitPoint(x: 0.67, y: 1))
+                )
+                .overlay(
+                    RoundedRectangle(cornerRadius: 13 * u)
+                        .stroke(Color(red: 1, green: 0.667, blue: 0.588).opacity(0.12), lineWidth: 1 * u)
+                )
+                .opacity(isOpen ? 1 : 0)
+            dmCartridgeFront(item, index: index)
+                .opacity(isOpen ? 0 : 1)
+        }
+        .frame(width: cardWidth, height: cardHeight)
+        .rotation3DEffect(.degrees(isOpen ? 103 : 0), axis: (x: 0, y: 1, z: 0), anchor: .leading, perspective: 0.85)
+        .animation(.timingCurve(0.3, 1.35, 0.4, 1, duration: 0.68), value: isOpen)
+    }
+
+    /// The cartridge front face (0227): matte brick-red shell, top
+    /// notch, SUPER MARIO ODYSSEY band, recessed cover with the outfit
+    /// sticker, aged-paper label, gold fingers. Sizes are prototype px
+    /// scaled by u; the face is 150u x 212u. Used by the lid (its
+    /// front) and by the reflection (flipped).
+    @ViewBuilder
+    private func dmCartridgeFront(_ item: DeckItem, index: Int) -> some View {
+        ZStack {
+            // Shell: matte brick-red gradient, inset ring and bottom
+            // shadow, fine grain. No gloss anywhere (v4).
+            RoundedRectangle(cornerRadius: 13 * u)
+                .fill(
+                    LinearGradient(
+                        gradient: Gradient(stops: [
+                            .init(color: Color(red: 0.788, green: 0.251, blue: 0.235), location: 0),
+                            .init(color: Color(red: 0.690, green: 0.200, blue: 0.188), location: 0.48),
+                            .init(color: Color(red: 0.576, green: 0.188, blue: 0.173), location: 1),
+                        ]),
+                        startPoint: UnitPoint(x: 0.35, y: 0), endPoint: UnitPoint(x: 0.65, y: 1))
+                )
+                .overlay(
+                    DmGrain(opacity: 0.09, blendMode: .overlay)
+                        .clipShape(RoundedRectangle(cornerRadius: 13 * u))
+                )
+                .overlay(
+                    RoundedRectangle(cornerRadius: 13 * u)
+                        .stroke(Color(red: 0.275, green: 0.055, blue: 0.039).opacity(0.35), lineWidth: 1 * u)
+                )
+            // Bottom inner shadow (the shell darkens toward the base).
+            VStack {
+                Spacer()
+                LinearGradient(colors: [.clear, Color(red: 0.275, green: 0.047, blue: 0.031).opacity(0.30)], startPoint: .top, endPoint: .bottom)
+                    .frame(height: 22 * u)
+            }
+            .clipShape(RoundedRectangle(cornerRadius: 13 * u))
+            // Content: notch, band, cover, label, pins.
+            VStack(spacing: 0) {
+                // Top notch: the cartridge slot, flush with the top edge.
+                UnevenRoundedRectangle(cornerRadii: .init(topLeading: 0, bottomLeading: 6 * u, bottomTrailing: 6 * u, topTrailing: 0))
+                    .fill(Color(red: 0.235, green: 0.031, blue: 0.024).opacity(0.5))
+                    .frame(width: 44 * u, height: 7 * u)
+                VStack(spacing: 0) {
+                    Text("SUPER MARIO ODYSSEY")
+                        .font(.custom("Futura", size: 8 * u).weight(.bold))
+                        .tracking(8 * u * 0.14)
+                        .foregroundStyle(Color(red: 0.953, green: 0.902, blue: 0.812).opacity(0.92))
+                        .padding(.top, 4 * u)
+                    // Recessed cover with the outfit sticker: the render
+                    // as a paper sticker — no white edge (v4) — light
+                    // paper grain comes from the cover itself, a soft
+                    // drop shadow and a slight hand-placed tilt
+                    // (alternating by index).
+                    ZStack {
+                        RoundedRectangle(cornerRadius: 8 * u)
+                            .fill(
+                                RadialGradient(
+                                    gradient: Gradient(stops: [
+                                        .init(color: Color(red: 0.165, green: 0.200, blue: 0.314), location: 0),
+                                        .init(color: Color(red: 0.102, green: 0.137, blue: 0.220), location: 0.62),
+                                        .init(color: Color(red: 0.071, green: 0.102, blue: 0.173), location: 1),
+                                    ]),
+                                    center: UnitPoint(x: 0.5, y: 0.3), startRadius: 0, endRadius: 120 * u)
+                            )
+                            .overlay(
+                                RoundedRectangle(cornerRadius: 8 * u)
+                                    .stroke(Color(red: 0.745, green: 0.706, blue: 0.588).opacity(0.14), lineWidth: 1 * u)
+                            )
+                            .overlay(
+                                DmGrain(opacity: 0.07, blendMode: .overlay)
+                                    .clipShape(RoundedRectangle(cornerRadius: 8 * u))
+                            )
+                        if let img = item.image.flatMap(dmOutfitImage) {
+                            Image(uiImage: img)
+                                .resizable()
+                                .scaledToFit()
+                                .padding(.horizontal, 5 * u)
+                                .padding(.bottom, 2 * u)
+                                .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .bottom)
+                                .rotationEffect(.degrees(index % 2 == 0 ? -1.3 : 1.0))
+                                .shadow(color: Color(red: 0.039, green: 0.024, blue: 0.016).opacity(0.45), radius: 4 * u, x: 0, y: 4 * u)
+                        } else {
+                            Text(item.name)
+                                .font(.system(size: 18 * u, weight: .bold))
+                                .foregroundStyle(.white)
+                                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        }
+                    }
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+                    .padding(.top, 4 * u)
+                    // Aged-paper label: the Chinese name + the English code.
+                    VStack(spacing: 1 * u) {
+                        Text(item.name)
+                            .font(.custom("Songti SC", size: 15 * u).weight(.bold))
+                            .tracking(15 * u * 0.06)
+                            .foregroundStyle(Color(red: 0.227, green: 0.173, blue: 0.110))
+                        Text(dmOutfitENCode(item.id))
+                            .font(.custom("Courier New", size: 7.5 * u).weight(.bold))
+                            .tracking(7.5 * u * 0.2)
+                            .foregroundStyle(Color(red: 0.541, green: 0.435, blue: 0.259))
+                    }
+                    .padding(EdgeInsets(top: 5 * u, leading: 4 * u, bottom: 4 * u, trailing: 4 * u))
+                    .frame(maxWidth: .infinity)
+                    .background(
+                        LinearGradient(
+                            gradient: Gradient(stops: [
+                                .init(color: Color(red: 0.965, green: 0.937, blue: 0.859), location: 0),
+                                .init(color: Color(red: 0.937, green: 0.890, blue: 0.761), location: 0.6),
+                                .init(color: Color(red: 0.906, green: 0.839, blue: 0.671), location: 1),
+                            ]),
+                            startPoint: .top, endPoint: .bottom)
+                    )
+                    .clipShape(RoundedRectangle(cornerRadius: 4 * u))
+                    .overlay(
+                        RoundedRectangle(cornerRadius: 4 * u)
+                            .stroke(Color(red: 0.573, green: 0.463, blue: 0.251).opacity(0.35), lineWidth: 1 * u)
+                    )
+                    .overlay(
+                        RoundedRectangle(cornerRadius: 3 * u)
+                            .strokeBorder(Color(red: 0.573, green: 0.431, blue: 0.204).opacity(0.45), style: StrokeStyle(lineWidth: 1 * u, dash: [3 * u, 2 * u]))
+                            .padding(2 * u)
+                    )
+                    .overlay(
+                        DmGrain(opacity: 0.12, blendMode: .multiply)
+                            .clipShape(RoundedRectangle(cornerRadius: 4 * u))
+                    )
+                    .shadow(color: Color(red: 0.196, green: 0.031, blue: 0.016).opacity(0.45), radius: 5 * u, x: 0, y: 2 * u)
+                    .rotationEffect(.degrees(-0.5))
+                    .padding(.top, 6 * u)
+                    // Gold fingers: the cartridge's edge connector.
+                    HStack(spacing: 4 * u) {
+                        ForEach(0..<9, id: \.self) { _ in
+                            RoundedRectangle(cornerRadius: 1.5 * u)
+                                .fill(
+                                    LinearGradient(colors: [Color(red: 0.812, green: 0.682, blue: 0.290), Color(red: 0.659, green: 0.518, blue: 0.184)], startPoint: .top, endPoint: .bottom)
+                                )
+                                .frame(width: 9 * u, height: 8 * u)
+                        }
+                    }
+                    .padding(.top, 6 * u)
+                }
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                .padding(.horizontal, 7 * u)
+                .padding(.bottom, 6 * u)
+            }
+            .frame(maxWidth: .infinity, maxHeight: .infinity)
+        }
+        .frame(width: cardWidth, height: cardHeight)
+    }
+
+    /// The cartridge's left spine (0227): the 40u extrusion's left
+    /// face, with the outfit's English code running vertically. It is
+    /// a 40u-wide plane rotated 90 degrees about its trailing edge so
+    /// it spans the box's depth, flush with the front face.
+    private func dmCartridgeSpine(_ item: DeckItem) -> some View {
+        ZStack {
+            Rectangle()
+                .fill(
+                    LinearGradient(
+                        gradient: Gradient(stops: [
+                            .init(color: Color(red: 0.753, green: 0.227, blue: 0.212), location: 0),
+                            .init(color: Color(red: 0.627, green: 0.173, blue: 0.157), location: 0.26),
+                            .init(color: Color(red: 0.510, green: 0.149, blue: 0.133), location: 0.5),
+                            .init(color: Color(red: 0.404, green: 0.118, blue: 0.110), location: 0.74),
+                            .init(color: Color(red: 0.298, green: 0.082, blue: 0.075), location: 1),
+                        ]),
+                        startPoint: .leading, endPoint: .trailing)
+                )
+            Rectangle()
+                .fill(
+                    LinearGradient(colors: [.black.opacity(0.18), .clear, .clear, .black.opacity(0.18)], startPoint: .top, endPoint: .bottom)
+                )
+            Text(dmOutfitENCode(item.id))
+                .font(.system(size: 10 * u, weight: .heavy))
+                .tracking(10 * u * 0.28)
+                .foregroundStyle(Color(red: 0.953, green: 0.902, blue: 0.812))
+                .frame(width: cardHeight * 0.8, height: 10 * u, alignment: .center)
+                .rotationEffect(.degrees(90))
+        }
+        .frame(width: 40 * u, height: cardHeight)
+        .rotation3DEffect(.degrees(90), axis: (x: 0, y: 1, z: 0), anchor: .trailing, perspective: 0.85)
