From 1ec4492c8316a320a14b0dc8d069eff59057c5fd Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sun, 15 Nov 2026 20:51:29 +0800
Subject: [PATCH] 0145: match the coins icon and the moon dots so each group
 moves together

---
 dm/games/0100000000010000/hud_runtime.c | 27 +++++++++++-
 dm/games/0100000000010000/patches.py    | 58 +++++++++++++------------
 2 files changed, 55 insertions(+), 30 deletions(-)

diff --git a/dm/games/0100000000010000/hud_runtime.c b/dm/games/0100000000010000/hud_runtime.c
index 8f90f11..258766e 100644
--- a/dm/games/0100000000010000/hud_runtime.c
+++ b/dm/games/0100000000010000/hud_runtime.c
@@ -261,6 +261,20 @@ typedef unsigned long uintptr_t;
 #define HUD_E_TGUIDE0 0x47747854u
 #define HUD_E_TGUIDE1 0x65646975u
 #define HUD_E_TGUIDE2 0x00003130u
+// 0145 (user 2026-11-15 20:40: coins = icon + number together, regional =
+// hexagon + number together, moons move on their own): the coins icon glyph
+// and the moon dots, which the matcher never covered, so the visible pieces
+// stayed put while only the (invisible) numbers moved.
+// "TxtIconSh": "TxtI", "conS", "h\0\0\0" (the coins icon's shadow).
+#define HUD_E_TICONSH0 0x49747854u
+#define HUD_E_TICONSH1 0x536e6f63u
+#define HUD_E_TICONSH2 0x00000068u
+// "TxtIcon": "TxtI", "con\0" (the coins icon itself, the circled "1").
+#define HUD_E_TICON0 0x49747854u
+#define HUD_E_TICON1 0x006e6f63u
+// "TxtShine": "TxtS", "hine" (the moon dots, the two rows of circles).
+#define HUD_E_TSH0 0x53747854u
+#define HUD_E_TSH1 0x656e6968u
 
 // Bounded compare of a pane name's words against the given words (n words,
 // the rest of the name unchecked). Same as the old hud_words_eq.
@@ -430,11 +444,17 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // Moons: the counter group itself, a pane named 'Counter'; a bare
     // 'TxtTotalShine' is the fallback for a layout with no 'Counter' group,
     // and only when its parent is not a 'Counter' (the group's own number
-    // follows the group; matching both would move it twice). Life: the
+    // follows the group; matching both would move it twice). 0145: 'TxtShine'
+    // (the two rows of moon dots) joins the moons element, so the dots move
+    // with it on their own, separate from the coins and the regional coins. Life: the
     // 'Life' container, or a bare 'TxtLife' whose parent is NOT named
     // 'Life'. Coins: 'TxtCounterSh' and its sibling 'TxtCounter', both
     // matched by name, so both take the same offset and no twin-write walk
-    // is needed. Regional coins (0127): the hexagon icon and its number,
+    // is needed. 0145: the coins icon glyph 'TxtIconSh'/'TxtIcon' joins them,
+    // so the icon and the number move together as one group (the user
+    // 2026-11-15 20:40: coins = icon + number together); the white bar
+    // 'WinLine' has no matching name and is hidden in the overlay instead.
+    // Regional coins (0127): the hexagon icon and its number,
     // which live UNDER the moons 'Counter' group: a 'PicIconSh' / 'PicIcon' /
     // 'TxtTotalShine' whose parent IS a 'Counter' belongs to the regional
     // coins element (its own element since 0127, so it can be dragged and
@@ -459,6 +479,8 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     }
     else if (hud_edge_words_eq(nw, HUD_E_TCSH0, HUD_E_TCSH1, HUD_E_TCSH2, HUD_E_TCSH3, 4)) idx = 2;
     else if (hud_edge_words_eq(nw, HUD_E_TC0, HUD_E_TC1, HUD_E_TC2, 0, 3)) idx = 2;
+    else if (hud_edge_words_eq(nw, HUD_E_TICONSH0, HUD_E_TICONSH1, HUD_E_TICONSH2, 0, 3)) idx = 2;
+    else if (hud_edge_words_eq(nw, HUD_E_TICON0, HUD_E_TICON1, 0, 0, 2)) idx = 2;
     else if (hud_edge_words_eq(nw, HUD_E_PICONSH0, HUD_E_PICONSH1, HUD_E_PICONSH2, 0, 3)) {
         if (hud_edge_parent_is(pane, HUD_E_COUNTER0, HUD_E_COUNTER1, 2)) idx = 5;
     }
@@ -470,6 +492,7 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
         if (hud_edge_parent_is(pane, HUD_E_COUNTER0, HUD_E_COUNTER1, 2)) idx = 5;
         else idx = 3;
     }
+    else if (hud_edge_words_eq(nw, HUD_E_TSH0, HUD_E_TSH1, 0, 0, 2)) idx = 3;
     else if (hud_edge_words_eq(nw, HUD_E_TGUIDE0, HUD_E_TGUIDE1, HUD_E_TGUIDE2, 0, 3)) idx = 4;
     if (idx < 0) return;   // not a HUD element: leave it alone
 
