-// The button editor: a bar at the top (title, the size slider, the glass slider, Done, and a hint), and dragging
-// the icons. While it is open, touches drag controls instead of pressing them; tapping an icon
+// The settings panels' places (0116): both editor bars can be dragged anywhere by
+// their title or blank area, and where they are left is kept in NSUserDefaults
+// (DmPadPanelPos, {"pad": [fx, fy], "hud": [fx, fy]}) so it survives a restart.
+// The place is the bar's centre as a fraction of the view, so a rotation or a
+// different screen keeps it in the same relative place; the layout clamps the
+// bar back inside the view, so a panel can never be dragged off and lost. The
+// default is the left of the screen, low: the old top-centre place covered the
+// - / + / menu cluster at the top centre (DmPadGeometry.h: the pills sit midX
+// +/- 52u, the menu button at midX, all level with the top), so the + and -
+// could not be tapped to select them. On an iPhone in landscape (932x430
+// points) the pad bar's default frame is x 40..520, y 195..303 and the HUD
+// bar's x 4..564, y 195..287 (it is 560 wide, so it starts at the left edge):
+// clear of the drop keys at the top corners, the pills and the menu at the
+// top centre, the diamond at the bottom right and the jump / photo buttons
+// left of it, on the Pro Max and on the SE, the 17 Pro Max and the iPad Pro
+// 13 (checked against dm_pad_geo_at). The frames do cross the left stick's
+// ground, but the stick floats, so it is not drawn and no touch starts it
+// while an editor is open; on the iPad they clear it too. A drag starts only
+// background (a title or a hint label): a gesture on a slider, a button or
+// the segmented control is the control's own, so the panel never steals a
+// slider's drag.
+static NSString *const k_panel_pos_key = @"DmPadPanelPos";
+static const CGFloat k_panel_default[2][2] = {{0.30, 0.58}, {0.30, 0.56}};   // pad, HUD: the bars' centre fractions (x, y)
+- (void)loadPanelPos {
+    for (int i = 0; i < 2; i++) _panelPos[i] = CGPointMake(k_panel_default[i][0], k_panel_default[i][1]);   // fresh: the left of the screen, low
+    NSDictionary *d = [NSUserDefaults.standardUserDefaults dictionaryForKey:k_panel_pos_key];
+    if (![d isKindOfClass:[NSDictionary class]]) return;
+    static NSString *const keys[2] = {@"pad", @"hud"};
+    for (int i = 0; i < 2; i++) {
+        NSArray *v = d[keys[i]];
+        if ([v isKindOfClass:[NSArray class]] && v.count == 2 && [v[0] isKindOfClass:[NSNumber class]] && [v[1] isKindOfClass:[NSNumber class]])
+            _panelPos[i] = CGPointMake(fmin(fmax([v[0] doubleValue], 0), 1), fmin(fmax([v[1] doubleValue], 0), 1));
+    }
+}
+- (void)savePanelPos {
+    [NSUserDefaults.standardUserDefaults setObject:@{@"pad": @[@(_panelPos[0].x), @(_panelPos[0].y)], @"hud": @[@(_panelPos[1].x), @(_panelPos[1].y)]} forKey:k_panel_pos_key];
+}
+- (CGPoint)clampPanelCentre:(CGPoint)c size:(CGSize)s {   // a bar's centre, clamped so the whole bar stays inside the view (its Done button stays reachable)
+    CGFloat W = self.bounds.size.width, H = self.bounds.size.height, m = 4;
+    CGFloat loX = s.width / 2 + m, hiX = W - s.width / 2 - m, loY = s.height / 2 + m, hiY = H - s.height / 2 - m;
+    if (hiX < loX) c.x = W / 2; else c.x = fmin(fmax(c.x, loX), hiX);   // a bar wider than the view centres on it
+    if (hiY < loY) c.y = H / 2; else c.y = fmin(fmax(c.y, loY), hiY);
+    return c;
+}
+- (CGPoint)panelCentre:(int)i size:(CGSize)s {   // the bar's centre from its stored fraction, clamped inside the view
+    return [self clampPanelCentre:CGPointMake(_panelPos[i].x * self.bounds.size.width, _panelPos[i].y * self.bounds.size.height) size:s];
+}
+- (void)panelPan:(UIPanGestureRecognizer *)pan {   // drag a settings panel: it follows the finger, and stays where it is left
+    UIView *bar = pan.view;
+    int i = bar == _hudEditBar ? 1 : 0;
+    if (pan.state == UIGestureRecognizerStateBegan || pan.state == UIGestureRecognizerStateChanged) {
+        _panelDragging[i] = YES;
+        CGPoint d = [pan translationInView:self];
+        [pan setTranslation:CGPointZero inView:self];
+        bar.center = [self clampPanelCentre:CGPointMake(bar.center.x + d.x, bar.center.y + d.y) size:bar.bounds.size];
+    } else {
+        _panelDragging[i] = NO;
+        if (pan.state == UIGestureRecognizerStateEnded || pan.state == UIGestureRecognizerStateCancelled) {
+            _panelPos[i] = CGPointMake(fmin(fmax(bar.center.x / fmax(self.bounds.size.width, 1), 0), 1), fmin(fmax(bar.center.y / fmax(self.bounds.size.height, 1), 0), 1));
+            [self savePanelPos];
+        }
+    }
+}
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)t {   // a slider, a button or the segmented control keeps its own touch; the bar's background, title and hint start a drag
+    (void)g;
+    return ![t.view isKindOfClass:[UIControl class]];
+}
