+// it was left. While it is open, touches drag controls instead of pressing them; tapping an icon
 // selects it (a ring around it, its name in the hint line) and the slider tunes that icon's
 // own size; the glass slider tunes the Liquid Glass behind every icon, 0-100% (0115), the
 // game's own setting; the gear is hidden (it cannot be tapped now); the game keeps running behind it.
@@ -938,8 +1010,11 @@ static NSString *const k_glass_opacity_v2_key = @"DmPadGlassOpacityV2";   // the
