+    hint.text = [NSString stringWithFormat:@"当前：%@ · 拖动图标可以移动位置 · 拖动面板可以移动面板\n玻璃 %.0f%% 是现在的效果，100%% 最深", k_lineEditNames[e], k_glassAnchor * 100];
