-    hint.text = [NSString stringWithFormat:@"拖动图标可以移动位置\n玻璃 %.0f%% 是现在的效果，100%% 最深", k_glassAnchor * 100]; hint.textColor = UIColor.whiteColor; hint.font = [UIFont systemFontOfSize:12]; hint.textAlignment = NSTextAlignmentCenter;
+    hint.text = [NSString stringWithFormat:@"拖动图标可以移动位置 · 拖动面板可以移动面板\n玻璃 %.0f%% 是现在的效果，100%% 最深", k_glassAnchor * 100]; hint.textColor = UIColor.whiteColor; hint.font = [UIFont systemFontOfSize:12]; hint.textAlignment = NSTextAlignmentCenter;
     [_editBar addSubview:hint];
+    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(panelPan:)];   // the bar drags by its title or blank area (0116); a slider or the Done button keeps its own touch
