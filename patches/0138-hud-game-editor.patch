+// MARK: - In-game HUD editor (0137)
+//
+// A compact panel presented OVER the running game (GameMenu -> "HUD 设置"),
+// not the launcher's full editor: no preview photo, no drag -- the live game
+// is the preview. Every change saves to UserDefaults AND pushes the env var
+// at once (applyOneToEnvironment), so the host applies it on the next
+// present and the HUD in the game moves/resizes/hides in real time.
+// Position is adjusted with X/Y steppers (layout points, +/-10 per tap);
+// size with a 60%-180% slider, like the launcher editor and the button
+// settings. Hide is a TRUE hide (flags bit 0, hud_runtime.c), not off-screen.
+struct HudGameEditorView: View {
+    @ObservedObject var settings: HudSettings
+    @State private var selected: HudElement = .coins
+    @Environment(\.dismiss) private var dismiss
+
+    private func cur(_ el: HudElement) -> HudElementSetting {
+        settings.effective(el) ?? HudElementSetting(dx: 0, dy: 0, k: 1, hidden: false)
+    }
+    private func update(_ el: HudElement, _ s: HudElementSetting) {
+        settings.set(el, s)
+        settings.applyOneToEnvironment(el)
+    }
+    private func statusLine(_ el: HudElement) -> String {
+        let s = cur(el)
+        var parts = ["\(Int(s.k * 100))%"]
+        if s.dx != 0 || s.dy != 0 { parts.append("已移动") }
+        if s.hidden { parts.append("已隐藏") }
+        return parts.joined(separator: " · ")
+    }
+
+    var body: some View {
+        NavigationView {
+            List {
+                Section(header: Text("六个元素（点一行调它）")) {
+                    ForEach(HudElement.displayOrder) { el in
+                        HStack {
+                            Button(action: { selected = el }) {
+                                HStack {
+                                    Text(el.name)
+                                    Spacer()
+                                    Text(statusLine(el))
+                                        .font(.subheadline)
+                                        .foregroundStyle(.secondary)
+                                    if selected == el {
+                                        Image(systemName: "checkmark")
+                                            .foregroundStyle(.blue)
+                                    }
+                                }
+                            }
+                            .buttonStyle(.plain)
+                            Button(action: {
+                                var s = cur(el)
+                                s.hidden.toggle()
+                                update(el, s)
+                            }) {
+                                Image(systemName: cur(el).hidden ? "eye.slash" : "eye")
+                                    .foregroundStyle(cur(el).hidden ? .red : .blue)
+                            }
+                            .buttonStyle(.plain)
+                        }
+                    }
+                }
+                Section(header: Text("大小（\(selected.name)）")) {
+                    let s = cur(selected)
+                    HStack {
+                        Text("60%")
+                        Slider(value: Binding(
+                            get: { s.k },
+                            set: { v in var n = s; n.k = v; update(selected, n) }
+                        ), in: 0.6...1.8, step: 0.05)
+                        Text("\(Int(s.k * 100))%")
+                            .frame(width: 52, alignment: .trailing)
+                    }
+                }
+                Section(header: Text("位置（\(selected.name)，布局点）")) {
+                    let s = cur(selected)
+                    Stepper("横向 X：\(Int(s.dx))", value: Binding(
+                        get: { s.dx },
+                        set: { v in var n = s; n.dx = v; update(selected, n) }
+                    ), in: -640...640, step: 10)
+                    Stepper("纵向 Y：\(Int(s.dy))", value: Binding(
+                        get: { s.dy },
+                        set: { v in var n = s; n.dy = v; update(selected, n) }
+                    ), in: -360...360, step: 10)
+                    Button("恢复 \(selected.name) 默认") {
+                        settings.set(selected, nil)
+                        settings.applyOneToEnvironment(selected)
+                    }
+                    .foregroundStyle(.red)
+                }
+                Section {
+                    Button("全部恢复默认") {
+                        settings.resetAll()
+                        settings.applyToEnvironment()
+                    }
+                    .foregroundStyle(.red)
+                }
+            }
+            .navigationTitle("HUD 设置")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .confirmationAction) {
+                    Button("完成") { dismiss() }
+                }
+            }
+        }
+    }
+}
+
+// The in-game menu's "HUD 设置": present the game editor over the running
+// game. Mirrors the quit prompt's presentation (front_ios.m): walk to the
+// topmost presented view controller and present a DmHostingController.
+@_cdecl("dm_hud_open_game_editor")
+public func dmHudOpenGameEditor() {
+    DispatchQueue.main.async {
+        guard let window = UIApplication.shared.connectedScenes
+            .compactMap({ $0 as? UIWindowScene })
+            .flatMap({ $0.windows })
+            .first(where: { $0.isKeyWindow }),
+            var vc = window.rootViewController else { return }
+        while let p = vc.presentedViewController { vc = p }
+        let editor = HudGameEditorView(settings: HudSettings())
+        let host = DmHostingController(rootView: editor)
+        host.modalPresentationStyle = .pageSheet
+        vc.present(host, animated: true, completion: nil)
+    }
+}
