From: seedds <seedds@gmail.com>
Date: Sun, 15 Nov 2026 09:10:48 +0800
Subject: [PATCH] 0138: in-game HUD editor UI -- HudGameEditorView + GameMenu
 entry, live env updates
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A compact panel presented over the running game (GameMenu -> HUD 设置),
not the launcher's full editor: no preview photo, no drag -- the live game
is the preview. Six elements (display order), each with an eye toggle
(true hide), a 60%-180% size slider, and X/Y steppers (+/-10 layout
points) for the selected element, plus per-element and global reset. Every
change saves to UserDefaults AND pushes the env var at once
(HudSettings.applyOneToEnvironment), so the host -- which re-reads the env
vars every present -- applies it on the next frame: the HUD in the game
moves/resizes/hides in real time, no restart. Presented via
DmHostingController over the topmost view controller (the quit prompt's
pattern).
---
 dm/ios/Sources/GameMenu.swift  |   5 +-
 dm/ios/Sources/HudEditor.swift | 140 +++++++++++++++++++++++++++++++++
 2 files changed, 143 insertions(+), 2 deletions(-)

diff --git a/dm/ios/Sources/GameMenu.swift b/dm/ios/Sources/GameMenu.swift
index eafa4b0..4a6f0ba 100644
--- a/dm/ios/Sources/GameMenu.swift
+++ b/dm/ios/Sources/GameMenu.swift
@@ -20,17 +20,18 @@ private func gameMenuItems() -> [UIMenuElement] {
     }
     let layout = UIMenu(title: LauncherText.text("ui.controllerLayout", "Controller layout"), options: .singleSelection, children: layouts)   // a choice's value shows in its submenu: a subtitle would make each row two lines
     let padSettings = UIAction(title: "按键设置") { _ in dm_gamepad_open_pad_settings() }   // the button editor (DmGamepad.m): the icons' size and where they sit
+    let hudSettings = UIAction(title: "HUD 设置") { _ in dm_hud_open_game_editor() }   // (0137) the in-game HUD editor: size slider, X/Y steppers, true hide, live in the running game
     var items: [UIMenuElement] = []
     var placed = false
     if let m = gameMenuModel {
         for section in m.sections {
-            var rows: [UIMenuElement] = section == "Controls" ? [layout, padSettings] : []
+            var rows: [UIMenuElement] = section == "Controls" ? [layout, padSettings, hudSettings] : []
             if section == "Controls" { placed = true }
             for s in m.rows(in: section) where (s.kind == "choice" || s.kind == "toggle") && dm_setting_live(s.env, nil) { rows.append(gameMenuRow(m, s)) }
             if !rows.isEmpty { items.append(UIMenu(options: .displayInline, children: rows)) }
         }
     }
-    if !placed { items.insert(UIMenu(options: .displayInline, children: [layout, padSettings]), at: 0) }
+    if !placed { items.insert(UIMenu(options: .displayInline, children: [layout, padSettings, hudSettings]), at: 0) }
     items.append(Unmanaged<UIMenu>.fromOpaque(dm_quit_menu()).takeRetainedValue())   // Quit <game>, last and on its own: it opens the quit prompt (front_ios.m)
     return items
 }
diff --git a/dm/ios/Sources/HudEditor.swift b/dm/ios/Sources/HudEditor.swift
index 542dff4..130791b 100644
--- a/dm/ios/Sources/HudEditor.swift
+++ b/dm/ios/Sources/HudEditor.swift
@@ -229,6 +229,18 @@ final class HudSettings: ObservableObject {
             }
         }
     }
+    // (0137) In-game editor: push ONE element's current setting into the
+    // environment right now, so the host (which re-reads the env vars every
+    // present) applies it on the next frame -- the slider moves the HUD in
+    // the running game, no restart. An element with no manual setting is
+    // unset, so the game keeps its overlay base position.
+    func applyOneToEnvironment(_ e: HudElement) {
+        if let s = effective(e) {
+            setenv(e.env, s.encoded, 1)
+        } else {
+            unsetenv(e.env)
+        }
+    }
 }
 
 // The mockup's text shadow (.num, .hint-row): a dark 1px outline in four
@@ -812,3 +824,131 @@ struct HudEditorView: View {
         }
     }
 }
