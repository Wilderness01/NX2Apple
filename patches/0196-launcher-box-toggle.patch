From 5fd56972d9f60cdf9b845d00e88e8547748060f8 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Wed, 18 Nov 2026 17:33:50 +0800
Subject: [PATCH] 0196: launcher box closed by default, tap active icon to
 close

---
 dm/ios/Sources/Launcher.swift | 43 +++++++++++++++++++----------------
 1 file changed, 24 insertions(+), 19 deletions(-)

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index 3a21a33..6931ba3 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -3,8 +3,9 @@
 // dm/env.txt; main.m lists them in DM_ENV_FILE_KEYS) is shown but kept. All settings share one screen, grouped by section (rows: LauncherRow.swift). Choices that differ from the game's default are kept
 // in UserDefaults; Reset to tested defaults shows the defaults, and Play then forgets them. DM_LAUNCHER=0 in Documents/env.txt starts the game at once with the saved choices; DM_SAVED_CHOICES=0 ignores them (and keeps them)
 //
-// Layout (0194, V1.3.40): the poster fills the screen; the title and Play sit top-left; the settings and the character picker live in ONE glass panel on the right (the "box"), switched by the narrow
-// icon-only bar at the bottom centre. Nothing opens full-screen any more (this supersedes 0185's fullScreenCover): tapping a bottom icon swaps what the box shows. The box and the bar share one
+// Layout (0194, V1.3.40; 0196, V1.3.41): the poster fills the screen; the title and Play sit top-left; the settings and the character picker live in ONE glass panel on the right (the "box"), switched by the narrow
+// icon-only bar at the bottom centre. Nothing opens full-screen any more (this supersedes 0185's fullScreenCover). The box is closed by default, so the poster stays clean on entry: tapping a bottom icon opens its tab,
+// tapping the active icon again closes the box. The box and the bar share one
 // glass-intensity setting (UserDefaults DmGlassOpacity, 0-100, default 70), a slider in the Game tab. The character picker sits in the box too: hero + outfit deck + six character cards.
 import SwiftUI
 import UIKit
@@ -213,7 +214,7 @@ private func dmLauncherTitleImage() -> UIImage? {
     UIImage(named: "launcher_title_bg", in: Bundle(for: LauncherModel.self), compatibleWith: nil)
 }
 
-/// One settings category in the bottom bar (0182, 0194): an SF Symbol icon; the bar shows icons only (no text), the active one red. Tapping it swaps what the right-side box shows — nothing opens full-screen.
+/// One settings category in the bottom bar (0182, 0194): an SF Symbol icon; the bar shows icons only (no text), the active one red. Tapping it opens (or swaps to) its tab in the right-side box; tapping the active one again closes the box (0196) — nothing opens full-screen.
 private enum LauncherCategory: String, CaseIterable, Identifiable {
     case game, controls, performance, data, cloud, character
     var id: String { rawValue }
@@ -742,7 +743,8 @@ private struct LauncherBoxContent: View {
 private struct LauncherView: View {
     @ObservedObject var m: LauncherModel
     let play: () -> Void
-    @State private var selectedTab: LauncherCategory = .game
+    // 0196: nil means the box is closed; the launcher opens on the clean poster, no tab selected.
+    @State private var selectedTab: LauncherCategory? = nil
     @AppStorage("DmGlassOpacity") private var glassOpacity: Double = 70
 
     var body: some View {
@@ -779,26 +781,29 @@ private struct LauncherView: View {
                     .padding(.leading, 28 * s)
                     .padding(.top, 28 * s)
                     .frame(width: 330 * s, alignment: .leading)
-                    // Right: the glass box (0194) — the active tab's content, header on top.
-                    VStack(alignment: .leading, spacing: 0) {
-                        Text(selectedTab.title)
-                            .font(.system(size: 18 * s, weight: .bold))
-                            .foregroundStyle(.white)
-                            .padding(.horizontal, 16 * s)
-                            .padding(.top, 12 * s)
-                            .padding(.bottom, 6 * s)
-                        LauncherBoxContent(tab: selectedTab, m: m, glassOpacity: $glassOpacity, scale: s)
+                    // Right: the glass box (0194) — the active tab's content, header on top. Only when a tab is open (0196); closed by default.
+                    if let tab = selectedTab {
+                        VStack(alignment: .leading, spacing: 0) {
+                            Text(tab.title)
+                                .font(.system(size: 18 * s, weight: .bold))
+                                .foregroundStyle(.white)
+                                .padding(.horizontal, 16 * s)
+                                .padding(.top, 12 * s)
+                                .padding(.bottom, 6 * s)
+                            LauncherBoxContent(tab: tab, m: m, glassOpacity: $glassOpacity, scale: s)
+                        }
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .dmGlassCard(cornerRadius: 24, opacity: glassOpacity)
+                        .padding(.top, 20 * s)
+                        .padding(.trailing, 25 * s)
+                        .padding(.bottom, 8 * s)
                     }
-                    .frame(maxWidth: .infinity, maxHeight: .infinity)
-                    .dmGlassCard(cornerRadius: 24, opacity: glassOpacity)
-                    .padding(.top, 20 * s)
-                    .padding(.trailing, 25 * s)
-                    .padding(.bottom, 8 * s)
                 }
                 // Bottom: the icon bar (0194) — narrow, centred, icons only, the active one red. Tapping an icon swaps the box's content.
                 HStack(spacing: 0) {
                     ForEach(LauncherCategory.allCases) { c in
-                        Button { selectedTab = c } label: {
+                        // 0196: tapping the active icon again closes the box; any other icon opens (or swaps to) its tab.
+                        Button { selectedTab = (selectedTab == c ? nil : c) } label: {
                             Image(systemName: c.icon)
                                 .font(.system(size: 22 * s))
                                 .foregroundStyle(c == selectedTab ? Color(red: 0.9, green: 0.05, blue: 0.1) : Color(white: 0.4))
