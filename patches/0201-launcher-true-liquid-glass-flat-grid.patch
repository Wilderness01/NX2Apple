-/// Liquid Glass for the launcher's panels (0181, 0194): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the backdrop is a deep navy-black base, neutral on purpose — the text is white on dark glass, and a loud backdrop would fight it.
+/// Liquid Glass for the launcher's panels (0181, 0194, 0201): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the backdrop is a deep navy-black base, neutral on purpose — the text is white on dark glass, and a loud backdrop would fight it.
 ///
-/// `opacity` (0194) is the ONE glass-intensity setting (UserDefaults DmGlassOpacity, 0-100, default 70): 0 makes the glass vanish entirely (no effect, no tint, no shadow), 100 is the deepest. The box and the bottom bar read the same value, so one slider drives both. `light` is the bottom bar's pale pill: a white tint instead of the dark navy one, so its dark icons stay readable.
+/// `opacity` (0194, 0201) is the ONE glass-intensity setting (UserDefaults DmGlassOpacity, 0-100, default 70): 0 makes the glass vanish entirely (no effect, no tint, no shadow), 100 is the deepest. The box and the bottom bar read the same value, so one slider drives both. `light` is the bottom bar's pale pill: a white tint instead of the dark navy one, so its dark icons stay readable.
 private extension View {
     @ViewBuilder func dmGlassCard(cornerRadius: CGFloat = 32, opacity: Double = 70, light: Bool = false) -> some View {
         let op = max(0, min(100, opacity)) / 100
-        dmGlassBase(cornerRadius: cornerRadius, opacity: op)
-            // 0200: these overlays are decoration only, but SwiftUI hit-testing gives a tap to the topmost view that contains it — the fill RoundedRectangle covers the whole panel, so it ate every tap and the buttons underneath (bottom bar, box controls) never saw one. The bar has been dead since 0194 added this fill (V1.3.36's 0181 glass had only the 1pt stroke, which is why Play still worked then; 0197's contentShape could not help, the overlay sits above the buttons). Let touches fall through to the content.
-            .overlay(
-                RoundedRectangle(cornerRadius: cornerRadius)
-                    .fill((light ? Color.white : Color(red: 0.05, green: 0.07, blue: 0.13)).opacity((light ? 0.55 : 0.45) * op))
-                    .allowsHitTesting(false)
-            )
+        dmGlassBase(cornerRadius: cornerRadius, opacity: op, light: light)
+            // 0200: overlays are decoration only, but SwiftUI hit-testing gives a tap to the topmost view that contains it — a fill covering the whole panel ate every tap and the buttons underneath (bottom bar, box controls) never saw one. Keep them non-interactive.
             .overlay(
                 RoundedRectangle(cornerRadius: cornerRadius)
                     .strokeBorder(
@@ -184,13 +179,14 @@ private extension View {
             .shadow(color: .black.opacity(0.28 * op), radius: 16, x: 0, y: 8)
     }
 
-    @ViewBuilder private func dmGlassBase(cornerRadius: CGFloat, opacity: Double) -> some View {
+    @ViewBuilder private func dmGlassBase(cornerRadius: CGFloat, opacity: Double, light: Bool) -> some View {
         if opacity <= 0 {
             self
         } else {
             Group {
                 if #available(iOS 26.0, *) {
-                    self.glassEffect(.regular, in: RoundedRectangle(cornerRadius: cornerRadius))
+                    // 0201: true liquid glass. The tint lives INSIDE the glass effect, so the intensity slider drives the glass itself: clear and refractive at low values, milkier at high ones. Before (0194), a solid fill overlay sat on top of the glass and turned the panel into frosted plastic; the slider only faded that white wash, so the glass never visibly changed and the user saw "no effect".
+                    self.glassEffect(.regular.tint((light ? Color.white : Color(red: 0.05, green: 0.07, blue: 0.13)).opacity((light ? 0.55 : 0.45) * opacity)), in: RoundedRectangle(cornerRadius: cornerRadius))
                 } else {
                     self.background(.ultraThinMaterial, in: RoundedRectangle(cornerRadius: cornerRadius))
                 }
@@ -246,7 +242,7 @@ private func dmCharImage(_ name: String) -> UIImage? {
