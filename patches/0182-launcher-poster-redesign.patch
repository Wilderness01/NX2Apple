--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -183,38 +183,49 @@ private struct LauncherBackdrop: View {
     }
 }
 
-private struct LauncherView: View {
+/// The poster art (0182): the Odyssey key art the user sent — Mario, Cappy and the captured cast on a dark blue field, no menu, no logo (Alpha Coders 864351, 7372x4392 original, bundled at phone size 2796x1290 as a lossless PNG). The launcher is compiled into the app (DmIOS target), so the art lives in the app bundle: Bundle(for:) on LauncherModel (same module) names it in both the one-game app and the shell. UIImage(named:) finds the file the Sources glob bundles at the bundle root.
+private func dmLauncherTitleImage() -> UIImage? {
+    UIImage(named: "launcher_title_bg", in: Bundle(for: LauncherModel.self), compatibleWith: nil)
+}
+
+/// One settings category in the bottom row (0182): an icon and a label; tapping it opens that category's own settings page.
+private enum LauncherCategory: String, CaseIterable, Identifiable {
+    case game, controls, performance, data, cloud
+    var id: String { rawValue }
+    var icon: String {
+        switch self {
+        case .game: return "gamecontroller.fill"
+        case .controls: return "hand.tap.fill"
+        case .performance: return "cpu"
+        case .data: return "folder.fill"
+        case .cloud: return "icloud.fill"
+        }
+    }
+    var title: String {
+        switch self {
+        case .game: return LauncherText.sectionName("Game")
+        case .controls: return LauncherText.sectionName("Controls")
+        case .performance: return LauncherText.sectionName("Performance")
+        case .data: return LauncherText.text("ui.gameData", "Game data")
+        case .cloud: return LauncherText.text("ui.cloudSaves", "Cloud saves")
+        }
+    }
+}
+
+/// One category's own settings page (0182), shown as a sheet from the bottom row. The rows are the same SettingRow the old single list used, so nothing about how a setting is stored or applied changes; only where it is shown does.
+private struct LauncherCategorySheet: View {
+    let category: LauncherCategory
     @ObservedObject var m: LauncherModel
-    let play: () -> Void
+    @Environment(\.dismiss) private var dismiss
     @State private var memory = os_proc_available_memory()
 
     var body: some View {
-        GeometryReader { geometry in
-            HStack(spacing: 0) {
-                VStack(spacing: 16) {
-                    if let icon = appIcon() {
-                        Image(uiImage: icon).resizable().frame(width: 96, height: 96)
-                            .clipShape(RoundedRectangle(cornerRadius: 22))
-                            .accessibilityHidden(true)
-                    }
-                    Text((info("CFBundleDisplayName") as? String) ?? "Game")
-                        .font(.title.weight(.bold)).multilineTextAlignment(.center)
-                    Text("by 与荒野制作")
-                        .font(.subheadline).foregroundStyle(.secondary)
-                    Text("\(LauncherText.text("ui.version", "Version")) \((info("CFBundleShortVersionString") as? String) ?? "")")
-                        .font(.callout).foregroundStyle(.secondary)
-                    playButton
-                }
-                .padding(20)   // (0181) a little more air inside the glass panel
-                .frame(width: geometry.size.width / 3, height: geometry.size.height)
-                List {
-                    ForEach(m.sections, id: \.self) { section in
-                        let rows = m.rows(in: section)
-                        if !rows.isEmpty {
-                            Section(header: Text(LauncherText.sectionName(section))) {
-                                ForEach(rows) { SettingRow(s: $0, m: m) }
-                            }
-                        }
+        NavigationStack {
+            List {
+                switch category {
+                case .game:
+                    Section(header: Text(LauncherText.sectionName("Game"))) {
+                        ForEach(m.rows(in: "Game")) { SettingRow(s: $0, m: m) }
                     }
                     Section {
                         Button(LauncherText.text("ui.resetDefaults", "Reset to tested defaults")) { m.reset() }
@@ -222,8 +233,6 @@ private struct LauncherView: View {
                     } footer: {
                         Text(LauncherText.text("ui.resetDefaultsNote", "Brings back all settings this game was tested with."))
                     }
-                    GameDataSection()
-                    CloudSavesSection()
                     Section {
                         HStack {
                             Text(LauncherText.text("ui.memoryAvailable", "Memory available"))
@@ -231,17 +240,28 @@ private struct LauncherView: View {
                             Text(ByteCountFormatter.string(fromByteCount: Int64(memory), countStyle: .memory)).monospacedDigit().foregroundStyle(.secondary)
                         }
                     }
+                case .controls:
+                    Section(header: Text(LauncherText.sectionName("Controls"))) {
+                        ForEach(m.rows(in: "Controls")) { SettingRow(s: $0, m: m) }
+                    }
+                case .performance:
+                    Section(header: Text(LauncherText.sectionName("Performance"))) {
+                        ForEach(m.rows(in: "Performance")) { SettingRow(s: $0, m: m) }
+                    }
+                case .data:
+                    GameDataSection()
+                case .cloud:
+                    CloudSavesSection()
+                }
+            }
+            .navigationTitle(category.title)
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("\u{5b8c}\u{6210}") { dismiss() }
                 }
-                .listStyle(.insetGrouped)
-                .scrollContentBackground(.hidden)   // (0181) the list's own background goes, so the single glass panel behind it shows
-                .listRowBackground(Color.clear)   // (0181) every row is clear: the rows sit on the one glass panel, not on their own cards
-                .contentMargins(.horizontal, 12, for: .scrollContent)
-                .frame(width: geometry.size.width * 2 / 3)
             }
-            .dmGlassCard(cornerRadius: 0)   // (0181) one whole piece of glass: the game card and the settings list sit on a single glass panel, edge to edge; the toggles, sliders and menus on it are already glass on iOS 26, system-drawn
         }
-        .background(LauncherBackdrop())   // (0181) the backdrop the glass refracts
-        .preferredColorScheme(.dark)
         .task {
             while !Task.isCancelled {
                 memory = os_proc_available_memory()
@@ -249,17 +269,78 @@ private struct LauncherView: View {
             }
         }
     }
+}
+
+private struct LauncherView: View {
+    @ObservedObject var m: LauncherModel
+    let play: () -> Void
+    @State private var category: LauncherCategory?
 
-    @ViewBuilder var playButton: some View {
-        let button = Button(action: play) { Text(LauncherText.text("ui.play", "Play")).font(.title3.weight(.semibold)).frame(maxWidth: 220) }.controlSize(.large)
-        if #available(iOS 26.0, *) { button.buttonStyle(.glassProminent) } else { button.buttonStyle(.borderedProminent) }
+    var body: some View {
+        // Adaptive (0182): sizes scale with the screen — the reference is the iPhone 15 Pro Max landscape canvas (2796x1290); on an iPad (4:3) the same scale keeps the title, button and settings row in proportion, and the poster fills by cropping (scaledToFill).
+        GeometryReader { geo in
+        let s = min(max(geo.size.width / 2796, 0.5), 1.6)
+        ZStack {
+            // The poster (0182): the Odyssey key art, full-bleed. The navy backdrop behind it is the fallback if the art is missing.
+            if let art = dmLauncherTitleImage() {
+                Image(uiImage: art).resizable().scaledToFill().ignoresSafeArea()
+            } else {
+                LauncherBackdrop()
+            }
+            // Legibility: dark at the top-left where the title sits, and at the bottom where the settings row sits.
+            LinearGradient(colors: [.black.opacity(0.55), .black.opacity(0.2), .clear], startPoint: .leading, endPoint: .trailing).ignoresSafeArea()
+            LinearGradient(colors: [.black.opacity(0.5), .clear], startPoint: .top, endPoint: .bottom).ignoresSafeArea()
+            LinearGradient(colors: [.clear, .black.opacity(0.6)], startPoint: .top, endPoint: .bottom).ignoresSafeArea()
+            VStack(alignment: .leading, spacing: 0) {
+                // Top-left: the game name, start, author (0182; user: title at the top-left, not the bottom)
+                VStack(alignment: .leading, spacing: 10 * s) {
+                    Text("SUPER MARIO")
+                        .font(.system(size: 40 * s, weight: .black))
+                        .foregroundStyle(.white)
+                    Text("ODYSSEY")
+                        .font(.system(size: 60 * s, weight: .black))
+                        .foregroundStyle(Color(red: 0.9, green: 0.05, blue: 0.1))
+                    Text("\u{8d85}\u{7ea7}\u{9a6c}\u{91cc}\u{5965} \u{5965}\u{5fb7}\u{8d5b}")
+                        .font(.system(size: 20 * s)).foregroundStyle(.white.opacity(0.9))
+                    Text("by \u{4e0e}\u{8352}\u{91ce}\u{5236}\u{4f5c} · \(LauncherText.text("ui.version", "Version")) \((info("CFBundleShortVersionString") as? String) ?? "")")
+                        .font(.system(size: 15 * s)).foregroundStyle(.white.opacity(0.75))
+                    playButton(s)
+                }
+                .padding(.leading, 28 * s)
+                .padding(.top, 28 * s)
+                Spacer()
+                // Bottom: the settings row (0182) — one icon-and-label button per category, each opening its own page
+                HStack(spacing: 0) {
+                    ForEach(LauncherCategory.allCases) { c in
+                        Button { category = c } label: {
+                            VStack(spacing: 6 * s) {
+                                Image(systemName: c.icon).font(.system(size: 22 * s))
+                                Text(c.title).font(.system(size: 12 * s))
+                            }
+                            .foregroundStyle(.white)
+                            .frame(maxWidth: .infinity)
+                            .padding(.vertical, 12 * s)
+                        }
+                    }
+                }
+                .dmGlassCard(cornerRadius: 20)
+                .padding(.horizontal, 20 * s)
+                .padding(.bottom, 16 * s)
+            }
+        }
+        }
+        .preferredColorScheme(.dark)
+        .sheet(item: $category) { c in
+            LauncherCategorySheet(category: c, m: m)
+        }
     }
 
-    private func appIcon() -> UIImage? {
-        if let i = UIImage(named: "AppIcon") { return i }
-        guard let icons = info("CFBundleIcons") as? [String: Any], let primary = icons["CFBundlePrimaryIcon"] as? [String: Any],
-              let files = primary["CFBundleIconFiles"] as? [String], let last = files.last else { return nil }
-        return UIImage(named: last)
+    /// Start, in Odyssey red (0182): a big solid button on the poster, not the glass one the old card used. Width scales with the screen.
+    func playButton(_ s: CGFloat) -> some View {
+        Button(action: play) {
+            Text("\u{5f00}\u{59cb}\u{6e38}\u{620f}").font(.system(size: 20 * s, weight: .semibold)).foregroundStyle(.white).frame(maxWidth: 220 * s).padding(.vertical, 10 * s)
+        }
+        .background(Color(red: 0.9, green: 0.05, blue: 0.1), in: RoundedRectangle(cornerRadius: 14))
     }
 }
 
