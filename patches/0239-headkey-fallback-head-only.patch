From 2414418254eebb021122b81f71865c3d3bb77443 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Mon, 23 Nov 2026 09:01:05 +0000
Subject: [PATCH] 0239: narrow the 0237 headkey fallback to head lookups only
 (fix 0x6268a0)

---
 dm/games/0100000000010000/README.md  |  2 +-
 dm/games/0100000000010000/patches.py | 42 ++++++++++++++++++++++++----
 2 files changed, 37 insertions(+), 7 deletions(-)

diff --git a/dm/games/0100000000010000/README.md b/dm/games/0100000000010000/README.md
index 5d8f1cc4..051b9b42 100644
--- a/dm/games/0100000000010000/README.md
+++ b/dm/games/0100000000010000/README.md
@@ -90,7 +90,7 @@ General host and tool changes first needed here; each applies to every game:
 
 - Character selection in the in-game shop (0166, open): the shop rows are in (0167: Mario/Luigi/Wario at ItemList.byml 147,148,149, Luigi2D.szs icon, MSBT labels) and the title-menu picker is removed (0168: row 3 is VR again, guide taps fall through while a page is shown), but buying a row does not persist the character yet. The confirmed row cannot be identified from static code: the fs-preview route is refuted by log-64 (the shop opens every row's body file while building the list and nothing new at confirm), the 0x50a5c0 accessor's +0x70 is a float, not a row index, and NrvSelectDecideEnd (0x442980) is cleanup. The list NrvDecide hook point 0x2e8dfc is verified and can set a confirm flag, but the flag alone does not name the row.
 - Costume hands stay stock (0222, stopgap, open): a costume's hand file is never redirected. The Mechanic form has no own hands (no `MarioMechanicHandL/R.szs` in RomFS), so it borrows the player's hands and looks `MarioHandL`/`MarioHandR` up by name; a costume hand file's FMDL is named after itself, the lookup returns NULL, and the bone-transform setup faults at NULL+0x28 (`0x6ad530`, log-93). The guard in `dm_char_redirect` keeps the stock white gloves. The proper fix, like 0220 for caps, is hand reskins with FMDL `MarioHandL`/`MarioHandR`.
-- Costume-head crash, diagnostic probe (0228, open): a pool-external costume (Happi) and a pool-internal one (Explorer) crash identically at `0x6ad530` (log-106/log-107) because `(resource->0xa0)->0xb8 == 0` for the key `"ObjectData/<name>Head"` in the model-definition loader `0x65f520` -- the pool is not the discriminator. A temporary FRAME_STEP probe (two cuts at `0x65f8c8` and `0x65fb50`, ring in the state page at +0x3300, drained once per present) logs `key/res/doc/doc_b8` for every head lookup; run once per costume (Happi, Explorer, Hakama) and compare `doc_b8`. The fix (pre-register the head document, or route the key to the default head document) waits on that log. Remove the probe once it has decided. Fixed by 0237 (REPORT-7-3-HEADKEY-LOOKUP.md): the backtrace in log-0b911672 (Football) and log-5d1c1a20 (Explorer) pins the chain 0x3e67e4 -> 0x3e7810 -> 0x6dc260 -> 0x6dc290 -> 0x660ab0 -> 0x65f520 -> 0x747300, and the head key is "ObjectData/<head>Head" with the head base name from a separate accessor (0x513760), not the clothes name and not the cap -- which is why matching caps still crash, and why the 0226 save write (which never wrote in those runs: 5 matches) cannot be the cause. The per-costume head document is not in the byml-document dictionary at assembly time (the head .szs FILE is served by the fs redirect, but the file and the document are different namespaces). A FRAME_STEP cut at 0x65f8cc (right after the 0228 probe's 0x65f8c8 cut) re-looks a NULL-doc_b8 head lookup up as the shared "ObjectData/MarioHighHead" (probe-proven valid, doc_b8 = 0x706f2c8000 in both runs) and uses that resource: the setter then reads a valid +0xb8. The costume hat is kept (geometry/texture come from the redirected head file); only the document metadata comes from the shared high head. The 0228 probe is kept: it logs the original NULL-doc_b8 lookup and the substituted valid one, and since the fix prevents the crash the drain now runs and both records reach the log.
+- Costume-head crash, diagnostic probe (0228, open): a pool-external costume (Happi) and a pool-internal one (Explorer) crash identically at `0x6ad530` (log-106/log-107) because `(resource->0xa0)->0xb8 == 0` for the key `"ObjectData/<name>Head"` in the model-definition loader `0x65f520` -- the pool is not the discriminator. A temporary FRAME_STEP probe (two cuts at `0x65f8c8` and `0x65fb50`, ring in the state page at +0x3300, drained once per present) logs `key/res/doc/doc_b8` for every head lookup; run once per costume (Happi, Explorer, Hakama) and compare `doc_b8`. The fix (pre-register the head document, or route the key to the default head document) waits on that log. Remove the probe once it has decided. Fixed by 0237 (REPORT-7-3-HEADKEY-LOOKUP.md): the backtrace in log-0b911672 (Football) and log-5d1c1a20 (Explorer) pins the chain 0x3e67e4 -> 0x3e7810 -> 0x6dc260 -> 0x6dc290 -> 0x660ab0 -> 0x65f520 -> 0x747300, and the head key is "ObjectData/<head>Head" with the head base name from a separate accessor (0x513760), not the clothes name and not the cap -- which is why matching caps still crash, and why the 0226 save write (which never wrote in those runs: 5 matches) cannot be the cause. The per-costume head document is not in the byml-document dictionary at assembly time (the head .szs FILE is served by the fs redirect, but the file and the document are different namespaces). A FRAME_STEP cut at 0x65f8cc (right after the 0228 probe's 0x65f8c8 cut) re-looks a NULL-doc_b8 head lookup up as the shared "ObjectData/MarioHighHead" (probe-proven valid, doc_b8 = 0x706f2c8000 in both runs) and uses that resource: the setter then reads a valid +0xb8. The costume hat is kept (geometry/texture come from the redirected head file); only the document metadata comes from the shared high head. The 0228 probe is kept: it logs the original NULL-doc_b8 lookup and the substituted valid one, and since the fix prevents the crash the drain now runs and both records reach the log. Narrowed by 0239 (REPORT-7-3-HEAD-ONLY.md): the 0237 cut intercepted EVERY model lookup at 0x65f520, not just heads, and crashed stage loading at 0x6268a0 (log-0adb2f98 / log-df935933 / log-78dd8466, byte-identical, even default Mario); 0239 reads the lookup key from [sp, #0x128] and only falls back when the key ends in "Head", so non-head lookups (body, stage, "Bind") pass through untouched.
 - The three thunder geometry shaders do not translate.
 - The silent first minute of sound.
 - development.md calls SDK 7.3.2 "the oldest so far"; Mario Kart 8 Deluxe (SDK 4.4.0) is older now.
diff --git a/dm/games/0100000000010000/patches.py b/dm/games/0100000000010000/patches.py
index bd5a2c75..03ea5686 100644
--- a/dm/games/0100000000010000/patches.py
+++ b/dm/games/0100000000010000/patches.py
@@ -433,6 +433,12 @@ def _diag_headkey_frame_step(ctx):
     fs_put(0x65fb50, [B(0x65fb50, start_b)], '0228 diagnostic: 0x65f520 headkey probe, joint-setup site (REPORT-LOOKUP-DECODE.md §7.3)')
 
 # (0237) Route a NULL-doc_b8 costume-head lookup to the shared high head.
+# (0239 head-only) 0237 fixed §7.3 but its cut intercepted EVERY model
+# lookup at 0x65f520, not just heads, and crashed stage loading at 0x6268a0
+# (log-0adb2f98 / log-df935933 / log-78dd8466, byte-identical, even default
+# Mario). 0239 narrows it: the trampoline first reads the lookup key from
+# [sp, #0x128] and scans for the suffix "Head" (followed by NUL); non-head
+# lookups pass through untouched.
 # §7.3: the setter 0x6ad4d0 faults at 0x6ad530 reading [x8,#0x28] with x8 = 0,
 # i.e. ([resource,#0xa0])->0xb8 == NULL, where resource is the 0x747300 result
 # for the key "ObjectData/<head>Head" built by 0x3e7810 from 0x513760(x25)
@@ -464,7 +470,8 @@ def _diag_headkey_frame_step(ctx):
 # Cut at 0x65f8cc (right after the 0228 probe's 0x65f8c8 cut, replacing
 # `mov x26, x0`): at the site x0 is the resource, x22 is the document,
 # x23 is the manager ([x20,#0xc8]) and x19 is the 0x747300 arg-4, all live.
-# The trampoline preserves x19-x30 and sp; it only writes x0-x2 and x22/x26.
+# The trampoline preserves x19-x30 and sp; it only writes x0-x5 and x22/x26
+# (x3-x5 are dead here: clobbered by bl 0x747300 and by the 0228 probe body).
 # It saves x30 across the fallback `bl 0x747300` (which clobbers it) and
 # executes the replaced instruction before branching back.
 DIAG_HEADKEY_FALLBACK_KEY = "ObjectData/MarioHighHead"
@@ -489,10 +496,33 @@ def _headkey_fallback_frame_step(ctx):
     def _bl(target): body.append(('bl', target))
     def _adrp(reg, target): body.append(('adrp', reg, target))
     def _b_abs(target): body.append(('b_abs', target))
-    _w(STP_PRE(30, 31, 31, -16))   # stp x30, xzr, [sp, #-16]! (save x30: the bl clobbers it)
-    _cbz(22, 'fallback')           # if doc == 0, fallback
-    _w(LDRX(1, 22, 0x17))          # x1 = doc_b8 = [x22, #0xb8]
-    _cbnz(1, 'done')               # if doc_b8 != 0, normal path
+    # (0239) Head-only gate: read the lookup key from [sp, #0x128] BEFORE
+    # pushing x30 (sp is still the caller's sp here), then scan it for the
+    # suffix "Head" (followed by NUL). The peek loads (LDRB, unsigned offset)
+    # do not advance x3, so a failed 'H' match resumes scanning at the next
+    # character and overlapping candidates (e.g. "HHead") are not missed.
+    _w(LDRX(3, 31, 0x25))        # x3 = key ptr = [sp, #0x128]
+    _w(STP_PRE(30, 31, 31, -16)) # stp x30, xzr, [sp, #-16]! (save x30: the bl clobbers it)
+    _label('scan')
+    _w(LDRB_POST(4, 3, 1))       # w4 = *x3++ (next key char)
+    _cbz(4, 'done')              # NUL: not a head key, skip the fallback
+    _w(SUBI(5, 4, 0x48))         # x5 = w4 - 'H'
+    _cbnz(5, 'scan')             # not 'H', keep scanning
+    _w(LDRB(5, 3, 0))            # w5 = *x3 ('e'?)
+    _w(SUBI(5, 5, 0x65))         # x5 = w5 - 'e'
+    _cbnz(5, 'scan')             # not 'e', keep scanning
+    _w(LDRB(5, 3, 1))            # w5 = *(x3+1) ('a'?)
+    _w(SUBI(5, 5, 0x61))         # x5 = w5 - 'a'
+    _cbnz(5, 'scan')             # not 'a', keep scanning
+    _w(LDRB(5, 3, 2))            # w5 = *(x3+2) ('d'?)
+    _w(SUBI(5, 5, 0x64))         # x5 = w5 - 'd'
+    _cbnz(5, 'scan')             # not 'd', keep scanning
+    _w(LDRB(5, 3, 3))            # w5 = *(x3+3) (NUL?)
+    _cbnz(5, 'scan')             # not NUL: "Head" mid-string, keep scanning
+    # Head key confirmed: the 0237 fallback logic, unchanged.
+    _cbz(22, 'fallback')         # if doc == 0, fallback
+    _w(LDRX(1, 22, 0x17))        # x1 = doc_b8 = [x22, #0xb8]
+    _cbnz(1, 'done')             # if doc_b8 != 0, normal path
     _label('fallback')
     _w(MOV(0, 23))                 # x0 = manager
     _adrp(1, key_addr)             # x1 = page of "ObjectData/MarioHighHead"
@@ -513,7 +543,7 @@ def _headkey_fallback_frame_step(ctx):
         elif item[0] == 'bl': emit(B(pc, item[1]) | 0x80000000)
         elif item[0] == 'adrp': emit(ADRP(item[1], pc, item[2]))
         elif item[0] == 'b_abs': emit(B(pc, item[1]))
-    fs_put(0x65f8cc, [B(0x65f8cc, start)], '0237: route a NULL-doc_b8 costume-head lookup to the shared high head (REPORT-7-3-HEADKEY-LOOKUP.md)')
+    fs_put(0x65f8cc, [B(0x65f8cc, start)], '0239: head-only fallback -- route a NULL-doc_b8 costume-HEAD lookup to the shared high head; non-head lookups pass through (REPORT-7-3-HEAD-ONLY.md)')
 
 # (0230 diagnostic) The allocator "grow" probe: log the grow-call parameters
 # at the abort site (allocator 0x954310, REPORT-LOG108-LOG109.md §7 + the
