+// (0132) Walk the full parent chain and sum the local translations
+// (+0x30/+0x34), giving the pane's layout position in the root's space.
+// A static pane's +0x70 is never composed by the game, so the stored
+// original cannot come from it; and the 0130 single-parent fallback is
+// insufficient -- it only ran when the pane's own local was non-zero, and
+// it read only the immediate parent's layout, so it missed a layout that
+// lives further up the chain (log-41: TxtCounter's local is (0,0), so
+// 0130 never ran for it; and the regional panes' live matrix is non-zero,
+// so 0130 never triggered for them either). The chain sum is the layout
+// whenever the layout is in the +0x30 chain at all (a plain sum: no
+// rotation, parent scale 1 -- the scales in the HUD chains are 1, and the
+// origin effect is a few units at most, so the sum is exact to within a
+// few units). It never reads any +0x70 (a stale cache for a static pane,
+// and a moved matrix for a matched parent). It stops at the root (no
+// parent) or after 8 levels, and never follows a NULL or unaligned parent
+// (the same guards hud_edge_unparent uses). A pane named 'All' is a
+// genuinely positioned container when its local is non-zero (log-41:
+// Life's parent 'All' is at (585.7,284)), so the walk does NOT stop at
+// it -- it sums its local like any other ancestor.
+static inline __attribute__((always_inline)) void hud_edge_chain_origin(void *pane, float *ox, float *oy) {
+    float x = 0.0f, y = 0.0f;
+    void *p = pane;
+    for (int i = 0; i < 8 && p && !((uintptr_t)p & 7u); i++) {
+        x += *(const float *)((const char *)p + 0x30);
+        y += *(const float *)((const char *)p + 0x34);
+        p = *(void **)((const char *)p + 0x18);
+    }
+    *ox = x;
+    *oy = y;
+}
