diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index 450ddef..8ca98ac 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -837,7 +837,7 @@ HLE_FORCE("_ZN2nn2fs7UnmountEPKc", "fsp-srv; host mounts are permanent, a no-op,
 // (stage/actor Byaml) through the generic CRC32-hashed resource system, so
 // there is no game-binary hook point for the model. The hook lives here, in
 // the host filesystem layer, which sees the full guest path of every open.
-//   DM_CHAR_SELECT   mario | luigi | wario (unset = mario: no redirect)
+//   DM_CHAR_SELECT   mario | luigi | wario | peach | pauline | toad (unset = mario: no redirect)
 //   DM_CHAR_CAP      cap costume name (e.g. MarioColorWario), "default", or unset (follow the save)
 //   DM_CHAR_CLOTHES  clothes costume name, "default", or unset (follow the save)
 // A leading "Mario" in an ObjectData filename is replaced by the character
@@ -890,7 +890,7 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
         LOG("[char] fs %s kept (sel=%s)", p, sel ? sel : "(unset)");
         return 0;
     }
-    const char *ch = !strcmp(sel, "luigi") ? "Luigi" : !strcmp(sel, "wario") ? "Wario" : !strcmp(sel, "peach") ? "Peach" : NULL;
+    const char *ch = !strcmp(sel, "luigi") ? "Luigi" : !strcmp(sel, "wario") ? "Wario" : !strcmp(sel, "peach") ? "Peach" : !strcmp(sel, "pauline") ? "CityMayor" : !strcmp(sel, "toad") ? "Toad" : NULL;
     if (!ch) {
         LOG("[char] fs %s kept (sel=%s: unknown character)", p, sel);
         return 0;
