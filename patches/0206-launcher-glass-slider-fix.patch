From 061e7dcd7f5be623970813fdd22f48f17ab4f882 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Thu, 19 Nov 2026 02:51:53 +0000
Subject: [PATCH] 0206: glass slider visibly drives the glass

---
 dm/ios/Sources/Launcher.swift | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index 83fc4da..755fb81 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -160,9 +160,9 @@ private struct DocumentPicker: UIViewControllerRepresentable {
     }
 }
 
-/// Liquid Glass for the launcher's panels (0181, 0194, 0201): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the backdrop is a deep navy-black base, neutral on purpose — the text is white on dark glass, and a loud backdrop would fight it.
+/// Liquid Glass for the launcher's panels (0181, 0194, 0201, 0206): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the backdrop is a deep navy-black base, neutral on purpose — the text is white on dark glass, and a loud backdrop would fight it.
 ///
-/// `opacity` (0194, 0201) is the ONE glass-intensity setting (UserDefaults DmGlassOpacity, 0-100, default 70): 0 makes the glass vanish entirely (no effect, no tint, no shadow), 100 is the deepest. The box and the bottom bar read the same value, so one slider drives both. `light` is the bottom bar's pale pill: a white tint instead of the dark navy one, so its dark icons stay readable.
+/// `opacity` (0194, 0201, 0206) is the ONE glass-intensity setting (UserDefaults DmGlassOpacity, 0-100, default 70): 0 makes the glass vanish entirely (no effect, no tint, no shadow), 100 is the deepest. The box and the bottom bar read the same value, so one slider drives both. `light` is the bottom bar's pale pill: a white tint instead of the dark navy one, so its dark icons stay readable. (0206: below 35 the glass is `.clear`, at and above it `.regular` with a deepening tint — the frost itself switches, so the slider is visible.)
 private extension View {
     @ViewBuilder func dmGlassCard(cornerRadius: CGFloat = 32, opacity: Double = 70, light: Bool = false) -> some View {
         let op = max(0, min(100, opacity)) / 100
@@ -186,7 +186,14 @@ private extension View {
             Group {
                 if #available(iOS 26.0, *) {
                     // 0201: true liquid glass. The tint lives INSIDE the glass effect, so the intensity slider drives the glass itself: clear and refractive at low values, milkier at high ones. Before (0194), a solid fill overlay sat on top of the glass and turned the panel into frosted plastic; the slider only faded that white wash, so the glass never visibly changed and the user saw "no effect".
-                    self.glassEffect(.regular.tint((light ? Color.white : Color(red: 0.05, green: 0.07, blue: 0.13)).opacity((light ? 0.55 : 0.45) * opacity)), in: RoundedRectangle(cornerRadius: cornerRadius))
+                    // 0206: tint-only still read as nothing on device (V1.3.44): `.regular` keeps a FIXED frost level no matter the tint alpha, and the tint is a near-black navy (max 0.45) over an already dark poster, so 0→100 changed almost no pixel. The value now also switches the glass itself: below 0.35 the glass is `.clear` (poster sharp behind), at and above it is `.regular` (frosted), with the tint deepening 0.15→0.75 as the value rises. Dragging past the threshold visibly frosts the panel over — that step is the intensity the user feels. The tint curve is continuous across the threshold; only the frost steps.
+                    let tint = light ? Color.white : Color(red: 0.05, green: 0.07, blue: 0.13)
+                    if opacity < 0.35 {
+                        self.glassEffect(.clear, in: RoundedRectangle(cornerRadius: cornerRadius))
+                    } else {
+                        let deep = (opacity - 0.35) / 0.65
+                        self.glassEffect(.regular.tint(tint.opacity((light ? 0.25 : 0.15) + (light ? 0.55 : 0.60) * deep)), in: RoundedRectangle(cornerRadius: cornerRadius))
+                    }
                 } else {
                     self.background(.ultraThinMaterial, in: RoundedRectangle(cornerRadius: cornerRadius))
                 }
