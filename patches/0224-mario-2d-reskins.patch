diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index 60a119b..557b20c 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -1074,17 +1074,32 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
             // file is kept -- the 0218 behavior, never a crash.
             // 0223 (log-95): a body slot maps to the Mario body reskin
             // (<Body>R, e.g. MarioHakamaR.szs), NOT to the stock costume
-            // body -- the reskin's FMDL and SARC member are both "Mario",
-            // so the Path C name lookup succeeds. Only for Mario: other
-            // characters' costume bodies load by content (log-69) and have
-            // no reskins. If the reskin is not found, the next candidate is
-            // the character default ("Mario" = the stem, self-skipped), so
-            // the file is kept -- never the stock costume file (that
-            // crashes via Path C).
+            // body. NOTE (log-96): the body reskin did NOT fix Path C --
+            // it applied and the crash persisted, so the body FMDL/member
+            // name is not what Path C looks up. The reskins are kept
+            // (they load, FMDL "Mario") but they are not the Path C fix.
+            // Only for Mario: other characters' costume bodies load by
+            // content (log-69) and have no reskins. If the reskin is not
+            // found, the next candidate is the character default ("Mario"
+            // = the stem, self-skipped), so the file is kept -- never the
+            // stock costume file.
+            // 0224 (log-97): a 2D slot maps to the Mario2D reskin
+            // (<2D>R, e.g. MarioHappi2DR.szs), NOT to the stock costume
+            // 2D -- the reskin's FMDL and SARC member are both "Mario2D",
+            // so the Path C name lookup succeeds. The dot bones are not
+            // the trigger (log-97: Happi's 2D has all 9 dots and still
+            // crashed via Path C); by elimination the 2D file itself is
+            // the trigger and its FMDL name is the remaining suspect.
+            // Only for Mario: other characters have no 2D reskins. If the
+            // reskin is not found, the next candidate is the character
+            // default ("Mario2D" = the stem, self-skipped), so the file is
+            // kept -- never the stock costume file.
             if (!strcmp(part, "Cap"))
                 snprintf(cand[ncand], sizeof cand[0], "%s%s%sR", ch, slot + 5, part);
             else if (!plen && !strcmp(ch, "Mario"))
                 snprintf(cand[ncand], sizeof cand[0], "%s%sR", ch, slot + 5);
+            else if (!strcmp(part, "2D") && !strcmp(ch, "Mario"))
+                snprintf(cand[ncand], sizeof cand[0], "%s%s%sR", ch, slot + 5, part);
             else
                 snprintf(cand[ncand], sizeof cand[0], "%s%s%s", ch, slot + 5, part);
             ncand++;
