From 7e5815762659a4e04ca8d4ccce90c630557a873b Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sun, 15 Nov 2026 20:01:12 +0800
Subject: [PATCH] 0142: write the HUD pane GLOBAL matrix from the absolute
 target, not the parent-compensated delta

0137 wrote +0x70 from the parent-compensated effective delta (edx/edy/ek),
the same values the LOCAL write uses. But +0x70 is an ABSOLUTE displayed
transform: the global already contains the parent's transform, so
compensating it again put a child of a moved/scaled parent one parent-shift
short and one parent-scale over-divided (dragging the moons misplaced the
regional coins, dragging the compass misplaced the hints). The local write
keeps the compensated values (the game composes the global from the local,
so the local must compensate); the global write now uses the absolute target
(tdx/tdy/tk). The absolute target is stored per entry in unused e_orig
slots ([1] g_dx, [2] g_dy, [4] g_k -- e_orig only reads [0],[3],[5],[7])
and the recompute check and early return compare against it. Verified by a
mock run of the transform logic: a static child of a moved/scaled parent
lands exactly on its absolute target (old code: one parent-shift short,
scale over-divided). The HUD panes this matters for are static (their +0x70
is never composed by the game, which is why 0137 writes it directly), so
the absolute write is exact there; a dynamic pane still costs one frame
when its parent moves, then self-corrects.
---
 dm/games/0100000000010000/hud_runtime.c | 58 ++++++++++++++++----
 dm/games/0100000000010000/patches.py    | 73 +++++++++++++------------
 2 files changed, 84 insertions(+), 47 deletions(-)

diff --git a/dm/games/0100000000010000/hud_runtime.c b/dm/games/0100000000010000/hud_runtime.c
index 3898601..8f90f11 100644
--- a/dm/games/0100000000010000/hud_runtime.c
+++ b/dm/games/0100000000010000/hud_runtime.c
@@ -180,6 +180,29 @@ typedef unsigned long uintptr_t;
 #define HUD_MANUAL_MASK_OFF 72     // byte offset of the manual mask (+0x248; the 18 floats end at +0x247)
 #define HUD_HIDDEN_MASK_OFF 76     // byte offset of the hidden mask (+0x24C)
 
+// (0142) The GLOBAL matrix (+0x70) is ABSOLUTE (a displayed transform in
+// layout space), so its write and its recompute check use the ABSOLUTE
+// target (tdx/tdy/tk), not the parent-compensated effective delta
+// (edx/edy/ek) the LOCAL write uses. 0137 used the compensated values for
+// both, which is wrong for the global: when a matched parent is moved or
+// scaled (dragging the moons moves the regional coins, dragging the
+// compass moves the hints), the child landed one parent-shift short and
+// one parent-scale over-divided. The absolute target is stored per entry
+// in e_orig slots the local never uses (e_orig only reads [0],[3],[5],[7];
+// the rest are zeroed on first sighting and free): [1] = last written
+// absolute global dx, [2] = last written absolute global dy, [4] = last
+// written absolute global k. The early return checks them too, so a change
+// in the absolute target alone (parent moved by exactly the target change)
+// still triggers a write. Limitation: for a DYNAMIC pane (the game
+// recomposes its global every frame) a parent move still costs one frame
+// -- the game's composed global includes the parent's move, the check
+// reads it as a recomposition and e_mod absorbs it, then corrects on the
+// next frame. The HUD children this matters for (regional coins, hints)
+// are static panes in practice, so the fix is exact there.
+#define HUD_GDX_SLOT 1   // e_orig[1]: absolute global dx last written
+#define HUD_GDY_SLOT 2   // e_orig[2]: absolute global dy last written
+#define HUD_GK_SLOT 4    // e_orig[4]: absolute global k last written
+
 // A hidden element is pushed this far off-screen (0113 hid its guide text
 // the same way: a pane already past 5000 is off-screen). The layout is at
 // most 1560 wide, so +10000 is safely outside it whatever the aspect.
@@ -610,13 +633,15 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
         e_orig[0] = cur_sx;
         e_orig[5] = cur_sy;
     }
-    if (!recomputed && (cur_gx != e_mod[3] + *e_dx || cur_gy != e_mod[7] + *e_dy)) {
+    if (!recomputed && (cur_gx != e_mod[3] + e_orig[HUD_GDX_SLOT] || cur_gy != e_mod[7] + e_orig[HUD_GDY_SLOT])) {
         // The game recomposed the global (a layout reload, an animation):
         // the stored original global follows the game's new value minus
-        // our applied delta, so the next write re-derives correctly.
+        // our applied ABSOLUTE delta (0142: the global is absolute, so the
+        // reference is the absolute delta, not the compensated *e_dx), so
+        // the next write re-derives correctly.
         recomputed = 1;
-        e_mod[3] = cur_gx - *e_dx;
-        e_mod[7] = cur_gy - *e_dy;
+        e_mod[3] = cur_gx - e_orig[HUD_GDX_SLOT];
+        e_mod[7] = cur_gy - e_orig[HUD_GDY_SLOT];
         for (int i = 0; i < 12; i++) {
             if (i == 3 || i == 7) continue;
             e_mod[i] = *(const float *)((const char *)pane + 0x70 + i * 4);
@@ -624,7 +649,8 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
         // Re-derive the scale reference too: the stored k stays, the
         // matrix basis is refreshed above.
     }
-    if (!recomputed && *e_dx == edx && *e_dy == edy && *e_k == ek && *e_hidden == (u32)hidden) return;   // already correct: nothing to do
+    if (!recomputed && *e_dx == edx && *e_dy == edy && *e_k == ek && *e_hidden == (u32)hidden
+        && e_orig[HUD_GDX_SLOT] == tdx && e_orig[HUD_GDY_SLOT] == tdy && e_orig[HUD_GK_SLOT] == tk) return;   // already correct: nothing to do (0142: the absolute target must match too -- a parent move can leave the compensated delta unchanged while the absolute target moved)
 
     // The local shift is always re-derived from the stored original, so a
     // fixed offset cannot drift: local = original local + effective delta,
@@ -644,14 +670,19 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // the game's global is final, so it is what Draw renders and what the
     // children compose from. (A static pane's +0x70 may be stale; the
     // local write above is the fallback for that path.)
+    // (0142) The global is ABSOLUTE, so the shift/scale here are the
+    // ABSOLUTE target (tdx/tdy/tk), NOT the parent-compensated edx/edy/ek
+    // the local write uses: the global already contains the parent's
+    // transform, and compensating it again would move a child of a moved
+    // parent one parent-shift short and one parent-scale over-divided.
     {
         float *gm = (float *)((char *)pane + 0x70);
-        gm[0] = e_mod[0] * ek;
-        gm[1] = e_mod[1] * ek;
-        gm[3] = e_mod[3] + edx;
-        gm[4] = e_mod[4] * ek;
-        gm[5] = e_mod[5] * ek;
-        gm[7] = e_mod[7] + edy;
+        gm[0] = e_mod[0] * tk;
+        gm[1] = e_mod[1] * tk;
+        gm[3] = e_mod[3] + tdx;
+        gm[4] = e_mod[4] * tk;
+        gm[5] = e_mod[5] * tk;
+        gm[7] = e_mod[7] + tdy;
     }
     // (0137) TRUE hide: clear the visible bit (flags bit 0 at +0x58) to
     // hide, set it to show. This is a real visibility toggle, not an
@@ -666,6 +697,11 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     *e_dy = edy;
     *e_k = ek;
     *e_hidden = (u32)hidden;
+    // (0142) Remember the ABSOLUTE global transform just written, so the
+    // recompute check and the early return above compare against it.
+    e_orig[HUD_GDX_SLOT] = tdx;
+    e_orig[HUD_GDY_SLOT] = tdy;
+    e_orig[HUD_GK_SLOT] = tk;
 
     // Mark this pane dirty (flags bit 4 at +0x58), so the game recomposes
     // its +0x70 from the shifted local in the same Calculate call (the
