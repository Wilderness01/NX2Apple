 1 file changed, 94 insertions(+), 29 deletions(-)

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index 24c8f6e0..f3d614c1 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -629,6 +629,37 @@ private struct DmGrain: View {
 /// state only: tapping wears the outfit (onSelect) and toggles the lid;
 /// a second tap on the same card closes it, a tap on another card moves
 /// the open lid there.
+///
+/// (0231) Switch-like detents for the cartridge flow: one flick moves
+/// at most one card, with a haptic tick per step. `.viewAligned` snaps
+/// to the nearest card but lets a hard flick fly past several; a toggle
+/// switch never does that. A slow release keeps the nearest snap — the
+/// content is already where the finger left it, so clamping it back
+/// would fight the drag. Only a real flick (release velocity above the
+/// threshold) is clamped to one step from the card centered at release.
+/// `startX` is the content x of item 0's center: the leading padding
+/// centers the first card too, so it is max(cardWidth/2, viewport/2).
+private struct DmCartridgeDetentBehavior: ScrollTargetBehavior {
+    let pitch: CGFloat
+    let cardWidth: CGFloat
+    let itemCount: Int
+    let startX: CGFloat
+    let centeredIndex: Int
+
+    func updateTarget(_ target: inout ScrollTarget, context: TargetContext) {
+        guard itemCount > 1, pitch > 0 else { return }
+        let proposed = min(max(Int(round((target.rect.midX - startX) / pitch)), 0), itemCount - 1)
+        guard abs(context.velocity.x) > 250 else { return }
+        guard abs(proposed - centeredIndex) > 1 else { return }
+        let step = proposed > centeredIndex ? 1 : -1
+        let next = min(max(centeredIndex + step, 0), itemCount - 1)
+        let cx = startX + CGFloat(next) * pitch
+        target.rect = CGRect(x: cx - cardWidth / 2, y: target.rect.origin.y,
+                             width: cardWidth, height: target.rect.height)
+        target.anchor = .center
+    }
+}
+
 private struct CartridgeCoverFlowView: View {
     let characterId: String
     let characterName: String
@@ -684,6 +715,17 @@ private struct CartridgeCoverFlowView: View {
         }
     }
 
+    /// (0231) Sibling paint order for the cover-flow: the centered
+    /// card paints above its neighbours. This must sit on the
+    /// LazyHStack child (the card's frame) — the zIndex that used to
+    /// sit on the rotated stack inside the card only ordered views
+    /// within that card and did nothing for the siblings.
+    private func cardZIndex(_ item: DeckItem) -> Double {
+        let center = items.firstIndex(where: { $0.id == (centeredId ?? effectiveSelectedId) }) ?? 0
+        let idx = items.firstIndex(where: { $0.id == item.id }) ?? 0
+        return Double(200 - abs(idx - center) * 10)
+    }
+
