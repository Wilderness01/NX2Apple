+            // (.scrollPosition + detent behavior). The pitch is at
+            // least a card wide plus a gap (0229): the old
+            // clamp(width/6.4, 74, 112) put adjacent centers closer
+            // than the card width, so the neighbors covered the
+            // centered cartridge's edges and it could not be tapped.
+            // Widening the pitch was not enough (0231, device report
+            // 2026-11-21: tapping the middle card still selected the
+            // right one): the tap lived on a Button inside the
+            // 3D-rotated stack, so its hit area followed the rotation
+            // and perspective — the neighbors' near edges swing
+            // forward and their spine/side planes stick out past
+            // their frames — and the zIndex on the inner stack cannot
+            // order the GeometryReader siblings, so the right card
+            // wins any overlap. The tap now lives on an overlay over
+            // the card's untransformed frame (see cartridgeCard), and
+            // the zIndex sits on the LazyHStack child, so a tap can
+            // only ever land on the card whose frame contains it.
+            // The padding centers the first and last cards.
             GeometryReader { outer in
                 let pitch = max(cardWidth + 16 * u, outer.size.width / 4.5)
+                let startX = max(cardWidth / 2, outer.size.width / 2)
+                let centeredIndex = items.firstIndex(where: { $0.id == (centeredId ?? effectiveSelectedId) }) ?? 0
                 ScrollView(.horizontal, showsIndicators: false) {
                     LazyHStack(spacing: pitch - cardWidth) {
                         ForEach(Array(items.enumerated()), id: \.element.id) { index, item in
                             cartridgeCard(item, index: index, centerX: outer.size.width / 2, pitch: pitch)
                                 .id(item.id)
+                                .zIndex(cardZIndex(item))
                         }
                     }
                     .scrollTargetLayout()
                     .padding(.horizontal, max(0, outer.size.width / 2 - cardWidth / 2))
                 }
                 .scrollPosition(id: $centeredId, anchor: .center)
-                .scrollTargetBehavior(.viewAligned)
+                .scrollTargetBehavior(DmCartridgeDetentBehavior(pitch: pitch, cardWidth: cardWidth, itemCount: items.count, startX: startX, centeredIndex: centeredIndex))
+                .sensoryFeedback(.selection, trigger: centeredId)
                 .coordinateSpace(name: "cartridgeflow")
                 .onAppear { centeredId = effectiveSelectedId }
             }
@@ -769,26 +822,38 @@ private struct CartridgeCoverFlowView: View {
             let angle = max(-68, min(68, d * 50))
             let shrink = max(0.6, 1 - abs(d) * 0.145)
             let fade: CGFloat = abs(d) <= 2.7 ? 1 : max(0, 1 - (abs(d) - 2.7) * 0.75)
-            VStack(spacing: 5 * u) {
-                Button {
-                    tap(item)
-                } label: {
+            // (0231) The tap target is the card's frame, not the
+            // rotated Button: the visual stack (tilt, shrink, lid,
+            // spine/side planes) is hit-dead, and a clear overlay
+            // over the frame owns every tap. The overlay is a sibling
+            // of the rotated stack, so it is never transformed; the
+            // frames tile without overlap (pitch >= cardWidth + 16u),
+            // so a tap can only land on the card whose frame holds
+            // it — no neighbor can steal the middle card's taps any
+            // more. The |d| gate keeps near-invisible far cards
+            // untappable, as before.
+            ZStack {
+                VStack(spacing: 5 * u) {
                     cartridgeBox(item, index: index, isOpen: isOpen)
+                    // Reflection: a flipped copy of the front face, faded
+                    // and darkened; only near the center, so 52 cards do
+                    // not all render twice (LazyHStack already drops far
+                    // cards from the hierarchy).
+                    if abs(d) <= 3 {
+                        dmCartridgeReflection(item, index: index, d: d)
+                    }
                 }
-                .buttonStyle(.plain)
-                // Reflection: a flipped copy of the front face, faded
-                // and darkened; only near the center, so 52 cards do
-                // not all render twice (LazyHStack already drops far
-                // cards from the hierarchy).
-                if abs(d) <= 3 {
-                    dmCartridgeReflection(item, index: index, d: d)
-                }
+                .rotation3DEffect(.degrees(angle), axis: (x: 0, y: 1, z: 0), perspective: 0.85)
+                .scaleEffect(shrink)
+                .opacity(fade)
+                .allowsHitTesting(false)
+                Color.clear
+                    .frame(width: cardWidth, height: flowHeight)
+                    .contentShape(Rectangle())
+                    .onTapGesture {
+                        if abs(d) <= 3.6 { tap(item) }
+                    }
             }
-            .rotation3DEffect(.degrees(angle), axis: (x: 0, y: 1, z: 0), perspective: 0.85)
-            .scaleEffect(shrink)
-            .opacity(fade)
-            .zIndex(Double(200 - Int(round(abs(d) * 10)) + (isOpen ? 50 : 0)))
-            .allowsHitTesting(abs(d) <= 3.6)
         }
         .frame(width: cardWidth, height: flowHeight)
     }
