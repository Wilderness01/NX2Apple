+// A polygon in the mockup's 0-100 viewBox coordinates, scaled into the frame
+// (the compass needle's two triangles).
+private struct UnitPolygon: Shape {
+    let points: [CGPoint]
+    func path(in rect: CGRect) -> Path {
+        let sc = min(rect.width, rect.height) / 100
+        let ox = rect.midX - 50 * sc, oy = rect.midY - 50 * sc
+        var p = Path()
+        for (i, pt) in points.enumerated() {
+            let q = CGPoint(x: ox + pt.x * sc, y: oy + pt.y * sc)
+            if i == 0 { p.move(to: q) } else { p.addLine(to: q) }
+        }
+        p.closeSubpath()
+        return p
+    }
+}
+
+// The heart (mockup SVG path, 100x100 viewBox -- copied verbatim):
+// M50 79 C36 68 25 57 25 44 C25 34 32 28 39.5 28 C45 28 49 31 50 36
+// C51 31 55 28 60.5 28 C68 28 75 34 75 44 C75 57 64 68 50 79 Z
+private struct HeartShape: Shape {
+    func path(in rect: CGRect) -> Path {
+        let sc = min(rect.width, rect.height) / 100
+        let ox = rect.midX - 50 * sc, oy = rect.midY - 50 * sc
+        func pt(_ x: CGFloat, _ y: CGFloat) -> CGPoint { CGPoint(x: ox + x * sc, y: oy + y * sc) }
+        var p = Path()
+        p.move(to: pt(50, 79))
+        p.addCurve(to: pt(25, 44), control1: pt(36, 68), control2: pt(25, 57))
+        p.addCurve(to: pt(39.5, 28), control1: pt(25, 34), control2: pt(32, 28))
+        p.addCurve(to: pt(50, 36), control1: pt(45, 28), control2: pt(49, 31))
+        p.addCurve(to: pt(60.5, 28), control1: pt(51, 31), control2: pt(55, 28))
+        p.addCurve(to: pt(75, 44), control1: pt(68, 28), control2: pt(75, 34))
+        p.addCurve(to: pt(50, 79), control1: pt(75, 57), control2: pt(64, 68))
+        p.closeSubpath()
+        return p
+    }
+}
