-// Scale orig about the pane's centre, then move by (dx, dy) in layout units,
-// into mod. sx scales the x row, sy the y row (a HUD widget passes
-// sx == sy == k). The centre is the pane's middle passed through its own
-// matrix. The middle is found from the pane's origin (the byte at +0x5b,
-// confirmed by disassembly of the local matrix helper at main+0x9096d0: bits
-// 4-5 the horizontal origin, 1 left, 2 right; bits 6-7 the vertical origin,
-// 1 top, 2 bottom; 0 is the centre either way) and its size at +0x50 /
-// +0x54: the centre is the origin plus half the size towards the middle
-// (the layout is y-up, the origin at the parent's centre, so a top origin's
-// centre is half the height below it, a left origin's half the width to its
-// right). A pane with no usable size scales about its translation (its
-// origin), which is the same thing for a point-sized pane. The third row
-// (depth) is left alone: this is a 2D widget, and scaling its depth would
-// change its draw order. (From the old hud_calc.c, unchanged.)
-static inline __attribute__((always_inline)) void hud_edge_xform(const float *orig, float *mod, float dx, float dy,
-                      float sx, float sy, float w, float h, unsigned char origin) {
-    float cx, cy;
+// The centre of a pane, in global layout units: its origin plus half its
+// size towards the middle (the layout is y-up, the origin at the parent's
+// centre, so a top origin's centre is half the height below it, a left
+// origin's half the width to its right). A pane with no usable size is
+// centred on its translation. The origin byte is at +0x5b (confirmed by
+// disassembly of the local matrix helper at main+0x9096d0: bits 4-5 the
+// horizontal origin, 1 left, 2 right; bits 6-7 the vertical origin, 1 top,
+// 2 bottom; 0 is the centre either way); the size is at +0x50 / +0x54.
+static inline __attribute__((always_inline)) void hud_edge_centre(const float *m, float w, float h,
+                      unsigned char origin, float *cx, float *cy) {
     if (w > 0.0f && w < 100000.0f && h > 0.0f && h < 100000.0f) {
         float ox = ((origin >> 4) & 3) == 1 ? w * 0.5f : ((origin >> 4) & 3) == 2 ? -w * 0.5f : 0.0f;
         float oy = ((origin >> 6) & 3) == 1 ? -h * 0.5f : ((origin >> 6) & 3) == 2 ? h * 0.5f : 0.0f;
-        cx = orig[0] * ox + orig[1] * oy + orig[3];
-        cy = orig[4] * ox + orig[5] * oy + orig[7];
+        *cx = m[0] * ox + m[1] * oy + m[3];
+        *cy = m[4] * ox + m[5] * oy + m[7];
     } else {
-        cx = orig[3];
-        cy = orig[7];
+        *cx = m[3];
+        *cy = m[7];
     }
+}
+
+// Scale orig about the given centre (cx, cy), then move by (dx, dy) in
+// layout units, into mod. sx scales the x row, sy the y row (a HUD widget
+// passes sx == sy == k). The third row (depth) is left alone: this is a 2D
+// widget, and scaling its depth would change its draw order. (From the old
+// hud_calc.c, unchanged.)
+static inline __attribute__((always_inline)) void hud_edge_xform_c(const float *orig, float *mod, float dx, float dy,
+                      float sx, float sy, float cx, float cy) {
     for (int i = 0; i < 3; i++) { mod[i] = orig[i] * sx; mod[4 + i] = orig[4 + i] * sy; }
     mod[3] = cx + (orig[3] - cx) * sx + dx;
     mod[7] = cy + (orig[7] - cy) * sy + dy;
     for (int i = 8; i < 12; i++) mod[i] = orig[i];
 }
 
+// Scale orig about the pane's own centre, then move by (dx, dy).
+static inline __attribute__((always_inline)) void hud_edge_xform(const float *orig, float *mod, float dx, float dy,
+                      float sx, float sy, float w, float h, unsigned char origin) {
+    float cx, cy;
+    hud_edge_centre(orig, w, h, origin, &cx, &cy);
+    hud_edge_xform_c(orig, mod, dx, dy, sx, sy, cx, cy);
+}
+
+// Find the table entry for a pane (a linear scan over the whole table: 40
+// entries, no pointer chasing). Returns 0 when the pane has no entry (it
+// was never matched, or its slot was reclaimed).
+static inline __attribute__((always_inline)) char *hud_edge_find_entry(void *table, void *pane) {
+    for (int i = 0; i < HUD_EDGE_N * HUD_EDGE_SLOTS_PER_ELEM; i++) {
+        char *e = (char *)table + i * HUD_EDGE_ENTRY;
+        if (*(u32 *)(e + 124) != 0 && *(uintptr_t *)(e + 0) == (uintptr_t)pane) return e;
+    }
+    return 0;
+}
+
+// Undo a matched parent's applied transform from a child's current global
+// matrix, giving the child's UNMODIFIED global matrix in out. The parent's
+// applied (dx_m, dy_m, k_m) come from the parent's table entry (its stored
+// applied transform, +104/+108/+112); the parent's centre C comes from the
+// parent's stored ORIGINAL matrix (the parent's entry +8) and the parent
+// pane's size/origin -- C is the centre the parent's own transform scaled
+// about, i.e. in the unmodified frame, so the undo is:
+//     out = S_C(1/k_m) * T(-dx_m,-dy_m) * g
+// (a translate, then a scale about C; when k_m == 1 the scale is skipped --
+// it is the identity -- so the undo is exact, with no rounding at all).
+// A HIDDEN parent is undone too: its stored dx/dy/k are (0,0,1) but its
+// matrix was pushed +10000 off-screen, so the undo also translates by
+// -HUD_HIDE_DX (a hidden parent is never the identity, whatever its stored
+// dx/dy/k say).
+// Returns 1 when a non-identity parent transform was undone, 0 when there
+// is nothing to undo (no parent entry, the parent's stored transform is
+// stale, or the parent applied the identity): out is then just g.
+// The parent's applied transform is also written to *pm_dx / *pm_dy / *pm_k
+// (the identity when there is no parent entry), and whether the parent is
+// hidden to *pm_hidden, so the caller can tell whether the child wants
+// exactly its parent's transform. The stored transform is stale when the
+// entry was only just created (the 1e30f sentinel in e_dx: the entry exists
+// but no transform has been applied through it yet) or when k_m is not a
+// usable number.
+static inline __attribute__((always_inline)) int hud_edge_unparent(void *pane, const float *g, void *table,
+                      float *out, float *pm_dx, float *pm_dy, float *pm_k, int *pm_hidden) {
+    for (int i = 0; i < 12; i++) out[i] = g[i];
+    *pm_dx = 0.0f; *pm_dy = 0.0f; *pm_k = 1.0f; *pm_hidden = 0;
+    void *parent = *(void **)((const char *)pane + 0x18);
+    if (!parent || ((uintptr_t)parent & 7u)) return 0;
+    char *pe = hud_edge_find_entry(table, parent);
+    if (!pe) return 0;
+    float dx_m = *(const float *)(pe + 104);
+    float dy_m = *(const float *)(pe + 108);
+    float k_m = *(const float *)(pe + 112);
+    if (dx_m == 1e30f) return 0;   // the parent's entry is fresh: no transform applied yet
+    if (k_m == 0.0f || k_m != k_m) return 0;
+    *pm_dx = dx_m; *pm_dy = dy_m; *pm_k = k_m;
+    *pm_hidden = *(const u32 *)(pe + 116) != 0;
+    if (!*pm_hidden && dx_m == 0.0f && dy_m == 0.0f && k_m == 1.0f) return 0;   // identity: nothing to undo
+    // Translate out by (-dx_m, -dy_m) (the rows are untouched: a pure
+    // translation left-multiplied onto the matrix only moves its translation).
+    out[3] -= dx_m;
+    out[7] -= dy_m;
+    // A hidden parent was pushed off-screen on top of its (identity) stored
+    // transform: undo that too, so the child's original is its own layout
+    // position and hiding the parent does not hide the child.
+    if (*pm_hidden) out[3] -= HUD_HIDE_DX;
+    if (k_m != 1.0f) {
+        // Scale about the parent's (unmodified) centre C by 1/k_m.
+        float pw = *(const float *)((const char *)parent + 0x50);
+        float ph = *(const float *)((const char *)parent + 0x54);
+        unsigned char porigin = *(const unsigned char *)((const char *)parent + 0x5b);
+        float cx, cy;
+        hud_edge_centre((const float *)(pe + 8), pw, ph, porigin, &cx, &cy);
+        float s = 1.0f / k_m;
+        float tmp[12];
+        hud_edge_xform_c(out, tmp, 0.0f, 0.0f, s, s, cx, cy);
+        for (int i = 0; i < 12; i++) out[i] = tmp[i];
+    }
+    return 1;
+}
