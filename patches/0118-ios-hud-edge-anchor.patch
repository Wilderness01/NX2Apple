From 3f2a0a7dfda79908dff292e503d0a96e67ca9901 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Thu, 12 Nov 2026 11:10:53 +0000
Subject: [PATCH] 0118 (V1.3.14): HUD edge anchor -- the four HUD widgets move
 to the screen edges from the aspect

Automatic, no user input, no settings UI. Pane::Calculate is hooked twice
(entry + 0x13c) and hud_edge translates the four HUD elements by a fixed
signed horizontal offset from the screen aspect (loader.c state + 0x58):
edge = 640 * (aspect / 1.7777778 - 1), clamped to [-200, +200] UI px.
iPhone 19.5:9 (+140: coins/moons left, compass/lives right), iPhone Duo
1.43:1 (-126, pulled in), iPad 4:3 (-160, pulled in), 16:9 (0, no-op).
Matched by pane name only; the only tree walk is the bounded flag-only
mark-dirty, so the 0113 crash class is structurally absent. Replaces the
cancelled draggable HUD (0113).
---
 dm/games/0100000000010000/hud_edge.c | 302 +++++++++++++++++++++++++++
 dm/games/0100000000010000/patches.py | 133 ++++++++++++
 2 files changed, 435 insertions(+)
 create mode 100644 dm/games/0100000000010000/hud_edge.c
 create mode 100644 dm/games/0100000000010000/patches.py

diff --git a/dm/games/0100000000010000/hud_edge.c b/dm/games/0100000000010000/hud_edge.c
new file mode 100644
index 0000000..e1a0e5b
--- /dev/null
+++ b/dm/games/0100000000010000/hud_edge.c
@@ -0,0 +1,302 @@
+// hud_edge.c -- Super Mario Odyssey HUD edge anchor (0118).
+//
+// The game's HUD (coins, moons, compass, lives) is laid out for a 1280x720
+// (16:9) screen, so on a wider screen (iPhone 19.5:9) it sits inset from the
+// edges, and on a narrower screen (iPhone Duo 1.43:1, iPad 4:3) it would be
+// cut off at the edges. This hook pushes the HUD to the screen edges,
+// automatically adapting to the screen aspect: the left widgets (coins, moons)
+// move left on a wider screen and right on a narrower one; the right widgets
+// (compass, lives) move right on a wider screen and left on a narrower one.
+//
+// The offset comes from the screen aspect the host already writes into the
+// frame-step state page (loader.c dm_fps_state_apply, state +0x58: the ratio
+// r; the iOS front end resolves DM_SCREEN_ASPECT "auto" to the window's aspect
+// before the host writes the state page, so r is the resolved aspect by the
+// time the game runs; 0 means 16:9). The offset is:
+//     edge = 640 * (r / 1.7777778 - 1)
+// iPhone 19.5:9 (r=2.167): +140 per side (push out). iPhone Duo 1.43:1
+// (r=1.429): -126 per side (pull in). iPad 4:3 (r=1.333): -160 per side
+// (pull in). 16:9 (r=0): 0. The sign is uniform: a left widget takes
+// dx = -edge, a right widget dx = +edge, so a wider screen pushes both
+// outward and a narrower screen pulls both inward. No user setting, no drag,
+// no resize, no settings UI.
+//
+// The hook runs from the same two rewriter cuts as the old 0113
+// (Pane::Calculate main+0x909494: the entry cut at +0x20 and the +0x13c cut
+// at +0x13c), because one cut misses static panes (see the old hud_calc.c
+// header: the skip path over the +0x13c site). It matches the four HUD
+// widgets by pane name only -- no subtree walk, no tree search, no
+// guide/root classification, no camera widening, no log. The only walk is the
+// dirty-mark for a moved container's children (hud_edge_mark_dirty), which
+// only sets a flag and uses the v8 single struct-array (no second base
+// register, so the log-27 sdepth/x18 fault class is structurally absent);
+// it never reads a pane name and never decides a match.
+//
+// A moved pane's original matrix is stored in a small table (state +0x300,
+// eight 120-byte entries, two per element -- two layout instances can match
+// the same element) and the modified matrix is always re-derived from that
+// original, so a fixed offset never accumulates into a drift, and a game
+// recompute (an animation, a count change, a layout reload) is followed by
+// re-storing the original. The offset itself is also stored per entry, so an
+// aspect change re-applies instead of being ignored.
+//
+// What this patch does NOT do (deliberately): no HUD settings UI, no
+// user-set entry point, no user-saved offsets, no drag/resize, no map-camera widen, no
+// settings/map code, no guide-text hiding, no root stretch. The camera icon
+// in the top-right is NOT a HUD element -- it is the photo button (a
+// virtual pad button, positioned by DmGamepad), so it is never matched.
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-asynchronous-unwind-tables -c
+// (same flags as the old hud_calc.c). The function takes everything through
+// its arguments -- no static data, no literal pool, no external calls -- so
+// the emitted words are position-independent and relocation-free and can be
+// dropped into the rewriter's patch area verbatim:
+//   x0 = the pane (nn::ui2d::Pane *), x1 = the aspect (state + 0x58: a float,
+//   the screen's width / height; 0 = 16:9), x2 = the edge table (state +
+//   0x300: eight 120-byte entries, two per HUD element).
+//   Element order: 0 compass (right), 1 lives (right), 2 coins (left),
+//   3 moons (left). The state page starts zeroed, so a table entry with
+//   pane == 0 is unused.
+
+typedef unsigned int u32;
+typedef unsigned long uintptr_t;
+
+#define HUD_EDGE_N 4
+#define HUD_EDGE_ENTRY 120         // bytes per table entry
+#define HUD_EDGE_SLOTS_PER_ELEM 2  // table slots per HUD element: two layout instances can match the same element
+
+// The pane names, as little-endian u32s (no string literal: a literal would
+// sit in .rodata and the code would load its address with an adrp, a
+// relocation, and the embedded words carry no literal pool).
+// "PicStrap": "PicS", "trap" (8 letters, the 9th byte is the NUL).
+#define HUD_E_STRAP0 0x53636950u
+#define HUD_E_STRAP1 0x70617274u
+// "Counter": "Coun", "ter\0".
+#define HUD_E_COUNTER0 0x6e756f43u
+#define HUD_E_COUNTER1 0x00726574u
+// "TxtTotalShine": "TxtT", "otal", "Shin", "e\0".
+#define HUD_E_TSHINE0 0x54747854u
+#define HUD_E_TSHINE1 0x6c61746fu
+#define HUD_E_TSHINE2 0x6e696853u
+#define HUD_E_TSHINE3 0x00000065u
+// "TxtCounterSh": "TxtC", "ount", "erSh", 0 (12 bytes, the fourth word is the NUL word).
+#define HUD_E_TCSH0 0x43747854u
+#define HUD_E_TCSH1 0x746e756fu
+#define HUD_E_TCSH2 0x68537265u
+#define HUD_E_TCSH3 0x00000000u
+// "TxtCounter": "TxtC", "ount", "er\0".
+#define HUD_E_TC0 0x43747854u
+#define HUD_E_TC1 0x746e756fu
+#define HUD_E_TC2 0x00007265u
+// "TxtLife": "TxtL", "ife\0".
+#define HUD_E_TLIFE0 0x4c747854u
+#define HUD_E_TLIFE1 0x00656669u
+// "Life" ("Life" as one word; the 5th byte is the NUL).
+#define HUD_E_LIFE0 0x6566694cu
+
+// Bounded compare of a pane name's words against the given words (n words,
+// the rest of the name unchecked). Same as the old hud_words_eq.
+static inline __attribute__((always_inline)) int hud_edge_words_eq(const u32 *nw, u32 a, u32 b, u32 c, u32 d, int n) {
+    if (n >= 1 && nw[0] != a) return 0;
+    if (n >= 2 && nw[1] != b) return 0;
+    if (n >= 3 && nw[2] != c) return 0;
+    if (n >= 4 && nw[3] != d) return 0;
+    return 1;
+}
+
+// The guards every subtree walk below applies (same as the old v7 guards,
+// because a layout's child list can go stale while the game unloads it):
+//  (a) a popped pane is checked for NULL / alignment before it is read;
+//  (b) a list node is checked (non-NULL, 8-byte aligned, >= 0x10000) before
+//      child = node - 8 is computed from it;
+//  (c) a child that is the pane itself, or lies inside the pane's own
+//      first 0x100 bytes, is never treated as a pane.
+static inline __attribute__((always_inline)) int hud_edge_node_ok(void *node) {
+    uintptr_t v = (uintptr_t)node;
+    return v != 0 && (v & 7u) == 0 && v >= 0x10000;
+}
+
+static inline __attribute__((always_inline)) int hud_edge_child_self(void *p, void *child) {
+    if (child == p) return 1;
+    if ((uintptr_t)child <= (uintptr_t)p) return 0;
+    return (uintptr_t)child - (uintptr_t)p < 0x100;
+}
+
+// The DFS stack: ONE array of {pane, depth} entries (the v8 fix for the
+// log-27 crash: the old v7 kept two parallel arrays, and the second array's
+// separate base register was the faulting access). Co-locating pane and depth
+// in one entry leaves a single array base, so there is no second base
+// register to lose.
+typedef struct { void *pane; unsigned char depth; } hud_edge_stack_ent;
+
+// Mark every descendant of a pane dirty (flags bit 4 at +0x58), so the game
+// recomputes their global matrices from this pane's (just-modified) matrix.
+// This is the ONLY subtree walk in this patch, and it only sets a flag: it
+// never reads a pane name and never decides a match. The parent-changed flag
+// the game passes to children is 0 on the skip path, so without this a static
+// container's children never recompute and never follow it. The flag is the
+// game's own signal (Pane::Calculate sets it when a parent changed and
+// clears it on recompute), so the game's next Calculate on each descendant
+// recomputes from the moved parent. Bounded (64 visits, 32 children per
+// pane, depth 3); the pane itself is never marked (marking it would make
+// the game recompute and wipe the hook's edit). Only called when the hook
+// actually writes a new matrix, never on the already-correct early return.
+static inline __attribute__((always_inline)) void hud_edge_mark_dirty(void *pane) {
+    if (!pane) return;
+    hud_edge_stack_ent st[64];
+    int sp = 0, visits = 0;
+    st[sp].pane = pane;
+    st[sp].depth = 3;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = st[sp].pane;
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (a) never read a popped NULL / unaligned pane
+        unsigned char depth = st[sp].depth;
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_edge_node_ok(node)) break;     // (b) never follow a bad node
+            void *child = (char *)node - 8;
+            if (hud_edge_child_self(p, child)) { node = *(void **)((const char *)child + 0x10); continue; } // (c) skip the self child, keep its siblings
+            visits++;
+            *(unsigned short *)((char *)child + 0x58) |= 0x10u;   // flags bit 4: dirty, recompute from the parent
+            if (depth > 0 && sp < 64) {
+                st[sp].pane = child;
+                st[sp].depth = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+}
+
+// Is the given pane's parent named by these words (exact, n words)? The
+// parent is read once, directly -- no walk. A NULL parent is never the
+// container, so a parentless pane takes the fallback.
+static inline __attribute__((always_inline)) int hud_edge_parent_is(void *pane, u32 a, u32 b, int n) {
+    void *parent = *(void **)((const char *)pane + 0x18);
+    if (!parent) return 0;
+    const u32 *pnw = (const u32 *)((const char *)parent + 0xb8);
+    if (n >= 1 && pnw[0] != a) return 0;
+    if (n >= 2 && pnw[1] != b) return 0;
+    return 1;
+}
+
+void hud_edge(void *pane, const float *aspect_ptr, void *table) {
+    if (!pane || !aspect_ptr || !table) return;
+    // The edge offset, from the screen aspect the host wrote into the state
+    // page (state +0x58; 0 = 16:9, unwritten). Valid aspects are 1.3 to 2.2
+    // (the range loader.c accepts); anything else is 16:9. The offset is
+    // clamped so a wild aspect can never throw a widget off the screen.
+    float aspect = *aspect_ptr;
+    float edge = 0.0f;
+    if (aspect >= 1.3f && aspect <= 2.2f) {
+        edge = 640.0f * (aspect / 1.7777778f - 1.0f);
+        if (edge > 200.0f) edge = 200.0f;
+        if (edge < -200.0f) edge = -200.0f;
+    }
+    if (edge == 0.0f) return;   // 16:9, or an unwritten aspect: nothing to do
+
+    // Flags bit 7 is set by Pane::Calculate's epilogue, so it tells whether
+    // this pane has ever calculated. On a pane's very first frame its matrix
+    // is still zero; skip it (the +0x13c cut catches it after the game
+    // computes it, and the entry cut catches it from the next frame on).
+    unsigned short pflags = *(const unsigned short *)((const char *)pane + 0x58);
+    if (!(pflags & 0x80u)) return;
+
+    const char *name = (const char *)pane + 0xb8;
+    const u32 *nw = (const u32 *)name;
+
+    // Which HUD element is this pane, by name only (no subtree walk).
+    // Moons: the counter group itself, a pane named 'Counter'; a bare
+    // 'TxtTotalShine' is the fallback for a layout with no 'Counter' group,
+    // and only when its parent is not a 'Counter' (the group's own number
+    // follows the group; matching both would move it twice). Life: the
+    // 'Life' container, or a bare 'TxtLife' whose parent is NOT named
+    // 'Life'. Coins: 'TxtCounterSh' and its sibling 'TxtCounter', both
+    // matched by name, so both take the same offset and no twin-write walk
+    // is needed. Compass: 'PicStrap', the right strip (the dial itself is
+    // not a Pane, so the strip is the compass; moving the strip moves the
+    // whole right-hand cluster together). The old v1 actor names
+    // (CompassArea / CoinCounter / MoonNum) are NOT matched: they are actor
+    // / state-machine names, not pane names, and matching them never fired.
+    int idx = -1;
+    if (nw[0] == HUD_E_STRAP0 && nw[1] == HUD_E_STRAP1 && name[8] == 0) idx = 0;
+    else if (nw[0] == HUD_E_LIFE0 && name[4] == 0) idx = 1;
+    else if (hud_edge_words_eq(nw, HUD_E_TLIFE0, HUD_E_TLIFE1, 0, 0, 2)) {
+        if (!hud_edge_parent_is(pane, HUD_E_LIFE0, 0, 1)) idx = 1;
+    }
+    else if (hud_edge_words_eq(nw, HUD_E_TCSH0, HUD_E_TCSH1, HUD_E_TCSH2, HUD_E_TCSH3, 4)) idx = 2;
+    else if (hud_edge_words_eq(nw, HUD_E_TC0, HUD_E_TC1, HUD_E_TC2, 0, 3)) idx = 2;
+    else if (hud_edge_words_eq(nw, HUD_E_COUNTER0, HUD_E_COUNTER1, 0, 0, 2)) idx = 3;
+    else if (hud_edge_words_eq(nw, HUD_E_TSHINE0, HUD_E_TSHINE1, HUD_E_TSHINE2, HUD_E_TSHINE3, 4)) {
+        if (!hud_edge_parent_is(pane, HUD_E_COUNTER0, HUD_E_COUNTER1, 2)) idx = 3;
+    }
+    if (idx < 0) return;   // not a HUD element: leave it alone
+
+    // Left widgets (coins, moons) take dx = -edge; right widgets (compass,
+    // lives) take dx = +edge. A wider screen (edge > 0) pushes both outward
+    // to the edges; a narrower screen (edge < 0) pulls both inward so they
+    // stay visible and at the edges. dy is always 0 and the scale is always
+    // 1: this patch only translates, never resizes.
+    float dx = (idx <= 1) ? edge : -edge;
+
+    // The per-element entry: the pane, its original matrix (as the game
+    // computed it), the modified matrix (the original + this translation),
+    // and the offset the modified matrix was computed from. Two slots per
+    // element (idx and idx + HUD_EDGE_N): two layout instances can match the
+    // same element, and one slot per element cannot hold both.
+    char *ent = 0;
+    for (int s = 0; s < HUD_EDGE_SLOTS_PER_ELEM; s++) {
+        char *e = (char *)table + (idx + s * HUD_EDGE_N) * HUD_EDGE_ENTRY;
+        if (*(uintptr_t *)(e + 0) == (uintptr_t)pane) { ent = e; break; }
+        if (!ent && *(u32 *)(e + 112) == 0) ent = e;   // first free slot
+    }
+    if (!ent) ent = (char *)table + idx * HUD_EDGE_ENTRY;   // both taken: reclaim the first (a reload)
+    uintptr_t *e_pane = (uintptr_t *)(ent + 0);
+    float *e_orig = (float *)(ent + 8);
+    float *e_mod = (float *)(ent + 56);
+    float *e_dx = (float *)(ent + 104);
+    if (*e_pane != (uintptr_t)pane) {   // first sighting, or the layout reloaded
+        *e_pane = (uintptr_t)pane;
+        *(u32 *)(ent + 108) = (u32)idx;
+        *(u32 *)(ent + 112) = 1u;
+        *e_dx = 1e30f;   // sentinel: force a recompute below (the stored offset is stale)
+        for (int i = 0; i < 12; i++) { e_orig[i] = 0.0f; e_mod[i] = 0.0f; }
+    }
+
+    // Did the game recompute the matrix since the last frame? Compare the
+    // current matrix against the stored modified one: if they differ, the
+    // game wrote a new original (an animation, a count change, a layout
+    // reload), so the stored original follows it. If they are the same, the
+    // game left our modified matrix alone, and only an offset change needs
+    // a recompute.
+    const float *g = (const float *)pane + 0x70 / 4;
+    int recomputed = 0;
+    {
+        const u32 *cur = (const u32 *)g;
+        u32 *mod = (u32 *)e_mod;
+        for (int i = 0; i < 12; i++) if (cur[i] != mod[i]) { recomputed = 1; break; }
+    }
+    if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g[i];
+    if (!recomputed && *e_dx == dx) return;   // already correct: nothing to do
+
+    // The modified matrix is the original plus this translation (scale 1, so
+    // the origin/pivot does not matter: a pure translation adds to the
+    // translation slots only). Never accumulated: it is always re-derived
+    // from the stored original, so a fixed offset cannot drift.
+    for (int i = 0; i < 12; i++) e_mod[i] = e_orig[i];
+    e_mod[3] += dx;
+    *e_dx = dx;
+
+    // Write the modified matrix back to the pane. Its children are
+    // calculated after this hook, so they inherit the moved parent -- but
+    // only if the game recomputes them: mark the descendants dirty and the
+    // game recomputes them from this modified matrix on the same frame.
+    float *dst = (float *)pane + 0x70 / 4;
+    for (int i = 0; i < 12; i++) dst[i] = e_mod[i];
+    hud_edge_mark_dirty(pane);
+}
