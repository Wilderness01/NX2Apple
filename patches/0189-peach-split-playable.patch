diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index 97067e9..450ddef 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -890,7 +890,7 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
         LOG("[char] fs %s kept (sel=%s)", p, sel ? sel : "(unset)");
         return 0;
     }
-    const char *ch = !strcmp(sel, "luigi") ? "Luigi" : !strcmp(sel, "wario") ? "Wario" : NULL;
+    const char *ch = !strcmp(sel, "luigi") ? "Luigi" : !strcmp(sel, "wario") ? "Wario" : !strcmp(sel, "peach") ? "Peach" : NULL;
     if (!ch) {
         LOG("[char] fs %s kept (sel=%s: unknown character)", p, sel);
         return 0;
diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index d91308a..ed1f45e 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -408,6 +408,7 @@ private struct CharacterPickerView: View {
         CharEntry(id: "mario", name: "\u{9a6c}\u{91cc}\u{5965}", image: "char_mario"),
         CharEntry(id: "luigi", name: "\u{8def}\u{6613}\u{5409}", image: "char_luigi"),
         CharEntry(id: "wario", name: "\u{74e6}\u{91cc}\u{5965}", image: "char_wario"),
+        CharEntry(id: "peach", name: "\u{6843}\u{82b1}", image: "char_peach"),
     ]
 
     private var current: CharEntry { roster.first(where: { $0.id == selected }) ?? roster[0] }
