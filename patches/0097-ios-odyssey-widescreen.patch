+++ b/dm/host/loader.c
@@ -311,14 +311,17 @@ void dm_fps_state_apply(void) {
     const char *rs = getenv("DM_RENDER_SCALE"); float sc = 1.0f;
     if (rs) { char *end; sc = strtof(rs, &end); if (end == rs || *end || !(sc >= 0.5f && sc <= 1.0f)) { LOG("[RED] DM_RENDER_SCALE=%s: must be 0.5 to 1.0; keeping the game's size", rs); sc = 1.0f; } else LOG("%s: 3D views rendered at %.2f of the game's size (DM_RENDER_SCALE)", g_fps_mod, sc); }
     memcpy(dm_fps_state + 0x10, &sc, sizeof sc);
-    // Screen shape: DM_SCREEN_ASPECT, the screen's width / height between 1.3 and 1.77, makes the builds with screen-shape stubs
-    // (Breath of the Wild 1.9.0's patches.py) render that shape: the output keeps its width (1920) and takes the height that gives the ratio, a multiple of 48 so the
-    // 2/3-size layout space (1280 wide) stays whole: 1.43 → 1920x1344 and 1280x896. State +0x48 u32 output height, +0x4c u32 layout height, +0x50 its float; 0 = 16:9
+    // Screen shape: DM_SCREEN_ASPECT, the screen's width / height between 1.3 and 2.2, makes the builds with screen-shape stubs
+    // (Breath of the Wild 1.9.0's patches.py, Super Mario Odyssey's) render that shape. A taller screen (1.3 to 1.77): the output keeps its width (1920)
+    // and takes the height that gives the ratio, a multiple of 48 so the 2/3-size layout space (1280 wide) stays whole: 1.43 → 1920x1344 and 1280x896.
+    // State +0x48 u32 output height, +0x4c u32 layout height, +0x50 its float; 0 = 16:9. A wider screen (1.78 to 2.2): the output keeps its height (1080)
+    // and takes the width that gives the ratio, the layout its width the same way: 2.167 → 2340x1080 and 1560x720. State +0x40 u32 output width,
+    // +0x44 u32 layout width; 0 = 16:9
     const char *as = getenv("DM_SCREEN_ASPECT");
     if (as && *as && strcmp(as, "0") && strcmp(as, "auto")) {   // 0: 16:9; auto: the iOS front end resolves it to the screen's shape (a Mac window has none)
         char *end; float a = strtof(as, &end);
-        if (end == as || *end || !(a >= 1.3f && a < 1.77f)) LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 1.3 to 1.77; keeping 16:9", as);
-        else {
+        if (end == as || *end || !(a >= 1.3f && a <= 2.2f)) LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 1.3 to 2.2 (1.3 to 1.77 taller, 1.78 to 2.2 wider); keeping 16:9", as);
+        else if (a < 1.77f) {   // taller than 16:9: the existing body below, unchanged
             uint32_t oh = (uint32_t)(1920.0f / a / 48.0f + 0.5f) * 48, lh = oh * 2 / 3; float lf = (float)lh;
             memcpy(dm_fps_state + 0x48, &oh, 4); memcpy(dm_fps_state + 0x4c, &lh, 4); memcpy(dm_fps_state + 0x50, &lf, 4);
             extern void mtl_present_screen(uint32_t w, uint32_t h); mtl_present_screen(1920, oh);   // the picture's shape for a texture that follows it (nvn_mtl.m present_shape)
@@ -346,6 +349,34 @@ void dm_fps_state_apply(void) {
             LOG("%s: screen shape: HUD moves out by %.0f (edge %.0f, listed widgets %.0f), panes %.0fx%.0f or larger stretched %.3f", g_fps_mod, anc[0], anc[2], anc[3], anc[4], anc[5], anc[1]);
             LOG("%s: screen shape %.3f: output 1920x%u, layout 1280x%u (DM_SCREEN_ASPECT; only builds with screen-shape stubs follow it)", g_fps_mod, a, oh, lh);
         }
+        else if (a > 1.78f) {   // wider than 16:9: the output keeps its height (1080) and takes the width that gives the ratio, the layout its width
+            // the same way: 2.167 -> 2340x1080 and 1560x720. State +0x40 u32 output width, +0x44 u32 layout width; the ratio (+0x58), k (+0x5c) and the
+            // tolerance (+0x60) as for the taller screen; the HUD camera's 16:9 projection (+0x74 / +0x78 / +0x7c) as for the taller screen. The HUD at
+            // the wider edges takes its own block (+0xa0..+0xb4, mirroring +0x80..+0x98): the shift (half the layout width over 640), the stretch
+            // (layout width / 1280), the edge rule's distance, the listed corner widgets' distance, a full-screen pane's width and height in the
+            // 1280x720 space, and the widest pane still stretched. DM_SCREEN_HUD overrides the last five for trials, as for the taller screen
+            uint32_t ow = (uint32_t)(1080.0f * a + 0.5f), lw = (uint32_t)(720.0f * a + 0.5f);
+            memcpy(dm_fps_state + 0x40, &ow, 4); memcpy(dm_fps_state + 0x44, &lw, 4);
+            extern void mtl_present_screen(uint32_t w, uint32_t h); mtl_present_screen(ow, 1080);   // the picture's shape for a texture that follows it (nvn_mtl.m present_shape)
+            extern void mtl_present_layer(uint32_t w, uint32_t h); mtl_present_layer(ow, 1080);   // the present's fallback (nvn_mtl.m present_shape): the game's window texture is 1600x900, its crop 1560x720, so the texture's 16:9 does not match the screen's 2.167 and the shape falls back to the layer's; make the layer the wider output so the fallback is the wider shape, not 16:9
+            const char *ms = getenv("DM_SCREEN_ASPECT_SITES"); uint32_t mask = ms ? (uint32_t)strtoul(ms, NULL, 0) : 0xffffffffu;   // the stubs of the game's own conversions, one bit each (+0x54)
+            memcpy(dm_fps_state + 0x54, &mask, 4);
+            if (ms) LOG("%s: screen shape: conversion sites %#x (DM_SCREEN_ASPECT_SITES)", g_fps_mod, mask);
+            // The field of view: a wider view keeps the vertical angle and shows more at the sides (the stubs of Super Mario Odyssey's patches.py read the
+            // layout width, not this); k = (16/9) / ratio is below 1 here, the view is wider than 16:9, not taller
+            float r = (float)ow / 1080.0f, k = (16.0f / 9.0f) / r, tol = 0.01f;
+            const char *fo = getenv("DM_SCREEN_FOV"); if (fo && !strcmp(fo, "off")) tol = -1.0f;   // trials: the scene keeps the game's vertical angle (no view matches); the HUD camera still widens
+            memcpy(dm_fps_state + 0x58, &r, 4); memcpy(dm_fps_state + 0x5c, &k, 4); memcpy(dm_fps_state + 0x60, &tol, 4);
+            float wide = 16.0f / 9.0f, wtol = 0.001f, far = 10000.0f;   // the HUD camera's projection: 16:9, near 1, far 10000 (+0x74 / +0x78 / +0x7c)
+            memcpy(dm_fps_state + 0x74, &wide, 4); memcpy(dm_fps_state + 0x78, &wtol, 4); memcpy(dm_fps_state + 0x7c, &far, 4);
+            float anc[7] = {(float)lw / 2 - 640.0f, (float)lw / 1280.0f, 280.0f, 100.0f, 1270.0f, 710.0f, 1300.0f};
+            const char *hv = getenv("DM_SCREEN_HUD");
+            if (hv && sscanf(hv, "%f,%f,%f,%f,%f", &anc[2], &anc[3], &anc[4], &anc[5], &anc[6]) < 4) LOG("[RED] DM_SCREEN_HUD=%s: <edge>,<listed>,<full width>,<full height>[,<widest>]; keeping the rest", hv);
+            memcpy(dm_fps_state + 0xa0, anc, sizeof anc);
+            LOG("%s: screen shape: HUD moves out by %.0f (edge %.0f, listed widgets %.0f), panes %.0fx%.0f or larger stretched %.3f", g_fps_mod, anc[0], anc[2], anc[3], anc[4], anc[5], anc[1]);
+            LOG("%s: screen shape %.3f: output %ux1080, layout %ux720 (DM_SCREEN_ASPECT; only builds with screen-shape stubs follow it)", g_fps_mod, a, ow, lw);
+        }
+        // else a is 16:9 (1.77 to 1.78): the game's own shape, nothing to write
     }
     char cap[32]; snprintf(cap, sizeof cap, ", capped at %d fps", t);
     LOG("%s: frame step %s%s (%s)", g_fps_mod, !t ? "as the game sets it" : "in whole vsyncs decided by the host", t ? cap : "", e ? "DM_FPS_TARGET" : "game profile fps_target");
