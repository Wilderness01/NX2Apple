 }
+// 0153: Reset: every element back to its overlay base position (the
+// edge-aligned anchor), shown, 100%. A default element has no key and no
+// DM_HUD_* variable, so the runtime leaves it on the overlay base at once
+// (applyAll unsets every var) and the reset survives a relaunch (save
+// removes every DmHudPad.* key). The handles snap back to their anchors.
+- (void)resetAll:(UIButton *)b {
+    (void)b;
+    for (int i = 0; i < kHudPadCount; i++) { _dx[i] = 0; _dy[i] = 0; _k[i] = 1; _hidden[i] = NO; }
+    [self applyAll];
+    [self save];
+    _editSlider.value = 1;
+    [self updateEditEye];
+    [self updateHint];
+    [self layoutHandles];
+    fputs("hud editor: reset to edge-aligned base (HUD 已复位到贴边位置)\n", stderr);
+}
 
