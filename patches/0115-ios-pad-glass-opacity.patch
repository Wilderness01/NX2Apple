 // Every UIGlassEffect reference sits inside if (@available(iOS 26.0, *)): the type exists
-// only on iOS 26+, so an unguarded reference is a compile error.
+// only on iOS 26+, so an unguarded reference is a compile error. The strength is the
+// player's own setting (0115): the button settings' glass slider, 0-100%. The anchor is
+// the look as shipped (70%), 0 is no glass at all, 100 is the deepest the glass gets:
+// below the anchor the glass fades in to the shipped look, above it a white tint (real
+// glass) or deeper alphas (fallback disc) keep darkening it. The real glass fades as a
+// whole view, the fallback disc scales every alpha on it.
+static const CGFloat k_glassAnchor = 0.70;   // the slider value of the look as shipped
+static const CGFloat k_glassTintMax = 0.38;  // the white tint's alpha at 100% (real glass)
 static const CGFloat k_glassGradTop = 0.50, k_glassGradBottom = 0.26;
-static const CGFloat k_glassRimAlpha = 0.90, k_glassHiAlpha = 0.75, k_glassShadeAlpha = 0.27;
+static const CGFloat k_glassGradTopDeep = 0.72, k_glassGradBottomDeep = 0.46;   // the fallback disc at 100%
+static const CGFloat k_glassRimAlpha = 0.90, k_glassHiAlpha = 0.75, k_glassShadeAlpha = 0.27, k_glassShadowAlpha = 0.20;
+static const CGFloat k_glassRimDeep = 1.0, k_glassHiDeep = 0.90, k_glassShadeDeep = 0.45, k_glassShadowDeep = 0.30;
 static CGPathRef glassCirclePath(CGRect r) { return CGPathCreateWithEllipseInRect(r, NULL); }
 static void setGlassPath(CAShapeLayer *l, CGPathRef p) { l.path = p; CGPathRelease(p); }
 static CGPathRef glassArcPath(CGRect r, CGFloat a0, CGFloat a1) {   // an arc of the circle, inset so the stroke sits inside the rim; angles in radians, 270 is the top
@@ -296,6 +307,20 @@ static void glassDiscLayout(CAGradientLayer *disc, CGRect frame) {   // the disc
     setGlassPath((CAShapeLayer *)disc.sublayers[1], glassArcPath(b, 195 * M_PI / 180, 345 * M_PI / 180));   // the top highlight
     setGlassPath((CAShapeLayer *)disc.sublayers[2], glassArcPath(b, 15 * M_PI / 180, 165 * M_PI / 180));   // the bottom shade
 }
+static void glassDiscSetOpacity(CAGradientLayer *disc, CGFloat p) {   // the fallback disc's strength, 0-100% (0115): at the anchor it is the look as shipped; above the anchor every alpha deepens
+    CGFloat f = p <= k_glassAnchor ? p / k_glassAnchor : 1;   // the fade-in to the look as shipped
+    CGFloat t = p <= k_glassAnchor ? 0 : (p - k_glassAnchor) / (1 - k_glassAnchor);   // the deepening past the anchor
+    CGFloat gradTop = k_glassGradTop * f + (k_glassGradTopDeep - k_glassGradTop) * t;
+    CGFloat gradBottom = k_glassGradBottom * f + (k_glassGradBottomDeep - k_glassGradBottom) * t;
+    CGFloat rim = k_glassRimAlpha * f + (k_glassRimDeep - k_glassRimAlpha) * t;
+    CGFloat hi = k_glassHiAlpha * f + (k_glassHiDeep - k_glassHiAlpha) * t;
+    CGFloat shade = k_glassShadeAlpha * f + (k_glassShadeDeep - k_glassShadeAlpha) * t;
+    disc.colors = @[(id)[UIColor colorWithWhite:1 alpha:gradTop].CGColor, (id)[UIColor colorWithWhite:1 alpha:gradBottom].CGColor];
+    ((CAShapeLayer *)disc.sublayers[0]).strokeColor = [UIColor colorWithWhite:1 alpha:rim].CGColor;   // rim
+    ((CAShapeLayer *)disc.sublayers[1]).strokeColor = [UIColor colorWithWhite:1 alpha:hi].CGColor;   // top highlight
+    ((CAShapeLayer *)disc.sublayers[2]).strokeColor = [UIColor colorWithWhite:0 alpha:shade].CGColor;   // bottom shade
+    disc.shadowOpacity = (float)(k_glassShadowAlpha * f + (k_glassShadowDeep - k_glassShadowAlpha) * t);
+}
 
