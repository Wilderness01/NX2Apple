+// The glass effect's strength, 0-100% in the button settings (0115): 0 is no glass at
+// all (the icon alone on the picture), the anchor (70%) is the look as shipped, 100 is
+// the deepest the glass gets. It is the game's own setting, nothing to do with the
+// system's; it survives a restart (NSUserDefaults DmPadGlassOpacity). The real glass
+// (iOS 26+) fades as a whole view up to the anchor, then a white tint deepens it; the
+// fallback disc below iOS 26 scales every alpha up to the anchor, then deepens each one.
+static NSString *const k_glass_opacity_key = @"DmPadGlassOpacity";
+static NSString *const k_glass_opacity_v2_key = @"DmPadGlassOpacityV2";   // the stored value was remapped to the anchored scale (0115)
+- (void)loadGlassOpacity {
+    _glassOpacity = k_glassAnchor;   // fresh: the look as shipped
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    NSNumber *v = [d objectForKey:k_glass_opacity_key];
+    if (![v isKindOfClass:[NSNumber class]]) return;
+    double stored = fmin(fmax(v.doubleValue, 0), 100);
+    if (![d boolForKey:k_glass_opacity_v2_key]) {
+        // Values saved by the first version (0-100, 100 was the look as shipped) remap
+        // onto the anchored scale, so 100 becomes the anchor and nothing jumps deeper:
+        // the old fade v/100 is the new fade v'/(100 * anchor), so v' = v * anchor.
+        stored = stored * k_glassAnchor;
+        [d setObject:@((NSInteger)lround(stored)) forKey:k_glass_opacity_key];
+        [d setBool:YES forKey:k_glass_opacity_v2_key];
+    }
+    _glassOpacity = stored / 100;
+}
+- (void)saveGlassOpacity {
+    [NSUserDefaults.standardUserDefaults setObject:@((NSInteger)lround(_glassOpacity * 100)) forKey:k_glass_opacity_key];
+}
+- (void)applyGlassOpacity {   // the glass views and discs follow the setting, live from the slider
+    CGFloat p = _glassOpacity;
+    CGFloat fade = p <= k_glassAnchor ? p / k_glassAnchor : 1;   // 0 at no glass, 1 from the anchor up
+    CGFloat tint = p <= k_glassAnchor ? 0 : k_glassTintMax * (p - k_glassAnchor) / (1 - k_glassAnchor);   // the white tint, only past the anchor
+    for (int g = 0; g < G_N; g++) {
+        if (_glassView[g]) {
+            _glassView[g].alpha = fade;
+            if (fabs(tint - _glassTint) > 0.001 && @available(iOS 26.0, *)) {
+                // The tint is part of the effect, so it takes a fresh effect; at the
+                // anchor and below the tint is nil, which is the factory glass exactly.
+                UIGlassEffect *effect = [UIGlassEffect effectWithStyle:UIGlassEffectStyleRegular];
+                effect.interactive = YES;
+                if (tint > 0) effect.tintColor = [UIColor colorWithWhite:1 alpha:tint];
+                _glassView[g].effect = effect;
+            }
+        }
+        if (_glassDisc[g]) glassDiscSetOpacity(_glassDisc[g], p);
+    }
+    _glassTint = tint;
+}
