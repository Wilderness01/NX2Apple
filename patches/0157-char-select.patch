+        UILabel *name = (UILabel *)[b viewWithTag:220 + i];
+        name.frame = CGRectMake(42, 0, rowW - 80, rowH);
+        UILabel *mark = (UILabel *)[b viewWithTag:230 + i];
+        mark.frame = CGRectMake(rowW - 36, 0, 28, rowH);
