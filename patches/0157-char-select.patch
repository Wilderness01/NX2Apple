+// ---------- Character selection (Super Mario Odyssey) ----------
+// The game never names the player model in code: the name comes from data
+// (stage/actor Byaml) through the generic CRC32-hashed resource system, so
+// there is no game-binary hook point for the model. The hook lives here, in
+// the host filesystem layer, which sees the full guest path of every open.
+//   DM_CHAR_SELECT   mario | luigi | wario (unset = mario: no redirect)
+//   DM_CHAR_CAP      cap costume name (e.g. MarioColorWario), "default", or unset (follow the save)
+//   DM_CHAR_CLOTHES  clothes costume name, "default", or unset (follow the save)
+// A leading "Mario" in an ObjectData filename is replaced by the character
+// name (Mario.szs -> Luigi.szs, MarioColorWarioHead.szs -> WarioColorWarioHead.szs).
+// A target is only used when the romfs-overlay actually has it; otherwise the
+// request falls back to the character's default part, and if that is missing
+// too the original path is left alone, so the base Mario file loads. That last
+// rule matters twice over: a costume the character has no adapted version of
+// must not turn the player back into Mario, and must not fail the open.
+static const char *dm_char_parts[] = {
+    "HeadTexture", "BodyTexture", "HandTexture", "HeadMetal", "HeadOther",
+    "HairNoCap", "HandL", "HandR", "Under", "Head", "Face", "Hair", "Eye",
+    "Cap", "2D",
+};
+static int dm_char_redirect(const char *p, char *out, size_t n) {
+    const char *sel = getenv("DM_CHAR_SELECT");
+    if (!sel || !strcmp(sel, "mario")) return 0;
+    const char *ch = !strcmp(sel, "luigi") ? "Luigi" : !strcmp(sel, "wario") ? "Wario" : NULL;
+    if (!ch) return 0;
+    if (!p || strncmp(p, "rom:/ObjectData/", 16)) return 0;
+    const char *file = p + 16;
+    if (strchr(file, '/')) return 0;   // only the files directly under ObjectData
+    size_t flen = strlen(file);
+    if (flen < 5 || strcmp(file + flen - 4, ".szs")) return 0;
+    if (strncmp(file, "Mario", 5)) return 0;   // only the player/costume family
+    char stem[256];
+    size_t slen = flen - 4;
+    if (slen >= sizeof stem) return 0;
+    memcpy(stem, file, slen); stem[slen] = 0;
+    // Split the stem into "Mario" + core + part (longest part suffix first).
+    // A core of "" is a default part (Mario.szs, MarioHead.szs, MarioCap.szs);
+    // a non-empty core is a costume (MarioColorWarioHead.szs -> core ColorWario, part Head).
+    const char *part = "";
+    size_t plen = 0;
+    for (size_t i = 0; i < sizeof dm_char_parts / sizeof *dm_char_parts; i++) {
+        size_t l = strlen(dm_char_parts[i]);
+        if (slen >= 5 + l && !strcmp(stem + slen - l, dm_char_parts[i])) { part = dm_char_parts[i]; plen = l; break; }
+    }
+    size_t core_len = slen - plen - 5;
+    const char *core = stem + 5;   // the costume name minus "Mario" ("" for a default part)
+    const mount_t *rom = NULL;
+    for (int i = 0; i < g_nmnt; i++) if (mnt_named(&g_mnt[i], "rom")) { rom = &g_mnt[i]; break; }
+    if (!rom || !rom->overlay[0]) return 0;
+    // The slot env var (cap files follow DM_CHAR_CAP, everything else DM_CHAR_CLOTHES).
+    // A set value names the costume to force ("default" = the character's own
+    // default part); unset follows the save, with the adapted-or-default rule.
+    const char *slot = !strcmp(part, "Cap") ? getenv("DM_CHAR_CAP") : getenv("DM_CHAR_CLOTHES");
+    char cand[2][256];
+    int ncand = 0;
+    if (slot && !strcmp(slot, "default")) {
+        snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
+    } else if (slot && !strncmp(slot, "Mario", 5) && slot[5]) {
+        snprintf(cand[ncand], sizeof cand[0], "%s%s%s", ch, slot + 5, part); ncand++;
+        snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
+    } else if (core_len) {
+        snprintf(cand[ncand], sizeof cand[0], "%s%.*s%s", ch, (int)core_len, core, part); ncand++;
+        snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
+    } else {
+        snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
+    }
+    for (int i = 0; i < ncand; i++) {
+        char rest[1024], tmp[1024];
+        snprintf(rest, sizeof rest, "/ObjectData/%s.szs", cand[i]);
+        if (!rom_overlay_path(rom, rest, tmp, sizeof tmp)) continue;
+        snprintf(out, n, "rom:/ObjectData/%s.szs", cand[i]);
+        if (g_flag.fs) LOG("fs char-select: %s -> %s", p, out);
+        return 1;
+    }
+    return 0;
+}
