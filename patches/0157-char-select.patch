--- a/dm/ios/Sources/DmGameMenu.h
+++ b/dm/ios/Sources/DmGameMenu.h
@@ -13,6 +13,7 @@ void dm_pad_layout_set(int layout);   // releases every touch first, and is save
 void dm_gamepad_open_pad_settings(void);   // DmGamepad.m: the in-game menu's "按键设置" (button settings) opens the button editor
 void dm_hud_pad_open_editor(void);   // HudPadEditor.m: the in-game menu's "HUD 设置" opens the pad-style HUD editor
 void dm_hud_pad_apply_saved(void);   // HudPadEditor.m: the saved DmHudPad.* settings go into the DM_HUD_* environment before the game starts
+void dm_char_select_apply_saved(void);   // CharSelectEditor.m (0157): the saved DmCharSelect.* settings go into the DM_CHAR_* environment before the game starts
 void dm_gamepad_touch_feedback(bool on);   // DM_TOUCH_HAPTICS
 bool dm_setting_live(const char *env, const char *value);
 void *dm_quit_menu(void);   // front_ios.m: the menu's last item, Quit <game>, which opens the quit prompt (a retained UIMenu, shown inline)   // front_ios.m: value NULL asks whether the running game takes env at once; otherwise applies it
diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index db24a34..b7655c7 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -238,7 +238,7 @@ public func dmShowLauncher(_ viewController: UnsafeMutableRawPointer, _ done: @c
     // env key, falling back to the English in launcher.json.
     let model = LauncherModel(LauncherText.localizedSettings(file.settings))
     gameMenuModel = model   // the in-game menu shows and saves the same choices (GameMenu.swift)
-    if ProcessInfo.processInfo.environment["DM_LAUNCHER"] == "0" { fputs("launcher: off (DM_LAUNCHER=0)\n", stderr); model.applySaved(); dm_hud_pad_apply_saved(); return false }
+    if ProcessInfo.processInfo.environment["DM_LAUNCHER"] == "0" { fputs("launcher: off (DM_LAUNCHER=0)\n", stderr); model.applySaved(); dm_hud_pad_apply_saved(); dm_char_select_apply_saved(); return false }
     let parent = Unmanaged<UIViewController>.fromOpaque(viewController).takeUnretainedValue()
     var host: UIViewController?
     let view = LauncherView(m: model) {
@@ -246,6 +246,7 @@ public func dmShowLauncher(_ viewController: UnsafeMutableRawPointer, _ done: @c
         host = nil
         model.apply()
         dm_hud_pad_apply_saved()
+        dm_char_select_apply_saved()
         h.dismiss(animated: false) { done() }
     }
     let h = DmHostingController(rootView: view)
