-FRAME_STEP = {BUILD_141: _hud_runtime_frame_step}
+# char_select, compiled from char_select.c (0157: the title-menu character
+# picker) with aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+# -fno-stack-protector -fno-jump-tables -fno-unwind-tables
+# -fno-asynchronous-unwind-tables -c, and objcopy -O binary
+# --only-section=.text (never plain -O binary: the 0131 .eh_frame lesson).
+# One function: char_select_decide_vr(menu, state, tableA, tableB) -- see
+# char_select.c for the why (the VR row is repurposed; a 7th row cannot be
+# added through the table).
+CHAR_SELECT_WORDS = (
+    "39416005b9401c0472001ca5540001a1b864d862528000005280000353181c84b90264222a0500842a030084b9026824b9426c2211000442b9026c22d65f03c0b864d8427100185f540000e112bfe000528000260b0000c32a0603e0b902602617ffffef528000035280000017ffffec"
+)
+
+# (0157) The title-menu "角色选择" row (the repurposed VR row, title row 3,
+# action 6, pane ParList06) and the confirm intercept that opens the picker.
+# Two cuts, both in the title setup / confirm paths; the HUD runtime above
+# is untouched. The first version hooked Decide's merge point (0x1d78f8);
+# that was wrong: Decide (0x1d7800) has no BL caller and never runs the
+# VR action -- the confirm is dispatched by the switch at 0x1d7290,
+# called from Update (0x1d7548) and from 0x1d7184, whose action-6 case
+# (0x1d7334) is the only path to the VR transition (0x1d7740). The
+# intercept moved to the switch entry (fix report
+# REPORT-CHAR-SELECT-VR-STILL.md in the staging dir).
+#   * 0x4972f4 (title setup 0x497220, after rows 0-2 are set): the row-3
+#     text becomes the hardcoded UTF-16 "角色选择" via List::setText.
+#     The text is a raw UTF-16 pointer (the layout setter 0x6314e0 scans
+#     it as UTF-16, 0x6a6180), so no MSBT label is needed. setText(row 3)
+#     reads Table A[3] = 6 and writes panes[6] (ParList06), which exists.
+#     The trampoline also clears [List+0x59] afterwards: the setup tail
+#     calls the show path (0x1d6d00), which re-applies the VR label to
+#     panes[6] whenever [List+0x59] != 0 (it is 1 from the List ctor,
+#     0x1d6610) and would overwrite the new text. With +0x59 cleared the
+#     show path returns at once and the row keeps "角色选择" (rows 0-2
+#     prove setText alone displays a row's text -- they never go through
+#     show). The CUTS NOP at 0x497314 still forces the show path to run
+#     (so the row is not hidden); the clear only stops it re-writing.
+#   * 0x1d7290 (the confirm switch entry): the stub recomputes the
+#     action id from the same fields the switch reads ([x0+0x58] table
+#     selector, [x0+0x1c] row) and, for action 6 on the title menu
+#     (Table A), sets the host flag (state +0x260) so the picker opens
+#     and the trampoline returns to the caller, skipping the VR action
+#     entirely; the pause menu's VR (Table B) and actions 0-5 fall
+#     through to the re-executed ldrb and the switch runs normally.
+#     The trampoline passes the FULL table addresses (ADRP + ADDI):
+#     the tables are not page-aligned, and the #72 version passed only
+#     the page (0xec8000), so the stub read string data as the action
+#     table and never returned 1. The stub also writes diagnostics to
+#     state +0x264/+0x268/+0x26c on every call (action, sel/row/ret,
+#     call counter) so the host tick can log each switch invocation.
+# The VR row is forced visible by the CUTS entry above (the 2P-activation
+# gate at 0x497314 is NOPed): the "角色选择" row must always show.
+def _char_select_frame_step(ctx):
+    here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
+    char_code = here()
+    hx = ''.join(CHAR_SELECT_WORDS)
+    for i in range(0, len(hx), 8):
+        emit(int(hx[i:i + 8], 16))
+    # The confirm-switch intercept at 0x1d7290: `ldrb w11, [x0, #0x58]`.
+    # x0 (the menu/List) and x30 (the return address into Update 0x1d754c
+    # or 0x1d7188) are saved across the bl: the stub clobbers x0 (w0
+    # becomes the row) and the bl clobbers x30. The stub is a leaf and
+    # touches no callee-saved register, so nothing else needs saving.
+    # The replaced ldrb is NOT PC-relative, so it is re-executed verbatim.
+    # cbnz tests the stub's return value (w0), not the flags -- the stub
+    # leaves the flags arbitrary.
+    fs_site(0x1d7290, '0b604139')
+    sstart = here()
+    emit(STP_PRE(0, 30, 31, -16))              # stp x0, x30, [sp, #-16]! (live: the menu/List, the return address)
+    emit(ADRP(1, here(), FS_STATE_OFF))         # x1 = state page
+    # The tables are NOT page-aligned (Table A 0xec8270, Table B 0xec8288),
+    # so ADRP alone gives the page (0xec8000) -- the #72 trampoline passed
+    # the page as the table, the stub read string data as the action table
+    # and never returned 1 (row 3 went to VR, log-57 had zero [char]).
+    # ADDI the low 12 bits, like the setup trampoline does for its string
+    # and like the game's own switch does (adrp; add).
+    emit(ADRP(2, here(), 0xec8270))            # x2 = Table A page (title)
+    emit(ADDI(2, 2, 0x270))                    # x2 = 0xec8270 (Table A)
+    emit(ADRP(3, here(), 0xec8288))            # x3 = Table B page (pause)
+    emit(ADDI(3, 3, 0x288))                    # x3 = 0xec8288 (Table B)
+    emit(B(here(), char_code) | 0x80000000)     # bl char_select_decide_vr
+    emit(LDP_POST(0, 30, 31, 16))              # ldp x0, x30, [sp], #16
+    ret_at = sstart + 44
+    emit(CBNZ(0, here(), ret_at))               # cbnz w0, ret (stub set the flag: skip the VR action)
+    emit(0x3941600b)                            # ldrb w11, [x0, #0x58] (the replaced instruction)
+    emit(B(here(), 0x1d7294))                  # back to the hook site + 4
+    emit(0xd65f03c0)                            # ret (to the switch's caller)
+    fs_put(0x1d7290, [B(0x1d7290, sstart)], 'Confirm switch entry: title VR row (action 6, Table A) opens the character picker, VR skipped (char_select)')
+    # The row-3 text: UTF-16LE "角色选择" + NUL, emitted as data words.
+    row3_str = here()
+    emit(0x827289d2)                            # bytes D2 89 72 82 (角 色)
+    emit(0x62e99009)                            # bytes 09 90 E9 62 (选 择)
+    emit(0x00000000)                            # NUL + padding
+    fs_site(0x4972f4, '680e40f9')
+    rstart = here()
+    emit(ADRP(2, here(), row3_str))             # x2 = page of the UTF-16 string
+    emit(ADDI(2, 2, row3_str & 0xFFF))          # x2 = the UTF-16 string address
+    emit(0xaa1403e0)                             # mov x0, x20 (the list)
+    emit(0x52800061)                             # mov w1, #3 (row 3, the VR row)
+    emit(B(here(), 0x1d6b70) | 0x80000000)       # bl List::setText
+    emit(0x3901669f)                             # strb wzr, [x20, #0x59] (clear the List's "needs show" flag, so the setup tail's show path does not re-apply the VR label over the new text; x20 is callee-saved, setText preserves it)
+    emit(0xf9400e68)                             # ldr x8, [x19, #0x18] (the replaced instruction; ldr is not PC-relative)
+    emit(B(here(), 0x4972f8))                    # back to the hook site + 4
+    fs_put(0x4972f4, [B(0x4972f4, rstart)], 'Title menu setup: row 3 (VR) text becomes "角色选择" (char_select)')
+
+def _frame_step_141(ctx):
+    _hud_runtime_frame_step(ctx)
+    _char_select_frame_step(ctx)
+
+FRAME_STEP = {BUILD_141: _frame_step_141}
 
