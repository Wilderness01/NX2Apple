@@ -23,6 +23,9 @@ def CMPR(n, m): return 0xEB00001F | (m << 16) | (n << 5)   # cmp xn, xm (subs xz
 def BEQ(frm, to):
     off = to - frm; assert -(1 << 20) <= off < (1 << 20) and off % 4 == 0
     return 0x54000000 | (((off >> 2) & 0x7FFFF) << 5)
+def CBNZ(rt, frm, to):
