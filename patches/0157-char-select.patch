+// ---------- Character selection (0157) ----------
+// The guest switch stub (char_select.c, the confirm-switch cut at 0x1d7290)
+// sets state +0x260 when the player picks the title menu's "角色选择" row
+// (the repurposed VR row, action 6, Table A). This runs once per present
+// (from dm_hud_manual_frame_tick, which uw.c calls every present) and
+// opens the picker. The flag is cleared here so the picker opens once per
+// pick. dm_char_select_open_editor is CharSelectEditor.m (it dispatches to
+// the main thread; UIKit must run there). The slot is in the free zone
+// +0x250..+0x300 (the HUD masks end at +0x250, the HUD table starts at
+// +0x300). The stub also writes diagnostics to +0x264/+0x268/+0x26c on
+// every switch call (action, sel/row/ret, call counter); the tick logs
+// each invocation once so the device run proves what the hook sees.
+#define CHAR_SELECT_FLAG_OFF 0x260
+#define CHAR_SELECT_DIAG_ACTION_OFF 0x264
+#define CHAR_SELECT_DIAG_MISC_OFF 0x268
+#define CHAR_SELECT_COUNT_OFF 0x26c
+void dm_char_select_open_editor(void);   // CharSelectEditor.m
+static uint32_t g_char_select_last_count;   // last switch-call counter logged
+static void dm_char_select_frame_tick(uint8_t *st) {
+    // Diagnostic (#72 fix): log every switch invocation the stub saw.
+    // Independent of the flag -- a Confirm that computes the wrong
+    // action (e.g. the guide row) is exactly what the log needs to show.
+    volatile uint32_t *count = (volatile uint32_t *)(st + CHAR_SELECT_COUNT_OFF);
+    if (*count != g_char_select_last_count) {
+        g_char_select_last_count = *count;
+        uint32_t action = *(volatile uint32_t *)(st + CHAR_SELECT_DIAG_ACTION_OFF);
+        uint32_t misc = *(volatile uint32_t *)(st + CHAR_SELECT_DIAG_MISC_OFF);
+        LOG("[char] switch #%u sel=%u row=%u action=%d ret=%u",
+            *count, misc & 0xff, (misc >> 8) & 0xff, (int32_t)action, (misc >> 24) & 0xff);
+    }
+    volatile uint32_t *flag = (volatile uint32_t *)(st + CHAR_SELECT_FLAG_OFF);
+    if (*flag != 1) return;
+    *flag = 0;
+    LOG("[char] title menu: character picker requested (state +0x260)");
+    dm_char_select_open_editor();
+}
+
