+// CharSelectEditor.h -- the title-menu character/costume picker (0157).
+//
+// The picker opens over the title menu when the player picks the
+// "角色选择" row (the repurposed VR row): the guest Decide stub sets the
+// host flag (state +0x260) and the host frame tick calls
+// dm_char_select_open_editor. Three characters (Mario, Luigi, Wario) and
+// their costumes, all at once. Peach / Toad / Pauline are not in this
+// round (no ready models) and are not listed.
+//
+// Style (the user asked for the game's own UI, not an iOS one): the
+// character rows reuse the title menu's SelectMenuParts row (white rounded
+// window, TxtContent, Cursor); the costume lists reuse the Closet's
+// horizontal strip (white 9-slice cards, selection frame, counters); the
+// text uses the game's own font (dm/font/standard.ttf, registered from
+// DM_FONT_DIR) instead of the iOS system font the other editors use.
+// See CharSelectEditor.m for the layout and the costume lists.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void dm_char_select_open_editor(void);   // hud_manual.c: the frame tick opens the picker when the guest set state +0x260
+void dm_char_select_apply_saved(void);   // Launcher.swift: before the game starts, the saved DmCharSelect.* settings go into the DM_CHAR_* environment
+#ifdef __cplusplus
+}
+#endif
+
+#import <UIKit/UIKit.h>
+
+// The editor itself: a full-screen dimmed overlay on the key window, with
+// a centred game-style panel. The title menu shows through dimmed behind
+// it. Created by dm_char_select_open_editor, removed by Done (closeEditor).
+@interface CharSelectEditor : UIView
+- (void)openEditor;   // read the saved settings, apply them live, show the panel
+- (void)closeEditor;  // Done: save the settings and remove the editor
+@end
