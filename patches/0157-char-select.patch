+// ---- Costume strips ----
+// One card per entry: "默认" first, the character's costumes, "跟随存档" last.
+// The entry value is the DM_CHAR_* string (nil = follow the save).
+- (NSString *)displayNameForCostume:(const char *)name {
+    if (!name) return @"跟随存档";
+    if (!strcmp(name, "default")) return @"默认";
+    if (!strncmp(name, "Mario", 5)) return [NSString stringWithUTF8String:name + 5];
+    return [NSString stringWithUTF8String:name];
+}
+- (void)buildStrip:(UIScrollView *)strip isCap:(BOOL)isCap {
+    for (UIView *v in strip.subviews) [v removeFromSuperview];
+    // Entries: "default", the character's costumes, nil (follow the save).
+    const char *names[64];
+    int n = 0;
+    names[n++] = "default";
+    if (isCap) {
+        if (_character == 0) { for (size_t i = 0; i < sizeof kCharCapMario / sizeof *kCharCapMario; i++) names[n++] = kCharCapMario[i]; }
+        else if (_character == 2) { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) names[n++] = kCharWario[i]; }
+        // Luigi: no adapted caps (Default only).
+    } else {
+        if (_character == 0) { for (size_t i = 0; i < sizeof kCharClothesMario / sizeof *kCharClothesMario; i++) names[n++] = kCharClothesMario[i]; }
+        else if (_character == 1) { for (size_t i = 0; i < sizeof kCharClothesLuigi / sizeof *kCharClothesLuigi; i++) names[n++] = kCharClothesLuigi[i]; }
+        else { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) names[n++] = kCharWario[i]; }
+    }
+    names[n++] = NULL;   // follow the save
+    CGFloat x = 0, cw = 118, ch = 68, gap = 8;
+    for (int i = 0; i < n; i++) {
+        const char *entry = names[i];
+        NSString *value = entry ? [NSString stringWithUTF8String:entry] : nil;
+        UIButton *card = [UIButton buttonWithType:UIButtonTypeCustom];
+        card.frame = CGRectMake(x, 4, cw, ch);
+        card.backgroundColor = [UIColor colorWithWhite:0.96 alpha:1];
+        card.layer.cornerRadius = 8;
+        card.layer.borderWidth = 2;
+        NSString *cur = isCap ? _cap : _clothes;
+        BOOL selected = (value == nil && cur == nil) || (value != nil && cur != nil && [value isEqualToString:cur]);
+        card.layer.borderColor = selected ? charSelectColor(0xC9A227).CGColor : [UIColor clearColor].CGColor;
+        card.titleLabel.font = charSelectFont(14, selected);
+        card.titleLabel.numberOfLines = 2;
+        card.titleLabel.textAlignment = NSTextAlignmentCenter;
+        [card setTitle:[self displayNameForCostume:entry] forState:UIControlStateNormal];
+        [card setTitleColor:[UIColor colorWithWhite:0.2 alpha:1] forState:UIControlStateNormal];
+        card.tag = isCap ? 300 + i : 400 + i;
+        [card addTarget:self action:isCap ? @selector(pickCap:) : @selector(pickClothes:) forControlEvents:UIControlEventTouchUpInside];
+        [strip addSubview:card];
+        x += cw + gap;
+    }
+    strip.contentSize = CGSizeMake(x, ch + 8);
+}
+- (NSString *)stripValue:(BOOL)isCap index:(int)idx {
+    // Rebuild the entry list exactly as buildStrip did, and return idx's value.
+    const char *names[64];
+    int n = 0;
+    names[n++] = "default";
+    if (isCap) {
+        if (_character == 0) { for (size_t i = 0; i < sizeof kCharCapMario / sizeof *kCharCapMario; i++) names[n++] = kCharCapMario[i]; }
+        else if (_character == 2) { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) names[n++] = kCharWario[i]; }
+    } else {
+        if (_character == 0) { for (size_t i = 0; i < sizeof kCharClothesMario / sizeof *kCharClothesMario; i++) names[n++] = kCharClothesMario[i]; }
+        else if (_character == 1) { for (size_t i = 0; i < sizeof kCharClothesLuigi / sizeof *kCharClothesLuigi; i++) names[n++] = kCharClothesLuigi[i]; }
+        else { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) names[n++] = kCharWario[i]; }
+    }
+    names[n++] = NULL;
+    if (idx < 0 || idx >= n) return nil;
+    return names[idx] ? [NSString stringWithUTF8String:names[idx]] : nil;
+}
+
+// ---- Selection ----
+- (void)refresh {
+    for (int i = 0; i < 3; i++) {
+        BOOL selected = (i == _character);
+        _charButtons[i].layer.borderColor = selected ? charSelectColor(0xC9A227).CGColor : [UIColor clearColor].CGColor;
+        UILabel *mark = (UILabel *)[_charButtons[i] viewWithTag:230 + i];
+        mark.hidden = !selected;
+    }
+    // A pick that is not on the new character's list falls back to Default
+    // (it cannot stay: the list no longer offers it).
+    if (![self costume:_cap isCap:YES validFor:_character]) _cap = @"default";
+    if (![self costume:_clothes isCap:NO validFor:_character]) _clothes = @"default";
+    [self buildStrip:_capStrip isCap:YES];
+    [self buildStrip:_clothesStrip isCap:NO];
+}
+- (BOOL)costume:(NSString *)value isCap:(BOOL)isCap validFor:(int)character {
+    if (value == nil) return YES;   // follow the save is always valid
+    if ([value isEqualToString:@"default"]) return YES;
+    // Check the value is in this character's list.
+    const char *list[64]; int n = 0;
+    if (isCap) {
+        if (character == 0) { for (size_t i = 0; i < sizeof kCharCapMario / sizeof *kCharCapMario; i++) list[n++] = kCharCapMario[i]; }
+        else if (character == 2) { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) list[n++] = kCharWario[i]; }
+    } else {
+        if (character == 0) { for (size_t i = 0; i < sizeof kCharClothesMario / sizeof *kCharClothesMario; i++) list[n++] = kCharClothesMario[i]; }
+        else if (character == 1) { for (size_t i = 0; i < sizeof kCharClothesLuigi / sizeof *kCharClothesLuigi; i++) list[n++] = kCharClothesLuigi[i]; }
+        else { for (size_t i = 0; i < sizeof kCharWario / sizeof *kCharWario; i++) list[n++] = kCharWario[i]; }
+    }
+    for (int i = 0; i < n; i++) if (!strcmp(list[i], value.UTF8String)) return YES;
+    return NO;
+}
+- (void)pickCharacter:(UIButton *)sender {
+    int idx = (int)(sender.tag - 200);
+    if (idx < 0 || idx > 2) return;
+    _character = idx;
+    [self refresh];
+    [self applyLive];
+}
+- (void)pickCap:(UIButton *)sender {
+    int idx = (int)(sender.tag - 300);
+    _cap = [self stripValue:YES index:idx];
+    [self buildStrip:_capStrip isCap:YES];
+    [self applyLive];
+}
+- (void)pickClothes:(UIButton *)sender {
+    int idx = (int)(sender.tag - 400);
+    _clothes = [self stripValue:NO index:idx];
+    [self buildStrip:_clothesStrip isCap:NO];
+    [self applyLive];
+}
+- (void)reset:(UIButton *)sender {
+    (void)sender;
+    _character = 0; _cap = @"default"; _clothes = @"default";
+    [self refresh];
+    [self applyLive];
+}
+
+// ---- Saved settings / live channel ----
+- (void)loadSaved {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    NSString *ch = [d stringForKey:charSelectKey(@"character")];
+    _character = 0;
+    for (int i = 0; i < 3; i++) if ([kCharIds[i] isEqualToString:ch]) { _character = i; break; }
+    _cap = charSelectLoadCostume(@"cap");
+    _clothes = charSelectLoadCostume(@"clothes");
+    // Clamp a saved costume that is not on this character's list (e.g. the
+    // character changed since it was saved): fall back to Default.
+    if (![self costume:_cap isCap:YES validFor:_character]) _cap = @"default";
+    if (![self costume:_clothes isCap:NO validFor:_character]) _clothes = @"default";
+}
+- (void)save {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    [d setObject:kCharIds[_character] forKey:charSelectKey(@"character")];
+    charSelectSaveCostume(@"cap", _cap);
+    charSelectSaveCostume(@"clothes", _clothes);
+    fputs("char editor: saved DmCharSelect.* (角色选择已保存)\n", stderr);
+}
+- (void)applyLive {
+    charSelectApplyLive(kCharIds[_character], _cap, _clothes);
+}
+- (void)openEditor {
+    [self loadSaved];
+    [self applyLive];
+    [self refresh];
+}
+- (void)closeEditor {
+    [self save];
+    [self applyLive];
+    [self removeFromSuperview];
+    g_editor = nil;
+}
+- (void)done:(UIButton *)sender {
+    (void)sender;
+    [self closeEditor];
+}
+@end
+
+void dm_char_select_open_editor(void) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (g_editor) return;
+        UIWindow *window = nil;
+        for (UIScene *scene in [UIApplication sharedApplication].connectedScenes) {
+            if (![scene isKindOfClass:[UIWindowScene class]]) continue;
+            for (UIWindow *w in ((UIWindowScene *)scene).windows) {
+                if (w.isKeyWindow) { window = w; break; }
+            }
+            if (window) break;
+        }
+        if (!window) window = [UIApplication sharedApplication].keyWindow;
+        if (!window) { fputs("[char] no key window for the character picker\n", stderr); return; }
+        CharSelectEditor *editor = [[CharSelectEditor alloc] initWithFrame:window.bounds];
+        g_editor = editor;
+        [window addSubview:editor];
+        [editor openEditor];
+        fputs("[char] character picker opened\n", stderr);
+    });
+}
+
+void dm_char_select_apply_saved(void) {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    NSString *ch = [d stringForKey:charSelectKey(@"character")];
+    if (!ch) ch = @"mario";
+    NSString *cap = charSelectLoadCostume(@"cap");
+    NSString *clothes = charSelectLoadCostume(@"clothes");
+    charSelectApplyLive(ch, cap, clothes);
+}
