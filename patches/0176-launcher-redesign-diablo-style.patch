+/// The right panel (0176): the reference's dark glass "Launch Config" — header, the settings
+/// sections, Reset, the game-data and cloud-saves sections, and the memory row. In landscape it is
+/// a fixed-height card whose content scrolls; in portrait it is a plain stack and the page scrolls.
+private struct ConfigPanel: View {
+    @ObservedObject var m: LauncherModel
+    @Binding var gameDataPicking: Bool
+    @Binding var cloudPicking: Bool
+    var memory: UInt64
+    var scrolls: Bool
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack {
+                Text("启动配置").font(.title3.weight(.bold))
+                Spacer()
+                Text("LAUNCH CONFIG").font(.caption.weight(.semibold)).tracking(3).foregroundStyle(.secondary)
+            }
+            .padding(.horizontal, 20).padding(.top, 18).padding(.bottom, 10)
+            Rectangle().fill(.white.opacity(0.12)).frame(height: 1).padding(.horizontal, 20)
+            Group {
+                if scrolls {
+                    ScrollView {
+                        panelContent.padding(.horizontal, 20).padding(.vertical, 12)
+                    }
+                    .clipShape(RoundedRectangle(cornerRadius: 24))
+                } else {
+                    panelContent.padding(.horizontal, 20).padding(.vertical, 12)
+                }
+            }
+        }
+        .tint(odysseyGold)   // (0176) the reference's gold toggles: the switches and menu values in the panel take the coin gold
+        .dmGlassCard()
+    }
+
+    private var panelContent: some View {
+        VStack(alignment: .leading, spacing: 18) {
+            ForEach(m.sections, id: \.self) { section in
+                if !m.rows(in: section).isEmpty {
+                    ConfigSection(section: section, m: m)
+                }
+            }
+            VStack(alignment: .leading, spacing: 6) {
+                Button(LauncherText.text("ui.resetDefaults", "Reset to tested defaults")) { m.reset() }
+                    .disabled(!m.changed)
+                Text(LauncherText.text("ui.resetDefaultsNote", "Brings back all settings this game was tested with."))
+                    .font(.footnote).foregroundStyle(.secondary)
+            }
+            GameDataSection(picking: $gameDataPicking)
+            CloudSavesSection(picking: $cloudPicking)
+            HStack {
+                Text(LauncherText.text("ui.memoryAvailable", "Memory available"))
+                Spacer()
+                Text(ByteCountFormatter.string(fromByteCount: Int64(memory), countStyle: .memory)).monospacedDigit().foregroundStyle(.secondary)
+            }
+        }
+    }
+}
