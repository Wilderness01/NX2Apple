+/// One settings section inside the config panel (0176): the Chinese name with the English name in
+/// spaced gold caps on the right, as in the reference's panel, then the rows with their 0171 gold
+/// icons. SettingRow itself is untouched — it is shared with the Mac settings window.
+private struct ConfigSection: View {
+    let section: String
+    @ObservedObject var m: LauncherModel
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack {
+                Text(LauncherText.sectionName(section)).font(.headline)
+                Spacer()
+                Text(section.uppercased()).font(.caption.weight(.semibold)).tracking(2).foregroundStyle(odysseyGold)
+            }
+            .padding(.bottom, 6)
+            let rows = m.rows(in: section)
+            ForEach(Array(rows.enumerated()), id: \.element.id) { index, row in
+                if index > 0 { Rectangle().fill(.white.opacity(0.10)).frame(height: 1) }
+                if let icon = dmSettingIcon(row.env) {
+                    HStack(spacing: 12) {
+                        Image(systemName: icon).font(.title3).foregroundStyle(odysseyGold).frame(width: 26)
+                        SettingRow(s: row, m: m)
+                    }
+                    .padding(.vertical, 7)
+                } else {
+                    SettingRow(s: row, m: m)
+                        .padding(.vertical, 7)
+                }
+            }
+        }
+    }
+}
