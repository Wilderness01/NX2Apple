+/// Free storage on the app's volume (0176): FileManager's systemFreeSize, formatted like the memory
+/// row below. The launcher never computed this before — it only showed available memory — so the
+/// device pill computes it here instead of hardcoding a model or a number.
+private func dmFreeDiskSpace() -> Int64 {
+    guard let attrs = try? FileManager.default.attributesOfFileSystem(forPath: NSHomeDirectory()),
+          let free = attrs[.systemFreeSize] as? NSNumber else { return 0 }
+    return free.int64Value
+}
