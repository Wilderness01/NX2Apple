+/// The hero column (0176): the left side of the reference — edition line, huge serif title with the
+/// second line in Odyssey red, Chinese title, the "by 与荒野制作" byline, a flavor line, then the
+/// big red Play beside the save-backup glass button and the import-game-data glass button below.
+/// ViewThatFits picks the roomiest variant that fits the height: on a short iPhone landscape screen
+/// the title and spacing shrink instead of clipping.
+private struct DiabloHero: View {
+    let play: () -> Void
+    @Binding var gameDataPicking: Bool
+    @Binding var cloudPicking: Bool
+
+    var body: some View {
+        ViewThatFits(in: .vertical) {
+            heroContent(titleSize: 56, spacing: 12)
+            heroContent(titleSize: 48, spacing: 8)
+            heroContent(titleSize: 40, spacing: 6)
+            heroContent(titleSize: 34, spacing: 4)   // short landscape phones: the roomiest three do not fit ~335 pt of content height
+        }
+    }
+
+    @ViewBuilder private func heroContent(titleSize: CGFloat, spacing: CGFloat) -> some View {
+        VStack(alignment: .leading, spacing: spacing) {
+            Text("SINGLE-GAME EDITION · 单游戏版")
+                .font(.caption.weight(.semibold)).tracking(2).foregroundStyle(odysseyGold)
+            VStack(alignment: .leading, spacing: 0) {
+                Text("SUPER MARIO")
+                    .font(.system(size: titleSize, weight: .black, design: .serif))
+                    .minimumScaleFactor(0.6).lineLimit(1)
+                Text("ODYSSEY")
+                    .font(.system(size: titleSize, weight: .black, design: .serif))
+                    .foregroundStyle(odysseyRed)
+                    .minimumScaleFactor(0.6).lineLimit(1)
+            }
+            Text("超级马里奥 奥德赛")
+                .font(.title2.weight(.bold))
+            Text("by 与荒野制作")
+                .font(.subheadline).foregroundStyle(odysseyGold)
+            Text("戴上帽子，出发吧——穿梭一个个王国，收集能量月亮，把桃花公主从库巴手中救回来。")
+                .font(.callout).foregroundStyle(.secondary).lineLimit(3)
+            HStack(spacing: 12) {
+                playButton.frame(maxWidth: .infinity)
+                glassSecondaryButton(title: "存档备份导入", systemImage: "icloud") { cloudPicking = true }
+                    .frame(maxWidth: .infinity)
+            }
+            glassSecondaryButton(title: "导入游戏数据", systemImage: "square.and.arrow.down") { gameDataPicking = true }
+                .frame(maxWidth: .infinity)
+            Spacer(minLength: 0)
+        }
+    }
+
+    @ViewBuilder var playButton: some View {
+        let button = Button(action: play) { Text(LauncherText.text("ui.play", "Play")).font(.title3.weight(.semibold)) }.controlSize(.large)
+            .tint(odysseyRed)   // (0171) Odyssey red: the Play button is Mario red, not system blue; glassProminent takes the tint on iOS 26, borderedProminent below it
+        if #available(iOS 26.0, *) { button.buttonStyle(.glassProminent) } else { button.buttonStyle(.borderedProminent) }
+    }
+
+    @ViewBuilder private func glassSecondaryButton(title: String, systemImage: String, action: @escaping () -> Void) -> some View {
+        let button = Button(action: action) { Label(title, systemImage: systemImage).font(.headline.weight(.semibold)) }.controlSize(.large)
+        if #available(iOS 26.0, *) { button.buttonStyle(.glass) } else { button.buttonStyle(.bordered) }
+    }
+}
