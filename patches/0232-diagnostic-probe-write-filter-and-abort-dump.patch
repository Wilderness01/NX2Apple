diff --git a/dm/tools/nso_asm.py b/dm/tools/nso_asm.py
index 33fcd4bf..5aed87a0 100644
--- a/dm/tools/nso_asm.py
+++ b/dm/tools/nso_asm.py
@@ -31,6 +31,7 @@ def CBZ(rt, frm, to):
 def LDRB_POST(t, n, imm): return 0x38400400 | ((imm & 0x1FF) << 12) | (n << 5) | t   # ldrb wt,[xn],#imm (post-index; bit 10 marks the writeback -- without it this decodes as ldurb, an unscaled load that never advances the pointer)
 def STRB_POST(t, n, imm): return 0x38000400 | ((imm & 0x1FF) << 12) | (n << 5) | t   # strb wt,[xn],#imm (post-index; bit 10 marks the writeback)
 def STRB(t, n, imm12=0): return 0x39000000 | (imm12 << 10) | (n << 5) | t   # strb wt,[xn,#imm12]
+def LDRB(t, n, imm12=0): return 0x39400000 | (imm12 << 10) | (n << 5) | t   # ldrb wt,[xn,#imm12] (unsigned offset; the load half of STRB)
 def STRW(t, n, imm12=0): return 0xB9000000 | (imm12 << 10) | (n << 5) | t   # str wt,[xn,#imm12*4]
 def LDXRW(t, n): return 0x885F7C00 | (n << 5) | t   # ldxr wt,[xn] (32-bit exclusive load)
 def STXRW(s, t, n): return 0x88007C00 | (s << 16) | (n << 5) | t   # stxr ws,wt,[xn] (32-bit exclusive store; ws = 0 on success)
