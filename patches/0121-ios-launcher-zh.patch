+    /// The Chinese string for `key`, or `fallback` when the table does
+    /// not have it (a row this build does not know).
+    static func text(_ key: String, _ fallback: String) -> String {
+        table[key] ?? fallback
+    }
+
+    /// A section heading in Chinese. The model keeps
+    /// the English name: GameMenu.swift matches on it ("Controls"), and
+    /// the Mac settings window shares the model.
+    static func sectionName(_ english: String) -> String {
+        text("launch.section." + english, english)
+    }
+
+    /// One launcher.json row in Chinese: its label, its note (only when
+    /// the list has one; the Mac launcher does the same) and its choice
+    /// labels. A row or option the table does not know keeps its English.
+    static func localizedSetting(_ s: Setting) -> Setting {
+        let note = s.note.isEmpty ? "" : text("launch.set." + s.env + ".note", s.note)
+        let options = s.options?.map { o in
+            o.count > 1 ? [o[0], text("launch.opt." + s.env + "." + o[0], o[1])] : o
+        }
+        return Setting(env: s.env, kind: s.kind, label: text("launch.set." + s.env, s.label),
+                       note: note, def: s.def, section: s.section, needs: s.needs, level: s.level,
+                       base: s.base, options: options, min: s.min, max: s.max, step: s.step,
+                       on: s.on, off: s.off)
+    }
+
+    /// The whole list, in Chinese. Called only by the iOS launcher
+    /// (Launcher.swift dmShowLauncher): the model keeps the English
+    /// section names, so the in-game menu (GameMenu.swift) and the Mac
+    /// settings window, which share the model, are unaffected.
+    static func localizedSettings(_ settings: [Setting]) -> [Setting] {
+        settings.map(localizedSetting)
+    }
