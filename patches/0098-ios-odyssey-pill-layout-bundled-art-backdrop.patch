+// Per-game touch-button skin: see DmTouchSkin.h.
+#import "DmTouchSkin.h"
+#include <stdlib.h>
+#include <string.h>
+
+// The framework's own bundle: the art lives in its Resources, so it is found from the code that runs, not from
+// the app bundle (the shell's) or the game's Documents folder.
+@interface DmTouchSkinBundleMarker : NSObject @end
+@implementation DmTouchSkinBundleMarker @end
+static NSBundle *dm_touch_skin_bundle(void) {
+    static NSBundle *bundle;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ bundle = [NSBundle bundleForClass:[DmTouchSkinBundleMarker class]]; });
+    return bundle;
+}
+
+static NSMutableDictionary<NSString *, UIImage *> *s_cache;   // name → image, for the run
+static BOOL s_checked, s_enabled;                              // the cached dm_touch_skin_enabled() answer
+
+NSString *dm_touch_title_id(void) {
+    const char *save = getenv("DM_SAVE");   // the shell sets …/Documents/games/<title ID>/save (EngineLaunchPlan)
+    if (!save || !*save) return nil;
+    NSArray<NSString *> *parts = [[NSString stringWithUTF8String:save] pathComponents];
+    NSUInteger i = [parts indexOfObject:@"games"];
+    if (i == NSNotFound || i + 1 >= parts.count) return nil;
+    return parts[i + 1];
+}
+
+UIImage *dm_touch_skin_image(NSString *name) {
+    if (!name) return nil;
+    if (!s_cache) s_cache = [NSMutableDictionary dictionary];
+    UIImage *image = s_cache[name];
+    if (image) return image == (id)[NSNull null] ? nil : image;
+    NSString *titleID = dm_touch_title_id();
+    NSString *dir = titleID ? [@"TouchSkin" stringByAppendingPathComponent:titleID] : nil;
+    NSString *path = dir ? [dm_touch_skin_bundle() pathForResource:name ofType:@"png" inDirectory:dir] : nil;
+    image = path ? [UIImage imageWithContentsOfFile:path] : nil;
+    s_cache[name] = image ?: (id)[NSNull null];   // remember the miss too: the art does not change during a run
+    return image;
+}
+
+// DmGamepad.m's B_* order: A B X Y L3 R3 L R ZL ZR + −, then the four D-pad arms.
+NSString *dm_touch_skin_name_for_button(int b) {
+    static NSString *const names[] = {@"a", @"b", @"x", @"y", @"l3", @"r3", @"l", @"r", @"zl", @"zr", @"plus", @"minus",
+                                      @"dpad", @"dpad", @"dpad", @"dpad"};
+    if (b < 0 || b >= (int)(sizeof names / sizeof *names)) return nil;
+    return names[b];
+}
+NSString *dm_touch_skin_stick_name(void) { return @"stick"; }
+NSString *dm_touch_skin_stick_base_name(void) { return @"stick-base"; }
+
+bool dm_touch_skin_available(void) {
+    if (!dm_touch_title_id()) return false;
+    static NSString *const known[] = {@"a", @"b", @"x", @"y", @"zl", @"zr", @"l", @"r", @"l3", @"r3",
+                                      @"plus", @"minus", @"stick", @"stick-base", @"dpad", @"gear"};
+    for (int i = 0; i < (int)(sizeof known / sizeof *known); i++) if (dm_touch_skin_image(known[i])) return true;
+    return false;
+}
+
+BOOL dm_touch_skin_enabled(void) {
+    if (s_checked) return s_enabled;
+    const char *e = getenv("DM_TOUCH_SKIN");
+    s_enabled = !(e && !strcmp(e, "off")) && dm_touch_skin_available();
+    s_checked = YES;
+    return s_enabled;
+}
+
+void dm_touch_skin_set_enabled(BOOL on) {
+    if (on) unsetenv("DM_TOUCH_SKIN"); else setenv("DM_TOUCH_SKIN", "off", 1);   // "auto" is the default: unset means auto
+    s_checked = NO; [s_cache removeAllObjects];   // the toggle re-reads the bundled art
+    (void)dm_touch_skin_enabled();
+}
