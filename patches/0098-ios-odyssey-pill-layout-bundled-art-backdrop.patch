+// Patch 0098: the in-game layout editor's live apply. The framework takes it through dm_setting_live; when the
+// running framework is too old to export dm_glue_touch_apply, the change is already saved per game and reaches
+// the game at the next launch instead — never an error, never a crash.
+void dm_shell_touch_apply(const char *env, const char *value) {
+    if (!env || !value) return;
+    if (g_touch) g_touch(env, value);
+    else fprintf(stderr, "shell: this game's framework does not take live touch changes (dm_glue_touch_apply missing): the saved choice applies at the next launch\n");
+}
