+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -14939,12 +14939,23 @@ static id<MTL4CommandAllocator> g_snap_alloc[SNAP_MAX]; static id<MTL4CommandBuf
 static id<MTLResidencySet> g_snap_res; static id<MTLSharedEvent> g_snap_ev; static uint64_t g_snap_v;
 static _Atomic uint64_t g_snap_next, g_snap_cmt;   // g_snap_cmt: the last copy the encode thread has committed (its g_snap_v)
 static int g_snap_n = 2;
+// DM_PICTURE_BACKDROP (front_ios.m, on by default): fill the Fit black bars with a blurred copy of the picture. The backdrop's frame comes
+// from the snapshot ring below, so snapshots are forced on when it is set (the same cost as the Frame buffering toggle).
+// DM_PICTURE_BACKDROP=0 turns it off.
+static int backdrop_on(void) {
+    static int v = -1; if (v >= 0) return v;
+    const char *e = getenv("DM_PICTURE_BACKDROP"); v = !(e && atoi(e) == 0);
+    if (v) MLOG("picture backdrop on (DM_PICTURE_BACKDROP, default on): the front end blurs the newest snapshot into the Fit black bars");
+    return v;
+}
 int mtl_snap_on(void) {
     static int v = -1; if (v >= 0) return v;
     const char *e = getenv("DM_PRESENT_SNAP");
     int n = e ? atoi(e) : dm_prof()->present_snap ? 2 : 0;   // the profile's present_snap (a ring of 2)
+    int forced = 0;
+    if (!n && backdrop_on()) { n = 2; forced = 1; }   // the backdrop needs the ring as its frame source
     v = n > 0; g_snap_n = n < 2 ? 2 : n > SNAP_MAX ? SNAP_MAX : n;
-    if (v) MLOG("present snapshots (DM_PRESENT_SNAP=%d): each present is copied into a ring of %d host textures and the game's texture is free at once", n, g_snap_n);
+    if (v) MLOG("present snapshots (DM_PRESENT_SNAP=%d%s): each present is copied into a ring of %d host textures and the game's texture is free at once", n, forced ? ", forced by DM_PICTURE_BACKDROP" : "", g_snap_n);
     else MLOG("present snapshots off (%s): the screen shows the game's own texture", e ? "DM_PRESENT_SNAP" : "game profile present_snap");   // Frame buffering off: the log says so too
     return v;
 }
@@ -14969,6 +14980,21 @@ uint64_t mtl_snap_acquire_wait(void) {
     if (ws_on()) ws_put(WS_SNAP, w0, blocked);
     return ws_t0() - w0;
 }
+// The iOS front end's picture backdrop (DM_PICTURE_BACKDROP=1): the newest snapshot texture for its blurred fill of the Fit
+// black bars, with the shared event + value that signal that slot's copy (0 = the slot has never been copied: wait for
+// nothing). NULL when snapshots are off or no frame has been copied yet. The texture is retained for the caller; the slot can
+// be reused by the next present while the caller still holds it, so a backdrop sampled mid-copy may mix two frames — at 60x34
+// and heavily blurred that is invisible, and the caller waits for the event before sampling.
+void *mtl_backdrop_texture(void **event, uint64_t *ev) {
+    if (!mtl_snap_on() || !g_snap_ev) return NULL;
+    uint64_t next = atomic_load(&g_snap_next);
+    if (!next) return NULL;
+    int k = (int)((next - 1) % (uint64_t)g_snap_n);
+    id<MTLTexture> tex = g_snap[k].tex; if (!tex) return NULL;
+    if (event) *event = (__bridge void *)g_snap_ev;
+    if (ev) *ev = atomic_load(&g_snap[k].ev);
+    return (__bridge_retained void *)tex;
+}
 // Copy the presented texture into the next ring slot; returns the slot's serial (0 = no snapshot: the game's texture is presented as before)
 static uint64_t snap_take(const tex_t *t) {
     int k = (int)(atomic_load(&g_snap_next) % (uint64_t)g_snap_n);
