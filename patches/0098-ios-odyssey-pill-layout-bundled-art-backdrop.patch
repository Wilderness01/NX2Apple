diff --git a/dm/ios/Sources/DmTouchSkin.h b/dm/ios/Sources/DmTouchSkin.h
new file mode 100644
index 0000000..3f83da6
--- /dev/null
+++ b/dm/ios/Sources/DmTouchSkin.h
@@ -0,0 +1,40 @@
+// Per-game touch-button skin: the running game's own button art, drawn by DmGamepad.m instead of its
+// built-in shapes. A skin is a folder of individual PNGs, bundled in the game's framework as resources:
+//
+//     DmGame<title ID>.framework/Resources/TouchSkin/<title ID>/<name>.png
+//
+// Only Odyssey (0100000000010000) ships art: the lookup is keyed to the running game's title ID (from DM_SAVE,
+// which the shell sets to Documents/games/<title ID>/save), and a game with no art in its framework draws the
+// default icons. The art is part of the IPA, so it works with nothing but the IPA installed; an IPA update
+// (same bundle ID) keeps it, as it keeps the framework.
+//
+// DM_TOUCH_SKIN (docs/env_switches.tsv): "auto" (default) uses the bundled art when the game has it, "off" never does.
+// An explicit value other than "off" behaves like "auto": a game with no art always draws the default icons.
+#pragma once
+#import <UIKit/UIKit.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// The running game's title ID, from DM_SAVE (…/games/<title ID>/save); nil when no game is running.
+NSString *dm_touch_title_id(void);
+// True when the game's framework bundles at least one known button image.
+bool dm_touch_skin_available(void);
+// True when the skin is in use: DM_TOUCH_SKIN is not "off" and a skin is available. Cached; see below.
+BOOL dm_touch_skin_enabled(void);
+// Re-reads DM_TOUCH_SKIN and the bundled art (the in-game menu's live toggle); drops the image cache.
+void dm_touch_skin_set_enabled(BOOL on);
+// "<name>.png" from the game's bundled art, cached for the run; nil when the file is absent or unreadable.
+UIImage *dm_touch_skin_image(NSString *name);
+// The asset name for DmGamepad.m's B_* button index ("a", "b", "x", "y", "l3", "r3", "l", "r", "zl", "zr",
+// "plus", "minus"; the four D-pad arms share "dpad"); nil for an index with no art.
+NSString *dm_touch_skin_name_for_button(int b);
+// The stick art: "stick" (knob) and "stick-base" (the ring box, optional).
+NSString *dm_touch_skin_stick_name(void);
+NSString *dm_touch_skin_stick_base_name(void);
+
+#ifdef __cplusplus
+}
+#endif
