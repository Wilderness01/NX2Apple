+// Saves a touch pick per game, as Play saves a setting (LauncherModel.choose): the standard defaults under the
+// per-game app's key (launcher.<VAR>), and the shell's per-game suite (dev.nx2apple.shell.game.<title ID>) under
+// the key the shell's GameTouchStore reads, so the next launch — whose environment the shell builds from that
+// suite — shows the same choice. A default value is forgotten, like the shell's store forgets one: the next launch
+// then follows the shell-wide default instead of pinning this game to it.
+void dm_touch_choice_save(const char *env, const char *value) {
+    if (!env || !value) return;
+    NSString *key = [NSString stringWithUTF8String:env];
+    NSString *val = [NSString stringWithUTF8String:value];
+    [[NSUserDefaults standardUserDefaults] setObject:val forKey:[@"launcher." stringByAppendingString:key]];
+    NSString *tid = dm_touch_title_id();
+    if (!tid) return;
+    static NSString *const map[][2] = {{@"DM_TOUCH_SIZE", @"touchSize"}, {@"DM_TOUCH_STICK", @"touchStick"},
+                                       {@"DM_TOUCH_LAYOUT", @"touchLayout"}, {@"DM_TOUCH_SKIN", @"touchSkin"}};
+    NSString *storeKey = nil;
+    for (int i = 0; i < 4; i++) if ([key isEqualToString:map[i][0]]) storeKey = map[i][1];
+    if (!storeKey) return;
+    NSUserDefaults *suite = [[NSUserDefaults alloc] initWithSuiteName:[@"dev.nx2apple.shell.game." stringByAppendingString:tid]];
+    if (!suite) return;
+    BOOL isDefault = ([key isEqualToString:@"DM_TOUCH_SIZE"] && [val isEqualToString:@"medium"]) ||
+                     ([key isEqualToString:@"DM_TOUCH_STICK"] && [val isEqualToString:@"corner"]) ||
+                     ([key isEqualToString:@"DM_TOUCH_LAYOUT"] && val.length == 0) ||
+                     ([key isEqualToString:@"DM_TOUCH_SKIN"] && [val isEqualToString:@"auto"]);
+    if (isDefault) [suite removeObjectForKey:storeKey]; else [suite setObject:val forKey:storeKey];
+}
