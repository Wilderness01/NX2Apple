+void *mtl_backdrop_texture(void **event, uint64_t *ev);   // newest present-snapshot texture (retained by the caller) + the shared event/value that signals its copy; NULL when snapshots are off or no frame has been copied yet (DM_PICTURE_BACKDROP, front_ios.m)
