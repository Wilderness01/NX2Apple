index f91b002..ad43128 100644
--- a/dm/ios/Sources/GameMenu.swift
+++ b/dm/ios/Sources/GameMenu.swift
@@ -30,10 +30,48 @@ private func gameMenuItems() -> [UIMenuElement] {
         }
     }
     if !placed { items.insert(UIMenu(options: .displayInline, children: [layout]), at: 0) }
+    if let touch = touchButtonsMenu() { items.append(UIMenu(options: .displayInline, children: [touch])) }   // patch 0098: before Quit
     items.append(Unmanaged<UIMenu>.fromOpaque(dm_quit_menu()).takeRetainedValue())   // Quit <game>, last and on its own: it opens the quit prompt (front_ios.m)
     return items
 }
 
+// Patch 0098: the touch buttons, live. Size and icons apply at once (DmGamepad.m, front_ios.m dm_setting_live)
+// and are saved per game, so the next launch shows the same choice. "Move buttons…" opens the shell's layout
+// editor: the engine only posts the request, the shell presents its editor; the row is shown only in the shell,
+// where the editor lives (the one-game app has no layout editor). The Icons row is shown only when the running
+// game actually has bundled skin art, so other games never see it.
+private func touchButtonsMenu() -> UIMenuElement? {
+    var rows: [UIMenuElement] = []
+    let size = ProcessInfo.processInfo.environment["DM_TOUCH_SIZE"] ?? "medium"
+    let sizeActions = [("small", "Small"), ("medium", "Medium"), ("large", "Large")].map { v, label in
+        UIAction(title: label, state: size == v ? .on : .off) { _ in
+            dm_touch_size_set(v)
+            dm_touch_choice_save("DM_TOUCH_SIZE", v)
+        }
+    }
+    rows.append(UIMenu(title: "Size", options: .singleSelection, children: sizeActions))
+    if dm_touch_skin_available() {
+        let skin = ProcessInfo.processInfo.environment["DM_TOUCH_SKIN"] ?? "auto"
+        let custom = UIAction(title: "Custom icons", state: skin != "off" ? .on : .off) { _ in
+            dm_touch_skin_set("auto")
+            dm_touch_choice_save("DM_TOUCH_SKIN", "auto")
+        }
+        let def = UIAction(title: "Default icons", state: skin == "off" ? .on : .off) { _ in
+            dm_touch_skin_set("off")
+            dm_touch_choice_save("DM_TOUCH_SKIN", "off")
+        }
+        rows.append(UIMenu(title: "Icons", options: .singleSelection, children: [custom, def]))
+    }
+    if dm_touch_in_shell() {
+        rows.append(UIAction(title: "Move buttons…") { _ in
+            NotificationCenter.default.post(name: Notification.Name("dev.nx2apple.shell.touchLayoutEditorRequested"),
+                                            object: nil, userInfo: ["titleID": dm_touch_title_id() ?? ""])
+        })
+    }
+    guard !rows.isEmpty else { return nil }
+    return UIMenu(title: "Touch buttons", children: rows)
+}
+
 private func gameMenuRow(_ m: LauncherModel, _ s: Setting) -> UIMenuElement {
     let now = m.values[s.env] ?? s.def, fixed = m.fixed.contains(s.env)
     let attributes: UIMenuElement.Attributes = fixed ? .disabled : []
