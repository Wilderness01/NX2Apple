From f75f21f2551679439871283040398bd5e6a5e6bc Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sat, 14 Nov 2026 05:17:14 +0000
Subject: [PATCH] 0131: layout probe for the HUD numbers (log-38)

0130 had zero effect on device (log-38 identical to log-37): its
fallback rebuilds e_orig from the pane's local +0x30, but TxtCounter's
local is (0,0) on device -- the layout (263,71) is most likely in the
parent Capture02/03's local transform, which 0130 never reads -- and
for the regional group the fallback never triggers and the (c) gate is
trivially true. The probe only logged the result, never the inputs, so
the next fix would be another unverified guess.

This probe adds one layout record (type 3) per pane hud_edge matched:
the pane's own local translation (+0x30/+0x34), the parent's local
translation, and the stored original's translation (e_orig[3]/e_orig[7])
after hud_edge. The host prints it as a [hudprobe] layout line. H1
(pane local (0,0), parent local ~(263,71), e_orig (0,0)) means the
layout is in the parent's local and the 0131 fix should accumulate
local +0x30 along the parent chain; H2 (pane local (263,71), e_orig
(0,0)) means the fallback did not run or the build is stale; H3 (both
locals (0,0)) means the layout is in no +0x30. Diagnostic only; it
moves no pane and changes no behaviour.
---
 dm/games/0100000000010000/hud_probe.c | 69 +++++++++++++++++++++++++--
 dm/games/0100000000010000/patches.py  | 51 ++++++++++++--------
 dm/host/hud_manual.c                  | 20 ++++++--
 3 files changed, 113 insertions(+), 27 deletions(-)

diff --git a/dm/games/0100000000010000/hud_probe.c b/dm/games/0100000000010000/hud_probe.c
index 311fa8a..c6362af 100644
--- a/dm/games/0100000000010000/hud_probe.c
+++ b/dm/games/0100000000010000/hud_probe.c
@@ -25,6 +25,18 @@
 //      the translation actually written back to the pane matrix
 //      (final_m3/final_m7) -- so a corrupted number-pane matrix, a stale
 //      parent, or an off-screen push is visible, not guessed.
+//   4. (0131) for every pane hud_edge matched, one layout record: the
+//      pane's own local translation (+0x30/+0x34), the parent's local
+//      translation, and the stored original's translation (e_orig[3]/
+//      e_orig[7] from the table entry, after hud_edge). 0130 had zero
+//      effect on device (log-38 identical to log-37): its fallback
+//      rebuilds e_orig from the pane's local +0x30, but TxtCounter's
+//      local is (0,0) on device -- the layout (263,71) is most likely in
+//      the parent Capture02/03's local transform, which 0130 never reads
+//      -- and for the regional group the fallback never triggers and the
+//      (c) gate is trivially true. The layout record shows, per pane,
+//      where the layout actually lives, so the 0131 fix is written from
+//      measured values, not from another unverified assumption.
 //
 // How it works: the rewriter's two Pane::Calculate cuts call this stub
 // after hud_edge (same arguments, plus the probe buffer). The stub writes
@@ -90,6 +102,7 @@ typedef unsigned long uintptr_t;
 #define HP_REC_PANE 0
 #define HP_REC_EDGE 1
 #define HP_REC_ASPECT 2
+#define HP_REC_LAYOUT 3   // (0131) the pane's local transform + the stored original
 // Record field offsets (relative to the record start, 96 bytes total).
 #define HP_R_TYPE 0
 #define HP_R_ADDR_LO 4
@@ -244,9 +257,10 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         slot = (entry_index - idx) / HUD_EDGE_N;
     }
     // How many records: one pane record, plus one edge-decision record
-    // when matched. Both must fit, or neither is written and the pane
-    // stays un-seen (it retries next frame, when the host has flushed).
-    int need = matched ? 2 : 1;
+    // and one layout record (0131) when matched. All must fit, or none
+    // is written and the pane stays un-seen (it retries next frame, when
+    // the host has flushed).
+    int need = matched ? 3 : 1;
     u32 rc = hdr[HP_REC_COUNT / 4];
     if (rc + (u32)need > HUD_PROBE_REC_CAP) return;
 
@@ -325,6 +339,55 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         rc++;
     }
 
+    // The layout record (0131), for a matched pane only: the pane's own
+    // local translation (+0x30/+0x34), the parent's local translation
+    // (0,0 when there is no parent), and the stored original's
+    // translation (e_orig[3]/e_orig[7] from the table entry, after
+    // hud_edge processed this pane -- the probe runs after hud_edge in
+    // the hook, so this is the value hud_edge actually computed). This
+    // is the evidence the 0130 diagnosis needs: 0130's fallback rebuilds
+    // e_orig from the pane's local +0x30, but on device TxtCounter's
+    // local is (0,0) -- the layout (263,71) is most likely in the parent
+    // Capture02/03's local transform, which 0130 never reads -- and for
+    // the regional group the fallback never triggers and the (c) gate is
+    // trivially true. Logging both locals and the resulting e_orig shows,
+    // per pane, where the layout actually lives, so the 0131 fix stops
+    // guessing: H1 (pane local (0,0), parent local ~(263,71), e_orig
+    // (0,0)) means the layout is in the parent's local; H2 (pane local
+    // (263,71), e_orig (0,0)) means the fallback did not run or the
+    // build is stale; H3 (both locals (0,0)) means the layout is in no
+    // +0x30. e_orig is entry +8, so e_orig[3] is entry +20 and
+    // e_orig[7] is entry +36 (the same offsets hud_edge.c's 0130
+    // fallback reads from the parent's entry).
+    if (matched) {
+        float lx = *(const float *)((const char *)pane + 0x30);
+        float ly = *(const float *)((const char *)pane + 0x34);
+        float plx = 0.0f, ply = 0.0f;
+        if (parent_ok) {
+            plx = *(const float *)((const char *)parent + 0x30);
+            ply = *(const float *)((const char *)parent + 0x34);
+        }
+        volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+        hp_put_u32(rec, HP_R_TYPE, HP_REC_LAYOUT);
+        hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+        hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+        hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+        if (parent_ok) hud_probe_copy_name(rec + HP_R_PNAME, (const char *)parent + 0xb8, 20);
+        else rec[HP_R_PNAME] = 0;
+        hp_put_f32(rec, HP_R_V0, lx);
+        hp_put_f32(rec, HP_R_V1, ly);
+        hp_put_f32(rec, HP_R_V2, plx);
+        hp_put_f32(rec, HP_R_V3, ply);
+        hp_put_f32(rec, HP_R_V4, *(const float *)(ent + 20));   // e_orig[3]
+        hp_put_f32(rec, HP_R_V5, *(const float *)(ent + 36));   // e_orig[7]
+        hp_put_f32(rec, HP_R_V6, 0.0f);
+        hp_put_u32(rec, HP_R_W0, (u32)idx);
+        hp_put_u32(rec, HP_R_W1, (u32)slot);
+        hp_put_u32(rec, HP_R_W2, 0);
+        hp_put_u32(rec, HP_R_W3, 0);
+        rc++;
+    }
+
     hdr[HP_REC_COUNT / 4] = rc;
     // Mark seen only after both records were written, so a deferred pane
     // (buffer full) retries next frame instead of being lost.
