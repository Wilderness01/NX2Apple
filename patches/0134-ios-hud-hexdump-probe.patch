From 2ac14bd88aaa91c17587857edc343ab496358827 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sat, 14 Nov 2026 11:59:52 +0000
Subject: [PATCH] 0134: add a hex-dump probe for the HUD numbers' layout
 (log-42)

Log-42 proved (263,71) is in no chain, no scale and no size/origin
combination, and the V1.3.17 screenshot re-measurement confirmed
(263,71) is the right target value. Dump the raw struct bytes
0x00-0xFF of TxtCounterSh, TxtCounter, Capture02, Capture03 and
RootPane (the coin number's own chain, matched or not) in 60-byte
chunks, so the layout can be found by grepping for 263.0 = 0x43838000,
123.0 = 0x42F60000 or 71.0 = 0x428E0000. BINDING v12 -> v13.
---
 dm/games/0100000000010000/hud_probe.c | 116 ++++++++++++++++++++++++--
 dm/games/0100000000010000/patches.py  |  83 ++++++++++--------
 dm/host/hud_manual.c                  |  36 +++++++-
 3 files changed, 193 insertions(+), 42 deletions(-)

diff --git a/dm/games/0100000000010000/hud_probe.c b/dm/games/0100000000010000/hud_probe.c
index 314384b..37098f2 100644
--- a/dm/games/0100000000010000/hud_probe.c
+++ b/dm/games/0100000000010000/hud_probe.c
@@ -58,6 +58,26 @@
 //      hud_edge's just-written value (the same numbers as final_m3/
 //      final_m7 in the edge-decision record); the pre-write value is
 //      e_orig in the layout record.
+//   7. (0134) for every pane whose name is one of TxtCounterSh,
+//      TxtCounter, Capture02, Capture03, RootPane -- the coin number's
+//      own chain, matched or not (Capture02/03 and RootPane are parents,
+//      never matched by hud_edge) -- five hex-dump records: the pane
+//      struct's raw bytes 0x00-0xFF in 60-byte chunks, so the (263,71)
+//      layout (confirmed by the V1.3.17 screenshot re-measurement,
+//      REPORT-0133-remeasure.md) can be found by grepping for its float
+//      bit patterns (263.0 = 0x43838000, 123.0 = 0x42F60000,
+//      71.0 = 0x428E0000) if it lives in a field the probe has not read
+//      yet (rotation, an independent layout struct, .bflyt data copied
+//      into the pane). The chunk data spans the record's pname field
+//      (20 bytes) + v0..v6 (28) + w0..w2 (12); w3 packs the chunk index,
+//      the byte count, the element index and the slot. The log format is
+//      greppable (pane name + byte offset + hex, one line per chunk).
+//      A matched target pane takes ten records (the five above plus
+//      five hex), an unmatched target pane six (pane + five hex); the
+//      13-record cap is unchanged, so a flush carries the aspect record
+//      plus one matched target pane and the rest defer -- the host
+//      flushes every present, so a few seconds of stand-still still logs
+//      every pane.
 //
 // How it works: the rewriter's two Pane::Calculate cuts call this stub
 // after hud_edge (same arguments, plus the probe buffer). The stub writes
@@ -126,6 +146,36 @@ typedef unsigned long uintptr_t;
 #define HP_REC_LAYOUT 3   // (0131) the pane's local transform + the stored original
 #define HP_REC_CHAIN 4    // (0133) the full parent chain's local translations
 #define HP_REC_FIELDS 5   // (0133) local scales, sizes, origins, live global
+#define HP_REC_HEXDUMP 6  // (0134) 60 bytes of the pane struct per record
+// Hex dump (0134): 256 bytes per target pane (struct 0x00-0xFF), in
+// 60-byte chunks (pname 20 + v0..v6 28 + w0..w2 12); w3 packs chunk |
+// count<<8 | idx<<16 | slot<<24. Five chunks cover 0x00-0xFF.
+#define HUD_PROBE_HEX_SPAN 256
+#define HUD_PROBE_HEX_CHUNK 60
+#define HUD_PROBE_HEX_CHUNKS 5
+// The hex-dump targets (0134), as little-endian u32s (no string
+// literal: same rule as hud_edge.c's HUD_E_* -- a literal would sit in
+// .rodata and the code would load its address with an adrp).
+// "TxtCounterSh": "TxtC", "ount", "erSh", NUL word.
+#define HP_HEX_TCSH0 0x43747854u
+#define HP_HEX_TCSH1 0x746e756fu
+#define HP_HEX_TCSH2 0x68537265u
+#define HP_HEX_TCSH3 0x00000000u
+// "TxtCounter": "TxtC", "ount", "er\0".
+#define HP_HEX_TC0 0x43747854u
+#define HP_HEX_TC1 0x746e756fu
+#define HP_HEX_TC2 0x00007265u
+// "Capture02": "Capt", "ure0", "2\0\0\0".
+#define HP_HEX_CAP020 0x74706143u
+#define HP_HEX_CAP021 0x30657275u
+#define HP_HEX_CAP022 0x00000032u
+// "Capture03": "Capt", "ure0", "3\0\0\0".
+#define HP_HEX_CAP030 0x74706143u
+#define HP_HEX_CAP031 0x30657275u
+#define HP_HEX_CAP032 0x00000033u
+// "RootPane": "Root", "Pane", NUL at byte 8.
+#define HP_HEX_ROOT0 0x746f6f52u
+#define HP_HEX_ROOT1 0x656e6150u
 // Chain levels stored per record (levels 0..4 as floats in v0..v6 +
 // w0..w2, which hold float bit patterns); a deeper chain stores the
 // first five and reports its full depth in w3.
@@ -179,6 +229,21 @@ static inline __attribute__((always_inline)) void hud_probe_copy_name(volatile c
     dst[i] = 0;
 }
 
+// Is this pane name one of the hex-dump targets (0134)? The names are
+// compared as u32 words (no string literal, see the HP_HEX_* defines);
+// the trailing NUL word / byte is checked so a longer name sharing a
+// prefix (e.g. "TxtCounterShX") does not match. "TxtCounter" and
+// "TxtCounterSh" are distinguished by the NUL in the third word.
+static inline __attribute__((always_inline)) int hud_probe_is_hex_target(const char *name) {
+    const u32 *nw = (const u32 *)name;
+    if (nw[0] == HP_HEX_TCSH0 && nw[1] == HP_HEX_TCSH1 && nw[2] == HP_HEX_TCSH2 && nw[3] == HP_HEX_TCSH3) return 1;
+    if (nw[0] == HP_HEX_TC0 && nw[1] == HP_HEX_TC1 && nw[2] == HP_HEX_TC2) return 1;
+    if (nw[0] == HP_HEX_CAP020 && nw[1] == HP_HEX_CAP021 && nw[2] == HP_HEX_CAP022) return 1;
+    if (nw[0] == HP_HEX_CAP030 && nw[1] == HP_HEX_CAP031 && nw[2] == HP_HEX_CAP032) return 1;
+    if (nw[0] == HP_HEX_ROOT0 && nw[1] == HP_HEX_ROOT1 && name[8] == 0) return 1;
+    return 0;
+}
+
 // Find the hud_edge table entry for a pane (the same linear scan
 // hud_edge.c uses). Returns 0 when the pane has no entry (never matched,
 // or its slot was reclaimed).
@@ -283,18 +348,24 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         int entry_index = (int)(((uintptr_t)ent - (uintptr_t)table) / HUD_EDGE_ENTRY);
         slot = (entry_index - idx) / HUD_EDGE_N;
     }
+    // Hex-dump target (0134)? The coin number's own chain, matched or
+    // not -- Capture02/03 and RootPane are parents, never matched by
+    // hud_edge, but their struct bytes are where the (263,71) layout
+    // may hide.
+    int is_hex_target = hud_probe_is_hex_target((const char *)pane + 0xb8);
     // How many records: one pane record, plus one edge-decision record,
     // one layout record (0131), one chain record (0133) and one fields
     // record (0133) when matched -- five per matched pane, one per
-    // unmatched pane. All must fit, or none is written and the pane
+    // unmatched pane -- plus five hex-dump records (0134) when the pane
+    // is a hex target. All must fit, or none is written and the pane
     // stays un-seen (it retries next frame, when the host has flushed).
     // The 13-record cap is unchanged (the record buffer is 13 x 96
-    // bytes to the end of the state page); a matched pane now takes five
-    // slots, so a flush carries the aspect record plus two matched
-    // panes (and unmatched panes in the remaining slots), and the rest
-    // defer to the next flush -- the host flushes every present, so a
-    // 5-second stand-still still logs every pane.
-    int need = matched ? 5 : 1;
+    // bytes to the end of the state page); a matched target pane now
+    // takes ten slots, so a flush carries the aspect record plus one
+    // matched target pane (and unmatched panes in the remaining slots),
+    // and the rest defer to the next flush -- the host flushes every
+    // present, so a 5-second stand-still still logs every pane.
+    int need = (matched ? 5 : 1) + (is_hex_target ? HUD_PROBE_HEX_CHUNKS : 0);
     u32 rc = hdr[HP_REC_COUNT / 4];
     if (rc + (u32)need > HUD_PROBE_REC_CAP) return;
 
@@ -516,6 +587,37 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         rc++;
     }
 
+    // The hex-dump records (0134), for a target pane only: the pane
+    // struct's raw bytes 0x00-0xFF in 60-byte chunks. Each chunk's data
+    // spans the record's pname field (20 bytes) + v0..v6 (28) + w0..w2
+    // (12); w3 packs the chunk index, the byte count, the element index
+    // and the slot. The offsets and counts are multiples of 4, so the
+    // bytes are copied as u32 words (the record is volatile, one access
+    // per word, exactly as written). The last chunk's tail is zeroed so
+    // the record is deterministic. The host prints one greppable line
+    // per chunk (pane name + byte offset + hex); the (263,71) floats are
+    // 263.0 = 0x43838000 (bytes 00 80 83 43), 123.0 = 0x42F60000 (bytes
+    // 00 00 F6 42) and 71.0 = 0x428E0000 (bytes 00 00 8E 42).
+    if (is_hex_target) {
+        for (int c = 0; c < HUD_PROBE_HEX_CHUNKS; c++) {
+            int off = c * HUD_PROBE_HEX_CHUNK;
+            int cnt = HUD_PROBE_HEX_SPAN - off;
+            if (cnt > HUD_PROBE_HEX_CHUNK) cnt = HUD_PROBE_HEX_CHUNK;
+            volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+            hp_put_u32(rec, HP_R_TYPE, HP_REC_HEXDUMP);
+            hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+            hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+            hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+            for (int w = 0; w < HUD_PROBE_HEX_CHUNK / 4; w++) {
+                u32 v = 0;
+                if (w * 4 < cnt) v = *(const u32 *)((const char *)pane + off + w * 4);
+                hp_put_u32(rec, HP_R_PNAME + w * 4, v);
+            }
+            hp_put_u32(rec, HP_R_W3, (u32)c | ((u32)cnt << 8) | ((u32)(idx & 0xff) << 16) | ((u32)(slot & 0xff) << 24));
+            rc++;
+        }
+    }
+
     hdr[HP_REC_COUNT / 4] = rc;
     // Mark seen only after both records were written, so a deferred pane
     // (buffer full) retries next frame instead of being lost.
