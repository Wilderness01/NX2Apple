+        // Type 6 stores raw bytes in pname, not a string -- terminating
+        // it would corrupt data byte 19. (The stub still NUL-terminates
+        // the name field of a hex record, so name[19] above is safe.)
+        if (type != 6) pname[19] = '\0';
         if (type == 0) {
             float w = *(float *)(rec + 52);
             float h = *(float *)(rec + 56);
@@ -209,6 +219,30 @@ static void dm_hud_probe_tick(void) {
             uint32_t slot = (w3 >> 24) & 0xffu;
             LOG("[hudprobe] fields pane '%s' idx=%d slot=%d scale=(%.3f,%.3f) parent_scale=(%.3f,%.3f) size=%.0fx%.0f parent_size=%.0fx%.0f origin=0x%02x parent_origin=0x%02x live_global=(%.1f,%.1f)",
                 name, (int)idx, (int)slot, sx, sy, psx, psy, w, h, pw, ph, origin, porigin, lgx, lgy);
+        } else if (type == 6) {
+            // Hexdump (0134): 60 bytes of the pane struct per record.
+            // The data spans pname[20] + v0..v6 + w0..w2 (record
+            // +32..+91); w3 packs chunk | count<<8 | idx<<16 | slot<<24.
+            // The hex is the raw bytes in memory order (little-endian),
+            // so 263.0 prints as 00808343, 123.0 as 0000f642 and 71.0 as
+            // 00008e42 -- grep for those strings. idx/slot are 0xff for
+            // an unmatched pane (Capture02/03, RootPane).
+            uint32_t w3 = *(uint32_t *)(rec + 92);
+            uint32_t chunk = w3 & 0xffu;
+            uint32_t count = (w3 >> 8) & 0xffu;
+            uint32_t idx = (w3 >> 16) & 0xffu;
+            uint32_t slot = (w3 >> 24) & 0xffu;
+            if (count > 60) count = 60;
+            char hex[121];
+            for (uint32_t k = 0; k < count; k++) {
+                unsigned char b = (unsigned char)rec[32 + k];
+                hex[2 * k] = "0123456789abcdef"[b >> 4];
+                hex[2 * k + 1] = "0123456789abcdef"[b & 0xf];
+            }
+            hex[2 * count] = '\0';
+            LOG("[hudprobe] hexdump pane '%s' idx=%d slot=%d chunk=%d off=0x%02x bytes=%d hex=%s",
+                name, idx == 0xffu ? -1 : (int)idx, slot == 0xffu ? -1 : (int)slot,
+                (int)chunk, (int)(chunk * 60), (int)count, hex);
         }
     }
