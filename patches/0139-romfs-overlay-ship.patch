From 70616724d9ab654e8d0eb292610078009a179db2 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sun, 15 Nov 2026 04:39:36 +0000
Subject: [PATCH] 0139: ship the HUD .bflyt overlay with the app -- copy
 dm/romfs-overlay into Gen/dm at build time

---
 dm/ios/tools/build_ipa.sh                       |   6 ++++++
 dm/romfs-overlay/LayoutData/CounterCoin.szs     | Bin 0 -> 19065 bytes
 .../LayoutData/CounterCollectCoin.szs           | Bin 0 -> 18777 bytes
 dm/romfs-overlay/LayoutData/CounterLife.szs     | Bin 0 -> 84585 bytes
 dm/romfs-overlay/LayoutData/CounterShine.szs    | Bin 0 -> 5074 bytes
 dm/romfs-overlay/LayoutData/MapMini.szs         | Bin 0 -> 12738 bytes
 dm/romfs-overlay/LayoutData/PlayGuide.szs       | Bin 0 -> 22620 bytes
 7 files changed, 6 insertions(+)
 create mode 100644 dm/romfs-overlay/LayoutData/CounterCoin.szs
 create mode 100644 dm/romfs-overlay/LayoutData/CounterCollectCoin.szs
 create mode 100644 dm/romfs-overlay/LayoutData/CounterLife.szs
 create mode 100644 dm/romfs-overlay/LayoutData/CounterShine.szs
 create mode 100644 dm/romfs-overlay/LayoutData/MapMini.szs
 create mode 100644 dm/romfs-overlay/LayoutData/PlayGuide.szs

diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index 3019b44..77617ee 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -174,6 +174,12 @@ LD=$(python3 -c 'import json, sys; print(next((s["default"] for s in json.load(o
 if [ -n "$LD" ] && [ "$LD" != "$DM_LANG" ]; then t "game language: the game has no $DM_LANG; packing $LD, its first"; export DM_LANG=$LD; fi
 # Diagnostic build: DM_ENV_FILE=file → dm/env.txt in the bundle (main.m sets one environment variable per line at boot)
 if [ -n "${DM_ENV_FILE:-}" ]; then cp "$DM_ENV_FILE" Gen/dm/env.txt || die "copy DM_ENV_FILE"; t "env: $(grep -v '^#' "$DM_ENV_FILE" | tr '\n' ' ')"; fi
+# HUD .bflyt overlay (0136/0139): ship the rebuilt .szs with the app so main.m
+# finds dm/romfs-overlay in the bundle and sets DM_ROMFS_OVERLAY. The folder
+# lives in the repo at dm/romfs-overlay (committed as data, not code); without
+# this copy the 0136 env setup finds nothing and the overlay silently does
+# not apply -- the HUD stays at its 16:9 defaults.
+if [ -d "$DM/romfs-overlay" ]; then cp -R "$DM/romfs-overlay" Gen/dm/romfs-overlay || die "copy romfs-overlay"; t "romfs-overlay: $(find Gen/dm/romfs-overlay -type f | wc -l) files"; fi
 # The shader libraries go into the archive as DmIOS.app/msl/<folder>, or an NVN game's as the file DmIOS.app/msl/<folder>.img (main.m sets DM_MSL_DIR to msl)
 if [ "$GFXAPI" = vulkan ]; then MSLDIR=vk; elif [ "$GFXAPI" = gl ]; then MSLDIR=gl; else MSLDIR=b-$V; fi
 # Shared-font stand-ins: standard = macOS's Arial Unicode (absent on iOS), Nintendo extension = button icons generated by make_ext_font.py (needs fontTools; FONT_PY names a python that has it)
diff --git a/dm/romfs-overlay/LayoutData/CounterCoin.szs b/dm/romfs-overlay/LayoutData/CounterCoin.szs
new file mode 100644
index 0000000000000000000000000000000000000000..2b34e258a9b957a1839cf9206d7228928395f767
