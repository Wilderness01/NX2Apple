diff --git a/dm/tools/nso_asm.py b/dm/tools/nso_asm.py
index 0b346303..33fcd4bf 100644
--- a/dm/tools/nso_asm.py
+++ b/dm/tools/nso_asm.py
@@ -23,6 +23,7 @@ def CMPR(n, m): return 0xEB00001F | (m << 16) | (n << 5)   # cmp xn, xm (subs xz
 def MOV(dd, n): return 0xAA0003E0 | (n << 16) | dd   # mov x<dd>, x<n> (orr xd, xzr, xn)
 def MOVZ(dd, imm16, sh=0): return 0xD2800000 | (sh << 21) | ((imm16 & 0xFFFF) << 5) | dd   # movz x<dd>, #imm16 (lsl #16*sh)
 def MOVK(dd, imm16, sh=0): return 0xF2800000 | (sh << 21) | ((imm16 & 0xFFFF) << 5) | dd   # movk x<dd>, #imm16 (lsl #16*sh) — keeps the other halfwords, unlike movz
+def LDRW(t, n, imm12=0): return 0xB9400000 | (imm12 << 10) | (n << 5) | t   # ldr w<t>, [x<n>, #imm12*4] (32-bit load; the upper half of x<t> is zeroed)
 def SUBR(dd, n, m): return 0xCB000000 | (m << 16) | (n << 5) | dd   # sub x<dd>, x<n>, x<m>
 def CBZ(rt, frm, to):
     off = to - frm; assert -(1 << 20) <= off < (1 << 20) and off % 4 == 0
