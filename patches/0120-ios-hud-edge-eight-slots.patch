From d7125aed12867ae6016bf9304a43acf6f750a83e Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Thu, 12 Nov 2026 15:09:44 +0000
Subject: [PATCH] 0120: HUD edge anchor slots 2 -> 8 per element (fix V1.3.14
 drift)

V1.3.14 (build #45) lost the coin/moon numbers on device: log-28 shows
two TxtCounterSh + two TxtCounter panes match coins, but the edge table
had only two slots per element, so the third and fourth pane reclaimed
slot 0 every frame. The re-init re-derived the original matrix from the
pane's still-modified matrix (a static pane takes the skip path, so the
game has not recomputed it at the entry cut) and the offset drifted by
-140 per frame until the numbers were off-screen. Eight slots per element
(32 entries) give every observed pane its own entry; no reclamation, no
drift. BINDING v2 -> v3.
---
 dm/games/0100000000010000/hud_edge.c |  8 ++--
 dm/games/0100000000010000/patches.py | 71 ++++++++++++++--------------
 2 files changed, 39 insertions(+), 40 deletions(-)

diff --git a/dm/games/0100000000010000/hud_edge.c b/dm/games/0100000000010000/hud_edge.c
index af3ac8f..46b005a 100644
--- a/dm/games/0100000000010000/hud_edge.c
+++ b/dm/games/0100000000010000/hud_edge.c
@@ -56,8 +56,8 @@
 // it never reads a pane name and never decides a match.
 //
 // A moved pane's original matrix is stored in a small table (state +0x300,
-// eight 128-byte entries, two per element -- two layout instances can match
-// the same element) and the modified matrix is always re-derived from that
+// 32 128-byte entries, eight per element -- up to eight layout instances can
+// match the same element) and the modified matrix is always re-derived from that
 // original, so a fixed offset never accumulates into a drift, and a game
 // recompute (an animation, a count change, a layout reload) is followed by
 // re-storing the original. The offset, size and hidden flag the modified
@@ -85,7 +85,7 @@
 // dropped into the rewriter's patch area verbatim:
 //   x0 = the pane (nn::ui2d::Pane *), x1 = the aspect (state + 0x58: a float,
 //   the screen's width / height; 0 = 16:9), x2 = the edge table (state +
-//   0x300: eight 128-byte entries, two per HUD element), x3 = the manual
+//   0x300: 32 128-byte entries, eight per HUD element), x3 = the manual
 //   settings (state + 0x200: 12 floats, a u32 manual mask, a u32 hidden
 //   mask; a NULL pointer reads as no manual setting).
 //   Element order: 0 compass (right), 1 lives (right), 2 coins (left),
@@ -97,7 +97,7 @@ typedef unsigned long uintptr_t;
 
 #define HUD_EDGE_N 4
 #define HUD_EDGE_ENTRY 128         // bytes per table entry
-#define HUD_EDGE_SLOTS_PER_ELEM 2  // table slots per HUD element: two layout instances can match the same element
+#define HUD_EDGE_SLOTS_PER_ELEM 8  // table slots per HUD element: up to eight layout instances can match the same element (log-28 shows two TxtCounterSh + two TxtCounter matching coins; two slots thrashed and the re-init re-derived the original from an already-modified matrix, so the offset drifted off-screen -- 0120)
 
 // The manual settings block (state +0x200), as the host writes it.
 #define HUD_MANUAL_FLOATS 12       // dx, dy, k per element (4 elements)
diff --git a/dm/games/0100000000010000/patches.py b/dm/games/0100000000010000/patches.py
