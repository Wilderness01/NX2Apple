     r[0] = crop[0]; r[1] = crop[1]; r[2] = crop[2]; r[3] = crop[3]; return 1;
 }
 static int present_encode(id<MTLCommandBuffer> cb, id<MTLTexture> src, id<MTLTexture> dst, const int crop[4]) {
+    // Ultrawide (UW): every present, with the drawable (canvas) size in pixels. Updates the widened aspect from the size and runs the
+    // direct-write pass; a no-op when UW is not active. The 1600x900 texture is stretched to the 2340x1080 present shape (loader.c), which
+    // the canvas fills, so the picture is wider with correct proportions.
+    uw_frame_hook((double)dst.width, (double)dst.height);
     NSUInteger r[4]; if (!present_crop_rect(src, crop, r)) return 0;
     NSUInteger cx = r[0], cy = r[1], cw = r[2], ch = r[3];
     static uint64_t last_crop[8]; uint64_t meta[8] = {src.width, src.height, cx, cy, cw, ch, dst.width, dst.height};
