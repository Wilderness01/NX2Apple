diff --git a/dm/host/uw.c b/dm/host/uw.c
new file mode 100644
index 0000000..e9370ca
--- /dev/null
+++ b/dm/host/uw.c
@@ -0,0 +1,418 @@
+// uw.c — Ultrawide (UW) for NX2Apple. See uw-implementation.md for the
+// disassembly evidence (DmIOS file offsets) behind every constant and branch.
+#include "uw.h"
+#include "dm.h"
+#include <math.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <libkern/OSCacheControl.h>
+
+#define UW_LOG(...) LOG("[uw] " __VA_ARGS__)
+
+// --- constants (DmIOS file offsets in comments) ---
+#define UW_ASPECT_16_9   1.7777777777777777   // double @0xb6c70
+#define UW_ASPECT_MIN     0.5
+#define UW_ASPECT_MAX     8.0
+#define UW_ENABLE_MIN     1.7866666666666664 // double @0xb9d50 (update threshold)
+#define UW_TOL            1e-4f              // float @0xb8714
+#define UW_CHECK_169      0.001f             // float @0xb9e64 (trampoline tolerance)
+#define UW_NEG_169        (-1.77777779f)     // float @0xb9e60
+#define UW_RESTORE_169    0x3fe38e39u        // float bits of 1.7777778f
+#define UW_VTSLOT_MAX     63
+
+// --- config page (DmIOS 0x1014c7000+0x170; baked-in defaults from the file) ---
+static struct {
+    const char *mod;            // +0x170, default "main"
+    uint32_t patch0, patch1;    // +0x178/+0x17c
+    int32_t vtslot;             // +0x180, -1 = unset
+    uint32_t cam[5];            // +0x184..+0x194
+    float last_aspect;          // +0x198
+} g_cfg = {
+    .mod = "main",
+    .patch0 = 0x010edb04, .patch1 = 0xbd410101,
+    .vtslot = -1,
+    .cam = { 0x01e39d10, 0x01d05380, 0x38, 0xb0, 8 },
+    .last_aspect = -1.0f,
+};
+
+// --- state page (DmIOS 0x102291000) ---
+static struct {
+    uint8_t nopatch;            // +0x200
+    uintptr_t aspect_addr;      // +0x208 (0 = third path inert)
+    uintptr_t aspect_page;      // +0x210
+    uint64_t aspect_len;        // +0x218
+    uintptr_t mod_base;         // +0x220
+    uint64_t scan_hi;           // +0x228
+    uint64_t scan_lo;           // +0x230
+    int32_t negative;           // +0x238
+    float aspect;               // +0x23c (widened aspect)
+    int32_t enabled;            // +0x240
+    uint8_t inited;             // +0x244
+    uint8_t hooked;             // +0x248
+    _Atomic uint32_t active;    // +0x24c
+    uint8_t scan;               // +0x250
+    uint32_t proj;              // +0x254
+    uint32_t call_n;            // +0x258
+    uint32_t bad_n;             // +0x25c
+    uint8_t written;            // +0x260
+    uint8_t force;              // +0x264
+    uint32_t write_n;           // +0x268
+    void *orig_fn;              // +0x270
+    uint32_t tramp_n;           // +0x278
+} g_st;
+
+// --- MOD table (DmIOS 0x10236a900 header + 0x10236a970 entries, stride 0xf8) ---
+#define UW_MOD_MAX 8
+typedef struct {
+    const char *name;           // +0x00
+    uintptr_t base;             // +0x10
+    uint64_t size;              // +0x18
+    uint64_t f28;               // +0x28 (opaque; feeds scan_lo)
+    uint64_t aspect_off;        // +0x38
+    uint64_t aspect_size;       // +0x40
+    uint64_t f48, f50, f60;     // +0x48/+0x50/+0x60 (opaque; feed scan_hi)
+} uw_mod_t;
+static uw_mod_t g_mods[UW_MOD_MAX];
+static int g_mods_n;
+static int g_log_level;         // DM_UW_LOG, parsed once
+static uint8_t g_squeeze = 1;   // +0x538: 1 = off (default), 0 = on
+static int g_ui_mode = 6;       // +0x53c
+static int g_safe;              // DM_UW_SAFE flag (0x1014c3000+0x28c)
+static bool g_hook_ok;
+
+// --- helpers ---
+static void uw_flush(void *addr, size_t len) {
+    // DmIOS dispatches through a host callback table (0x5b46c); the engine
+    // equivalent is sys_icache_invalidate (hle_cheats.c:608, probe.c:173).
+    sys_icache_invalidate(addr, len);
+}
+
+static int uw_parse_one(char **cursor, uint32_t *out) {
+    // DmIOS 0x83c2c: skip ','/' '/tab, then strtoul(..., 16). 1 = parsed.
+    char *s = *cursor;
+    for (;;) {
+        unsigned char c = (unsigned char)*s;
+        if (c == ',' || c == ' ' || c == '\t') { s++; continue; }
+        break;
+    }
+    if (!*s) return 0;
+    char *end = NULL;
+    unsigned long v = strtoul(s, &end, 16);
+    if (end == s) return 0;
+    *out = (uint32_t)v;
+    *cursor = end;
+    return 1;
+}
+
+static int uw_env_flag(const char *name) {
+    // "non-empty and first char != '0'" — the pattern every DM_UW_* flag uses.
+    const char *e = getenv(name);
+    return e && *e && *e != '0';
+}
+
+static const uw_mod_t *uw_mod_find(const char *name) {
+    for (int i = 0; i < g_mods_n; i++)
+        if (name && g_mods[i].name && !strcmp(g_mods[i].name, name)) return &g_mods[i];
+    return NULL;
+}
+
+void uw_mod_register(const char *name, uintptr_t main_base, uint64_t size,
+                     uint64_t aspect_off, uint64_t aspect_size) {
+    if (g_mods_n >= UW_MOD_MAX) { UW_LOG("[RED] MOD table full, %s not registered", name); return; }
+    uw_mod_t *m = &g_mods[g_mods_n++];
+    memset(m, 0, sizeof *m);
+    m->name = name; m->base = main_base; m->size = size;
+    m->aspect_off = aspect_off; m->aspect_size = aspect_size;
+}
+
+// --- aspect-apply: third write path (DmIOS 0x834e4) ---
+static void uw_apply_aspect(float aspect) {
+    if (!g_st.aspect_addr) return;
+    if (g_st.aspect_page &&
+        mprotect((void *)g_st.aspect_page, (size_t)g_st.aspect_len, PROT_READ | PROT_WRITE) == 0) {
+        uw_flush((void *)g_st.aspect_addr, 4);
+        *(float *)g_st.aspect_addr = aspect;
+        if (mprotect((void *)g_st.aspect_page, (size_t)g_st.aspect_len, PROT_READ) != 0)
+            UW_LOG("[RED] aspect-apply: mprotect restore failed");
+    } else {
+        uint32_t bits; memcpy(&bits, &aspect, sizeof bits);   // float bits, no type punning (strict aliasing)
+        UW_LOG("[RED] aspect-apply: mprotect failed, aspect %#x not written", bits);
+    }
+}
+
+// --- trampoline: vtable slot hook (DmIOS 0x83cc4) ---
+// Generic 16-argument signature so every argument register is forwarded
+// (x0-x7, d0-d7 per AAPCS64). The hooked slot is the projection object's
+// calcMatrix-style vtable entry; it takes no float argument in d0-d2 (the
+// original asm clobbers them as scratch), so forwarding is safe.
+typedef void (*uw_calc_fn)(void *, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t,
+                           double, double, double, double, double, double, double, double);
+static void uw_trampoline(void *x0, uint64_t x1, uint64_t x2, uint64_t x3, uint64_t x4,
+                          uint64_t x5, uint64_t x6, uint64_t x7,
+                          double d0, double d1, double d2, double d3,
+                          double d4, double d5, double d6, double d7) {
+    float *field = (float *)((char *)x0 + g_cfg.cam[3]);   // CAM[3] = 176
+    float cur = *field;
+    uw_calc_fn orig = (uw_calc_fn)g_st.orig_fn;
+    // The original asm passes d0 = widened aspect whenever UW is enabled and
+    // the widened value is non-zero (s0 side effect); otherwise d0 passes through.
+    double d0o = d0;
+    if (g_st.enabled && g_st.aspect != 0.0f) d0o = (double)g_st.aspect;
+    if (g_st.enabled && g_st.aspect != 0.0f &&
+        (g_st.force || fabsf(cur + UW_NEG_169) <= UW_CHECK_169)) {
+        *field = g_st.aspect;                              // temporary swap
+        orig(x0, x1, x2, x3, x4, x5, x6, x7, d0o, d1, d2, d3, d4, d5, d6, d7);
+        *field = cur;                                      // restore
+    } else {
+        orig(x0, x1, x2, x3, x4, x5, x6, x7, d0o, d1, d2, d3, d4, d5, d6, d7);
+    }
+    if (g_st.tramp_n++ == 0)
+        UW_LOG("calcMatrix this=%p aspect %g -> %g", x0, (double)cur, (double)g_st.aspect);
+}
+
+// --- vtable hook install (DmIOS 0x832a4) ---
+static int uw_install_hook(void) {
+    if (g_cfg.vtslot < 0) return -1;
+    if (!g_st.mod_base || !g_cfg.cam[1]) return -1;
+    uintptr_t vt = g_st.mod_base + g_cfg.cam[1];
+    void **slot = (void **)(vt + (uintptr_t)g_cfg.vtslot * 8);
+    void *orig = *slot;
+    if ((uintptr_t)orig <= 0xfff) { UW_LOG("[RED] hook: slot %d empty (%p)", g_cfg.vtslot, orig); return -1; }
+    if (orig == (void *)uw_trampoline) { g_st.hooked = 1; return 0; }  // idempotent
+    g_st.orig_fn = orig;
+    long ps = sysconf(_SC_PAGESIZE);
+    if (ps <= 0) ps = 0x4000;
+    uintptr_t page = (uintptr_t)slot & ~((uintptr_t)ps - 1);
+    // The original queries the current protection through a Mach wrapper and
+    // restores it afterwards; the engine uses plain mprotect (probe.c:418).
+    // The vtable page is RX; restore to PROT_READ|PROT_EXEC.
+    if (mprotect((void *)page, (size_t)ps, PROT_READ | PROT_WRITE) != 0) {
+        UW_LOG("[RED] hook: mprotect RW failed (%p), vtable hook unavailable", (void *)page);
+        return -1;
+    }
+    *slot = (void *)uw_trampoline;
+    sys_icache_invalidate(slot, sizeof *slot);
+    if (mprotect((void *)page, (size_t)ps, PROT_READ | PROT_EXEC) != 0)
+        UW_LOG("[RED] hook: mprotect restore failed");
+    g_st.hooked = 1;
+    UW_LOG("hooked vtable slot %d (%s+%#x), orig %p", g_cfg.vtslot, g_cfg.mod, g_cfg.cam[1], orig);
+    return 0;
+}
+
+// --- direct-write (DmIOS 0x83714 wrapper + 0x83880) ---
+static void uw_direct_write(void) {
+    if (!g_st.inited) return;
+    if (g_st.hooked) {   // hook active: trampoline owns the aspect
+        atomic_store_explicit(&g_st.active,
+            (uint32_t)(g_st.enabled && g_st.aspect != 0.0f), memory_order_release);
+        return;
+    }
+    if (g_st.scan) {      // DM_UW_SCAN: one-shot diagnostic scan (log only)
+        g_st.scan = 0;
+        uintptr_t lo = g_st.scan_lo, hi = g_st.scan_hi;
+        uintptr_t want = g_st.mod_base + g_cfg.cam[1];
+        for (uintptr_t p = lo; p + 8 <= hi; p += 8) {
+            if (*(uintptr_t *)p == want) {
+                float a = *(float *)((char *)p + g_cfg.cam[3]);
+                UW_LOG("scan: slot %p aspect %g (vtable %#x)", (void *)p, (double)a, g_cfg.cam[1]);
+            }
+        }
+    }
+    uintptr_t obj;
+    if (g_st.proj) {
+        obj = g_st.mod_base + g_st.proj;
+    } else {
+        obj = *(uintptr_t *)(g_st.mod_base + g_cfg.cam[0]);   // [base + CAM[0]]
+    }
+    g_st.call_n++;
+    if (!obj) {
+        g_st.bad_n++;
+        atomic_store_explicit(&g_st.active, 0, memory_order_release);
+        return;
+    }
+    obj += g_cfg.cam[2];                                       // +56
+    uintptr_t vtab = *(uintptr_t *)obj;
+    if (g_st.call_n <= 3)
+        UW_LOG("direct: obj %p vtab %#llx aspect %g (want %#llx)",
+               (void *)obj, (unsigned long long)vtab,
+               (double)*(float *)((char *)obj + g_cfg.cam[3]),
+               (unsigned long long)(g_st.mod_base + g_cfg.cam[1]));
+    if (vtab != g_st.mod_base + g_cfg.cam[1]) {                // not the target object
+        g_st.bad_n++;
+        if (g_st.bad_n == 1)
+            UW_LOG("[RED] direct: object %p vtab %#llx != %#llx, skipping",
+                   (void *)obj, (unsigned long long)vtab,
+                   (unsigned long long)(g_st.mod_base + g_cfg.cam[1]));
+        atomic_store_explicit(&g_st.active, 0, memory_order_release);
+        return;
+    }
+    float *field = (float *)((char *)obj + g_cfg.cam[3]);
+    if (!g_st.enabled || g_st.aspect == 0.0f) {               // restore path
+        atomic_store_explicit(&g_st.active, 0, memory_order_release);
+        if (g_st.written) {
+            uw_flush(field, 4);
+            *(uint32_t *)field = UW_RESTORE_169;               // 1.7777778f
+            *(uint8_t *)((char *)obj + g_cfg.cam[4]) = 1;
+            g_st.written = 0;
+            UW_LOG("direct: restored aspect to 16:9");
+        }
+        return;
+    }
+    float cur = *field;
+    if (fabsf(cur - g_st.aspect) <= UW_TOL) {                  // already wide
+        atomic_store_explicit(&g_st.active, 1, memory_order_release);
+        return;
+    }
+    if (!g_st.force && fabsf(cur + UW_NEG_169) > UW_TOL) {     // not 16:9
+        if (cur != g_cfg.last_aspect) {
+            g_cfg.last_aspect = cur;
+            UW_LOG("direct: aspect %g is not 16:9, skipping", (double)cur);
+        }
+        return;
+    }
+    uw_flush(field, 4);
+    *field = g_st.aspect;
+    *(uint8_t *)((char *)obj + g_cfg.cam[4]) = 1;
+    g_st.written = 1;
+    atomic_store_explicit(&g_st.active, 1, memory_order_release);
+    if (g_st.write_n++ == 0)
+        UW_LOG("direct: aspect %g -> %g (obj %p)", (double)cur, (double)g_st.aspect, (void *)obj);
+}
+
+// --- update from canvas size (DmIOS 0x835d0) ---
+static void uw_update_from_size(double w, double h) {
+    if (h <= 0.0) return;
+    if (!g_st.inited) return;
+    double aspect = w / h;
+    int enabled = (aspect > UW_ENABLE_MIN && aspect <= UW_ASPECT_MAX) ? 1 : 0;
+    if (enabled != g_st.enabled ||
+        (enabled && fabsf((float)aspect - g_st.aspect) > UW_TOL)) {
+        float old = g_st.aspect;
+        g_st.enabled = enabled;
+        if (enabled) g_st.aspect = (float)aspect;
+        uw_apply_aspect(g_st.aspect);
+        UW_LOG("canvas %.0fx%.0f aspect %.4f -> %s (was %.4f)",
+               w, h, aspect, enabled ? "on" : "off", (double)old);
+    }
+}
+
+void uw_frame_hook(double w, double h) {
+    uw_update_from_size(w, h);
+    uw_direct_write();
+}
+
+float uw_effective_aspect(float in) {
+    if (!g_st.inited) return in;
+    if (atomic_load_explicit(&g_st.active, memory_order_acquire)) return g_st.aspect;
+    return in;
+}
+
+bool uw_hook_ok(void) { return g_hook_ok; }
+bool uw_squeeze_enabled(void) { return g_squeeze == 0; }
+int uw_ui_mode(void) { return g_ui_mode; }
+
+// --- env parsing + init (DmIOS 0x82b2c) ---
+int uw_init(void) {
+    const char *e;
+    // DM_UW_CAM: up to 5 hex values, comma/space/tab separated.
+    if ((e = getenv("DM_UW_CAM")) && *e) {
+        char *cur = (char *)e;
+        int n = 0;
+        while (n < 5 && uw_parse_one(&cur, &g_cfg.cam[n])) n++;
+        if (n < 2) UW_LOG("[RED] DM_UW_CAM needs at least 2 values, got %d", n);
+    }
+    if ((e = getenv("DM_UW_MOD")) && *e) g_cfg.mod = e;
+    if (uw_env_flag("DM_UW_NOPATCH")) g_st.nopatch = 1;
+    if ((e = getenv("DM_UW_PROJ")) && *e) {
+        char *cur = (char *)e;
+        uw_parse_one(&cur, &g_st.proj);
+    }
+    if (uw_env_flag("DM_UW_SCAN")) g_st.scan = 1;
+    if (uw_env_flag("DM_UW_FORCE")) g_st.force = 1;
+    if ((e = getenv("DM_UW_VTSLOT")) && *e) {
+        char *end = NULL;
+        long v = strtol(e, &end, 0);
+        if (end != e && v <= UW_VTSLOT_MAX) g_cfg.vtslot = (int32_t)v;
+    }
+    if ((e = getenv("DM_UW_PATCH")) && *e) {
+        char *cur = (char *)e;
+        int n = 0;
+        while (n < 2 && uw_parse_one(&cur, &g_cfg.patch0 + n)) n++;
+        g_st.nopatch = 0;   // PATCH clears NOPATCH (DmIOS 0x82e18)
+    }
+    // DM_UW_LOG (parsed once per frame in the original, 0x4cf88; here at init —
+    // the level only gates diagnostics and the engine LOG macro has no levels).
+    if ((e = getenv("DM_UW_LOG")) && *e) g_log_level = atoi(e);
+    // DM_UW_SAFE (parsed in a matrix helper in the original, 0x8aec; default off).
+    if (uw_env_flag("DM_UW_SAFE")) g_safe = 1;
+    // MOD lookup.
+    const uw_mod_t *mod = uw_mod_find(g_cfg.mod);
+    if (!mod) { UW_LOG("[RED] UW: no MOD entry for '%s'", g_cfg.mod); return 10; }
+    g_st.mod_base = mod->base;
+    if (g_st.nopatch) {
+        if (mod->aspect_size < 0x104) {
+            UW_LOG("[RED] UW: MOD entry too small (%llu), aspect-apply disabled",
+                   (unsigned long long)mod->aspect_size);
+        } else {
+            g_st.aspect_addr = mod->base + mod->aspect_off + 0x100;
+            g_st.aspect_page = g_st.aspect_addr & ~0x3fffUL;
+            g_st.aspect_len = mod->aspect_size;
+        }
+    } else {
+        // NOPATCH=0: validate [base + PATCH[0]] == PATCH[1].
+        if (*(uint32_t *)(mod->base + g_cfg.patch0) != g_cfg.patch1)
+            UW_LOG("[RED] UW: PATCH check failed at %#x", g_cfg.patch0);
+    }
+    g_st.scan_lo = mod->f28;
+    g_st.scan_hi = mod->f48 >= 1 ? mod->f60 : mod->f50;
+    // DM_ASPECT.
+    double d8 = -1.0;
+    if ((e = getenv("DM_ASPECT")) && *e) {
+        if (!strcmp(e, "0")) {
+            d8 = 0.0;
+        } else if (!strcmp(e, "off") || !strcmp(e, "auto")) {
+            d8 = -1.0;   // off: stays -1; auto: resolved per-frame from the canvas
+        } else if (!strcmp(e, "16:9")) {
+            d8 = UW_ASPECT_16_9;
+        } else {
+            // sscanf with a trailing %c: "16:9" -> 2, "16:9x" -> 3 (invalid).
+            double w = 0, h = 0, single = 0;
+            char tail = 0;
+            int n1 = sscanf(e, "%lf:%lf%c", &w, &h, &tail);
+            int n2 = (n1 != 2) ? sscanf(e, "%lfx%lf%c", &w, &h, &tail) : 0;
+            if (n1 == 2 || n2 == 2) {
+                d8 = w / h;
+            } else if (sscanf(e, "%lf%c", &single, &tail) == 1) {
+                d8 = single;
+            }
+            if (d8 < UW_ASPECT_MIN || d8 > UW_ASPECT_MAX) {
+                UW_LOG("[RED] DM_ASPECT %s: <w>:<h> or a value %.1f-%.1f", e, UW_ASPECT_MIN, UW_ASPECT_MAX);
+                d8 = -1.0;
+            }
+        }
+    }
+    g_st.negative = (d8 < 0) ? 1 : 0;
+    g_st.aspect = (float)d8;
+    g_st.enabled = (d8 > 0) ? 1 : 0;
+    g_st.inited = 1;
+    uw_apply_aspect(g_st.aspect > 0 ? g_st.aspect : 0.0f);
+    UW_LOG("aspect %.4f %s (MOD %s, NOPATCH %d)", d8,
+           g_st.negative ? "auto" : (d8 > 0 ? "explicit" : "off"),
+           g_cfg.mod, g_st.nopatch);
+    if (g_st.enabled)
+        UW_LOG("widening %.1f%% (%.4f / 16:9)", (d8 / UW_ASPECT_16_9 - 1.0) * 100.0, d8);
+    // vtable hook.
+    if (uw_install_hook() == 0) {
+        g_hook_ok = true;
+    } else {
+        UW_LOG("[RED] UW: vtable hook not installed, direct-write only");
+        g_hook_ok = false;
+    }
+    // CAM check (log only, not a gate — DmIOS 0x8344c).
+    if (g_cfg.cam[0] != 0x01e39d10 || g_cfg.cam[1] != 0x01d05380)
+        UW_LOG("CAM %#x,%#x (not the baked-in %#x,%#x)", g_cfg.cam[0], g_cfg.cam[1], 0x01e39d10, 0x01d05380);
+    return 0;
+}
