new file mode 100644
index 0000000..077f055
--- /dev/null
+++ b/dm/host/uw.h
@@ -0,0 +1,53 @@
+// uw.h — Ultrawide (UW): camera-aspect widening for 19.5:9 iPhones.
+// The game keeps rendering 1600x900; the camera aspect is temporarily widened
+// to the screen aspect (2.167) while the projection matrix is built, and the
+// present layer stretches the 1600x900 output to fill the screen. The widen
+// factor (1.219) cancels the stretch factor (1.219), so the picture is wider
+// with correct proportions. Rewritten from the 3.0 IPA's DmIOS binary
+// (see uw-implementation.md); no S2Arm source was available.
+#ifndef DM_HOST_UW_H
+#define DM_HOST_UW_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Register a game module for the MOD table. Call at module load, before uw_init.
+//   name: module name for DM_UW_MOD matching ("main" for Odyssey).
+//   main_base: the module's main-code base (framework image base + 0x300000).
+//   size: module size (address-range lookup; 0 = unknown, lookup by name only).
+//   aspect_off/aspect_size: offset/size of the game's display-aspect float used
+//     by the third write path; pass 0/0 when unknown (that path stays inert).
+void uw_mod_register(const char *name, uintptr_t main_base, uint64_t size,
+                     uint64_t aspect_off, uint64_t aspect_size);
+
+// Parse DM_UW_* env, resolve the MOD entry, compute the widened aspect and
+// install the vtable hook. Call once at game start (loader.c, next to
+// install_fps_state). Returns 0 on success, non-zero when UW is not active
+// (no MOD entry, DM_ASPECT off/16:9, or the hook could not install —
+// direct-write still runs in that case, see uw_hook_ok).
+int uw_init(void);
+
+// Per-frame hook: call every present with the canvas (drawable) size in pixels.
+// Updates the widened aspect from the size and runs the direct-write pass.
+void uw_frame_hook(double w, double h);
+
+// Effective aspect for UI/layout code: the widened aspect when UW is active,
+// otherwise the input unchanged.
+float uw_effective_aspect(float in);
+
+// Whether the vtable hook installed (false -> direct-write only).
+bool uw_hook_ok(void);
+
+// DM_UW_SQUEEZE=1 (UI squeeze). Default off.
+bool uw_squeeze_enabled(void);
+
+// DM_UW_UI mode (default 6).
+int uw_ui_mode(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
