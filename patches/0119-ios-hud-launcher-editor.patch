 // The pane names, as little-endian u32s (no string literal: a literal would
 // sit in .rodata and the code would load its address with an adrp, a
 // relocation, and the embedded words carry no literal pool).
@@ -105,6 +148,62 @@ static inline __attribute__((always_inline)) int hud_edge_words_eq(const u32 *nw
     return 1;
 }
 
+// A manual size outside [0.6, 1.8], or not a number, is the editor's bug, not
+// a request: fall back to 1 (no resize). A zero scale is not a request either
+// (the state page starts zeroed, so an unwritten k reads as 0 and must mean
+// identity, never a collapse). The NaN test is k != k (a NaN is not equal to
+// itself); a negative scale would mirror the widget, which nobody asked for.
+// (The launcher's slider only writes 0.6 to 1.8; the host clamps too; this is
+// the third clamp, so a wild environment variable can never collapse a widget.)
+static inline __attribute__((always_inline)) float hud_edge_clamp_k(float k) {
+    if (k == 0.0f || k != k) return 1.0f;
+    if (k < 0.6f) return 0.6f;
+    if (k > 1.8f) return 1.8f;
+    return k;
+}
+
+// A manual offset outside the layout is the editor's bug, not a request:
+// clamp it, so a wild environment variable can never throw a widget off the
+// screen (hiding is the only way off-screen, and it is explicit).
+static inline __attribute__((always_inline)) float hud_edge_clamp_off(float v, float lim) {
+    if (v != v) return 0.0f;
+    if (v > lim) return lim;
+    if (v < -lim) return -lim;
+    return v;
+}
+
+// Scale orig about the pane's centre, then move by (dx, dy) in layout units,
+// into mod. sx scales the x row, sy the y row (a HUD widget passes
+// sx == sy == k). The centre is the pane's middle passed through its own
+// matrix. The middle is found from the pane's origin (the byte at +0x5b,
+// confirmed by disassembly of the local matrix helper at main+0x9096d0: bits
+// 4-5 the horizontal origin, 1 left, 2 right; bits 6-7 the vertical origin,
+// 1 top, 2 bottom; 0 is the centre either way) and its size at +0x50 /
+// +0x54: the centre is the origin plus half the size towards the middle
+// (the layout is y-up, the origin at the parent's centre, so a top origin's
+// centre is half the height below it, a left origin's half the width to its
+// right). A pane with no usable size scales about its translation (its
+// origin), which is the same thing for a point-sized pane. The third row
+// (depth) is left alone: this is a 2D widget, and scaling its depth would
+// change its draw order. (From the old hud_calc.c, unchanged.)
+static inline __attribute__((always_inline)) void hud_edge_xform(const float *orig, float *mod, float dx, float dy,
+                      float sx, float sy, float w, float h, unsigned char origin) {
+    float cx, cy;
+    if (w > 0.0f && w < 100000.0f && h > 0.0f && h < 100000.0f) {
+        float ox = ((origin >> 4) & 3) == 1 ? w * 0.5f : ((origin >> 4) & 3) == 2 ? -w * 0.5f : 0.0f;
+        float oy = ((origin >> 6) & 3) == 1 ? -h * 0.5f : ((origin >> 6) & 3) == 2 ? h * 0.5f : 0.0f;
+        cx = orig[0] * ox + orig[1] * oy + orig[3];
+        cy = orig[4] * ox + orig[5] * oy + orig[7];
+    } else {
+        cx = orig[3];
+        cy = orig[7];
+    }
+    for (int i = 0; i < 3; i++) { mod[i] = orig[i] * sx; mod[4 + i] = orig[4 + i] * sy; }
+    mod[3] = cx + (orig[3] - cx) * sx + dx;
+    mod[7] = cy + (orig[7] - cy) * sy + dy;
+    for (int i = 8; i < 12; i++) mod[i] = orig[i];
+}
