+// hud_manual.c -- the launcher HUD editor's host side (0119, V1.3.14). The
+// launcher's HUD editor (HudEditor.swift) writes the four DM_HUD_* environment
+// variables before the game starts; this file copies them into the frame step
+// state page (state +0x200), where the rewriter's hud_edge stub reads them every
+// frame. Nothing here writes game code: the stub is a load-time rewriter cut
+// (patches.py), and this file only writes the state page's data.
+#include "hud_manual.h"
+#include "dm.h"    // LOG
+#include "hle.h"   // dm_fps_state
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+// The HUD block in the frame step state page (patches.py, hud_edge.c):
+//   +0x200: 12 floats, per element (dx, dy, k): compass, lives, coins, moons
+//   +0x230: u32 manual mask, one bit per element (the launcher set it)
+//   +0x234: u32 hidden mask, one bit per element (the launcher hid it)
+//   +0x300: the HUD table (8 x 128 bytes, two per element, hud_edge's working copy)
+// The block fits the frame step state's reserved 0x4000 bytes; loader.c's own
+// fields end below +0x200, so there is no overlap. (0113 used the same +0x200
+// block for its own params; that block is free now that 0113 is deleted.)
+#define HUD_MANUAL_PARAMS_OFF  0x200
+#define HUD_MANUAL_MASK_OFF    (HUD_MANUAL_PARAMS_OFF + 48)
+#define HUD_MANUAL_HIDDEN_OFF  (HUD_MANUAL_PARAMS_OFF + 52)
+
+#define HUD_LOG(...) LOG("[hud] " __VA_ARGS__)
+
+// The four environment variables the launcher's HUD editor writes (HudEditor.swift):
+//   DM_HUD_COMPASS / DM_HUD_LIFE / DM_HUD_COINS / DM_HUD_MOONS
+// Each is "dx,dy,k,hidden" (dx, dy in layout points, 1280x720 space; k the size
+// multiplier; hidden 1 to hide the element). Unset (or unparseable) means the
+// element has no manual setting: it keeps the auto edge anchor (0118).
+static const char *const g_hud_env[DM_HUD_N] = {
+    "DM_HUD_COMPASS", "DM_HUD_LIFE", "DM_HUD_COINS", "DM_HUD_MOONS",
+};
+
+static float g_hud_dx[DM_HUD_N], g_hud_dy[DM_HUD_N], g_hud_k[DM_HUD_N] = {1, 1, 1, 1};   // as last written to the state page
+static uint32_t g_hud_manual, g_hud_hidden;   // the masks, as written to the state page
+static int g_hud_started;                     // the first write (or the no-settings line) has been logged
+
+static float hud_clamp_k(float k) { if (!(k > 0)) return 1; return fminf(fmaxf(k, 0.6f), 1.8f); }
+static float hud_clamp_dx(float dx) { return fminf(fmaxf(dx, -640.0f), 640.0f); }
+static float hud_clamp_dy(float dy) { return fminf(fmaxf(dy, -360.0f), 360.0f); }
+
+// Parse one "dx,dy,k,hidden" value. Returns 1 and fills dx/dy/k/hidden when the
+// string parses fully (four comma-separated fields, nothing trailing); 0 when the
+// variable is unset or malformed (then the element keeps the auto edge anchor).
+static int hud_parse(const char *s, float *dx, float *dy, float *k, int *hidden) {
+    if (!s || !*s) return 0;
+    char *end;
+    float v0 = strtof(s, &end); if (end == s || *end != ',') return 0; s = end + 1;
+    float v1 = strtof(s, &end); if (end == s || *end != ',') return 0; s = end + 1;
+    float v2 = strtof(s, &end); if (end == s || *end != ',') return 0; s = end + 1;
+    long v3 = strtol(s, &end, 10); if (end == s || *end != '\0') return 0;
+    *dx = hud_clamp_dx(v0); *dy = hud_clamp_dy(v1); *k = hud_clamp_k(v2); *hidden = v3 != 0;
+    return 1;
+}
+
+void dm_hud_manual_frame_tick(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    float dx[DM_HUD_N], dy[DM_HUD_N], k[DM_HUD_N];
+    uint32_t manual = 0, hidden = 0;
+    for (int i = 0; i < DM_HUD_N; i++) {
+        int hid = 0;
+        if (hud_parse(getenv(g_hud_env[i]), &dx[i], &dy[i], &k[i], &hid)) {
+            manual |= 1u << i;
+            if (hid) hidden |= 1u << i;
+        } else {
+            dx[i] = 0; dy[i] = 0; k[i] = 1;   // unset: the stub never reads these (no manual bit)
+        }
+    }
+    // Write only when something changed. The state page is the stub's input, and
+    // rewriting it every present would be a needless write.
+    int changed = manual != g_hud_manual || hidden != g_hud_hidden;
+    if (!changed) {
+        for (int i = 0; i < DM_HUD_N; i++) {
+            if ((manual & (1u << i)) && (dx[i] != g_hud_dx[i] || dy[i] != g_hud_dy[i] || k[i] != g_hud_k[i])) { changed = 1; break; }
+        }
+    }
+    if (!changed) {
+        if (!g_hud_started) {   // log once even when nothing is set, so the log shows the channel was checked
+            HUD_LOG("HUD manual: no DM_HUD_* set, auto edge anchor only");
+            g_hud_started = 1;
+        }
+        return;
+    }
+    memcpy(g_hud_dx, dx, sizeof dx); memcpy(g_hud_dy, dy, sizeof dy); memcpy(g_hud_k, k, sizeof k);
+    g_hud_manual = manual; g_hud_hidden = hidden;
+    float params[12];
+    for (int i = 0; i < DM_HUD_N; i++) { params[i*3] = dx[i]; params[i*3+1] = dy[i]; params[i*3+2] = k[i]; }
+    memcpy(st + HUD_MANUAL_PARAMS_OFF, params, sizeof params);
+    memcpy(st + HUD_MANUAL_MASK_OFF, &manual, 4);
+    memcpy(st + HUD_MANUAL_HIDDEN_OFF, &hidden, 4);
+    if (!g_hud_started) {
+        HUD_LOG("HUD manual: state page at %p, manual mask %#x, hidden mask %#x", (void *)st, manual, hidden);
+        for (int i = 0; i < DM_HUD_N; i++) {
+            if (manual & (1u << i)) HUD_LOG("HUD manual: element %d dx %.0f dy %.0f k %.2f hidden %d", i, dx[i], dy[i], k[i], (hidden >> i) & 1u);
+        }
+        g_hud_started = 1;
+    } else {
+        HUD_LOG("HUD manual: settings changed, manual mask %#x, hidden mask %#x", manual, hidden);
+    }
+}
