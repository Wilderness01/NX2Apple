diff --git a/dm/ios/Sources/HudEditor.swift b/dm/ios/Sources/HudEditor.swift
new file mode 100644
index 0000000..5c6a974
--- /dev/null
+++ b/dm/ios/Sources/HudEditor.swift
@@ -0,0 +1,348 @@
+// HudEditor.swift -- the launcher HUD editor (0119, V1.3.14). The settings screen
+// shows a game preview (the forest scene, the four HUD elements, the menu/map
+// hints) at the device's screen shape, and each element can be dragged, resized
+// (60%-180%) or hidden. A manual setting wins over the auto edge anchor (0118);
+// an element with no manual setting keeps the auto edge. Hidden in the editor
+// means hidden in the game. The settings are kept in UserDefaults and, when the
+// game starts, written to the DM_HUD_* environment variables (HudSettings).
+// The game reads them through the host (dm/host/hud_manual.c -> state page
+// +0x200 -> hud_edge.c). The four preview shapes are iPhone 19.5:9, iPhone Duo
+// 1.43:1, iPad 4:3 and 16:9; the default is the device's own shape.
+import SwiftUI
+import Foundation
+
+// One element's manual setting: an offset (dx, dy) in layout points (1280x720
+// space, y up, from the game's base layout position), a size multiplier k, and
+// whether the element is hidden. Encoded as "dx,dy,k,hidden" (dx, dy whole
+// points, k two decimals, hidden 1 / 0): the same string the host parses from
+// the DM_HUD_* environment variable, so the launcher and the host agree.
+struct HudElementSetting: Equatable {
+    var dx, dy, k: Double
+    var hidden: Bool
+    var encoded: String { "\(Int(dx.rounded())),\(Int(dy.rounded())),\(String(format: "%.2f", k)),\(hidden ? 1 : 0)" }
+    static func decode(_ s: String) -> HudElementSetting? {
+        let p = s.split(separator: ",")
+        guard p.count == 4, let dx = Double(p[0]), let dy = Double(p[1]), let k = Double(p[2]), let h = Int(p[3]) else { return nil }
+        return HudElementSetting(dx: dx, dy: dy, k: k, hidden: h != 0)
+    }
+}
+
+// The four HUD elements, in the game's order (hud_edge.c, hud_manual.c, patches.py).
+// The coins group ("金币") is the moons element's fallback: when no separate moons
+// setting exists, the moons element follows the coins group's setting, so the top
+// cluster (coin icon, moon icon, the white bar) moves as one unit -- the grouping
+// the player picked (the white part on top is the coins group, the dots below it
+// are the moons group). In the game the moon counter (icon, number, dots) is one
+// pane group (Counter), so it moves as one unit; the coin icon is a separate unit.
+enum HudElement: Int, CaseIterable, Identifiable {
+    case compass = 0, lives, coins, moons
+    var id: Int { rawValue }
+    var env: String {
+        switch self { case .compass: return "DM_HUD_COMPASS"; case .lives: return "DM_HUD_LIFE"; case .coins: return "DM_HUD_COINS"; case .moons: return "DM_HUD_MOONS" }
+    }
+    var name: String {
+        switch self { case .compass: return "指南针"; case .lives: return "生命"; case .coins: return "金币"; case .moons: return "月亮" }
+    }
+    var key: String { "DmHudManual.\(rawValue)" }   // UserDefaults key, one per element
+    // The element's centre in the 16:9 layout (1280x720, y down here for the
+    // preview; the game layout is y up, and the dy sign is flipped on encode).
+    // Approximate: log-28 gives the matrices, not the translations; the mockup's
+    // layout is the reference. Coins and moons are left, lives and compass right.
+    var base: CGPoint {
+        switch self { case .coins: return CGPoint(x: 170, y: 62); case .moons: return CGPoint(x: 370, y: 95); case .lives: return CGPoint(x: 1160, y: 110); case .compass: return CGPoint(x: 1200, y: 95) }
+    }
+    var isLeft: Bool { self == .coins || self == .moons }   // the auto edge moves left elements left, right elements right
+}
+
+// The four preview shapes. The default is the device's own shape.
+enum HudAspect: CaseIterable, Identifiable {
+    case phone, duo, pad, wide
+    var id: Self { self }
+    var name: String {
+        switch self { case .phone: return "iPhone 19.5:9"; case .duo: return "iPhone Duo 1.43:1"; case .pad: return "iPad 4:3"; case .wide: return "16:9" }
+    }
+    var ratio: Double {
+        switch self { case .phone: return 2.167; case .duo: return 1.429; case .pad: return 1.333; case .wide: return 1.778 }
+    }
+    // The layout size for the shape (loader.c dm_fps_state_apply's rule: wider
+    // than 16:9 keeps the height (720) and widens; taller keeps the width (1280)
+    // and grows taller).
+    var layout: CGSize {
+        if ratio > 1.78 { return CGSize(width: 720 * ratio, height: 720) }
+        if ratio < 1.77 { return CGSize(width: 1280, height: 1280 / ratio) }
+        return CGSize(width: 1280, height: 720)
+    }
+    static func device() -> HudAspect {
+        let s = UIScreen.main.bounds.size
+        let r = max(s.width, s.height) / max(1, min(s.width, s.height))
+        // The closest of the four shapes (the phone is 2.167, the Duo 1.429, the iPad 1.333, 16:9 is 1.778).
+        return [phone, duo, pad, wide].min(by: { abs($0.ratio - r) < abs($1.ratio - r) }) ?? .phone
+    }
+}
+
+final class HudSettings: ObservableObject {
+    // One setting per element; a missing key means "no manual setting" (auto edge).
+    @Published private(set) var values: [HudElement: HudElementSetting] = [:]
+    private let defaults: UserDefaults
+    init(defaults: UserDefaults = .standard) {
+        self.defaults = defaults
+        for e in HudElement.allCases {
+            if let s = (defaults.string(forKey: e.key)).flatMap(HudElementSetting.decode) { values[e] = s }
+        }
+    }
+    // The setting that actually applies to an element (the moons element falls
+    // back to the coins group's setting when it has no setting of its own).
+    func effective(_ e: HudElement) -> HudElementSetting? {
+        if e == .moons { return values[.moons] ?? values[.coins] }
+        return values[e]
+    }
+    func isManual(_ e: HudElement) -> Bool { effective(e) != nil }
+    func set(_ e: HudElement, _ s: HudElementSetting?) {
+        if let s { values[e] = s; defaults.set(s.encoded, forKey: e.key) }
+        else { values.removeValue(forKey: e); defaults.removeObject(forKey: e.key) }
+    }
+    func resetAll() { for e in HudElement.allCases { set(e, nil) } }
+    var anyManual: Bool { HudElement.allCases.contains { effective($0) != nil } }
+    // The auto edge offset for an aspect (hud_edge.c's formula): 640 * (aspect /
+    // 1.7777778 - 1), clamped to [-200, +200]. Left elements move by -edge, right
+    // elements by +edge; the dy is always 0 and the scale is never touched.
+    static func autoEdgeDx(_ e: HudElement, _ aspect: Double) -> Double {
+        guard aspect > 0, aspect >= 1.3, aspect <= 2.2 else { return 0 }
+        let edge = max(-200, min(200, 640 * (aspect / 1.7777778 - 1)))
+        return e.isLeft ? -edge : edge
+    }
+    // Before the game starts: every element with a manual setting goes into the
+    // environment (the host copies it to the state page); an element with no
+    // manual setting is unset, so the game keeps its auto edge anchor. A hidden
+    // element's hidden flag (1) is in the same string.
+    func applyToEnvironment() {
+        for e in HudElement.allCases {
+            if let s = effective(e) {
+                setenv(e.env, s.encoded, 1)
+                fputs("launcher: \(e.env)=\(s.encoded) (HUD editor)\n", stderr)
+            } else {
+                unsetenv(e.env)
+            }
+        }
+    }
+}
+
+// The preview of one HUD element, drawn to look like the game: the coin is a white
+// ring with a dark bar, the moon a white hexagon with a dark ring and a dot, the
+// lives a heart and a number, the compass a dial with the menu / map hints.
+private struct HudElementPreview: View {
+    let el: HudElement
+    let k: Double
+    var body: some View {
+        Group {
+            switch el {
+            case .coins:
+                VStack(spacing: 4 * k) {
+                    HStack(spacing: 6 * k) {
+                        ZStack {
+                            Circle().stroke(Color.white, lineWidth: 5 * k).frame(width: 34 * k, height: 34 * k)
+                            Circle().stroke(Color.white.opacity(0.85), lineWidth: 1.5 * k).frame(width: 24 * k, height: 24 * k)
+                            Rectangle().fill(Color.black.opacity(0.55)).frame(width: 3 * k, height: 26 * k)
+                        }
+                        Text("0896").font(.system(size: 22 * k, weight: .bold, design: .rounded)).foregroundStyle(.white)
+                    }
+                    Rectangle().fill(Color.white).frame(width: 150 * k, height: 5 * k).cornerRadius(2.5 * k)
+                }
+            case .moons:
+                VStack(spacing: 6 * k) {
+                    HStack(spacing: 6 * k) {
+                        ZStack {
+                            Hexagon().fill(Color.white).frame(width: 34 * k, height: 34 * k)
+                            Circle().stroke(Color.black.opacity(0.55), lineWidth: 2.5 * k).frame(width: 20 * k, height: 20 * k)
+                            Circle().fill(Color.black.opacity(0.55)).frame(width: 6 * k, height: 6 * k)
+                        }
+                        Text("020").font(.system(size: 22 * k, weight: .bold, design: .rounded)).foregroundStyle(.white)
+                    }
+                    VStack(spacing: 4 * k) {
+                        HStack(spacing: 5 * k) { ForEach(0..<6) { i in MoonDot(filled: i < 2, color: .blue) } }
+                        HStack(spacing: 5 * k) { ForEach(0..<6) { i in MoonDot(filled: false, color: .pink) } }
+                    }
+                }
+            case .lives:
+                HStack(spacing: 5 * k) {
+                    Text("♥").font(.system(size: 22 * k)).foregroundStyle(.red)
+                    Text("3").font(.system(size: 22 * k, weight: .bold, design: .rounded)).foregroundStyle(.white)
+                }
+            case .compass:
+                VStack(spacing: 4 * k) {
+                    ZStack {
+                        Circle().stroke(Color.white.opacity(0.9), lineWidth: 2.5 * k).frame(width: 56 * k, height: 56 * k)
+                        Text("N").font(.system(size: 14 * k, weight: .bold)).foregroundStyle(.white)
+                        Circle().fill(Color.red).frame(width: 6 * k, height: 6 * k).offset(y: -16 * k)
+                    }
+                    Text("+ 菜单").font(.system(size: 13 * k, weight: .semibold)).foregroundStyle(.white)
+                    Text("− 地图").font(.system(size: 13 * k, weight: .semibold)).foregroundStyle(.white)
+                }
+            }
+        }
+    }
+}
+
+private struct MoonDot: View {
+    let filled: Bool
+    let color: Color
+    var body: some View {
+        Group {
+            if filled { Circle().fill(color) }
+            else { Circle().stroke(Color.white.opacity(0.7), lineWidth: 1.5) }
+        }
+        .frame(width: 10, height: 10)
+    }
+}
+
+private struct Hexagon: Shape {
+    func path(in rect: CGRect) -> Path {
+        var p = Path()
+        for i in 0..<6 {
+            let a = CGFloat(i) * .pi / 3 - .pi / 2
+            let pt = CGPoint(x: rect.midX + rect.width / 2 * cos(a), y: rect.midY + rect.height / 2 * sin(a))
+            if i == 0 { p.move(to: pt) } else { p.addLine(to: pt) }
+        }
+        p.closeSubpath()
+        return p
+    }
+}
+
+struct HudEditorView: View {
+    @ObservedObject var settings: HudSettings
+    @State private var aspect: HudAspect = .device()
+    @State private var selected: HudElement = .coins
+    @State private var dragOffset = CGSize.zero   // the in-progress drag, in preview points
+    @Environment(\.dismiss) private var dismiss
+
+    // The preview's layout (points) for the chosen aspect, and the scale from
+    // layout points to preview points (uniform: the preview's shape is the layout's).
+    private func layoutPoint(_ el: HudElement, preview: CGSize, layout: CGSize) -> CGPoint {
+        let s = effectiveSetting(el)
+        let dx: Double
+        let dy: Double   // preview y is down; the game's dy is up, so the sign flips on display
+        if let s {
+            dx = s.dx; dy = -s.dy
+        } else {
+            dx = HudSettings.autoEdgeDx(el, aspect.ratio); dy = 0
+        }
+        let x = (el.base.x + CGFloat(dx)) / layout.width * preview.width
+        let y = (el.base.y + CGFloat(dy)) / layout.height * preview.height
+        return CGPoint(x: x, y: y)
+    }
+    private func effectiveSetting(_ el: HudElement) -> HudElementSetting? { settings.effective(el) }
+    private func dragScale(preview: CGSize, layout: CGSize) -> Double { Double(layout.width / max(1, preview.width)) }   // preview points -> layout points
+
+    var body: some View {
+        NavigationStack {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 16) {
+                    // The preview, at the chosen shape. The background is a forest
+                    // gradient in the official art's colours (the game screenshot is
+                    // not bundled with the app); the HUD sits on it as in the game.
+                    GeometryReader { geo in
+                        let layout = aspect.layout
+                        ZStack {
+                            LinearGradient(colors: [Color(red: 0.16, green: 0.42, blue: 0.24), Color(red: 0.35, green: 0.62, blue: 0.30), Color(red: 0.55, green: 0.75, blue: 0.38)],
+                                           startPoint: .topLeading, endPoint: .bottomTrailing)
+                            // A soft sky light, upper right, so the white HUD reads as it does on the bright art.
+                            RadialGradient(colors: [Color.white.opacity(0.28), Color.clear], center: .topTrailing, startRadius: 10, endRadius: geo.size.width * 0.7)
+                            Text("M").font(.system(size: 90, weight: .black)).foregroundStyle(.white.opacity(0.25))
+                            ForEach(HudElement.allCases) { el in
+                                let s = effectiveSetting(el)
+                                HudElementPreview(el: el, k: s?.k ?? 1)
+                                    .opacity(s?.hidden == true ? 0.25 : 1)
+                                    .overlay {
+                                        if selected == el {
+                                            RoundedRectangle(cornerRadius: 8).stroke(Color.yellow, lineWidth: 2)
+                                                .padding(-6)
+                                        }
+                                    }
+                                    .position(layoutPoint(el, preview: geo.size, layout: layout))
+                                    .offset(el == selected ? dragOffset : .zero)
+                                    .onTapGesture { selected = el }
+                                    .gesture(
+                                        DragGesture().onChanged { v in
+                                            selected = el; dragOffset = v.translation
+                                        }.onEnded { v in
+                                            // The drag (preview points, y down) into layout points (y up): dx as-is, dy negated.
+                                            // Start from the EFFECTIVE setting (a moons element following the coins group starts there, not at 0).
+                                            let sc = dragScale(preview: geo.size, layout: layout)
+                                            var cur = settings.effective(el) ?? HudElementSetting(dx: 0, dy: 0, k: 1, hidden: false)
+                                            cur.dx += Double(v.translation.width) * sc
+                                            cur.dy -= Double(v.translation.height) * sc
+                                            settings.set(el, cur)
+                                            dragOffset = .zero
+                                        }
+                                    )
+                            }
+                            if let s = effectiveSetting(selected), s.hidden {
+                                Text("游戏内不显示").font(.caption.weight(.semibold)).foregroundStyle(.white)
+                                    .padding(.horizontal, 8).padding(.vertical, 4)
+                                    .background(Color.black.opacity(0.6)).cornerRadius(6)
+                                    .position(x: geo.size.width / 2, y: geo.size.height - 24)
+                            }
+                        }
+                        .clipShape(RoundedRectangle(cornerRadius: 12))
+                    }
+                    .aspectRatio(aspect.ratio, contentMode: .fit)
+                    .frame(maxWidth: .infinity)
+
+                    // The four shapes: the preview's default is the edge anchor for that shape.
+                    Picker("预览比例", selection: $aspect) {
+                        ForEach(HudAspect.allCases) { Text($0.name).tag($0) }
+                    }
+                    .pickerStyle(.segmented)
+
+                    // The element list: tap to select; a manual element is marked 手动, a hidden one 已隐藏.
+                    VStack(spacing: 0) {
+                        ForEach(HudElement.allCases) { el in
+                            HStack {
+                                Text(el.name).font(.headline)
+                                Spacer()
+                                if effectiveSetting(el)?.hidden == true { Text("已隐藏").font(.caption).foregroundStyle(.secondary) }
+                                else if settings.isManual(el) { Text("手动").font(.caption).foregroundStyle(.orange) }
+                                else { Text("自动贴边").font(.caption).foregroundStyle(.secondary) }
+                            }
+                            .contentShape(Rectangle())
+                            .onTapGesture { selected = el }
+                            .padding(.vertical, 8)
+                            Divider()
+                        }
+                    }
+                    .padding(.horizontal, 4)
+
+                    // The selected element's controls.
+                    Group {
+                        VStack(alignment: .leading, spacing: 8) {
+                            Text("大小").font(.headline)
+                            let k = Binding(get: { effectiveSetting(selected)?.k ?? 1 }, set: { v in
+                                var cur = settings.effective(selected) ?? HudElementSetting(dx: 0, dy: 0, k: 1, hidden: false)
+                                cur.k = v; settings.set(selected, cur)
+                            })
+                            Slider(value: k, in: 0.6...1.8, step: 0.05)
+                            HStack { Text("60%"); Spacer(); Text("\(Int((effectiveSetting(selected)?.k ?? 1) * 100))%").monospacedDigit(); Spacer(); Text("180%") }
+                                .font(.caption).foregroundStyle(.secondary)
+                        }
+                        Toggle("隐藏（游戏内不显示）", isOn: Binding(get: { effectiveSetting(selected)?.hidden ?? false }, set: { v in
+                            var cur = settings.effective(selected) ?? HudElementSetting(dx: 0, dy: 0, k: 1, hidden: false)
+                            cur.hidden = v; settings.set(selected, cur)
+                        }))
+                        if settings.isManual(selected) {
+                            Button("恢复自动贴边") { settings.set(selected, nil) }
+                        }
+                        Button("全部恢复自动贴边", role: .destructive) { settings.resetAll() }
+                            .disabled(!settings.anyManual)
+                        if settings.anyManual {
+                            Text("手动设置优先于自动贴边；没有手动设置的继续自动贴边。").font(.caption).foregroundStyle(.secondary)
+                        }
+                    }
+                }
+                .padding()
+            }
+            .navigationTitle("HUD 设置")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .cancellationAction) { Button("完成") { dismiss() } } }
+        }
+    }
+}
