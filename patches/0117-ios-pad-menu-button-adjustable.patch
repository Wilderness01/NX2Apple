From 68ebefb1e83224791236ac8b79e33f2b6051d571 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Thu, 12 Nov 2026 00:00:35 +0000
Subject: [PATCH] Pad: the menu (gear) button is adjustable in the button
 editor (0117)

---
 dm/ios/Sources/DmGamepad.m | 29 +++++++++++++++++------------
 1 file changed, 17 insertions(+), 12 deletions(-)

diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 062f443..ce16625 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -47,10 +47,10 @@
 #import "DmGameMenu.h"
 
 enum { B_A = 0, B_B, B_X, B_Y, B_LS, B_RS, B_L, B_R, B_ZL, B_ZR, B_PLUS, B_MINUS, B_LEFT, B_UP, B_RIGHT, B_DOWN, B_N };
-enum { E_A = 0, E_B, E_Y, E_ZL, E_L, E_MINUS, E_PLUS, E_JUMP, E_PHOTO, E_N };   // the movable controls (the button editor); others are hidden (X, ZR, R, L3, R3, D-pad), fixed (the menu) or floating (the stick)
+enum { E_A = 0, E_B, E_Y, E_ZL, E_L, E_MINUS, E_PLUS, E_JUMP, E_PHOTO, E_MENU, E_N };   // the movable controls (the button editor), the menu included (0117); others are hidden (X, ZR, R, L3, R3, D-pad) or floating (the stick)
 enum { G_A = 0, G_B, G_Y, G_ZL, G_L, G_PLUS, G_MINUS, G_JUMP, G_PHOTO, G_MENU, G_N };   // the controls with a glass disc behind them (0111)
-static NSString *const k_lineEditKeys[E_N] = {@"a", @"b", @"y", @"zl", @"l", @"minus", @"plus", @"jump", @"photo"};   // the NSUserDefaults offsets' keys
-static NSString *const k_lineEditNames[E_N] = {@"A键", @"B键", @"攻击键", @"撞地键", @"视角键", @"+键", @"−键", @"跳跃键", @"拍照键"};   // the editor's name for the selected icon
+static NSString *const k_lineEditKeys[E_N] = {@"a", @"b", @"y", @"zl", @"l", @"minus", @"plus", @"jump", @"photo", @"menu"};   // the NSUserDefaults offsets' keys
+static NSString *const k_lineEditNames[E_N] = {@"A键", @"B键", @"攻击键", @"撞地键", @"视角键", @"+键", @"−键", @"跳跃键", @"拍照键", @"设置键"};   // the editor's name for the selected icon
 enum { C_NONE = 0, C_STICK, C_DPAD, C_FACE, C_BTN, C_GAME };   // which control a touch holds; C_GAME: none, the touch goes to the game's touch screen (finger slot << 8)
 
 static pthread_mutex_t g_mu = PTHREAD_MUTEX_INITIALIZER;
@@ -485,6 +485,7 @@ static int lockedKey(int c) {   // DmPadGeometry.h's control → the key it pres
                  case DM_PAD_C_MINUS: return B_MINUS; case DM_PAD_C_PLUS: return B_PLUS; case DM_PAD_C_L3: return B_LS; default: return B_RS; }
 }
 - (BOOL)menuTakes:(CGPoint)p {   // the menu button takes a touch in its hit circle unless a locked key's target is nearer (the drawn keys are hidden in Tap and with a controller)
+    if (_editing) return NO;   // the button editor is open: the touch falls through to the pad, where editTouchBegan picks the gear up as a movable control (0117)
     if (dm_pad_menu_distance(self.geo, p) > 1) return NO;
     if (_tap || _padOff || (_layout.separated && !CGRectContainsPoint(_layout.controls, p))) return YES;
     return dm_pad_menu_takes(self.geo, _full, _layout.separated, p);
@@ -707,7 +708,7 @@ static CGRect growRect(CGRect r, CGFloat fill) {   // grow a rect about its cent
         default: return squareFrame(self.menuCenter, 2 * self.geo->swapR);
     }
 }
-- (BOOL)glassHidden:(int)g {   // the glass follows its control: hidden with it in the Tap layout, and with the menu while the editor is open
+- (BOOL)glassHidden:(int)g {   // the glass follows its control: hidden with it in the Tap layout
     CALayer *icon = [self glassIconLayer:g];
     return icon ? icon.hidden : _menu.hidden;
 }
@@ -774,8 +775,8 @@ static BOOL g_hintShown;   // once per launch
 // the selected icon only; a missing size falls back to the legacy global "scale", then 1) and
 // each dragged control's offset in points from its built-in centre, so it survives a restart
 // and works in every orientation. X, ZR, R, L3, R3 and the D-pad are hidden and disabled
-// (applyLayout, recompute, touchesBegan); the menu is fixed; the left stick floats, so it has
-// no stored position. The extra buttons anchor on the diamond's centre and gap, so they follow
+// (applyLayout, recompute, touchesBegan); the menu is adjustable like the rest
+// (0117); the left stick floats, so it has no stored position. The extra buttons anchor on the diamond's centre and gap, so they follow
 // its layout. With an offset, the dragged face key falls out of the diamond's shared test and
 // is hit-tested on its own (faceSplit, dm_pad_hit).
 - (CGPoint)lineOffset:(NSString *)name { NSValue *v = _lineOffsets[name]; return v ? v.CGPointValue : CGPointZero; }   // the editor's drag offset for a control, or none
@@ -797,12 +798,14 @@ static BOOL g_hintShown;   // once per launch
     // the biggest key's hit circle, so the shared test still routes it to the diamond and
     // faceAt: then picks the key by its own radius.
     // The drop keys and the pills have their own slots, so they scale there. The stick, the
-    // knob, the menu and L3 / R3 are not adjustable, so they keep the legacy global size.
+    // knob and L3 / R3 are not adjustable, so they keep the legacy global size.
     CGFloat s = _lineScale;
     CGFloat maxFace = fmax(_lineSizes[E_A], fmax(_lineSizes[E_B], _lineSizes[E_Y]));
     g->faceHitR = fmax(g->faceHitR, g->faceR * 1.25 * maxFace);   // the diamond's hit radius, so dm_pad_hit's face test covers the biggest key (lineFaceHitR uses the built-in radius, so this is not scaled twice)
     g->dropR[DM_PAD_ZL] *= _lineSizes[E_ZL]; g->dropR[DM_PAD_L] *= _lineSizes[E_L];
-    g->clickR *= s; g->stickR *= s; g->knobR *= s; g->swapR *= s;
+    g->clickR *= s; g->stickR *= s; g->knobR *= s;
+    g->swapR *= _lineSizes[E_MENU];   // the menu button's own size (0117): never the legacy global, its stored size falls back to it on an old save (loadLineLayout)
+    CGPoint mo = [self lineOffset:@"menu"]; g->swap.x += mo.x; g->swap.y += mo.y;   // the menu button's drag offset (0117): menuCenter, the frame, the glass and menuTakes all follow it
     for (int i = 0; i < 2; i++) { CGFloat ps = _lineSizes[i == DM_PAD_MINUS ? E_MINUS : E_PLUS]; CGRect r = g->pill[i]; CGFloat w = r.size.width * ps, h = r.size.height * ps; g->pill[i] = CGRectMake(CGRectGetMidX(r) - w / 2, CGRectGetMidY(r) - h / 2, w, h); }
     static const int faceMoved[] = {0, 1, 3}; static NSString *const faceNames[] = {@"a", @"b", @"y"};   // faceKey[] is A B X Y
     BOOL split = NO;
@@ -1039,7 +1042,7 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
     _glassSlider.frame = CGRectMake(48, 40, w - 48 - 12, 20);
     UIView *hint = [_editBar viewWithTag:304]; hint.frame = CGRectMake(0, 66, w, 34);
 }
-- (void)openPadSettings {   // the in-game menu's "按键设置": hide the gear (it cannot be tapped now), show the editor
+- (void)openPadSettings {   // the in-game menu's "按键设置": the gear stays visible and can be picked (0117), show the editor
     if (_padOff || _editing) return;
     [self reset];   // release every key and touch first, as the menu does
     _editing = YES;
@@ -1100,7 +1103,7 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
         case E_A: return _key[B_A].hidden; case E_B: return _key[B_B].hidden; case E_Y: return _key[B_Y].hidden;
         case E_ZL: return _key[B_ZL].hidden; case E_L: return _key[B_L].hidden;
         case E_MINUS: return _key[B_MINUS].hidden; case E_PLUS: return _key[B_PLUS].hidden;
-        case E_JUMP: return _jump.hidden; default: return _photo.hidden;
+        case E_JUMP: return _jump.hidden; case E_MENU: return _menu.hidden; default: return _photo.hidden;
     }
 }
 - (CGFloat)editDrawnR:(int)e {   // the selected icon's drawn radius (the highlight rings this, not the hit circle)
@@ -1108,6 +1111,7 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
         case E_A: return [self lineFaceR:B_A]; case E_B: return [self lineFaceR:B_B]; case E_Y: return [self lineFaceR:B_Y];
         case E_ZL: return [self dropR:B_ZL]; case E_L: return [self dropR:B_L];
         case E_MINUS: case E_PLUS: return [self linePillRFor:e];
+        case E_MENU: return self.geo->swapR;   // the menu button's drawn radius (0117)
         default: return [self lineExtraRFor:e];
     }
 }
@@ -1117,7 +1121,7 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
         case E_ZL: return [self dropCenter:B_ZL]; case E_L: return [self dropCenter:B_L];
         case E_MINUS: { CGRect r = [self pillRect:B_MINUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
         case E_PLUS: { CGRect r = [self pillRect:B_PLUS]; return CGPointMake(CGRectGetMidX(r), CGRectGetMidY(r)); }
-        case E_JUMP: return [self jumpCenter]; default: return [self photoCenter];
+        case E_JUMP: return [self jumpCenter]; case E_MENU: return [self menuCenter]; default: return [self photoCenter];
     }
 }
 - (CGFloat)editRadius:(int)e {   // a movable control's hit radius, in points
@@ -1125,6 +1129,7 @@ static const CGFloat k_panel_default[1][2] = {{0.30, 0.58}};   // pad: the bar's
         case E_A: return [self lineFaceHitR:B_A]; case E_B: return [self lineFaceHitR:B_B]; case E_Y: return [self lineFaceHitR:B_Y];
         case E_ZL: return [self dropR:B_ZL]; case E_L: return [self dropR:B_L];
         case E_MINUS: case E_PLUS: return [self linePillRFor:e];
+        case E_MENU: return MAX(self.geo->swapR * 1.6, 22);   // the menu button's hit radius, the same formula as dm_pad_menu_hit_r (0117)
         default: return [self lineExtraRFor:e];   // jump and photo
     }
 }
@@ -1248,7 +1253,7 @@ static BOOL pads_slotted(GCController *gone) {
 }
 - (void)updateControlVisibility {
     _controls.hidden = _padOff;
-    _menu.hidden = _editing || (_padOff && _layout.onTV);   // the gear stays hidden while the button editor is open
+    _menu.hidden = (_padOff && _layout.onTV);   // the gear stays visible in the button editor (it is adjustable now, 0117)
     [self syncGlassVisibility];   // the glass hides with the whole touch pad while a controller is in use
 }
 - (void)padsChanged:(NSNotification *)note {
-- 
2.43.0

