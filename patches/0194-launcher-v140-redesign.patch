+/// What the right-side box shows for one bottom-bar tab (0194). Every tab renders inside the box — nothing opens full-screen any more.
+private struct LauncherBoxContent: View {
+    let tab: LauncherCategory
+    @ObservedObject var m: LauncherModel
+    @Binding var glassOpacity: Double
+    let scale: CGFloat
+
+    var body: some View {
+        Group {
+            switch tab {
+            case .game:
+                GameTabContent(m: m, glassOpacity: $glassOpacity, scale: scale)
+            case .controls:
+                SettingsListContent(section: "Controls", m: m, scale: scale)
+            case .performance:
+                SettingsListContent(section: "Performance", m: m, scale: scale)
+            case .data:
+                GameDataSection()
+            case .cloud:
+                CloudSavesSection()
+            case .character:
+                CharacterPickerView(scale: scale)
+            }
+        }
+    }
+}
