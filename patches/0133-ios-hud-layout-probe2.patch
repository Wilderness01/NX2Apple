From 2933366bf6becc875aaa147ea84aabd86e5ad683 Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sat, 14 Nov 2026 10:18:26 +0000
Subject: [PATCH] 0133: extend the HUD layout probe with chain + fields records
 (log-41)

---
 dm/games/0100000000010000/hud_probe.c | 138 +++++++++++++++++++++++++-
 dm/games/0100000000010000/patches.py  |  65 +++++++-----
 dm/host/hud_manual.c                  |  43 ++++++++
 3 files changed, 218 insertions(+), 28 deletions(-)

diff --git a/dm/games/0100000000010000/hud_probe.c b/dm/games/0100000000010000/hud_probe.c
index c6362af..314384b 100644
--- a/dm/games/0100000000010000/hud_probe.c
+++ b/dm/games/0100000000010000/hud_probe.c
@@ -37,6 +37,27 @@
 //      (c) gate is trivially true. The layout record shows, per pane,
 //      where the layout actually lives, so the 0131 fix is written from
 //      measured values, not from another unverified assumption.
+//   5. (0133) for every pane hud_edge matched, one chain record: the
+//      local translation (+0x30/+0x34) of the pane and each ancestor up
+//      to the root (five levels as floats, plus the depth walked).
+//      Log-41 proved the layout (263,71) is in neither the pane's local
+//      nor the immediate parent's (H3) and the full chain
+//      TxtCounter->Capture03->RootPane sums to (0,-100) -- but that proof
+//      joined the type-0 pane records (names + parentage) with the
+//      type-3 parent_local (one level). This record makes the whole
+//      chain explicit in one place, so a layout at level 2+ is visible
+//      without joining records, and the 0132 chain-walk's reconstruction
+//      can be checked level by level.
+//   6. (0133) for every pane hud_edge matched, one fields record: the
+//      pane's and its parent's local scales (+0x48/+0x4c), sizes
+//      (+0x50/+0x54) and origins (+0x5b), and the pane's live global
+//      translation (+0x70) as the probe sees it -- the other fields a
+//      layout could be derived from (a scaled accumulation, a centred
+//      position) if it is in no +0x30. NOTE: the probe runs after
+//      hud_edge in both cuts, so the live global on first sighting is
+//      hud_edge's just-written value (the same numbers as final_m3/
+//      final_m7 in the edge-decision record); the pre-write value is
+//      e_orig in the layout record.
 //
 // How it works: the rewriter's two Pane::Calculate cuts call this stub
 // after hud_edge (same arguments, plus the probe buffer). The stub writes
@@ -103,6 +124,12 @@ typedef unsigned long uintptr_t;
 #define HP_REC_EDGE 1
 #define HP_REC_ASPECT 2
 #define HP_REC_LAYOUT 3   // (0131) the pane's local transform + the stored original
+#define HP_REC_CHAIN 4    // (0133) the full parent chain's local translations
+#define HP_REC_FIELDS 5   // (0133) local scales, sizes, origins, live global
+// Chain levels stored per record (levels 0..4 as floats in v0..v6 +
+// w0..w2, which hold float bit patterns); a deeper chain stores the
+// first five and reports its full depth in w3.
+#define HUD_PROBE_CHAIN_LEVELS 5
 // Record field offsets (relative to the record start, 96 bytes total).
 #define HP_R_TYPE 0
 #define HP_R_ADDR_LO 4
@@ -256,11 +283,18 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         int entry_index = (int)(((uintptr_t)ent - (uintptr_t)table) / HUD_EDGE_ENTRY);
         slot = (entry_index - idx) / HUD_EDGE_N;
     }
-    // How many records: one pane record, plus one edge-decision record
-    // and one layout record (0131) when matched. All must fit, or none
-    // is written and the pane stays un-seen (it retries next frame, when
-    // the host has flushed).
-    int need = matched ? 3 : 1;
+    // How many records: one pane record, plus one edge-decision record,
+    // one layout record (0131), one chain record (0133) and one fields
+    // record (0133) when matched -- five per matched pane, one per
+    // unmatched pane. All must fit, or none is written and the pane
+    // stays un-seen (it retries next frame, when the host has flushed).
+    // The 13-record cap is unchanged (the record buffer is 13 x 96
+    // bytes to the end of the state page); a matched pane now takes five
+    // slots, so a flush carries the aspect record plus two matched
+    // panes (and unmatched panes in the remaining slots), and the rest
+    // defer to the next flush -- the host flushes every present, so a
+    // 5-second stand-still still logs every pane.
+    int need = matched ? 5 : 1;
     u32 rc = hdr[HP_REC_COUNT / 4];
     if (rc + (u32)need > HUD_PROBE_REC_CAP) return;
 
@@ -388,6 +422,100 @@ void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf
         rc++;
     }
 
+    // The chain record (0133), for a matched pane only: the local
+    // translations (+0x30/+0x34) of the pane and each ancestor up to the
+    // root. Levels 0..4 are stored as floats (v0..v6, then w0..w2 which
+    // hold float bit patterns); w3 packs the depth walked (bits 0-7),
+    // the element index (bits 8-15) and the slot (bits 16-23). A depth
+    // over 5 means the chain continues past the stored levels (the host
+    // print flags it TRUNCATED); log-41's chains are at most four levels
+    // (TxtGuide01 -> PicStrap -> All -> RootPane), so five covers every
+    // chain the device has shown. The walk mirrors hud_edge_chain_origin
+    // (a NULL or unaligned parent stops it, 8 levels max) but reads the
+    // locals instead of summing them, so the 0132 reconstruction can be
+    // checked level by level. Levels at or beyond the depth are zero.
+    if (matched) {
+        float clx[HUD_PROBE_CHAIN_LEVELS];
+        float cly[HUD_PROBE_CHAIN_LEVELS];
+        int depth = 0;
+        void *p = pane;
+        for (int i = 0; i < 8 && p && !((uintptr_t)p & 7u); i++) {
+            if (i < HUD_PROBE_CHAIN_LEVELS) {
+                clx[i] = *(const float *)((const char *)p + 0x30);
+                cly[i] = *(const float *)((const char *)p + 0x34);
+            }
+            depth++;
+            p = *(void **)((const char *)p + 0x18);
+        }
+        volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+        hp_put_u32(rec, HP_R_TYPE, HP_REC_CHAIN);
+        hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+        hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+        hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+        if (parent_ok) hud_probe_copy_name(rec + HP_R_PNAME, (const char *)parent + 0xb8, 20);
+        else rec[HP_R_PNAME] = 0;
+        for (int i = 0; i < HUD_PROBE_CHAIN_LEVELS; i++) {
+            float x = i < depth ? clx[i] : 0.0f;
+            float y = i < depth ? cly[i] : 0.0f;
+            hp_put_f32(rec, HP_R_V0 + i * 8, x);
+            hp_put_f32(rec, HP_R_V0 + i * 8 + 4, y);
+        }
+        hp_put_u32(rec, HP_R_W3, (u32)depth | ((u32)idx << 8) | ((u32)slot << 16));
+        rc++;
+    }
+
+    // The fields record (0133), for a matched pane only: the pane's and
+    // its parent's local scales (+0x48/+0x4c), sizes (+0x50/+0x54) and
+    // origins (+0x5b), and the pane's live global translation (+0x70
+    // m[3]/m[7]) as the probe sees it. These are the other fields a
+    // layout could be derived from if it is in no +0x30: a scaled
+    // accumulation (a parent scale != 1), or a position centred in the
+    // parent (size/origin). The parent's values are 0 when there is no
+    // parent. w0..w2 hold float bit patterns (live global y, parent size
+    // w/h); w3 packs the pane origin (bits 0-7), the parent origin (bits
+    // 8-15), the element index (bits 16-23) and the slot (bits 24-31).
+    // NOTE on the live global: the probe runs after hud_edge in both
+    // cuts, so on first sighting this is hud_edge's just-written value
+    // (the same numbers as final_m3/final_m7 in the edge-decision
+    // record); the pre-write value is e_orig in the layout record
+    // (type 3). A game recomposition on a later frame is absorbed by
+    // hud_edge's recomputed path and is not separately visible here.
+    if (matched) {
+        float sx = *(const float *)((const char *)pane + 0x48);
+        float sy = *(const float *)((const char *)pane + 0x4c);
+        float psx = 0.0f, psy = 0.0f, pw = 0.0f, ph = 0.0f;
+        unsigned char porigin = 0;
+        if (parent_ok) {
+            psx = *(const float *)((const char *)parent + 0x48);
+            psy = *(const float *)((const char *)parent + 0x4c);
+            pw = *(const float *)((const char *)parent + 0x50);
+            ph = *(const float *)((const char *)parent + 0x54);
+            porigin = *(const unsigned char *)((const char *)parent + 0x5b);
+        }
+        float w = *(const float *)((const char *)pane + 0x50);
+        float h = *(const float *)((const char *)pane + 0x54);
+        unsigned char origin = *(const unsigned char *)((const char *)pane + 0x5b);
+        volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+        hp_put_u32(rec, HP_R_TYPE, HP_REC_FIELDS);
+        hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+        hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+        hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+        if (parent_ok) hud_probe_copy_name(rec + HP_R_PNAME, (const char *)parent + 0xb8, 20);
+        else rec[HP_R_PNAME] = 0;
+        hp_put_f32(rec, HP_R_V0, sx);
+        hp_put_f32(rec, HP_R_V1, sy);
+        hp_put_f32(rec, HP_R_V2, psx);
+        hp_put_f32(rec, HP_R_V3, psy);
+        hp_put_f32(rec, HP_R_V4, w);
+        hp_put_f32(rec, HP_R_V5, h);
+        hp_put_f32(rec, HP_R_V6, g[3]);   // live global x (post-hud_edge; see note above)
+        hp_put_f32(rec, HP_R_W0, g[7]);   // live global y (float bits in a u32 slot)
+        hp_put_f32(rec, HP_R_W1, pw);     // parent size w (float bits)
+        hp_put_f32(rec, HP_R_W2, ph);     // parent size h (float bits)
+        hp_put_u32(rec, HP_R_W3, (u32)origin | ((u32)porigin << 8) | ((u32)idx << 16) | ((u32)slot << 24));
+        rc++;
+    }
+
     hdr[HP_REC_COUNT / 4] = rc;
     // Mark seen only after both records were written, so a deferred pane
     // (buffer full) retries next frame instead of being lost.
