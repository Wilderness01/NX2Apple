+/// The outfit picker (0188): two card rows, caps and clothes, for the picked character. The costume names are the shop ItemNames (the host redirect replaces the leading "Mario" with the picked character, so one list serves every character; a costume the character has no adapted file for falls back to that character's default part, it never turns the player back into Mario). Tapping a card saves it to DmCharSelect.cap / DmCharSelect.clothes (NSUserDefaults), which dm_char_select_apply_saved reads at startup. "Default" writes "default" (the character's own default part).
+private struct OutfitPickerView: View {
+    let characterId: String
+    let characterName: String
+    @State private var cap: String = UserDefaults.standard.string(forKey: "DmCharSelect.cap") ?? "default"
+    @State private var clothes: String = UserDefaults.standard.string(forKey: "DmCharSelect.clothes") ?? "default"
+
+    private func outfitRow(title: String, items: [(id: String, name: String)], selected: String, onPick: @escaping (String) -> Void) -> some View {
+        VStack(alignment: .leading, spacing: 10) {
+            Text(title)
+                .font(.system(size: 20, weight: .bold))
+                .foregroundStyle(.white)
+                .padding(.horizontal, 20)
+            ScrollView(.horizontal, showsIndicators: false) {
+                HStack(spacing: 12) {
+                    outfitCard(id: "default", name: "\u{9ed8}\u{8ba4}", selected: selected == "default") { onPick("default") }
+                    ForEach(items, id: \.id) { it in
+                        outfitCard(id: it.id, name: it.name, selected: selected == it.id) { onPick(it.id) }
+                    }
+                }
+                .padding(.horizontal, 20)
+            }
+        }
+    }
+
+    private func outfitCard(id: String, name: String, selected: Bool, onPick: @escaping () -> Void) -> some View {
+        Button(action: onPick) {
+            Text(name)
+                .font(.system(size: 16, weight: .semibold))
+                .foregroundStyle(.white)
+                .lineLimit(1)
+                .frame(width: 132, height: 84)
+                .background(Color.white.opacity(0.08))
+                .clipShape(RoundedRectangle(cornerRadius: 14))
+                .overlay(
+                    RoundedRectangle(cornerRadius: 14)
+                        .stroke(selected ? Color(red: 0.95, green: 0.75, blue: 0.25) : Color.white.opacity(0.15), lineWidth: selected ? 3 : 1)
+                )
+        }
+        .buttonStyle(.plain)
+    }
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 28) {
+                outfitRow(title: "\u{5e3d}\u{5b50}", items: dmOutfitCaps, selected: cap) { v in
+                    cap = v
+                    UserDefaults.standard.set(v, forKey: "DmCharSelect.cap")
+                }
+                outfitRow(title: "\u{8863}\u{670d}", items: dmOutfitClothes, selected: clothes) { v in
+                    clothes = v
+                    UserDefaults.standard.set(v, forKey: "DmCharSelect.clothes")
+                }
+                Text("\u{9009}\u{4e2d}\u{670d}\u{88c5}\u{540e}\u{4e0b}\u{6b21}\u{8fdb}\u{5165}\u{6e38}\u{620f}\u{751f}\u{6548}")
+                    .font(.system(size: 14))
+                    .foregroundStyle(.secondary)
+                    .padding(.horizontal, 20)
+            }
+            .padding(.vertical, 20)
+        }
+        .background(Color(red: 0.06, green: 0.08, blue: 0.12))
+        .navigationTitle(characterName + "\u{7684}\u{670d}\u{88c5}")
+        .navigationBarTitleDisplayMode(.inline)
+    }
+}
+
+/// The character picker (0188): the hero on top, character cards in a horizontal row at the bottom, like the reference video the user sent (a game library: big art for the selected item, cards laid out left to right, tap a card to select it). The choice is saved to DmCharSelect.character (NSUserDefaults), which dm_char_select_apply_saved reads at startup before the game starts, so the next launch plays as the picked character. The roster is Mario / Luigi / Wario / Peach; Peach is here only if her skeleton fits Mario's (the Peach check), otherwise drop her from `roster`.
+private struct CharacterPickerView: View {
+    @State private var selected: String = UserDefaults.standard.string(forKey: "DmCharSelect.character") ?? "mario"
+
+    private struct CharEntry: Identifiable {
+        let id: String
+        let name: String
+        let image: String
+    }
+    private let roster: [CharEntry] = [
+        CharEntry(id: "mario", name: "\u{9a6c}\u{91cc}\u{5965}", image: "char_mario"),
+        CharEntry(id: "luigi", name: "\u{8def}\u{6613}\u{5409}", image: "char_luigi"),
+        CharEntry(id: "wario", name: "\u{74e6}\u{91cc}\u{5965}", image: "char_wario"),
+    ]
+
+    private var current: CharEntry { roster.first(where: { $0.id == selected }) ?? roster[0] }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            // Hero: the selected character, large, on the dark backdrop. No name (the card below already shows it).
+            ZStack {
+                Color(red: 0.06, green: 0.08, blue: 0.12).ignoresSafeArea()
+                if let img = dmCharImage(current.image) {
+                    Image(uiImage: img)
+                        .resizable()
+                        .scaledToFit()
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .padding(24)
+                }
+            }
+            // Cards: one row, left to right, scrollable. The selected card gets a gold ring. The last card opens the outfit picker for the picked character.
+            ScrollView(.horizontal, showsIndicators: false) {
+                HStack(spacing: 16) {
+                    ForEach(roster) { c in
+                        Button {
+                            selected = c.id
+                            UserDefaults.standard.set(c.id, forKey: "DmCharSelect.character")
+                        } label: {
+                            VStack(spacing: 6) {
+                                if let img = dmCharImage(c.image) {
+                                    Image(uiImage: img)
+                                        .resizable()
+                                        .scaledToFit()
+                                        .frame(width: 110, height: 130)
+                                }
+                                Text(c.name)
+                                    .font(.system(size: 17, weight: .semibold))
+                                    .foregroundStyle(.white)
+                            }
+                            .frame(width: 140, height: 180)
+                            .background(Color.white.opacity(0.08))
+                            .clipShape(RoundedRectangle(cornerRadius: 16))
+                            .overlay(
+                                RoundedRectangle(cornerRadius: 16)
+                                    .stroke(c.id == selected ? Color(red: 0.95, green: 0.75, blue: 0.25) : Color.white.opacity(0.15), lineWidth: c.id == selected ? 3 : 1)
+                            )
+                        }
+                        .buttonStyle(.plain)
+                    }
+                    NavigationLink {
+                        OutfitPickerView(characterId: current.id, characterName: current.name)
+                    } label: {
+                        VStack(spacing: 6) {
+                            if let img = dmCharImage("char_outfit") {
+                                Image(uiImage: img)
+                                    .resizable()
+                                    .scaledToFit()
+                                    .frame(width: 110, height: 130)
+                            }
+                            Text("\u{670d}\u{88c5}\u{5546}\u{5e97}")
+                                .font(.system(size: 17, weight: .semibold))
+                                .foregroundStyle(.white)
+                        }
+                        .frame(width: 140, height: 180)
+                        .background(Color.white.opacity(0.08))
+                        .clipShape(RoundedRectangle(cornerRadius: 16))
+                        .overlay(
+                            RoundedRectangle(cornerRadius: 16)
+                                .stroke(Color.white.opacity(0.15), lineWidth: 1)
+                        )
+                    }
+                    .buttonStyle(.plain)
+                }
+                .padding(.horizontal, 20)
+                .padding(.vertical, 16)
+            }
+            .background(Color(red: 0.04, green: 0.05, blue: 0.08))
         }
     }
 }
