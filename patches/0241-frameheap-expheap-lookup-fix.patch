+    fs_put(0x954484, [B(0x954484, start)], '0241: FrameHeap arena-grow overflow -> current heap (getCurrentHeap 0x9564a0) allocate; FrameHeap guard + ExpHeap failure call V (aborts, as before) (REPORT-0241-EXPHEAP-LOOKUP-FIX.md)')
 
