+// Write the ortho box ([0xa8]/[0xac] = -halfW/+halfW, [0xa0]/[0xa4] =
+// +halfH/-halfH) and set the dirty flag at [0x8]. The read-back verifies
+// the write stuck; on failure the orig box is written back (best effort)
+// and 0 is returned. Returns 1 on success.
+static int ortho_write_box(void *x0, float hw, float hh, float orig_hw, float orig_hh) {
+    float *p_hw_neg = (float *)((char *)x0 + 0xa8);
+    float *p_hw_pos = (float *)((char *)x0 + 0xac);
+    float *p_hh_pos = (float *)((char *)x0 + 0xa0);
+    float *p_hh_neg = (float *)((char *)x0 + 0xa4);
+    *p_hw_neg = -hw; *p_hw_pos = hw;
+    *p_hh_pos = hh;  *p_hh_neg = -hh;
+    *(uint8_t *)((char *)x0 + 0x8) = 1;   // dirty: refresh the cached matrix
+    if (!ortho_close(*p_hw_pos, hw) || !ortho_close(*p_hw_neg, -hw) ||
+        !ortho_close(*p_hh_pos, hh) || !ortho_close(*p_hh_neg, -hh)) {
+        UW_LOG("[RED] ortho: write did not stick for object %p (wrote halfW %g halfH %g), restoring orig box",
+               x0, (double)hw, (double)hh);
+        *p_hw_neg = -orig_hw; *p_hw_pos = orig_hw;
+        *p_hh_pos = orig_hh;  *p_hh_neg = -orig_hh;
+        *(uint8_t *)((char *)x0 + 0x8) = 1;
+        return 0;
+    }
+    return 1;
+}
