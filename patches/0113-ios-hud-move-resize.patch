+static int ortho_orig_add(void *x0, float hw, float hh) {
+    if (g_st.ortho_orig_n >= UW_ORTHO_ORIG_MAX) return -1;
+    int i = g_st.ortho_orig_n++;
+    g_st.ortho_orig_this[i] = (uintptr_t)x0;
+    g_st.ortho_orig_hw[i] = hw;
+    g_st.ortho_orig_hh[i] = hh;
+    g_st.ortho_orig_k[i] = 1.0;
+    g_st.ortho_orig_hits[i] = 0;
