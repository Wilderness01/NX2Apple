+    // The same call site reads the same value every frame and across
+    // sessions, because it is a code offset, not a heap address. Stored as an
+    // offset from the module base (the raw address is kept when it falls
+    // outside the module, so the log still shows it).
+    uintptr_t lr = (uintptr_t)__builtin_return_address(0);
