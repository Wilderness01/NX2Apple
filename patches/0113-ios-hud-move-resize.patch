--- /dev/null
+++ b/dm/games/0100000000010000/hud_calc.c
@@ -0,0 +1,1312 @@
+// hud_calc.c -- Super Mario Odyssey HUD move / resize + full-screen UI hook (0113 v7, V1.3.12).
+//
+// The game draws its HUD (compass, life, coins, moons) and its full-screen menus
+// (the PauseMenu settings screen, the WorldMap map screen) with Nintendo's nn::ui2d
+// Layout / Pane system: every pane's Pane::Calculate (main+0x909494, the vtable's
+// slot 19) recomputes its global matrix (pane+0x70, a 3x4 row-major matrix, the
+// translation at +0x7c / +0x8c) and then calculates its children. This function runs
+// from TWO rewriter cuts at Pane::Calculate (see patches.py): the +0x13c cut
+// (main+0x9095d0), after the pane's own global matrix is final and before its
+// children's, and the entry cut (main+0x9094b4), at the function's first
+// instruction. Both call this same function with the same arguments. It edits
+// a pane's global matrix: a translation moves it, a scale about its centre (from
+// its size at +0x50 / +0x54 and its origin byte at +0x5b) resizes it. It writes
+// no object field except one flag (v5: the dirty flag, bit 4 at +0x58, on a
+// moved pane's descendants, so the game recomputes them from the moved parent),
+// never accumulates (the transform is always re-derived from the stored
+// original matrix), and never fights the game's own animation (when the game
+// recomputes the matrix, the stored original follows it). The layout space
+// is y-up with its origin at the parent's centre (confirmed by disassembly of the
+// local matrix helper at main+0x9096d0, which adds +parent_h/2 for a top origin and
+// -parent_h/2 for a bottom one, and by the duo_anchor anchors: a bottom widget sits
+// at a negative y, a top one at a positive y), so a positive dy moves a pane UP, and
+// a drag down the screen is a negative dy; the HUD editor (DmGamepad.m) negates the
+// drag's y for this.
+//
+// Why two cuts (v3): the +0x13c cut alone misses every pane whose Calculate takes
+// the skip path. Disassembly of Pane::Calculate (main+0x909494, DmIOS fileoff
+// 0x9fd494) shows three ways to reach the +0x13c site -- flags bit 6 set (matrix
+// already current), flags bit 5 set (the inline matrix path), or the helper path
+// (flags bit 4 or the parent's force flag) -- and one way to jump OVER it:
+// 0x9fd528 `tbz w10, #0, 0x9096c8`, when neither the parent changed (w3 bit 0 == 0)
+// nor this pane is dirty (flags bit 4 == 0), jumps to site+4 with w22 = 0, running
+// the child loop but never the hook. A layout that has gone static (the PauseMenu
+// sitting open, a HUD widget at rest) takes that path on every frame after its
+// first, so the hook never runs for it again. Worse, the first frame is a race:
+// the state page's root scale is only written by the host's first present tick, so
+// a layout that calculates its first frame before that tick sees a scale of 1, and
+// then goes static and is never hooked again. That is the P3 root cause: log-18
+// proves the hook saw the PauseMenu / WorldMap roots (they are in the log buffer)
+// yet the V1.3.9 screenshots show the pause menu still exactly 1280/1560 wide --
+// the root scale never landed on the rendered frames. The entry cut runs before
+// any of those paths (it replaces the first instruction after the prologue), so a
+// static pane is hooked on every Calculate call and a settings change or the root
+// scale lands on the next frame, not never. The +0x13c cut stays: for a dirty pane
+// the game recomputes the matrix after the entry hook (wiping its edit), and the
+// +0x13c hook re-applies it to the fresh matrix; the recompute check below makes
+// the two hooks agree instead of fighting. The early-return path (DrawInfo byte
+// 0x1d == 0, a hidden layout) also returns after the entry hook, so hidden panes
+// are hooked too, harmlessly: their matrices are overwritten when they calculate
+// for real, and the +0x13c hook re-applies then.
+//
+// Moving a container must carry its children with it, and the game's own
+// parent-changed flag does not do that for a static container (v5, found by
+// disassembly): Pane::Calculate passes w22 = 1 to its children only when it
+// reaches the +0x13c site (the recompute / inline / flag paths); a static pane
+// takes the skip path (0x9fd528 `tbz w10, #0, 0x9096c8`, when neither the
+// parent changed nor this pane is dirty) and passes w22 = 0, so its children
+// take the skip path too and never recompute from the moved parent. The hook
+// therefore marks a moved pane's descendants dirty (flags bit 4 at +0x58,
+// hud_mark_dirty below) whenever it writes a new matrix to a matched pane.
+// That flag is the game's own signal: Pane::Calculate sets it when a pane's
+// parent changed (0x9fd698) and clears it when it recomputes (0x9fd52c), so it
+// is a request for the game's own recompute, not a code patch, and the game's
+// Calculate clears it again on the same frame. Only descendants are marked,
+// never the pane itself (marking it would make the game recompute and wipe the
+// hook's edit), and only when a new matrix is actually written -- never on the
+// already-correct early return -- so a static widget costs nothing per frame.
+// The helper path the dirty flag forces (main+0x9096d0) recomputes the child
+// from its parent's current global matrix, which is the hook's modified one,
+// so the child lands where the moved parent puts it; the +0x13c hook then
+// re-applies the child's own settings to that fresh matrix.
+//
+// Two things ride on this one hook:
+//
+//  1. The four HUD widgets (compass, life, coins, moons), matched by pane name or
+//     by structure, are moved / resized by the player's own settings (the gear
+//     menu's "HUD 设置"). V1 matched the actor class names CompassArea /
+//     CoinCounter / MoonNum, which log-18 (65 [hud] lines, 0 matches) and the
+//     binary both refute: those strings are actor / Nerve state-machine names
+//     (CoinCounterNrvEnd/Wait/Appear..., CompassArea among Area actors, MoonNum
+//     among save-data keys), not pane names -- pane names in a .bflyt are short
+//     Pic/Txt/Par/Win names, and the ones the game code itself looks up by name
+//     (TxtTotalShine, ParList00, TxtContent...) are the only pane names in the
+//     binary at all. V4 matched the counters by the structures log-20 and log-21
+//     actually showed, because the v3 'Counter' rule never fired on-device: the
+//     Counter's parent is an 'All' group (RootPane -> All -> Counter), not a
+//     small RootPane, and the coin cluster has no 'Counter' pane at all. Moons
+//     (v6): the counter group itself, a pane named 'Counter' (log-20 lines
+//     404-413: the 320x200 group holding PicIcon / PicIconSh and
+//     'TxtTotalShine'), matched by name -- it works whether the counter's layout
+//     is its own small RootPane or a direct child of the gameplay HUD root, so it
+//     does not depend on the [hud] log ever seeing the small root (log-24/25
+//     have no 300x256 RootPane, no 'Counter', no 'TxtTotalShine' at all: the
+//     160-entry first-encounter log fills before the moon cluster is met). A
+//     bare 'TxtTotalShine' is the fallback for a layout with no 'Counter' group,
+//     and only when its parent is not a 'Counter'. Life: the 'Life' container
+//     at (9,40) whose subtree holds 'TxtLife' (log-21 lines 760-763: Life 30x40,
+//     PicLifeL / PicLifeR / PicIcon 128x128, TxtLife 42x64, appearing when the
+//     player takes damage), or a bare 'TxtLife' whose parent is not named
+//     'Life'. Coins: the 'TxtCounterSh' pane itself (a direct child of the
+//     gameplay HUD root, log-20 lines 471/480), with the twin-write moving its
+//     sibling 'TxtCounter' (the plain number, same position and size) with it.
+//     The compass is the 'PicStrap' right strip (v5). The dial has no pane of
+//     its own: log-20/21 show no dial, needle, or N/E/S/W pane anywhere, and
+//     the binary has no Compass pane name at all (one 'CompassArea', an actor
+//     class name), so the dial is most likely drawn by the game directly from
+//     the camera heading, not a Pane. The only pane in the top-right is
+//     'PicStrap', a 340x720 strip, the right-hand container that holds the
+//     compass, the life ring and the guide text. Moving 'PicStrap' moves the
+//     whole strip together (the compass, the life ring and the hints move and
+//     resize as one); it cannot move the compass alone. 'PicStrap' appears
+//     twice (two layouts, at (1194,0) and (780,0)); both instances match
+//     element 0, each in its own table slot, so they never drift against each
+//     other. The v1 actor names are kept as a fallback (a layout group named
+//     after its actor is still possible), clearly labelled, in case a pane ever
+//     does carry one.
+//  2. Full-screen layout roots (the PauseMenu settings screen, the WorldMap map
+//     screen, and any other full-screen layout) are stretched to the screen shape,
+//     because they are built on the game's 1280x720 layout while the main HUD is
+//     built on the wider layout the screen shape asks for (1560 wide at 2.167).
+//     The stretch is automatic, from DM_SCREEN_ASPECT, not a player setting. V1
+//     split roots by size (standard roots widened, oversized roots shrunk), but
+//     log-18 proves every root is 1280x720 -- no oversized root exists, the
+//     1400/800 split never fired and cannot tell the map from the pause menu.
+//     V3 tells them apart by structure instead: a root whose subtree holds a
+//     'PicMapCap' pane is the WorldMap, one holding 'ParList00' or 'WinSelect'
+//     is the PauseMenu. Both are widened to the screen shape's layout -- and the
+//     map is widened because of what the user said on 2026-11-11 23:22, correcting
+//     the first reading of the map screenshot: it is NOT the map panel being cut,
+//     it is the picture BEHIND the map that does not fill the screen (the blurred
+//     game scene on the left of the screenshot is the unfilled strip showing
+//     through), and when the map is panned into the side black bars it stutters
+//     and leaves a residual image of the map there. So the map root's stretch has
+//     to land on the picture, exactly like the PauseMenu's: the root's background
+//     fills the screen only if the root matrix is widened. The panning ghost is
+//     most likely a knock-on of the same cause -- the uncovered strip is not
+//     redrawn every frame -- so v3 fixed the fill first. The V1.3.10 screenshots
+//     show the root stretch does NOT fill the map on screen (the terrain is 3D,
+//     not a Pane -- see the v4 note below), so the ghost's cause is still open
+//     and the map-ortho investigation is next; if widening the whole map root
+//     distorts the map content or cuts the yellow side panel further, the next
+//     step is to stretch only the background child, not the whole root (the
+//     classification and the native/scaled log pair tell us which root to aim at).
+//     The pause menu and any other unclassified full-screen root are widened to
+//     the screen shape's layout (root_sx / root_sy, from DM_SCREEN_ASPECT): 1560
+//     wide at 2.167, so the PauseMenu fills the screen the way the main HUD
+//     already does. 16:9 is the identity. The map's 3D part (WorldMapCamera) is
+//     NOT handled here: a camera projection is not a Pane, and it needs its own
+//     hook -- but it does not need one, see fix-0113-notes.md (the UW vtable scan
+//     already widens every calcMatrix, and the 3D landmass keeps its proportions).
+//     A layout root is recognised structurally -- it has no parent pane -- and by
+//     its full-screen size, not by its name alone (the name is "RootPane" by
+//     nn::ui2d convention, but the romfs .bflyt that would confirm it is not on
+//     this host, so the name is only logged, never required). The root table grew
+//     from 8 to 19 entries: layouts reload into fresh pane objects (the moon
+//     counter alone appears at two addresses in log-18), and 8 slots exhaust over
+//     a session, leaving later roots unscaled. 19 is the most that fits before
+//     the log buffer at +0x1000 (the HUD table grew to 8 entries).
+//
+// V4 (2026-11-12): the root stretch deformed the gameplay HUD. V1.3.10 stretched
+// every full-screen root, including the main HUD root -- log-20 shows its matrix
+// 1.219/1.000 and a 1560x720 SCALED entry, and the life ring on screen measured
+// 82x66 (W/H 1.242) where V1.3.8/9 had it round. V4 does NOT stretch a root whose
+// subtree holds a gameplay-HUD pane (the coin texts, the Life container, a
+// Counter), so the HUD root keeps its own 1.219 matrix from the engine and is
+// round again. The same V1.3.10 screenshots prove the root stretch does NOT widen
+// the visible pause menu or map (pause pillar 116px, identical to V1.3.9; map
+// terrain 82% wide): a 1.219 x-scale on the root matrix leaves the visible menu /
+// map unchanged, while the HUD root next to it deformed -- so the visible
+// pause/map content is not driven by the root's matrix at render time. V4 keeps
+// stretching the pause / map roots (the mechanism is harmless and the log proves
+// it lands), but it does not claim to fill them: the map's terrain is 3D, drawn
+// by WorldMapCamera (an orthographic projection, not a Pane), and the pause
+// menu's panels sit in the central 1280 and need their own repositioning. Those
+// are the next investigations, not this patch.
+//
+// V5 (2026-11-12): the compass is the 'PicStrap' right strip (see above), and a
+// moved container now carries its children (the dirty flag, see the paragraph
+// after "Why two cuts"). Two cautions, both verified, not assumed. First, the
+// Life cluster (log-21: Life at (9,40)) is most likely NOT inside 'PicStrap'
+// (at (1194,0)): the log records the pane's global matrix (+0x70), so those are
+// absolute positions, and a child of 'PicStrap' at global (9,40) would need a
+// local offset of about -972, far outside a 340-wide strip. So dragging the
+// right strip may not move the life ring -- it is its own element (idx 1) and
+// is dragged separately -- and the strip's own contents (the compass, the
+// guide text, whatever sits inside 'PicStrap') are the ones that move with it.
+// The dirty flag is correct either way: it only touches a pane's actual
+// descendants, so if Life is inside 'PicStrap' after all, it follows; if it
+// is not, it is untouched and independent. Second, the full-2x2 rotation
+// logging stays (it was added to probe for a compass needle); the probe is
+// moot now that the dial is known not to be a Pane, but removing it would be
+// churn and it still documents a pane's rotation.
+//
+// V7 (2026-11-12, V1.3.12): six items on top of v6, none of them changes the
+// v6 rules (moon by 'Counter' name, element-0 slot guard, life idx 1, the HUD
+// root exclusion, the root stretch, hud_mark_dirty, the entry / +0x13c cuts,
+// the params / table / log layout).
+//  1. Compass un-stretched: 'PicStrap' reads matrix 1.219/1.000 in log-24/25
+//     while the life ring reads 1.000, and the compass dial on screen is
+//     78x64 (W/H 1.219). The HUD root is still excluded from our stretch in
+//     v5/v6, yet its current matrix in log-24 is 1.219 -- so the 1.219 on
+//     PicStrap is NOT our root stretch: the engine itself carries the HUD
+//     root at 1.219 (the main HUD is laid out on the wider 1560 space), and
+//     the life cluster stays round through the DrawInfo 0.82 pre-squash
+//     (pause-map-fullscreen-investigation.md §1.6) that PicStrap does not
+//     get. The fix is per-pane, at the source it no longer matters: when an
+//     element-0 pane's stored original carries the screen-shape stretch
+//     (its x scale is root_sx and its y scale root_sy), the stored original
+//     is divided back by root_sx / root_sy -- scale only, the translation
+//     is untouched, so the strip stays at the screen's right edge and the
+//     dial goes round. The user's own k then multiplies a round base.
+//  2. Coin twin-write, pairing by original matrix (v6's size check was not
+//     enough: the two live twins are both 84x72). A candidate twin must now
+//     match the anchor's ORIGINAL matrix (or the mod already written to it,
+//     or the previous frame's mod when the settings just changed -- a twin
+//     that still holds last frame's mod is the same twin, not a stranger's),
+//     as well as its size and name. A twin from another cluster has a
+//     different original, so it is never written; two clusters with
+//     identical originals get identical mods anyway (same element-2
+//     settings), so writing the first of them is harmless. The coin drag
+//     itself is confirmed now (the user dragged the coins in the log-26
+//     session and they did not move; log-26's dm_hud_set == 0 is v5's
+//     missing log line, not "no drag"), so this is a real bug, not a
+//     hypothesis.
+//  3. The "+ menu / - map" guide text above the compass is hidden: the text
+//     panes 'TxtGuide' / 'TxtGuideSh' (and 'TxtGuideLSh' / 'TxtGuideRSh',
+//     all four names are in the binary) are moved far off-screen, but ONLY
+//     when their parent or grandparent is 'PicStrap' -- the right strip
+//     that holds them. 'TxtGuideSh' also appears on the welcome screen and
+//     'TxtGuide01' on the map screen; neither is under PicStrap, so neither
+//     is touched. Hidden panes are logged (HUD_MATCH_HIDDEN) so the next
+//     probe shows exactly which panes were hidden.
+//  4. hud_tree_has hardening (log-23 crash): three guards on every subtree
+//     walk (hud_tree_has, hud_tree_has_life, hud_mark_dirty and the
+//     twin-write's walk, which is the same pattern): (a) a popped pointer
+//     is checked for NULL / alignment before it is read; (b) a list node is
+//     checked (non-NULL, 8-byte aligned, >= 0x10000) before child =
+//     node - 8; (c) a child that is the pane itself, or lies inside the
+//     pane's own first 0x100 bytes, is never treated as a pane (a corrupt
+//     list like log-23's, whose head.next pointed into the root itself, now
+//     stops the walk instead of descending into garbage and reaching
+//     NULL+0x28). The walk stops (breaks) on a corrupt node rather than
+//     trusting the rest of that list.
+//  5. Welcome screen excluded from the root stretch: hud_root_class gains
+//     HUD_CLASS_GUIDE -- a root whose subtree holds a guide text
+//     ('TxtGuide' / 'TxtGuideSh') AND a scenario text ('TxtScenario' /
+//     'TxtScenarioSh') AND 'WinLine', and none of the five gameplay-HUD
+//     names. A single 'TxtGuideSh' is NOT enough (it appears twice in
+//     log-24). The exclusion only stops the gold panel being stretched;
+//     the logo being cut is not explained by the root stretch
+//     (welcome-screen-root-cause.md §4.3), so it may not come back with
+//     this fix. The guide root is still logged (class 3).
+//  6. Map M4: after a MAP-class root is stretched, its subtree is marked
+//     dirty (hud_mark_dirty), so the map's static 2D panes recompute from
+//     the stretched root instead of keeping the matrices they computed
+//     before the stretch. Pause roots are NOT marked dirty here: the pause
+//     menu's failure is the matrix being reset between Calculate and Draw
+//     (H1), not static children, and that is a different fix. The ortho
+//     terrain widening itself is NOT in this build (see uw.c: record mode
+//     only); the map terrain stays 82% in V1.3.12.
+//
+// NOTE (HUD_WORDS): this file changed in v7, so the HUD_WORDS literal in
+// patches.py (still the v6 words) is STALE until it is regenerated from
+// this file with the ARM64 toolchain. Do NOT ship this patch without that
+// step: a build from stale words runs v6 behaviour, not v7.
+//
+
+// V6 (2026-11-12): the moon and the coins are adjustable without the [hud] log,
+// and element 0's slots take only the compass. Root causes, all from log-24/25
+// and the code: (a) the moon rule only matched the moon counter's small
+// RootPane layout (name 'RootPane', 100-600 on both sides, subtree holding
+// 'Counter' AND 'TxtTotalShine'), but log-24/25 -- two 81-second gameplay runs
+// -- have no such RootPane, no 'Counter', no 'TxtTotalShine' at all, while the
+// moon count 023 is on screen: the 160-entry first-encounter log fills before
+// the moon cluster is met, so a rule that needs the small root can never fire
+// in those runs. The moon is now the 'Counter' group by name (the 320x200
+// container holding the icon and the number), with a bare 'TxtTotalShine' as
+// the fallback when there is no 'Counter' group -- neither needs the log, the
+// root's size, or a subtree walk. (b) The coins are matched ('TxtCounterSh'
+// is element 2 in both logs) yet the user reports dragging them moves nothing,
+// and both logs have dm_hud_set == 0 (no drag was ever captured), so the drag
+// itself was never observed; the matcher and the settings path read correct,
+// and the likeliest in-code gap is the twin-write landing on the wrong
+// 'TxtCounter' sibling. The twin-write now requires the twin to be the same
+// size as its anchor, and dm_hud_set logs every editor call (hud.c), so the
+// next probe shows whether the settings reached the host and which twin was
+// written. (c) Element 0's slots were shared by 'PicStrap', a full-screen
+// RootPane and a 10x10 SelectPos (log-25 lines 244/630/633), so the compass
+// could not be adjusted: the matcher as written only returns idx 0 for
+// 'CompassArea' or 'PicStrap', so how those two panes were labelled 0 is not
+// explained by the matcher (a memory-safety / stale-log issue, in the same
+// family as the log-23 hud_tree_has crash); v6 adds a slot-name guard
+// (hud_slot_name_ok) that refuses to store a pane in an element's slots unless
+// its name is one of that element's own names, so only 'PicStrap' (or
+// 'CompassArea') can ever occupy element 0. Life (idx 1) is unchanged in v6:
+// its 'Life'-container and bare-'TxtLife' rules and the slot guard's idx-1
+// names are the same as v5, so a working life adjustment stays working.
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-asynchronous-unwind-tables -c
+// (the same flags the engine's duo_anchor.c uses, but with gcc; clang's
+// -target arm64-apple-macos is not installed on this host). The words of the
+// resulting __text are embedded in patches.py as HUD_WORDS. This file takes
+// everything through its arguments -- no static data, no literal pool, no external
+// calls -- so the emitted words are position-independent and relocation-free and
+// can be dropped into the rewriter's patch area verbatim:
+//   x0 = the pane (nn::ui2d::Pane *), x1 = params (state page + 0x200: 12 floats,
+//   dx / dy / scale per HUD element, then a u32 generation at +48, then the root
+//   scale root_sx at +52 and root_sy at +56), x2 = HUD table (state page + 0x300:
+//   eight 120-byte entries, two per HUD element -- two layout instances can match
+//   the same element), x3 = log buffer (state page + 0x1000: a u32 count, then
+//   160 entries of 72 bytes). The root table lives at state page + 0x700 (19
+//   entries of 120 bytes, derived here as table + 0x400). Element order:
+//   0 compass, 1 life, 2 coins, 3 moons. The state page starts zeroed, so a table
+//   entry with pane == 0 is unused and a generation of 0 means "never applied".
+//   A zeroed scale (k, root_sx, root_sy all 0 before the host writes) reads as 1,
+//   so an unwritten state page is a no-op, never a collapse.
+//
+// The log buffer records, deduped by pane address, name and matched code, every
+// pane the hook meets that is a full-screen layout root or sits in the screen's
+// top strip (name, position, size, which HUD element it matched if any, which
+// class of root it is, the pane's global matrix -- the full 2x2, so a rotating
+// pane (the compass needle, if it is one) is visible in the log -- its flags and
+// origin, and the pane's address), plus one extra entry per root after its
+// transform is applied (the same pane, the scaled size and matrix), so one run's
+// log.txt shows the real pane names -- which layout is "RootPane", whether the
+// PauseMenu / WorldMap roots are the ones this hook scaled, and by exactly how
+// much. A pane is only logged once it has calculated at least once (flags bit 7,
+// set by Pane::Calculate's epilogue): on a pane's very first frame its global
+// matrix is still zero, so logging it then would record (0,0) and a scale of 0.
+// Panes named 'All' are not logged (they are 30x40 placeholder groups, and
+// log-18 wasted over a dozen of its 64 entries on them) unless they matched a
+// HUD element, so a matched group is verifiable in the log. The buffer grew
+// from 64 to 160 entries for the same reason: log-18 filled up in its first
+// ~30 seconds (title, pause, map, objective panes) and the session's remaining
+// ~160 seconds of gameplay HUD
+// contributed nothing -- the compass, coins and life panes were very likely never
+// logged because the buffer was already full, not because their names are wrong.
+
+typedef unsigned int u32;
+typedef unsigned long uintptr_t;
+
+#define HUD_N 4
+#define HUD_NAME_MAX 24
+#define HUD_ENTRY 120          // bytes per table entry (HUD table and root table)
+#define HUD_SLOTS_PER_ELEM 2   // table slots per HUD element: two layout instances can match the same element
+#define HUD_ROOT_MAX 19        // root table slots (state page +0x700 .. +0xfe8)
+#define HUD_LOG_MAX 160
+#define HUD_LOG_ENTRY 72       // 24 name + 4 tx + 4 ty + 4 w + 4 h + 4 matched + 8 address + 4 g0 + 4 g1 + 4 g4 + 4 g5 + 2 flags + 1 origin + 1 class
+#define HUD_MATCH_NONE 0xffffffffu
+#define HUD_MATCH_ROOT 0xfffffffeu
+#define HUD_MATCH_ROOT_PAUSE 0xfffffffdu
+#define HUD_MATCH_ROOT_MAP 0xfffffffcu
+#define HUD_MATCH_ROOT_SCALED 0xfffffffbu
+#define HUD_MATCH_ROOT_SCALED_PAUSE 0xfffffffa
+#define HUD_MATCH_ROOT_SCALED_MAP 0xfffffff9u
+#define HUD_MATCH_HIDDEN 0xfffffff8u   // (v7) a guide-text pane hidden off-screen (item 3)
+
+#define HUD_CLASS_UNKNOWN 0u
+#define HUD_CLASS_PAUSE 1u
+#define HUD_CLASS_MAP 2u
+#define HUD_CLASS_GUIDE 3u   // (v7) the welcome / controller-guide root: excluded from the stretch like the HUD root
+
+// The first four bytes of each target name, as a little-endian u32: a fast reject
+// before the full compare. "Comp" (CompassArea), "Coin" (CoinCounter), "Moon" (MoonNum).
+#define HUD_P_COMP 0x706d6f43u
+#define HUD_P_COIN 0x6e696f43u
+#define HUD_P_MOON 0x6e6f6f4du
+// The rest of each name as little-endian u32s, NUL included, so the full compare
+// needs no string literal: a literal would sit in .rodata and the code would load
+// its address with an adrp (a relocation), and the embedded words carry no literal
+// pool. "CompassArea": bytes 4-7 "assA", 8-11 "rea\0"; "CoinCounter": "Coun",
+// "ter\0"; "MoonNum": bytes 4-7 "Num\0" (8 bytes: no third word to compare).
+#define HUD_C_COMP1 0x41737361u
+#define HUD_C_COMP2 0x00616572u
+#define HUD_C_COIN1 0x6e756f43u
+#define HUD_C_COIN2 0x00726574u
+#define HUD_C_MOON1 0x006d754eu
+// The counter widgets (v3, structural): the container pane is named "Counter"
+// ("Coun", "ter\0"); its identifying text child is 'TxtTotalShine' (moons),
+// 'TxtCounterSh' (coins) or 'TxtLife' (life). "TxtTotalShine": "TxtT", "otal",
+// "Shin", "e\0"; "TxtCounterSh": "TxtC", "ount", "erSh", 0 (12 bytes, so the
+// fourth word is the NUL word); "TxtLife": "TxtL", "ife\0".
+#define HUD_W_COUNTER0 0x6e756f43u
+#define HUD_W_COUNTER1 0x00726574u
+#define HUD_W_TSHINE0 0x54747854u
+#define HUD_W_TSHINE1 0x6c61746fu
+#define HUD_W_TSHINE2 0x6e696853u
+#define HUD_W_TSHINE3 0x00000065u
+#define HUD_W_TCSH0 0x43747854u
+#define HUD_W_TCSH1 0x746e756fu
+#define HUD_W_TCSH2 0x68537265u
+#define HUD_W_TCSH3 0x00000000u
+#define HUD_W_TLIFE0 0x4c747854u
+#define HUD_W_TLIFE1 0x00656669u
+// The life container (v4): a pane named "Life" ("Life" as one word, 0x6566694c;
+// the 5th byte is the NUL, so the name is checked exactly, not by word alone).
+// The coin twin (v4): the plain-number pane 'TxtCounter' ("TxtC", "ount",
+// "er\0"), the sibling of 'TxtCounterSh' that the twin-write moves with it.
+#define HUD_W_LIFE0 0x6566694cu
+#define HUD_W_TC0 0x43747854u
+#define HUD_W_TC1 0x746e756fu
+#define HUD_W_TC2 0x00007265u
+// The right strip (v5): a pane named "PicStrap" ("PicS", "trap"; 8 letters, so
+// the 9th byte is the NUL and the name is checked exactly, not by word alone).
+// It is the compass element (idx 0): the whole right-hand strip, compass and
+// life ring and guide text together.
+#define HUD_W_STRAP0 0x53636950u
+#define HUD_W_STRAP1 0x70617274u
+// The layout classifiers (v3, structural): 'PicMapCap' ("PicM", "apCa", "p\0")
+// marks the WorldMap, 'ParList00' ("ParL", "ist0", "0\0") and 'WinSelect'
+// ("WinS", "elec", "t\0") the PauseMenu. The small counter layouts' parent root
+// is named "RootPane" ("Root", "Pane", 0).
+#define HUD_W_MAPCAP0 0x4d636950u
+#define HUD_W_MAPCAP1 0x61437061u
+#define HUD_W_MAPCAP2 0x00000070u
+#define HUD_W_PARLIST0 0x4c726150u
+#define HUD_W_PARLIST1 0x30747369u
+#define HUD_W_PARLIST2 0x00000030u
+#define HUD_W_WINSEL0 0x536e6957u
+#define HUD_W_WINSEL1 0x63656c65u
+#define HUD_W_WINSEL2 0x00000074u
+#define HUD_W_ROOT0 0x746f6f52u
+#define HUD_W_ROOT1 0x656e6150u
+#define HUD_W_ROOT2 0x00000000u
+// The placeholder group name "All" ("All\0" as one word), never logged.
+#define HUD_W_ALL 0x006c6c41u
+// The guide texts (v7): 'TxtGuide' ("TxtG", "uide", NUL at [8]) and its
+// shadow 'TxtGuideSh' ("TxtG", "uide", "Sh\0"), plus 'TxtGuideLSh' /
+// 'TxtGuideRSh' (third word "LSh\0" / "RSh\0"). 'TxtGuide01' is a different
+// name (the map screen's guide box) and is never matched by these exact
+// compares -- the NUL at the name's end is part of the check.
+// The welcome screen's texts (v7): 'TxtScenario' ("TxtS", "cena", "rio\0")
+// and 'TxtScenarioSh' (one word more, "h\0"); 'WinLine' ("WinL", "ine\0").
+#define HUD_W_GUIDE0 0x47747854u
+#define HUD_W_GUIDE1 0x65646975u
+#define HUD_W_GUIDESH2 0x00006853u
+#define HUD_W_GUIDELSH2 0x0068534cu
+#define HUD_W_GUIDERSH2 0x00685352u
+#define HUD_W_SCEN0 0x53747854u
+#define HUD_W_SCEN1 0x616e6563u
+#define HUD_W_SCEN2 0x006f6972u
+#define HUD_W_SCENSH2 0x536f6972u
+#define HUD_W_SCENSH3 0x00000068u
+#define HUD_W_WINLINE0 0x4c6e6957u
+#define HUD_W_WINLINE1 0x00656e69u
+
+// Bounded compare of a pane name (at most 24 bytes, stops at NUL) against a name
+// already recorded in the log buffer (both are runtime data, never a literal).
+static inline __attribute__((always_inline)) int hud_name_eq(const char *name, const char *target) {
+    for (int i = 0; i < HUD_NAME_MAX; i++) {
+        if (name[i] != target[i]) return 0;
+        if (name[i] == 0) return 1;
+    }
+    return 0;
+}
+
+// Compare a pane name's words against a target's words (nwords of 4 bytes each,
+// NUL included where the name is short, so a longer name with the same prefix is
+// rejected). The name lives at pane+0xb8, 8-byte aligned, so the u32 reads are
+// aligned, exactly as v1's matcher did.
+static inline __attribute__((always_inline)) int hud_words_eq(const u32 *nw, u32 a, u32 b, u32 c, u32 d, int n) {
+    if (n > 0 && nw[0] != a) return 0;
+    if (n > 1 && nw[1] != b) return 0;
+    if (n > 2 && nw[2] != c) return 0;
+    if (n > 3 && nw[3] != d) return 0;
+    return 1;
+}
+
+static inline __attribute__((always_inline)) float hud_clamp_k(float k) {
+    // A scale outside [0.2, 3.0], or not a number, is the settings panel's bug, not
+    // a request: fall back to 1 (no resize). A zero scale is not a request either:
+    // the state page starts zeroed, so an unwritten slot reads as 0 and must mean
+    // identity, never a collapse. The NaN test is k != k (a NaN is not equal to
+    // itself); a negative scale would mirror the widget, which nobody asked for.
+    if (k == 0.0f || k != k) return 1.0f;
+    if (k < 0.2f) return 0.2f;
+    if (k > 3.0f) return 3.0f;
+    return k;
+}
+
+static inline __attribute__((always_inline)) float hud_clamp_root(float s) {
+    // The root stretch, from the screen shape: 1 is 16:9 (no stretch). A zero or
+    // non-number is an unwritten state page, so identity; outside [0.5, 2.0] is a
+    // host bug, so clamp. The screen's widest (2.2) asks for 2.2 / (16/9) = 1.24,
+    // and its tallest (1.3) for (16/9) / 1.3 = 1.37.
+    if (s == 0.0f || s != s) return 1.0f;
+    if (s < 0.5f) return 0.5f;
+    if (s > 2.0f) return 2.0f;
+    return s;
+}
+
+// Scale orig about the pane's centre, then move by (dx, dy) in layout units, into
+// mod. sx scales the x row, sy the y row (a HUD widget passes sx == sy == k; a
+// layout root passes the screen shape's sx / sy with dx == dy == 0). The centre is
+// the pane's middle passed through its own matrix. The middle is found from the
+// pane's origin (the byte at +0x5b, confirmed by disassembly of the local matrix
+// helper at main+0x9096d0: bits 4-5 the horizontal origin, 1 left, 2 right; bits
+// 6-7 the vertical origin, 1 top, 2 bottom; 0 is the centre either way) and its
+// size at +0x50 / +0x54: the centre is the origin plus half the size towards the
+// middle (the layout is y-up, the origin at the parent's centre, so a top
+// origin's centre is half the height below it, a left origin's half the width
+// to its right). A pane with no usable size scales about its translation (its
+// origin), which is the same thing for a point-sized pane. The third row (depth)
+// is left alone: this is a 2D widget, and scaling its depth would change its
+// draw order.
+static inline __attribute__((always_inline)) void hud_xform(const float *orig, float *mod, float dx, float dy,
+                      float sx, float sy, float w, float h, unsigned char origin) {
+    float cx, cy;
+    if (w > 0.0f && w < 100000.0f && h > 0.0f && h < 100000.0f) {
+        float ox = ((origin >> 4) & 3) == 1 ? w * 0.5f : ((origin >> 4) & 3) == 2 ? -w * 0.5f : 0.0f;
+        float oy = ((origin >> 6) & 3) == 1 ? -h * 0.5f : ((origin >> 6) & 3) == 2 ? h * 0.5f : 0.0f;
+        cx = orig[0] * ox + orig[1] * oy + orig[3];
+        cy = orig[4] * ox + orig[5] * oy + orig[7];
+    } else {
+        cx = orig[3];
+        cy = orig[7];
+    }
+    for (int i = 0; i < 3; i++) { mod[i] = orig[i] * sx; mod[4 + i] = orig[4 + i] * sy; }
+    mod[3] = cx + (orig[3] - cx) * sx + dx;
+    mod[7] = cy + (orig[7] - cy) * sy + dy;
+    for (int i = 8; i < 12; i++) mod[i] = orig[i];
+}
+
+// (v7, log-23) The guards every subtree walk below applies. A layout's
+// child list can go stale while the game unloads it (log-23: a root's
+// head.next pointed into the root itself, and the walk reached NULL+0x28),
+// so no walk trusts a pointer it did not validate:
+//  (a) a popped pane is checked for NULL / alignment before it is read;
+//  (b) a list node is checked (non-NULL, 8-byte aligned, >= 0x10000) before
+//      child = node - 8 is computed from it;
+//  (c) a child that is the pane itself, or lies inside the pane's own
+//      first 0x100 bytes (a pane's fields run to +0xd0, so 0x100 covers the
+//      object), is never treated as a pane: the walk stops instead of
+//      descending into the pane's own memory. A genuine child allocated in
+//      the 0x100 bytes right after its parent would be missed by (c) --
+//      that costs one subtree match, not a crash; the direct name matcher
+//      in hud_calc does not use these walks and is unaffected.
+static inline __attribute__((always_inline)) int hud_node_ok(void *node) {
+    uintptr_t v = (uintptr_t)node;
+    return v != 0 && (v & 7u) == 0 && v >= 0x10000;
+}
+
+static inline __attribute__((always_inline)) int hud_child_self(void *p, void *child) {
+    if (child == p) return 1;
+    if ((uintptr_t)child <= (uintptr_t)p) return 0;
+    return (uintptr_t)child - (uintptr_t)p < 0x100;
+}
+
+// Walk a pane's children (at most 32 per pane) and their children and
+// grandchildren (two more levels), calling the name test on each child's name,
+// and report whether any of them is named by the given words. The child list is
+// the game's own intrusive list, the same one Pane::FindPaneByName
+// (main+0x909310) and the child loop in Pane::Calculate walk: the head is at
+// pane+0x20, the first node at pane+0x28, a node's pane is 8 bytes below the
+// node, and the next node is at (pane+0x10) once the node is stepped back to its
+// pane. The walk is iterative (an explicit stack, so the function can be inlined
+// and the emitted words stay one function starting at hud_calc), bounded (64
+// node visits at most) and NULL-guarded; a layout instantiates all its panes at
+// load time, so a root's whole subtree is walkable from its first sighting. The
+// depth is 2 (not 1) because the moon counter's identifying text is a
+// great-grandchild of its small RootPane (RootPane -> All -> Counter ->
+// TxtTotalShine); the child cap is 32 because a full-screen root can have more
+// than 16 children. The stack holds 64 nodes, so the wider, deeper walk cannot
+// overflow it (at most 64 visits, so at most 64 pushes).
+static inline __attribute__((always_inline)) int hud_tree_has(void *pane, u32 a, u32 b, u32 c, u32 d, int n) {
+    if (!pane) return 0;
+    void *stack[64];
+    unsigned char sdepth[64];
+    int sp = 0, visits = 0;
+    stack[sp] = pane;
+    sdepth[sp] = 2;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = stack[sp];
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (v7 a) never read a popped NULL / unaligned pane
+        unsigned char depth = sdepth[sp];
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_node_ok(node)) break;          // (v7 b) never follow a bad node
+            void *child = (char *)node - 8;
+            if (hud_child_self(p, child)) break;    // (v7 c) never descend into the pane itself
+            visits++;
+            if (hud_words_eq((const u32 *)((const char *)child + 0xb8), a, b, c, d, n)) return 1;
+            if (depth > 0 && sp < 64) {
+                stack[sp] = child;
+                sdepth[sp] = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+    return 0;
+}
+
+// The same walk, but the name test is the exact 4-letter name "Life" (its 5th
+// byte is the NUL): hud_words_eq cannot express it, because "Life" fills one
+// word and the next word is the NUL plus padding, which the word compare would
+// also require to be zero. Used by the life rule and by the gameplay-HUD-root
+// exclusion, which both need to know whether a subtree holds the Life container.
+static inline __attribute__((always_inline)) int hud_tree_has_life(void *pane) {
+    if (!pane) return 0;
+    void *stack[64];
+    unsigned char sdepth[64];
+    int sp = 0, visits = 0;
+    stack[sp] = pane;
+    sdepth[sp] = 2;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = stack[sp];
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (v7 a)
+        unsigned char depth = sdepth[sp];
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_node_ok(node)) break;          // (v7 b)
+            void *child = (char *)node - 8;
+            if (hud_child_self(p, child)) break;    // (v7 c)
+            visits++;
+            {
+                const char *nm = (const char *)child + 0xb8;
+                if (*(const u32 *)nm == HUD_W_LIFE0 && nm[4] == 0) return 1;
+            }
+            if (depth > 0 && sp < 64) {
+                stack[sp] = child;
+                sdepth[sp] = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+    return 0;
+}
+
+// (v7) Does this subtree hold the welcome / controller-guide combination:
+// a guide text ('TxtGuide' or 'TxtGuideSh' or 'TxtGuideLSh' / 'TxtGuideRSh',
+// exact names -- 'TxtGuide01' on the map screen does not count) AND a
+// scenario text ('TxtScenario' or 'TxtScenarioSh', exact) AND 'WinLine'
+// (exact), and NONE of the five gameplay-HUD names? One walk, depth 3 (the
+// three names may sit deeper than hud_tree_has's depth 2), same 64-visit
+// bound and the same three guards as the other walks. A lone 'TxtGuideSh'
+// is not enough: log-24 has two of them (the welcome block and a 102x80
+// one), and hiding a root on one name alone would misfire.
+static inline __attribute__((always_inline)) int hud_tree_has_guide_combo(void *pane) {
+    if (!pane) return 0;
+    int saw_guide = 0, saw_scenario = 0, saw_winline = 0, saw_hud = 0;
+    void *stack[64];
+    unsigned char sdepth[64];
+    int sp = 0, visits = 0;
+    stack[sp] = pane;
+    sdepth[sp] = 3;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = stack[sp];
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (v7 a)
+        unsigned char depth = sdepth[sp];
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_node_ok(node)) break;          // (v7 b)
+            void *child = (char *)node - 8;
+            if (hud_child_self(p, child)) break;    // (v7 c)
+            visits++;
+            {
+                const char *nm = (const char *)child + 0xb8;
+                const u32 *nw = (const u32 *)nm;
+                if (nw[0] == HUD_W_GUIDE0 && nw[1] == HUD_W_GUIDE1 &&
+                    (nm[8] == 0 || (nw[2] == HUD_W_GUIDESH2) ||
+                     (nw[2] == HUD_W_GUIDELSH2) || (nw[2] == HUD_W_GUIDERSH2))) saw_guide = 1;
+                else if (nw[0] == HUD_W_SCEN0 && nw[1] == HUD_W_SCEN1 &&
+                         (nw[2] == HUD_W_SCEN2 || (nw[2] == HUD_W_SCENSH2 && nw[3] == HUD_W_SCENSH3))) saw_scenario = 1;
+                else if (nw[0] == HUD_W_WINLINE0 && nw[1] == HUD_W_WINLINE1 && nm[7] == 0) saw_winline = 1;
+                else if (hud_words_eq(nw, HUD_W_TCSH0, HUD_W_TCSH1, HUD_W_TCSH2, HUD_W_TCSH3, 4) ||
+                         hud_words_eq(nw, HUD_W_TC0, HUD_W_TC1, HUD_W_TC2, 0, 3) ||
+                         hud_words_eq(nw, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2) ||
+                         hud_words_eq(nw, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2) ||
+                         (nw[0] == HUD_W_LIFE0 && nm[4] == 0)) saw_hud = 1;
+            }
+            if (depth > 0 && sp < 64) {
+                stack[sp] = child;
+                sdepth[sp] = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+    return saw_guide && saw_scenario && saw_winline && !saw_hud;
+}
+
+// Which class of full-screen root is this: the WorldMap (a 'PicMapCap' pane
+// somewhere in its subtree), the PauseMenu (a 'ParList00' or 'WinSelect'), or
+// unknown (some other full-screen layout). Walked on every root sighting; the
+// subtree is small (a layout's panes) and roots are rare, so the cost is nothing.
+static inline __attribute__((always_inline)) u32 hud_root_class(void *pane) {
+    if (hud_tree_has(pane, HUD_W_MAPCAP0, HUD_W_MAPCAP1, HUD_W_MAPCAP2, 0, 3)) return HUD_CLASS_MAP;
+    if (hud_tree_has(pane, HUD_W_PARLIST0, HUD_W_PARLIST1, HUD_W_PARLIST2, 0, 3)) return HUD_CLASS_PAUSE;
+    if (hud_tree_has(pane, HUD_W_WINSEL0, HUD_W_WINSEL1, HUD_W_WINSEL2, 0, 3)) return HUD_CLASS_PAUSE;
+    if (hud_tree_has_guide_combo(pane)) return HUD_CLASS_GUIDE;
+    return HUD_CLASS_UNKNOWN;
+}
+
+// Append one log entry (name, position, size, matched code, address, the
+// full 2x2 of the global matrix, flags, origin, class), deduped by pane
+// address, name and matched code. Returns 1 if the entry was written. The
+// caller checks the count first. The whole 2x2 is logged (not just the
+// diagonal) so the probe can see rotation: the compass needle, if it is a Pane
+// at all, must carry a rotation in its matrix, and a pane with a zero
+// off-diagonal is provably not rotating (see the header).
+static inline __attribute__((always_inline)) int hud_log_add(void *logbuf, void *pane, const char *name,
+                      float tx, float ty, float w, float h, u32 matched,
+                      float g0, float g1, float g4, float g5, unsigned short pflags, unsigned char origin, u32 cls) {
+    if (!logbuf) return 0;
+    u32 *count = (u32 *)logbuf;
+    if (*count >= HUD_LOG_MAX) return 0;
+    char *entries = (char *)logbuf + 4;
+    for (u32 e = 0; e < *count; e++) {
+        char *en = entries + e * HUD_LOG_ENTRY;
+        if (*(uintptr_t *)(en + 44) == (uintptr_t)pane && hud_name_eq(en, name) &&
+            *(u32 *)(en + 40) == matched) return 0;
+    }
+    char *dst = entries + (*count) * HUD_LOG_ENTRY;
+    for (int i = 0; i < HUD_NAME_MAX; i++) {
+        dst[i] = name[i];
+        if (!name[i]) break;
+    }
+    // A slot the loop above did not write keeps the previous entry's bytes only
+    // if the name is shorter: zero the tail past the NUL so a stale name can
+    // never be read back.
+    for (int i = 0; i < HUD_NAME_MAX; i++) if (!dst[i]) { for (int j = i + 1; j < HUD_NAME_MAX; j++) dst[j] = 0; break; }
+    *(float *)(dst + 24) = tx;
+    *(float *)(dst + 28) = ty;
+    *(float *)(dst + 32) = w;
+    *(float *)(dst + 36) = h;
+    *(u32 *)(dst + 40) = matched;
+    *(uintptr_t *)(dst + 44) = (uintptr_t)pane;
+    *(float *)(dst + 52) = g0;
+    *(float *)(dst + 56) = g1;
+    *(float *)(dst + 60) = g4;
+    *(float *)(dst + 64) = g5;
+    *(unsigned short *)(dst + 68) = pflags;
+    dst[70] = (char)origin;
+    dst[71] = (char)cls;
+    (*count)++;
+    return 1;
+}
+
+// Mark every descendant of a pane dirty (flags bit 4 at +0x58), so the game
+// recomputes their global matrices from this pane's (just-modified) matrix
+// (v5). The parent-changed flag the game passes to children (w22, set to 1 at
+// the +0x13c site) is 0 on the skip path, so without this a static container's
+// children never recompute and never follow it -- the hook would move the
+// container and leave its contents behind. The flag is the game's own signal
+// (Pane::Calculate sets it when a parent changed and clears it on recompute),
+// so the game's next Calculate on each descendant takes the helper path, reads
+// the parent's current (modified) matrix, and reaches the +0x13c hook with a
+// fresh original. The walk is the same bounded one hud_tree_has uses (64 visits,
+// 32 children per pane, depth 3, so it reaches great-great-grandchildren); the
+// pane itself is never marked (marking it would make the game recompute and
+// wipe the hook's edit). Only called when the hook actually writes a new
+// matrix, never on the already-correct early return.
+static inline __attribute__((always_inline)) void hud_mark_dirty(void *pane) {
+    if (!pane) return;
+    void *stack[64];
+    unsigned char sdepth[64];
+    int sp = 0, visits = 0;
+    stack[sp] = pane;
+    sdepth[sp] = 3;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = stack[sp];
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (v7 a)
+        unsigned char depth = sdepth[sp];
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_node_ok(node)) break;          // (v7 b)
+            void *child = (char *)node - 8;
+            if (hud_child_self(p, child)) break;    // (v7 c) never write a flag into the pane itself
+            visits++;
+            *(unsigned short *)((char *)child + 0x58) |= 0x10u;
+            if (depth > 0 && sp < 64) {
+                stack[sp] = child;
+                sdepth[sp] = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+}
+
+// Compare two 3x4 matrices for equality within tol (absolute, per float).
+// Two matrices the game computed from the same layout are bit-identical;
+// a recompute may differ in the last ulp, so a small tolerance is allowed.
+static inline __attribute__((always_inline)) int hud_matrix_eq(const float *a, const float *b, float tol) {
+    for (int i = 0; i < 12; i++) {
+        float d = a[i] - b[i];
+        if (d < 0.0f) d = -d;
+        if (d > tol) return 0;
+    }
+    return 1;
+}
+
+// The coin twin-write (v4): when a 'TxtCounterSh' anchor is transformed, find
+// its sibling named 'TxtCounter' (the plain number, a direct child of the same
+// parent, at the same position with the same size and the same matrix) and write
+// the same modified matrix to it, so the shadow and the plain number move as
+// one. Moving only the shadow would visibly split the number. The twin has no
+// table entry of its own: the write is idempotent (the same mod every frame), so
+// it is re-applied whenever the anchor is, and it never accumulates. (v6) The
+// twin must be the plain number that belongs to this shadow: the same size, so
+// a 'TxtCounter' from another counter (or a stale layout) is never written to
+// by mistake; a name match with the wrong size is skipped, and the search
+// goes on. (v7) Size alone does not separate the two live twins (both are
+// 84x72), so the twin must also pair with the anchor by ORIGINAL matrix:
+// the candidate's current matrix must be the anchor's stored original, or
+// the mod already written to it (it was written on an earlier frame and is
+// already right), or -- when the settings just changed -- the previous
+// frame's mod (old_mod, only when have_old: the entry existed and had a
+// previous generation). A twin from another cluster has a different
+// original, so its matrix matches none of the three and it is never
+// written; a twin holding last frame's mod is the same twin, not a
+// stranger's, because the anchor's own mod is what was written to it.
+// The walk has the same three guards as the subtree walks (v7, log-23).
+static inline __attribute__((always_inline)) void hud_coin_twin_write(void *pane, const float *mod,
+                      const float *orig, const float *old_mod, int have_old) {
+    void *parent = *(void **)((const char *)pane + 0x18);
+    if (!parent) return;
+    float aw = *(const float *)((const char *)pane + 0x50);
+    float ah = *(const float *)((const char *)pane + 0x54);
+    void *head = (char *)parent + 0x20;
+    void *node = *(void **)((const char *)parent + 0x28);
+    for (int i = 0; i < 32; i++) {
+        if (!node || node == head) break;
+        if (!hud_node_ok(node)) break;          // (v7 b)
+        void *child = (char *)node - 8;
+        if (hud_child_self(parent, child)) break;   // (v7 c)
+        if (hud_words_eq((const u32 *)((const char *)child + 0xb8),
+                         HUD_W_TC0, HUD_W_TC1, HUD_W_TC2, 0, 3)) {
+            float cw = *(const float *)((const char *)child + 0x50);
+            float ch = *(const float *)((const char *)child + 0x54);
+            if (cw == aw && ch == ah) {
+                const float *cm = (const float *)child + 0x70 / 4;
+                if (hud_matrix_eq(cm, orig, 0.02f) || hud_matrix_eq(cm, mod, 0.02f) ||
+                    (have_old && hud_matrix_eq(cm, old_mod, 0.02f))) {
+                    float *dst = (float *)child + 0x70 / 4;
+                    for (int j = 0; j < 12; j++) dst[j] = mod[j];
+                    return;
+                }
+            }
+        }
+        node = *(void **)((const char *)child + 0x10);
+    }
+}
+
+// (v7) Compass un-stretch: divide a stored original's scale rows back by
+// the screen-shape stretch, when the original actually carries it. The
+// translation is untouched: the strip stays where the wide layout puts it
+// (at the screen's right edge) and only its shape goes round. rsx / rsy
+// come from the host's root scale (params[13] / params[14]), the same
+// factor the engine carries the HUD root at (log-24: the HUD root reads
+// 1.219 although v5/v6 never stretch it). An original whose x scale is not
+// root_sx (or whose y scale is not root_sy) is left alone: without the
+// match, dividing would squash a legitimately 1.0 pane to 0.82.
+static inline __attribute__((always_inline)) void hud_compass_destretch(float *orig, const float *params) {
+    float rsx = hud_clamp_root(params[13]);
+    float rsy = hud_clamp_root(params[14]);
+    if (rsx == 1.0f && rsy == 1.0f) return;
+    if (rsx == 0.0f || rsy == 0.0f) return;
+    {
+        float dx0 = orig[0] - rsx; if (dx0 < 0.0f) dx0 = -dx0;
+        float dy5 = orig[5] - rsy; if (dy5 < 0.0f) dy5 = -dy5;
+        if (dx0 > 0.02f * rsx || dy5 > 0.02f * rsy) return;
+    }
+    orig[0] /= rsx; orig[1] /= rsx; orig[2] /= rsx;
+    orig[4] /= rsy; orig[5] /= rsy; orig[6] /= rsy;
+}
+
+// (v7) Is this pane named 'PicStrap' (exact)? The right strip.
+static inline __attribute__((always_inline)) int hud_name_is_strap(const char *name) {
+    const u32 *nw = (const u32 *)name;
+    return nw[0] == HUD_W_STRAP0 && nw[1] == HUD_W_STRAP1 && name[8] == 0;
+}
+
+// (v7) Is this pane a guide text inside the right strip? The name must be
+// exactly 'TxtGuide' / 'TxtGuideSh' / 'TxtGuideLSh' / 'TxtGuideRSh' (the
+// NUL is part of the check, so 'TxtGuide01' on the map screen never
+// matches), and the parent or the grandparent must be 'PicStrap'. The
+// parent pointers are validated before their names are read (log-23's
+// family: a stale parent must not be dereferenced). A guide text anywhere
+// else (the welcome screen's 'TxtGuideSh', a footer guide) is left alone.
+static inline __attribute__((always_inline)) int hud_is_guide_text(void *pane, const char *name, void *parent) {
+    const u32 *nw = (const u32 *)name;
+    int is_guide = 0;
+    if (nw[0] == HUD_W_GUIDE0 && nw[1] == HUD_W_GUIDE1 &&
+        (name[8] == 0 || nw[2] == HUD_W_GUIDESH2 ||
+         nw[2] == HUD_W_GUIDELSH2 || nw[2] == HUD_W_GUIDERSH2)) is_guide = 1;
+    if (!is_guide) return 0;
+    if (parent && hud_node_ok(parent) && parent != pane) {
+        if (hud_name_is_strap((const char *)parent + 0xb8)) return 1;
+        void *gp = *(void **)((const char *)parent + 0x18);
+        if (gp && hud_node_ok(gp) && gp != pane && gp != parent &&
+            hud_name_is_strap((const char *)gp + 0xb8)) return 1;
+    }
+    return 0;
+}
+
+// (v6) Slot-name guard: is this pane's name one of element idx's own names?
+// The matcher above is the first check; this is the second, at the point a
+// pane is stored in an element's table slots. It stops a pane the matcher
+// mislabels (the log's RootPane / SelectPos as element 0) from ever taking a
+// slot. The names here mirror the matcher's rules exactly, so a legitimately
+// matched pane always passes: 0 is 'PicStrap' (or the 'CompassArea' fallback),
+// 1 is 'Life' or 'TxtLife', 2 is 'TxtCounterSh' (or 'CoinCounter'), 3 is
+// 'Counter' or 'TxtTotalShine' (or 'MoonNum'). The old small-RootPane moon
+// rule is gone in v6 (the moon is 'Counter' by name now), so 'RootPane' is
+// deliberately NOT an element-3 name here.
+static inline __attribute__((always_inline)) int hud_slot_name_ok(int idx, const char *name, const u32 *nw) {
+    if (idx == 0) {
+        if (nw[0] == HUD_W_STRAP0 && nw[1] == HUD_W_STRAP1 && name[8] == 0) return 1;
+        if (nw[0] == HUD_P_COMP && nw[1] == HUD_C_COMP1 && nw[2] == HUD_C_COMP2) return 1;
+        return 0;
+    }
+    if (idx == 1) {
+        if (nw[0] == HUD_W_LIFE0 && name[4] == 0) return 1;
+        if (hud_words_eq(nw, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2)) return 1;
+        return 0;
+    }
+    if (idx == 2) {
+        if (hud_words_eq(nw, HUD_W_TCSH0, HUD_W_TCSH1, HUD_W_TCSH2, HUD_W_TCSH3, 4)) return 1;
+        if (nw[0] == HUD_P_COIN && nw[1] == HUD_C_COIN1 && nw[2] == HUD_C_COIN2) return 1;
+        return 0;
+    }
+    if (idx == 3) {
+        if (hud_words_eq(nw, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2)) return 1;
+        if (hud_words_eq(nw, HUD_W_TSHINE0, HUD_W_TSHINE1, HUD_W_TSHINE2, HUD_W_TSHINE3, 4)) return 1;
+        if (nw[0] == HUD_P_MOON && nw[1] == HUD_C_MOON1) return 1;
+        return 0;
+    }
+    return 0;
+}
+
+void hud_calc(void *pane, const float *params, void *table, void *logbuf) {
+    if (!pane || !params || !table) return;
+    const char *name = (const char *)pane + 0xb8;
+    const u32 *nw = (const u32 *)name;
+    // The size and the parent are read here, before the matcher, because the
+    // life fallback needs the parent (and the root test and the log need the
+    // size); the v6 moon rules need neither a size nor a subtree walk.
+    float w = *(const float *)((const char *)pane + 0x50);
+    float h = *(const float *)((const char *)pane + 0x54);
+    void *parent = *(void **)((const char *)pane + 0x18);
+
+    // (v7) A guide text inside the right strip is hidden, not adjusted (item 3).
+    int hide_guide = hud_is_guide_text(pane, name, parent);
+
+    // Which HUD element is this pane. First the v1 actor names, kept as a
+    // fallback (a layout group named after its actor is still possible, and
+    // they cost two word compares): CompassArea, CoinCounter, MoonNum. Then the
+    // v4/v6 name and structure rules. Moons (v6): the counter group itself,
+    // a pane named 'Counter' (log-20 lines 404-413: the 320x200 group holding
+    // PicIcon / PicIconSh and 'TxtTotalShine'), matched by name -- it works
+    // whether the counter's layout is its own small RootPane or a direct child
+    // of the gameplay HUD root, so it does not depend on the root's size, its
+    // subtree, or the [hud] log ever seeing it. A bare 'TxtTotalShine' is the
+    // fallback for a layout with no 'Counter' group, and only when its parent
+    // is not a 'Counter' (the group's own number follows the group; matching
+    // both would move it twice). The v4/v5 small-RootPane structural rule is
+    // gone: it never fired in the forest-kingdom runs (log-24/25 have no
+    // 300x256 RootPane, no 'Counter', no 'TxtTotalShine' at all -- the 160-entry
+    // first-encounter log fills before the moon cluster is met), and the
+    // 'Counter' name is the precise container. Life: the 'Life' container
+    // (log-21 lines 760-763: Life 30x40 with PicLifeL / PicLifeR / PicIcon and
+    // 'TxtLife' under it at (9,40), appearing when the player takes damage),
+    // whose subtree holds 'TxtLife'; or a bare 'TxtLife' whose parent is NOT
+    // named 'Life' (the number without its container). Coins: the
+    // 'TxtCounterSh' pane itself (a direct child of the gameplay HUD root,
+    // log-20 lines 471/480), with the twin-write below moving its sibling
+    // 'TxtCounter' with it. The compass is 'PicStrap' (v5): the right strip,
+    // matched by name (see the header -- the dial itself is not a Pane, so the
+    // strip is the compass). Two instances match it, one slot each.
+    int idx = -1;
+    if (nw[0] == HUD_P_COMP && nw[1] == HUD_C_COMP1 && nw[2] == HUD_C_COMP2) idx = 0;
+    else if (nw[0] == HUD_P_COIN && nw[1] == HUD_C_COIN1 && nw[2] == HUD_C_COIN2) idx = 2;
+    else if (nw[0] == HUD_P_MOON && nw[1] == HUD_C_MOON1) idx = 3;
+    else if (nw[0] == HUD_W_STRAP0 && nw[1] == HUD_W_STRAP1 && name[8] == 0) idx = 0;
+    else if (hud_words_eq(nw, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2)) idx = 3;
+    else if (hud_words_eq(nw, HUD_W_TSHINE0, HUD_W_TSHINE1, HUD_W_TSHINE2, HUD_W_TSHINE3, 4)) {
+        // (v6) A bare 'TxtTotalShine' is the moon counter's number. It is the
+        // fallback for a layout with no 'Counter' group (the number as a direct
+        // child of the gameplay HUD root). It must NOT fire when the number sits
+        // inside a 'Counter' group (that group is matched above and carries the
+        // number with it -- matching both would move the number twice). This
+        // mirrors the bare-'TxtLife' fallback's parent check below.
+        if (!parent) idx = 3;
+        else {
+            const u32 *pnw = (const u32 *)((const char *)parent + 0xb8);
+            if (!hud_words_eq(pnw, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2)) idx = 3;
+        }
+    }
+    else if (nw[0] == HUD_W_LIFE0 && name[4] == 0 &&
+             hud_tree_has(pane, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2)) idx = 1;
+    else if (hud_words_eq(nw, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2)) {
+        if (!parent) idx = 1;
+        else {
+            const char *pn = (const char *)parent + 0xb8;
+            if (!(*(const u32 *)pn == HUD_W_LIFE0 && pn[4] == 0)) idx = 1;
+        }
+    }
+    else if (hud_words_eq(nw, HUD_W_TCSH0, HUD_W_TCSH1, HUD_W_TCSH2, HUD_W_TCSH3, 4)) idx = 2;
+
+    // The pane's current global matrix (as the game computed it), its size, its
+    // origin (the pivot's place in its own rectangle, +0x5b), its flags (+0x58:
+    // bit 7 is set by Pane::Calculate's epilogue, so it tells whether this pane
+    // has ever calculated -- on a pane's very first frame its matrix is still
+    // zero), and its parent. A layout root has no parent: it is the pane
+    // Layout::Calculate hands in, not a child of another pane.
+    const float *g = (const float *)pane + 0x70 / 4;
+    float tx = g[3], ty = g[7];
+    unsigned char origin = *(const unsigned char *)((const char *)pane + 0x5b);
+    unsigned short pflags = *(const unsigned short *)((const char *)pane + 0x58);
+
+    // A full-screen layout root (the PauseMenu settings screen, the WorldMap map
+    // screen, any other full-screen layout): no parent, and a full-screen size. The
+    // size test is the engine's own full-screen rule (loader.c dm_fps_state_apply,
+    // the duo_anchor anc values: a pane 1270 wide and 710 tall or larger is a
+    // full-screen pane; a looser width once stretched a half-width side panel past
+    // its bars). A HUD widget's own root is excluded by name (idx >= 0): it takes
+    // the player's settings, never the root stretch, so it is never stretched twice.
+    // Small widget roots are excluded by size: they are not full-screen layouts.
+    int is_root = (parent == 0 && idx < 0 && w >= 1270.0f && h >= 710.0f);
+    u32 cls = HUD_CLASS_UNKNOWN;
+    if (is_root) cls = hud_root_class(pane);
+
+    // Calibration log: every pane in the screen's top strip, and every full-screen
+    // layout root, deduped by pane address, name and matched code, so one run's
+    // log.txt shows the real pane names (which layout is "RootPane", which root the
+    // hook scaled, and by how much) and the positions and sizes they had. The top
+    // strip is the HUD's row (ty < 150 layout units); full-screen backgrounds
+    // (w >= 1200) and unnamed panes are not HUD widgets, but a full-screen root
+    // is logged by its own rule below. Panes named 'All' are not logged (30x40
+    // placeholder groups) unless they matched a HUD element, so a matched group
+    // is verifiable in the log instead of invisible. Each entry now also records
+    // the full 2x2 of the global matrix (not just the diagonal scale): the
+    // rotation probe for the compass (see the header). A pane is only logged
+    // once it has calculated at least once (flags bit 7): before that its matrix
+    // is still zero, and the entry would record a scale of 0. Capped at 160
+    // entries; once full the scan stops (the count check is the only per-pane
+    // cost after that).
+    if (logbuf && (pflags & 0x80u) && (nw[0] != HUD_W_ALL || idx >= 0)) {
+        u32 matched = HUD_MATCH_NONE;
+        int want = 0;
+        if (is_root) {
+            want = 1;
+            matched = cls == HUD_CLASS_PAUSE ? HUD_MATCH_ROOT_PAUSE :
+                      cls == HUD_CLASS_MAP ? HUD_MATCH_ROOT_MAP : HUD_MATCH_ROOT;
+        } else if (hide_guide) {
+            want = 1;
+            matched = HUD_MATCH_HIDDEN;
+        } else if (ty < 150.0f && ty > -50.0f && w > 0.0f && w < 1200.0f && name[0]) {
+            want = 1;
+            matched = idx < 0 ? HUD_MATCH_NONE : (u32)idx;
+        }
+        if (want) hud_log_add(logbuf, pane, name, tx, ty, w, h, matched, g[0], g[1], g[4], g[5], pflags, origin, cls);
+    }
+
+    if (hide_guide) {
+        // (v7) Move the guide text far off-screen (translation only; the
+        // scale is untouched). Already off-screen (tx > 5000) means the game
+        // has not recomputed the matrix since the last hide, so nothing more
+        // is written -- deriving the hide from the already-hidden matrix
+        // would drift it further every frame. If the game recomputes it back
+        // to its place, the next call hides it again.
+        if (tx < 5000.0f) {
+            float hm[12];
+            hud_xform(g, hm, 10000.0f, 0.0f, 1.0f, 1.0f, w, h, origin);
+            float *dst = (float *)pane + 0x70 / 4;
+            for (int i = 0; i < 12; i++) dst[i] = hm[i];
+        }
+        return;
+    }
+
+    if (idx >= 0) {
+        // A HUD widget: the player's own settings (dx, dy, scale) and the
+        // generation the host bumped on every write, so a settings change is
+        // applied even when the game did not recompute the matrix this frame (a
+        // static widget's matrix stays put). The entry cut is what makes this
+        // work for a static widget at all: the +0x13c cut never runs for it (the
+        // skip path), but the entry cut runs on every Calculate call.
+        float dx = params[idx * 3 + 0];
+        float dy = params[idx * 3 + 1];
+        float k = hud_clamp_k(params[idx * 3 + 2]);
+        u32 gen = ((const u32 *)params)[12];
+
+        // (v6) Slot-name guard: a pane whose name does not belong to this
+        // element never takes a table slot, however the matcher above labelled
+        // it (see hud_slot_name_ok). A refused pane is simply not adjusted;
+        // the log above still records the matcher's label, so a mislabel stays
+        // visible for diagnosis instead of silently taking a slot.
+        if (!hud_slot_name_ok(idx, name, nw)) return;
+
+        // The per-element entry: the pane, its original matrix (as the game
+        // computed it), the modified matrix (the original + this transform), and
+        // the generation the modified matrix was computed from. Two slots per
+        // element (idx and idx + HUD_N): two layout instances can match the same
+        // element (the moon counter and the coin counter each appear twice, in
+        // two layouts), and one slot per element cannot hold both. With one
+        // slot the two instances would take turns reclaiming it, and the
+        // reclaim sets the stored original to the pane's current matrix -- which
+        // is the already-transformed matrix for a static pane, so the transform
+        // would be applied again on every frame and the widget would drift off
+        // screen. Two slots keep both originals. If both slots are already
+        // taken by other panes, the first slot is reclaimed: that is a layout
+        // reload (the pane there is dead and the new pane is fresh), which the
+        // reclaim below handles correctly. A third live instance of the same
+        // element has never been seen; if it appears, it would share the first
+        // slot with the first instance, and the log would show three panes
+        // matching the same element.
+        char *ent = 0;
+        for (int s = 0; s < HUD_SLOTS_PER_ELEM; s++) {
+            char *e = (char *)table + (idx + s * HUD_N) * HUD_ENTRY;
+            if (*(uintptr_t *)(e + 0) == (uintptr_t)pane) { ent = e; break; }
+            if (!ent && *(u32 *)(e + 112) == 0) ent = e;   // first free slot
+        }
+        if (!ent) ent = (char *)table + idx * HUD_ENTRY;   // both taken: reclaim the first (a reload)
+        uintptr_t *e_pane = (uintptr_t *)(ent + 0);
+        float *e_orig = (float *)(ent + 8);
+        float *e_mod = (float *)(ent + 56);
+        u32 *e_gen = (u32 *)(ent + 104);
+        if (*e_pane != (uintptr_t)pane) {   // first sighting, or the layout reloaded
+            *e_pane = (uintptr_t)pane;
+            *(u32 *)(ent + 108) = (u32)idx;
+            *(u32 *)(ent + 112) = 1u;
+            *e_gen = 0;   // force a recompute below (the stored modified matrix is stale)
+            for (int i = 0; i < 12; i++) { e_orig[i] = 0.0f; e_mod[i] = 0.0f; }
+        }
+
+        // Did the game recompute the matrix since the last frame? Compare the
+        // current matrix against the stored modified one: if they differ, the game
+        // wrote a new original (an animation, a parent that moved, the layout
+        // reloading), so the stored original follows it. If they are the same, the
+        // game left our modified matrix alone, and only a settings change (a new
+        // generation) needs a recompute.
+        int recomputed = 0;
+        {
+            const u32 *cur = (const u32 *)g;
+            u32 *mod = (u32 *)e_mod;
+            for (int i = 0; i < 12; i++) if (cur[i] != mod[i]) { recomputed = 1; break; }
+        }
+        if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g[i];
+        // (v7) Compass un-stretch: if the game just recomputed an element-0
+        // pane's original and that original carries the screen-shape
+        // stretch, store the de-stretched original instead, so the player's
+        // k multiplies a round base (see hud_compass_destretch).
+        if (recomputed && idx == 0) hud_compass_destretch(e_orig, params);
+        if (!recomputed && *e_gen == gen) {   // already correct: nothing to do
+            if (idx == 2) hud_coin_twin_write(pane, e_mod, e_orig, 0, 0);   // keep the plain number with the shadow
+            return;
+        }
+        // (v7) The twin-write needs the mod this anchor wrote last frame, so
+        // it can tell its own twin (still holding last frame's mod) from a
+        // stranger's. e_mod still holds it here -- hud_xform below is the
+        // first write to e_mod on this call. A fresh / reclaimed entry has
+        // *e_gen == 0 (set above) and no previous mod to match against.
+        float old_mod[12];
+        int have_old = (*e_gen != 0);
+        for (int i = 0; i < 12; i++) old_mod[i] = e_mod[i];
+        hud_xform(e_orig, e_mod, dx, dy, k, k, w, h, origin);
+        *e_gen = gen;
+
+        // Write the modified matrix back to the pane. Its children are calculated
+        // after this hook, so they inherit the moved / resized parent -- but only
+        // if the game recomputes them (v5): a static parent passes w22 = 0 to
+        // its children, so mark the descendants dirty (hud_mark_dirty) and the
+        // game recomputes them from this modified matrix on the same frame.
+        float *dst = (float *)pane + 0x70 / 4;
+        for (int i = 0; i < 12; i++) dst[i] = e_mod[i];
+        hud_mark_dirty(pane);
+        if (idx == 2) hud_coin_twin_write(pane, e_mod, e_orig, old_mod, have_old);   // the plain number moves with the shadow
+        return;
+    }
+
+    if (is_root) {
+        // P1 (v4): the gameplay HUD root is NOT stretched. V1.3.10 deformed the
+        // HUD because the root stretch landed on the main HUD root (log-20: the
+        // root's matrix 1.219/1.000 and a 1560x720 SCALED entry; the life ring
+        // measured 82x66 on screen, W/H 1.242, where V1.3.8/9 had it round at
+        // 67x66). A root is the gameplay HUD root if its subtree holds a
+        // gameplay-HUD-only pane: the coin texts ('TxtCounterSh' /
+        // 'TxtCounter', direct children of the HUD root), the life container
+        // ('Life') or its number ('TxtLife'), or a 'Counter'. The pause and map
+        // roots hold none of these (ParList00 / WinSelect / PicMapCap /
+        // PicStrap / TxtGuide01 only), so they are still stretched. Not
+        // stretching the HUD root also frees a root-table slot. The root is
+        // still logged above (as a full-screen root, matrix 1.000, no SCALED
+        // entry), which is the probe that the exclusion worked.
+        if (hud_tree_has(pane, HUD_W_TCSH0, HUD_W_TCSH1, HUD_W_TCSH2, HUD_W_TCSH3, 4) ||
+            hud_tree_has(pane, HUD_W_TC0, HUD_W_TC1, HUD_W_TC2, 0, 3) ||
+            hud_tree_has(pane, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2) ||
+            hud_tree_has_life(pane) ||
+            hud_tree_has(pane, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2)) return;
+        // (v7) The welcome / controller-guide root is NOT stretched either
+        // (item 5): its gold panel is the one the root stretch shoved off
+        // centre. The HUD-five check above already guarantees this root
+        // holds no gameplay-HUD pane, so the GUIDE test's own !saw_hud is
+        // belt-and-braces. The root is still logged above (as a full-screen
+        // root, class 3, matrix 1.000, no SCALED entry), which is the probe
+        // that the exclusion worked. This does NOT claim to fix the logo:
+        // the logo being cut is not explained by the root stretch (see the
+        // header), so it may stay cut after this.
+        if (cls == HUD_CLASS_GUIDE) return;
+        // A full-screen layout root: the screen shape's stretch, about the pane's
+        // centre. The PauseMenu, the WorldMap (its background has to fill the
+        // screen -- see the header: the user's 2026-11-11 23:22 correction) and any
+        // other unclassified root are widened / heightened to the screen shape's
+        // layout (root_sx / root_sy, from DM_SCREEN_ASPECT, written by the host):
+        // 1560x720 at 2.167, so the PauseMenu and the map background fill the
+        // screen the way the main HUD already does. 16:9 is the identity (sx == sy
+        // == 1). The stretch is applied by whichever cut reaches the root -- the
+        // entry cut for a static root, the +0x13c cut for a dirty one -- so a root
+        // that goes static before the host has written the scale still gets it on
+        // the next frame. V4 keeps this for the pause / map roots, but the
+        // V1.3.10 screenshots prove the root-matrix stretch does NOT widen the
+        // visible pause menu or map (pause pillar 116px, identical to V1.3.9;
+        // map 82% wide): the visible content is not driven by the root's matrix
+        // at render time, so this stretch alone cannot fill them -- see the
+        // header for the map-ortho / pause-panel investigation that has to
+        // follow. Keeping the stretch here is harmless (it is the mechanism the
+        // log proves, and it may help layouts whose content DOES follow the
+        // root); the notes say plainly it does not guarantee a full pause/map.
+        float sx = hud_clamp_root(params[13]);
+        float sy = hud_clamp_root(params[14]);
+        if (sx == 1.0f && sy == 1.0f) return;   // 16:9, or an unwritten state page: nothing to do
+
+        // The root table (state page + 0x700, derived from the HUD table's base):
+        // one entry per root pane, found by pane pointer, so two layouts whose
+        // roots share the "RootPane" name still get their own entries. Nineteen
+        // slots, because layouts reload into fresh pane objects and eight (v1)
+        // exhaust over a session; 19 (not 20) because the HUD table grew to 8
+        // entries and the log buffer starts at +0x1000.
+        char *rtable = (char *)table + 0x400;
+        char *ent = 0;
+        for (int i = 0; i < HUD_ROOT_MAX; i++) {
+            char *e = rtable + i * HUD_ENTRY;
+            if (*(uintptr_t *)(e + 0) == (uintptr_t)pane) { ent = e; break; }
+            if (!ent && *(u32 *)(e + 112) == 0) ent = e;   // first free slot
+        }
+        if (!ent) return;   // no free slot: leave the root alone, never grow the table
+        uintptr_t *e_pane = (uintptr_t *)(ent + 0);
+        float *e_orig = (float *)(ent + 8);
+        float *e_mod = (float *)(ent + 56);
+        float *e_sx = (float *)(ent + 104);
+        float *e_sy = (float *)(ent + 108);
+        if (*e_pane != (uintptr_t)pane) {   // first sighting, or the slot was reused
+            *e_pane = (uintptr_t)pane;
+            *(u32 *)(ent + 112) = 1u;
+            *(u32 *)(ent + 116) = cls;
+            *e_sx = 0.0f;   // force a recompute below (the stored scale is stale)
+            *e_sy = 0.0f;
+            for (int i = 0; i < 12; i++) { e_orig[i] = 0.0f; e_mod[i] = 0.0f; }
+        } else {
+            *(u32 *)(ent + 116) = cls;   // the class can only get surer, never stale
+        }
+        int recomputed = 0;
+        {
+            const u32 *cur = (const u32 *)g;
+            u32 *mod = (u32 *)e_mod;
+            for (int i = 0; i < 12; i++) if (cur[i] != mod[i]) { recomputed = 1; break; }
+        }
+        if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g[i];
+        // A changed screen shape needs a recompute even when the game did not
+        // recompute the matrix (the root is static, its matrix stays put).
+        if (!recomputed && *e_sx == sx && *e_sy == sy) return;
+        hud_xform(e_orig, e_mod, 0.0f, 0.0f, sx, sy, w, h, origin);
+        *e_sx = sx;
+        *e_sy = sy;
+        float *dst = (float *)pane + 0x70 / 4;
+        for (int i = 0; i < 12; i++) dst[i] = e_mod[i];
+        // (v7 M4) The map's 2D panes are static: they computed their
+        // matrices before the stretch and never recompute, so the stretch
+        // above would leave the yellow panel and the kingdom name where
+        // they were. Mark the subtree dirty and the game recomputes it from
+        // this stretched root on the same frame (the same mechanism v5 uses
+        // for a moved HUD container). Only MAP roots: the pause menu's
+        // failure is the matrix being reset between Calculate and Draw
+        // (H1), not static children, and that needs a different fix.
+        if (cls == HUD_CLASS_MAP) hud_mark_dirty(pane);
+
+        // Proof the transform landed, in the log: a second entry for the same
+        // pane, with the scaled size and matrix scale and a SCALED matched code,
+        // so the next run's log.txt shows the native entry and the scaled entry
+        // side by side. Only once the pane has calculated at least once (flags
+        // bit 7): before that the stored original is still zero and the scaled
+        // entry would record a scale of 0.
+        if (pflags & 0x80u) {
+            u32 smatched = cls == HUD_CLASS_PAUSE ? HUD_MATCH_ROOT_SCALED_PAUSE :
+                           cls == HUD_CLASS_MAP ? HUD_MATCH_ROOT_SCALED_MAP :
+                           HUD_MATCH_ROOT_SCALED;
+            hud_log_add(logbuf, pane, name, e_mod[3], e_mod[7], w * sx, h * sy,
+                        smatched, e_mod[0], e_mod[1], e_mod[4], e_mod[5], pflags, origin, cls);
+        }
+        return;
+    }
+}
