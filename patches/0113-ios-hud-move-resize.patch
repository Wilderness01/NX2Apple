+# The HUD move / resize hook (0113): Pane::Calculate (main+0x909494, the vtable's slot
+# 19) recomputes every pane's global matrix and then its children's. The cut lands at
+# Pane::Calculate+0x13c (main+0x9095d0), where all paths converge after the pane's own
+# global matrix is final (the inline matrix at +0xc4, the helper at +0x13c's callers)
+# and before both child loops, so moving a container carries its children with it.
+# Two things ride on it: the four HUD widgets (compass, life, coins, moons), matched
+# by pane name, moved / resized by the gear menu's "HUD 设置"; and the full-screen
+# layout roots (the PauseMenu settings screen, the WorldMap map screen, any other
+# full-screen layout), recognised structurally (no parent pane, a full-screen size)
+# and stretched to the screen's shape, so the settings and map screens fill the
+# screen the way the main HUD already does. Two rules, told apart by the root's own
+# size: a standard root (about 1280x720) is widened / heightened to the screen
+# shape's layout (the PauseMenu, centred and narrow on a wide screen); an oversized
+# root (clearly larger than 1280x720, the WorldMap's, which overflows on every side)
+# is shrunk uniformly to fit inside the screen shape's layout, keeping its
+# proportions. The map's 3D part (WorldMapCamera) is NOT handled here: a camera
+# projection is not a Pane, and it needs its own hook -- but it does not need one
+# (see fix-0113-notes.md: the UW scan found only the main camera's calcMatrix slot
+# in the whole module, and the 3D landmass keeps its proportions).
+# The instruction there is `orr w22, wzr, #0x1` (w22 = 1, the flag the children's
+# Calculate calls take); x19 is the pane, x20 the DrawInfo, x21 the first argument.
+# w8 / w9 (the flags, read at the entry and used just after the site) are live past
+# it, so the stub saves and restores x8 / x9; x0-x7 and x10-x18 are dead there, the
+# vector registers are reloaded after it, and x30 is restored from the stack by the
+# function's own epilogue, so the stub's bl is safe. No runtime __TEXT write anywhere:
+# the cut is the rewriter's load-time replacement, the duo_anchor pattern.
+def _hud_frame_step(ctx):
+    here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
+    hud_code = here()
+    hx = ''.join(HUD_WORDS)
+    for i in range(0, len(hx), 8):
+        emit(int(hx[i:i + 8], 16))
+    fs_site(0x9fd5d0, 'f6030032')   # `orr w22, wzr, #0x1` at Pane::Calculate+0x13c
+    start = here()
+    emit(STP_PRE(8, 9, 31, -16))              # stp x8, x9, [sp, #-0x10]! (the live flags)
+    emit(0xaa1303e0)                          # mov x0, x19 (the pane)
+    emit(ADRP(1, here(), FS_STATE_OFF)); emit(ADDI(1, 1, 0x200))   # x1 = state + 0x200 (params)
+    emit(ADRP(2, here(), FS_STATE_OFF)); emit(ADDI(2, 2, 0x300))   # x2 = state + 0x300 (table)
+    emit(ADRP(3, here(), FS_STATE_OFF + 0x1000))   # x3 = state + 0x1000 (log buffer; a page, so no add is needed)
+    emit(B(here(), hud_code) | 0x80000000)    # bl hud_calc
+    emit(LDP_POST(8, 9, 31, 16))              # ldp x8, x9, [sp], #0x10 (restore the flags)
+    emit(0x320003f6)                          # orr w22, wzr, #0x1 (the replaced instruction)
+    emit(B(here(), 0x9fd5d4))                 # back to the hook site + 4
+    fs_put(0x9fd5d0, [B(0x9fd5d0, start)], 'Pane::Calculate: a HUD widget moved / resized by the HUD settings, the PauseMenu and WorldMap roots stretched to the screen shape (hud_calc.c)')
+
+FRAME_STEP = {BUILD_141: _hud_frame_step}
+
+BINDING = [
+    {'what': "HUD move / resize and full-screen UI (the gear menu's HUD settings, hud_calc.c)", 'now': 'build', 'goal': 'game', 'purpose': 'rendering',
+     'why': "Pane::Calculate and the pane layout are this build's nn::ui2d code, found by the HUDLOG diagnostic run (log-17) and confirmed by disassembly of DmIOS",
+     'blocked': 'the stubs have no function-matched form yet'},
+]
