+// (v7) Does this subtree hold the welcome / controller-guide combination:
+// a guide text ('TxtGuide' or 'TxtGuideSh' or 'TxtGuideLSh' / 'TxtGuideRSh',
+// exact names -- 'TxtGuide01' on the map screen does not count) AND a
+// scenario text ('TxtScenario' or 'TxtScenarioSh', exact) AND 'WinLine'
+// (exact), and NONE of the five gameplay-HUD names? One walk, depth 3 (the
+// three names may sit deeper than hud_tree_has's depth 2), same 64-visit
+// bound and the same three guards as the other walks. A lone 'TxtGuideSh'
+// is not enough: log-24 has two of them (the welcome block and a 102x80
+// one), and hiding a root on one name alone would misfire.
+static inline __attribute__((always_inline)) int hud_tree_has_guide_combo(void *pane) {
+    if (!pane) return 0;
+    int saw_guide = 0, saw_scenario = 0, saw_winline = 0, saw_hud = 0;
+    void *stack[64];
+    unsigned char sdepth[64];
+    int sp = 0, visits = 0;
+    stack[sp] = pane;
+    sdepth[sp] = 3;
+    sp++;
+    while (sp > 0 && visits < 64) {
+        sp--;
+        void *p = stack[sp];
+        if (!p || ((uintptr_t)p & 7u)) continue;   // (v7 a)
+        unsigned char depth = sdepth[sp];
+        void *head = (char *)p + 0x20;
+        void *node = *(void **)((const char *)p + 0x28);
+        for (int i = 0; i < 32; i++) {
+            if (!node || node == head) break;
+            if (!hud_node_ok(node)) break;          // (v7 b)
+            void *child = (char *)node - 8;
+            if (hud_child_self(p, child)) break;    // (v7 c)
+            visits++;
+            {
+                const char *nm = (const char *)child + 0xb8;
+                const u32 *nw = (const u32 *)nm;
+                if (nw[0] == HUD_W_GUIDE0 && nw[1] == HUD_W_GUIDE1 &&
+                    (nm[8] == 0 || (nw[2] == HUD_W_GUIDESH2) ||
+                     (nw[2] == HUD_W_GUIDELSH2) || (nw[2] == HUD_W_GUIDERSH2))) saw_guide = 1;
+                else if (nw[0] == HUD_W_SCEN0 && nw[1] == HUD_W_SCEN1 &&
+                         (nw[2] == HUD_W_SCEN2 || (nw[2] == HUD_W_SCENSH2 && nw[3] == HUD_W_SCENSH3))) saw_scenario = 1;
+                else if (nw[0] == HUD_W_WINLINE0 && nw[1] == HUD_W_WINLINE1 && nm[7] == 0) saw_winline = 1;
+                else if (hud_words_eq(nw, HUD_W_TCSH0, HUD_W_TCSH1, HUD_W_TCSH2, HUD_W_TCSH3, 4) ||
+                         hud_words_eq(nw, HUD_W_TC0, HUD_W_TC1, HUD_W_TC2, 0, 3) ||
+                         hud_words_eq(nw, HUD_W_TLIFE0, HUD_W_TLIFE1, 0, 0, 2) ||
+                         hud_words_eq(nw, HUD_W_COUNTER0, HUD_W_COUNTER1, 0, 0, 2) ||
+                         (nw[0] == HUD_W_LIFE0 && nm[4] == 0)) saw_hud = 1;
+            }
+            if (depth > 0 && sp < 64) {
+                stack[sp] = child;
+                sdepth[sp] = depth - 1;
+                sp++;
+            }
+            node = *(void **)((const char *)child + 0x10);
+        }
+    }
+    return saw_guide && saw_scenario && saw_winline && !saw_hud;
+}
