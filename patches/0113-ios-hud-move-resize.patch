+        UW_LOG("[RED] ortho: hook failed at slot %p", (void *)slot);
+        g_st.ortho_orig_fn = NULL;
+        return -1;
+    }
+    if (*(void **)slot != (void *)uw_trampoline_ortho) {
+        UW_LOG("[RED] ortho: slot %p did not hold the trampoline after install", (void *)slot);
+        g_st.ortho_orig_fn = NULL;
+        return -1;
