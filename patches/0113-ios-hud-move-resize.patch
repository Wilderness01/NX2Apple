+// Neighbour check, the perspective scan's rule: at least two of the four
+// adjacent slots must be valid in-module pointers (a vtable is a run of
+// them). Boundary-guarded the same way.
+static int uw_ortho_count_valid_neighbours(uintptr_t p) {
+    uintptr_t lo = g_st.mod_base, hi = g_st.mod_base + g_st.mod_size;
+    int good = 0;
+    if (p - lo >= 8 && uw_is_vtable_entry(*(uintptr_t *)(p - 8))) good++;
+    if (p - lo >= 16 && uw_is_vtable_entry(*(uintptr_t *)(p - 16))) good++;
+    if (p + 16 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 8))) good++;
+    if (p + 24 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 16))) good++;
+    return good;
