+// hud.h — The HUD editor: the gear menu's "HUD 设置" (DmGamepad.m) moves and
+// resizes the game's HUD panels (compass, life, coins, moons) and stretches the
+// full-screen layout roots (the PauseMenu settings screen, the WorldMap map
+// screen) to the screen's shape, through the rewriter stub in
+// dm/games/0100000000010000/patches.py (which calls hud_calc in hud_calc.c,
+// hooked into Pane::Calculate at load time). The settings live in the frame
+// step state page (+0x200), written by dm_hud_set and applied by
+// dm_hud_frame_tick, called once per present from uw_frame_hook.
+#ifndef DM_HOST_HUD_H
+#define DM_HOST_HUD_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// The four HUD panels, in hud_calc.c's order. 1 (life) has no locked pane name
+// yet (see fix-0113-notes.md): its settings are stored and pushed, but no pane
+// matches them until the name is locked from the V1.3.9 log.
+enum { DM_HUD_COMPASS = 0, DM_HUD_LIFE = 1, DM_HUD_COINS = 2, DM_HUD_MOONS = 3, DM_HUD_N = 4 };
+
+// Move / resize one HUD panel, live: dx, dy are layout points (the 1280x720
+// space), k the panel's size (1 = the game's own). Clamped to dx/dy ±640/±360,
+// k 0.2 to 3.0 (0 or NaN = 1). Stored in the host and written to the state page
+// by dm_hud_frame_tick; safe to call before the state page exists (the settings
+// wait for it). Called by the HUD editor (DmGamepad.m) on every drag and slider
+// change, and once per panel at launch to restore the saved layout.
+void dm_hud_set(int elem, float dx, float dy, float k);
+
+// Once per present: refreshes the root scale from DM_SCREEN_ASPECT (loader.c
+// dm_fps_state_apply's exact formulas, resolved at frame time, after the front
+// end has resolved "auto"), writes the settings to the state page when they
+// changed, and drains the log buffer (state +0x1000) into log.txt. Call from
+// uw_frame_hook, after uw_direct_write. A no-op when the build has no state page.
+void dm_hud_frame_tick(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
