+    else { new_hw = orig_hw; new_hh = orig_hh * (float)(1.0 / k); }         // tall: widen halfH
+    // Already at the target (same k): nothing to write.
+    if (ortho_close(hw_pos, new_hw) && ortho_close(hh_pos, new_hh)) {
