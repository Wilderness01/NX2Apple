+// The HUD editor's stored layout: NSUserDefaults DmHudLayout, {"elements": {name:
+// {"dx": NSNumber, "dy": NSNumber, "scale": NSNumber}}}. The offsets are layout
+// points (the 1280x720 space, y up, the origin at the screen's centre), the scale
+// 1 is the game's own size. Loading pushes every panel to the host (dm_hud_set),
+// so the saved layout applies from the first frame, before the editor opens; the
+// host keeps the settings until the state page exists (hud.c).
+static NSString *const k_hud_layout_key = @"DmHudLayout";
+- (void)loadHudLayout {
+    for (int e = 0; e < 4; e++) { _hudDx[e] = 0; _hudDy[e] = 0; _hudK[e] = 1; }   // fresh: every panel where the game puts it, at its own size
+    NSDictionary *d = [NSUserDefaults.standardUserDefaults dictionaryForKey:k_hud_layout_key];
+    if (![d isKindOfClass:[NSDictionary class]]) return;
+    NSDictionary *el = d[@"elements"];
+    if (![el isKindOfClass:[NSDictionary class]]) return;
+    for (int e = 0; e < 4; e++) {
+        NSDictionary *v = el[k_hudEditKeys[e]];
+        if (![v isKindOfClass:[NSDictionary class]]) continue;
+        NSNumber *dx = v[@"dx"], *dy = v[@"dy"], *k = v[@"scale"];
+        if ([dx isKindOfClass:[NSNumber class]]) _hudDx[e] = fmin(fmax(dx.doubleValue, -640), 640);
+        if ([dy isKindOfClass:[NSNumber class]]) _hudDy[e] = fmin(fmax(dy.doubleValue, -360), 360);
+        if ([k isKindOfClass:[NSNumber class]]) _hudK[e] = fmin(fmax(k.doubleValue, 0.5), 2.0);   // the slider's range (the host clamps wider, 0.2 to 3.0)
+    }
+    for (int e = 0; e < 4; e++) dm_hud_set(e, _hudDx[e], _hudDy[e], _hudK[e]);
+}
