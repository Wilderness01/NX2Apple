+// Two floats are "the same value" when they agree to 0.1% (relative). The
+// widened value is a float-rounded product, so an exact comparison would
+// miss a value that was already widened; 0.1% is far below the gap between
+// the orig box and the widened box (140 units at halfW 640).
+static int ortho_close(float a, float b) {
+    float m = fabsf(a) > fabsf(b) ? fabsf(a) : fabsf(b);
+    if (m < 1.0f) m = 1.0f;
+    return fabsf(a - b) <= 0.001f * m;
