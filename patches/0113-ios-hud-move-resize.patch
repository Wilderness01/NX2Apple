diff --git a/dm/host/hud.c b/dm/host/hud.c
new file mode 100644
index 0000000..b414125
--- /dev/null
+++ b/dm/host/hud.c
@@ -0,0 +1,138 @@
+// hud.c — The HUD editor's host side (see hud.h). The settings and the root
+// scale live in the frame step state page; the rewriter stub (hud_calc.c,
+// called from Pane::Calculate) reads them every frame. Nothing here writes game
+// code: the stub is a load-time rewriter cut (patches.py), and this file only
+// writes the state page's data.
+#include "hud.h"
+#include "dm.h"    // LOG
+#include "hle.h"   // dm_fps_state
+#include <math.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+
+// The HUD block in the frame step state page (patches.py, hud_calc.c):
+//   +0x200: 12 floats, per element (dx, dy, k): compass, life, coins, moons
+//   +0x200+48: u32 generation, bumped on every settings write
+//   +0x200+52: float root_sx, +0x200+56: float root_sy (the full-screen roots'
+//     stretch to the screen shape, from DM_SCREEN_ASPECT)
+//   +0x300: the HUD table (8 x 120 bytes, two per element, hud_calc's working copy)
+//   +0x700: the root table (19 x 120 bytes, one per full-screen root)
+//   +0x1000: the log buffer: u32 count, then 160 entries of 72 bytes
+//     (name[24], tx, ty, w, h, matched u32, address u64, g0, g1, g4, g5,
+//     flags u16, origin u8, class u8). The buffer fits the frame step state's
+//     reserved 0x4000 bytes (160 x 72 + 4 = 11524 < 0x3000); loader.c's own
+//     fields end below +0x200, so there is no overlap.
+#define HUD_PARAMS_OFF   0x200
+#define HUD_GEN_OFF      (HUD_PARAMS_OFF + 48)
+#define HUD_ROOT_SX_OFF  (HUD_PARAMS_OFF + 52)
+#define HUD_ROOT_SY_OFF  (HUD_PARAMS_OFF + 56)
+#define HUD_LOG_OFF      0x1000
+#define HUD_LOG_ENTRY    72
+#define HUD_LOG_MAX      160
+
+#define HUD_LOG(...) LOG("[hud] " __VA_ARGS__)
+
+static float g_hud_dx[DM_HUD_N], g_hud_dy[DM_HUD_N], g_hud_k[DM_HUD_N] = {1, 1, 1, 1};   // the editor's settings, in layout points (1280x720 space)
+static uint32_t g_hud_gen;          // bumped on every settings write (the stub recomputes when it changes)
+static _Atomic int g_hud_dirty;     // the state page still needs the settings
+static float g_root_sx = 1, g_root_sy = 1;   // the root scale as last written to the state page
+static uint64_t g_hud_frames;       // presents since launch (the log buffer drains every 60)
+static uint32_t g_log_drained;      // log entries already copied to log.txt
+static int g_hud_started;           // the first write has been logged
+
+static float hud_clamp_k(float k) { if (!(k > 0)) return 1; return fminf(fmaxf(k, 0.2f), 3.0f); }
+static float hud_clamp_dx(float dx) { return fminf(fmaxf(dx, -640.0f), 640.0f); }
+static float hud_clamp_dy(float dy) { return fminf(fmaxf(dy, -360.0f), 360.0f); }
+
+// The screen shape's layout, from DM_SCREEN_ASPECT, loader.c dm_fps_state_apply's
+// exact formulas (resolved at frame time, after the front end has resolved "auto"
+// to the screen's shape): wider than 16:9 keeps the height (720) and takes the
+// width that gives the ratio (2.167 -> 1560 wide); taller keeps the width (1280)
+// and takes the height (1.43 -> 896 tall); 16:9, "0", "auto" or a bad value keeps
+// 1280x720. Returns the root scale (layout / 1280, layout / 720).
+static void hud_root_scale(float *sx, float *sy) {
+    *sx = 1; *sy = 1;
+    const char *as = getenv("DM_SCREEN_ASPECT");
+    if (!as || !*as || !strcmp(as, "0") || !strcmp(as, "auto")) return;
+    char *end; float a = strtof(as, &end);
+    if (end == as || *end || !(a >= 1.3f && a <= 2.2f)) return;
+    if (a > 1.78f) { uint32_t lw = (uint32_t)(720.0f * a + 0.5f); *sx = (float)lw / 1280.0f; }
+    else if (a < 1.77f) { uint32_t oh = (uint32_t)(1920.0f / a / 48.0f + 0.5f) * 48, lh = oh * 2 / 3; *sy = (float)lh / 720.0f; }
+}
+
+void dm_hud_set(int elem, float dx, float dy, float k) {
+    if (elem < 0 || elem >= DM_HUD_N) return;
+    dx = hud_clamp_dx(dx); dy = hud_clamp_dy(dy); k = hud_clamp_k(k);
+    if (g_hud_dx[elem] == dx && g_hud_dy[elem] == dy && g_hud_k[elem] == k) return;
+    g_hud_dx[elem] = dx; g_hud_dy[elem] = dy; g_hud_k[elem] = k;
+    g_hud_gen++;
+    atomic_store(&g_hud_dirty, 1);
+    // (v6) Log every editor settings call, so the next probe shows whether a
+    // drag reached the host and which element it was for. Log-26 proved why
+    // this matters: the user dragged the coins, but v5's dm_hud_set wrote no
+    // log line, so the log could not tell a drag from no drag at all, and the
+    // coin bug stayed undiagnosed. One line per call; a drag fires many, but
+    // they are the proof the settings arrived.
+    HUD_LOG("dm_hud_set elem %d dx %.0f dy %.0f k %.2f gen %u", elem, dx, dy, k, g_hud_gen);
+}
+
+// Drain the log buffer (state +0x1000) into log.txt: each entry is a pane the
+// stub saw (a HUD panel, a full-screen root, or a top-strip pane it logged for
+// identification), with its name, global position and size, its global matrix
+// (the full 2x2, so a rotating pane is visible), and which rule matched it.
+// Only new entries are copied (g_log_drained); the stub dedupes by pane, so it
+// never re-logs one, and the buffer is never reset -- a reset would make the
+// stub log the same panes again.
+static void hud_log_drain(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    uint32_t n; memcpy(&n, st + HUD_LOG_OFF, 4);
+    if (n > HUD_LOG_MAX) n = HUD_LOG_MAX;
+    if (n <= g_log_drained) return;   // nothing new
+    for (uint32_t i = g_log_drained; i < n; i++) {
+        uint8_t *e = st + HUD_LOG_OFF + 4 + i * HUD_LOG_ENTRY;
+        char name[25]; memcpy(name, e, 24); name[24] = 0;
+        float tx, ty, w, h; memcpy(&tx, e + 24, 4); memcpy(&ty, e + 28, 4); memcpy(&w, e + 32, 4); memcpy(&h, e + 36, 4);
+        uint32_t matched; memcpy(&matched, e + 40, 4);
+        uint64_t addr; memcpy(&addr, e + 44, 8);
+        float g0, g1, g4, g5; memcpy(&g0, e + 52, 4); memcpy(&g1, e + 56, 4); memcpy(&g4, e + 60, 4); memcpy(&g5, e + 64, 4);
+        uint16_t pflags; memcpy(&pflags, e + 68, 2);
+        unsigned origin = e[70], cls = e[71];
+        const char *clsname = cls == 1 ? " (pause menu)" : cls == 2 ? " (world map)" : cls == 3 ? " (guide)" : "";
+        if (matched == 0xffffffffu) HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), top strip (not matched), matrix [%.3f %.3f; %.3f %.3f]", name, (void *)addr, w, h, tx, ty, g0, g1, g4, g5);
+        else if (matched == 0xfffffffeu || matched == 0xfffffffdu || matched == 0xfffffffcu)
+            HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), full-screen root%s, matrix [%.3f %.3f; %.3f %.3f], flags %#x, origin %#x", name, (void *)addr, w, h, tx, ty, clsname, g0, g1, g4, g5, pflags, origin);
+        else if (matched == 0xfffffffbu || matched == 0xfffffffa || matched == 0xfffffff9u)
+            HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), full-screen root%s SCALED (matrix [%.3f %.3f; %.3f %.3f])", name, (void *)addr, w, h, tx, ty, clsname, g0, g1, g4, g5);
+        else if (matched == 0xfffffff8u)
+            HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), hidden (guide text), matrix [%.3f %.3f; %.3f %.3f]", name, (void *)addr, w, h, tx, ty, g0, g1, g4, g5);
+        else if (matched < (uint32_t)DM_HUD_N) HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), HUD element %u, matrix [%.3f %.3f; %.3f %.3f]", name, (void *)addr, w, h, tx, ty, matched, g0, g1, g4, g5);
+        else HUD_LOG("pane '%s' at %p: %.0fx%.0f at (%.0f,%.0f), matched %#x, matrix [%.3f %.3f; %.3f %.3f]", name, (void *)addr, w, h, tx, ty, matched, g0, g1, g4, g5);
+    }
+    g_log_drained = n;
+}
+
+void dm_hud_frame_tick(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    g_hud_frames++;
+    float sx, sy; hud_root_scale(&sx, &sy);
+    float old_sx = g_root_sx, old_sy = g_root_sy;
+    int dirty = atomic_load(&g_hud_dirty);
+    if (dirty || sx != g_root_sx || sy != g_root_sy) {
+        // Write the whole params block: the four elements, the generation, and
+        // the root scale. The generation bumps when the settings changed, so the
+        // stub recomputes even on a frame the game did not recompute the matrix.
+        float params[12];
+        for (int i = 0; i < DM_HUD_N; i++) { params[i*3] = g_hud_dx[i]; params[i*3+1] = g_hud_dy[i]; params[i*3+2] = g_hud_k[i]; }
+        memcpy(st + HUD_PARAMS_OFF, params, sizeof params);
+        memcpy(st + HUD_GEN_OFF, &g_hud_gen, 4);
+        memcpy(st + HUD_ROOT_SX_OFF, &sx, 4); memcpy(st + HUD_ROOT_SY_OFF, &sy, 4);
+        g_root_sx = sx; g_root_sy = sy;
+        atomic_store(&g_hud_dirty, 0);
+        if (!g_hud_started) { HUD_LOG("HUD ready: state page at %p, root scale %.3fx%.3f (DM_SCREEN_ASPECT=%s)", (void *)st, sx, sy, getenv("DM_SCREEN_ASPECT") ?: "(unset)"); g_hud_started = 1; }
+        else if (sx != old_sx || sy != old_sy) HUD_LOG("HUD root scale changed to %.3fx%.3f", sx, sy);
+    }
+    if ((g_hud_frames % 60) == 0) hud_log_drain();   // once a second: new panes only
+}
