+// Widen one OrthoProjection object's box in place. hw_pos/hh_pos are the
+// current +halfW/+halfH, already read and sanity-checked by the trampoline.
+// Returns 1 if the fields were written (widened or restored), 0 otherwise.
+// The gate is here: mode must be widen (2) and the hook must not be
+// degraded; record/off never write a field.
+static int uw_ortho_widen(void *x0, float hw_pos, float hh_pos, uintptr_t lr_off) {
+    if (g_st.ortho_mode != 2 || g_st.ortho_degraded) return 0;
