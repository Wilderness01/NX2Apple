+// (v7, log-23) The guards every subtree walk below applies. A layout's
+// child list can go stale while the game unloads it (log-23: a root's
+// head.next pointed into the root itself, and the walk reached NULL+0x28),
+// so no walk trusts a pointer it did not validate:
+//  (a) a popped pane is checked for NULL / alignment before it is read;
+//  (b) a list node is checked (non-NULL, 8-byte aligned, >= 0x10000) before
+//      child = node - 8 is computed from it;
+//  (c) a child that is the pane itself, or lies inside the pane's own
+//      first 0x100 bytes (a pane's fields run to +0xd0, so 0x100 covers the
+//      object), is never treated as a pane: the walk stops instead of
+//      descending into the pane's own memory. A genuine child allocated in
+//      the 0x100 bytes right after its parent would be missed by (c) --
+//      that costs one subtree match, not a crash; the direct name matcher
+//      in hud_calc does not use these walks and is unaffected.
+static inline __attribute__((always_inline)) int hud_node_ok(void *node) {
+    uintptr_t v = (uintptr_t)node;
+    return v != 0 && (v & 7u) == 0 && v >= 0x10000;
+}
+
+static inline __attribute__((always_inline)) int hud_child_self(void *p, void *child) {
+    if (child == p) return 1;
+    if ((uintptr_t)child <= (uintptr_t)p) return 0;
+    return (uintptr_t)child - (uintptr_t)p < 0x100;
+}
