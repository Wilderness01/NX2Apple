 // --- MOD table (DmIOS 0x10236a900 header + 0x10236a970 entries, stride 0xf8) ---
@@ -531,6 +601,445 @@ static int uw_scan_hook_calcmatrix(void) {
     return hooked;
 }
 
+// --- ortho hook (V1.3.12, ortho-hook-design.md) ---
+// The WorldMap terrain is drawn through sead::OrthoProjection::calcMatrix; its
+// halfW is 640 (a 1280-wide box), which is why the terrain only fills 82% of
+// the 1560-wide screen. This build scans for the slot (six gates, any failure
+// means no hook), records what calls it, and — in widen mode
+// (DM_UW_ORTHO_MODE=widen) — widens the map camera's box so the terrain fills
+// the screen. Record mode never writes a game field; widen mode writes only
+// the box of objects that pass the halfW/halfH filter. Everything below is
+// independent of the perspective hook: its own tried/hooked flags, its own
+// orig, its own classes table; an ortho failure never touches g_hook_ok.
+
+// Is this (halfW, halfH, LR) the map camera, by the filter in ortho-hook-design.md
+// §5.3? (b) halfW/halfH inside the expected box, (c) LR on the whitelist when
+// one is set (empty whitelist = no LR filter). The box defaults are env-tunable
+// (DM_UW_ORTHO_HALFW/HALFH/TOL); the whitelist is DM_UW_ORTHO_LR.
+static int uw_ortho_is_map_cand(float hw, float hh, uintptr_t lr_off) {
+    if (fabsf(hw - g_st.ortho_halfw) > g_st.ortho_halfw * g_st.ortho_tol) return 0;
+    if (fabsf(hh - g_st.ortho_halfh) > g_st.ortho_halfh * g_st.ortho_tol) return 0;
+    if (g_st.ortho_lr_n > 0) {
+        for (int i = 0; i < g_st.ortho_lr_n; i++)
+            if (g_st.ortho_lr[i] == lr_off) return 1;
+        return 0;
+    }
+    return 1;
+}
+
+// Record one (this, LR) class: first sighting logs a line, later calls only bump
+// the hit count. A class whose box changes (set() rewrote it) keeps its
+// first-seen halfW/halfH; the class is a caller identity, not a live sample.
+static void uw_ortho_record(uintptr_t this_addr, float hw, float hh, uintptr_t lr_off) {
+    for (int i = 0; i < g_st.ortho_cls_n; i++) {
+        if (g_st.ortho_cls_this[i] == this_addr && g_st.ortho_cls_lr[i] == lr_off) {
+            g_st.ortho_cls_hits[i]++;
+            return;
+        }
+    }
+    if (g_st.ortho_cls_n >= UW_ORTHO_CLASS_MAX) return;   // table full: keep the known classes, drop new ones
+    int i = g_st.ortho_cls_n++;
+    g_st.ortho_cls_this[i] = this_addr;
+    g_st.ortho_cls_lr[i] = lr_off;
+    g_st.ortho_cls_hw[i] = hw;
+    g_st.ortho_cls_hh[i] = hh;
+    g_st.ortho_cls_hits[i] = 1;
+    UW_LOG("ortho first seen this=%p halfW %g halfH %g lr=+%#llx",
+           (void *)this_addr, (double)hw, (double)hh, (unsigned long long)lr_off);
+}
+
+// --- ortho widen (V1.3.12, ortho-hook-design.md §4) ---
+// Widen only when DM_UW_ORTHO_MODE=widen (mode 2) and the discriminator
+// live-check did not degrade the hook. The widen decision is the helper's
+// single gate, so the host test can drive it directly (the trampoline
+// itself cannot run on the host: its orig is AArch64 code).
+
+// Two floats are "the same value" when they agree to 0.1% (relative). The
+// widened value is a float-rounded product, so an exact comparison would
+// miss a value that was already widened; 0.1% is far below the gap between
+// the orig box and the widened box (140 units at halfW 640).
+static int ortho_close(float a, float b) {
+    float m = fabsf(a) > fabsf(b) ? fabsf(a) : fabsf(b);
+    if (m < 1.0f) m = 1.0f;
+    return fabsf(a - b) <= 0.001f * m;
+}
+
+// The widen orig table: one row per object, keyed by its address. 8 rows;
+// the map camera is one of the first objects, and a 9th distinct object is
+// left unwidened (logged once) rather than evicting a live entry.
+static int ortho_orig_find(void *x0) {
+    for (int i = 0; i < g_st.ortho_orig_n; i++)
+        if (g_st.ortho_orig_this[i] == (uintptr_t)x0) return i;
+    return -1;
+}
+
+static int ortho_orig_add(void *x0, float hw, float hh) {
+    if (g_st.ortho_orig_n >= UW_ORTHO_ORIG_MAX) return -1;
+    int i = g_st.ortho_orig_n++;
+    g_st.ortho_orig_this[i] = (uintptr_t)x0;
+    g_st.ortho_orig_hw[i] = hw;
+    g_st.ortho_orig_hh[i] = hh;
+    g_st.ortho_orig_k[i] = 1.0;
+    g_st.ortho_orig_hits[i] = 0;
+    return i;
+}
+
+// Write the ortho box ([0xa8]/[0xac] = -halfW/+halfW, [0xa0]/[0xa4] =
+// +halfH/-halfH) and set the dirty flag at [0x8]. The read-back verifies
+// the write stuck; on failure the orig box is written back (best effort)
+// and 0 is returned. Returns 1 on success.
+static int ortho_write_box(void *x0, float hw, float hh, float orig_hw, float orig_hh) {
+    float *p_hw_neg = (float *)((char *)x0 + 0xa8);
+    float *p_hw_pos = (float *)((char *)x0 + 0xac);
+    float *p_hh_pos = (float *)((char *)x0 + 0xa0);
+    float *p_hh_neg = (float *)((char *)x0 + 0xa4);
+    *p_hw_neg = -hw; *p_hw_pos = hw;
+    *p_hh_pos = hh;  *p_hh_neg = -hh;
+    *(uint8_t *)((char *)x0 + 0x8) = 1;   // dirty: refresh the cached matrix
+    if (!ortho_close(*p_hw_pos, hw) || !ortho_close(*p_hw_neg, -hw) ||
+        !ortho_close(*p_hh_pos, hh) || !ortho_close(*p_hh_neg, -hh)) {
+        UW_LOG("[RED] ortho: write did not stick for object %p (wrote halfW %g halfH %g), restoring orig box",
+               x0, (double)hw, (double)hh);
+        *p_hw_neg = -orig_hw; *p_hw_pos = orig_hw;
+        *p_hh_pos = orig_hh;  *p_hh_neg = -orig_hh;
+        *(uint8_t *)((char *)x0 + 0x8) = 1;
+        return 0;
+    }
+    return 1;
+}
+
+// Widen one OrthoProjection object's box in place. hw_pos/hh_pos are the
+// current +halfW/+halfH, already read and sanity-checked by the trampoline.
+// Returns 1 if the fields were written (widened or restored), 0 otherwise.
+// The gate is here: mode must be widen (2) and the hook must not be
+// degraded; record/off never write a field.
+static int uw_ortho_widen(void *x0, float hw_pos, float hh_pos, uintptr_t lr_off) {
+    if (g_st.ortho_mode != 2 || g_st.ortho_degraded) return 0;
+    // Widen factor k = aspect / 16:9. UW off (aspect <= 0) means no widen:
+    // k = 1, which takes the dead-zone restore path below.
+    double k = 1.0;
+    if (g_st.enabled && g_st.aspect > 0.0f)
+        k = (double)g_st.aspect / UW_ASPECT_16_9;
+    int dead = (fabs(k - 1.0) < 0.005);   // 16:9 dead zone: restore, do not widen
+
+    int i = ortho_orig_find(x0);
+    if (i < 0) {
+        // First widen-mode encounter: the current values are the orig values
+        // (nothing has widened this object yet). Filter on them.
+        if (!uw_ortho_is_map_cand(hw_pos, hh_pos, lr_off)) return 0;
+        if (dead) return 0;   // nothing widened to restore
+        i = ortho_orig_add(x0, hw_pos, hh_pos);
+        if (i < 0) {
+            if (!g_st.ortho_orig_full_logged) {
+                g_st.ortho_orig_full_logged = 1;
+                UW_LOG("[RED] ortho: orig table full, object %p not widened", x0);
+            }
+            return 0;
+        }
+        // Fall through: current == orig, so widen from orig.
+    }
+    float orig_hw = g_st.ortho_orig_hw[i];
+    float orig_hh = g_st.ortho_orig_hh[i];
+    double last_k = g_st.ortho_orig_k[i];
+    // What the fields would read if this object was widened with last_k.
+    float exp_hw, exp_hh;
+    if (last_k > 1.0) { exp_hw = orig_hw * (float)last_k; exp_hh = orig_hh; }
+    else if (last_k < 1.0) { exp_hw = orig_hw; exp_hh = orig_hh * (float)(1.0 / last_k); }
+    else { exp_hw = orig_hw; exp_hh = orig_hh; }
+
+    if (!ortho_close(hw_pos, orig_hw) || !ortho_close(hh_pos, orig_hh)) {
+        if (!ortho_close(hw_pos, exp_hw) || !ortho_close(hh_pos, exp_hh)) {
+            // Neither the orig values nor the previously-widened values:
+            // something else rewrote the box (set(), or this address was
+            // reused by another object). Take the current values as the new
+            // orig, and re-filter: a non-candidate stays unwidened.
+            g_st.ortho_orig_hw[i] = hw_pos;
+            g_st.ortho_orig_hh[i] = hh_pos;
+            orig_hw = hw_pos; orig_hh = hh_pos;
+            if (!uw_ortho_is_map_cand(hw_pos, hh_pos, lr_off)) return 0;
+            // The orig changed; last_k no longer describes this object.
+            g_st.ortho_orig_k[i] = 1.0;
+            last_k = 1.0;
+            exp_hw = orig_hw; exp_hh = orig_hh;
+        }
+        // else: current is the previously-widened value; fall through to
+        // re-widen (only if k changed) or leave it (dead zone restores).
+    }
+    // Dead zone (16:9): restore a previously-widened box to its orig.
+    if (dead) {
+        if (!ortho_close(hw_pos, orig_hw) || !ortho_close(hh_pos, orig_hh)) {
+            if (ortho_write_box(x0, orig_hw, orig_hh, orig_hw, orig_hh)) {
+                g_st.ortho_orig_k[i] = 1.0;
+                g_st.ortho_restore_n++;
+                UW_LOG("ortho restored this=%p halfW %g halfH %g (back to 16:9)",
+                       x0, (double)orig_hw, (double)orig_hh);
+                return 1;
+            }
+        }
+        return 0;
+    }
+    // Widen from the orig values with the current k.
+    float new_hw, new_hh;
+    if (k > 1.0) { new_hw = orig_hw * (float)k; new_hh = orig_hh; }        // wide: widen halfW
+    else { new_hw = orig_hw; new_hh = orig_hh * (float)(1.0 / k); }         // tall: widen halfH
+    // Already at the target (same k): nothing to write.
+    if (ortho_close(hw_pos, new_hw) && ortho_close(hh_pos, new_hh)) {
+        g_st.ortho_orig_k[i] = k;
+        return 0;
+    }
+    int first = (g_st.ortho_orig_hits[i] == 0);
+    int k_changed = (last_k != k);
+    if (ortho_write_box(x0, new_hw, new_hh, orig_hw, orig_hh)) {
+        g_st.ortho_orig_k[i] = k;
+        g_st.ortho_orig_hits[i]++;
+        g_st.ortho_wide_n++;
+        if (first || k_changed)
+            UW_LOG("ortho widened this=%p halfW %g->%g halfH %g->%g (k %.4f)",
+                   x0, (double)orig_hw, (double)new_hw, (double)orig_hh, (double)new_hh, k);
+        return 1;
+    }
+    return 0;
+}
+
+// The trampoline (same 16-argument generic signature as uw_trampoline: every
+// argument register is forwarded, and the original is called with the same
+// arguments — OrthoProjection::calcMatrix only uses x0 (this) and x1 (the
+// output matrix), but the rest pass through untouched). In record mode it
+// only records; in widen mode (mode 2) it also widens the box through
+// uw_ortho_widen, which is the single gate (mode + degraded + filter).
+static void uw_trampoline_ortho(void *x0, uint64_t x1, uint64_t x2, uint64_t x3, uint64_t x4,
+                                uint64_t x5, uint64_t x6, uint64_t x7,
+                                double d0, double d1, double d2, double d3,
+                                double d4, double d5, double d6, double d7) {
+    uw_calc_fn orig = (uw_calc_fn)g_st.ortho_orig_fn;
+    // Live-check the discriminator once: the slot before the hooked slot must
+    // return 1 for any this (its body is `mov w0,#1; ret`, and its head bytes
+    // were verified before the scan). It proves the hook sits on the Ortho
+    // table, not on another table that happens to hold calcMatrix. It cannot
+    // prove the object is an OrthoProjection — the function ignores this —
+    // that is what the field check below is for. A failure degrades the
+    // trampoline to record-only forever (in widen mode it will not write).
+    if (!g_st.ortho_disc_checked) {
+        g_st.ortho_disc_checked = 1;
+        int r = -1;
+        if (g_st.ortho_slot) {
+            uintptr_t disc_fn = *(uintptr_t *)(g_st.ortho_slot - 8);
+            if (disc_fn >= g_st.mod_base && disc_fn < g_st.mod_base + g_st.mod_size)
+                r = ((int (*)(void *))disc_fn)(x0);
+        }
+        if (r != 1) {
+            UW_LOG("[RED] ortho: discriminator returned %d (want 1), degrading to record-only", r);
+            g_st.ortho_degraded = 1;
+        }
+    }
+    // Read the ortho box: [0xa8]/[0xac] = -halfW/+halfW, [0xa0]/[0xa4] = +halfH/-halfH.
+    float hw_neg = *(float *)((char *)x0 + 0xa8);
+    float hw_pos = *(float *)((char *)x0 + 0xac);
+    float hh_pos = *(float *)((char *)x0 + 0xa0);
+    float hh_neg = *(float *)((char *)x0 + 0xa4);
+    g_st.ortho_calls++;
+    // The object must be a sane OrthoProjection: all four values finite, the
+    // two pairs symmetric (the field layout is symmetric by definition), and
+    // the magnitudes inside [1, 100000] (the map is 640x360; the shadow box
+    // is world units of unknown size but finite). Anything else is not the
+    // map camera (or a stale object): call orig and record nothing. Only the
+    // first failure is logged; the count is kept.
+    if (!isfinite(hw_neg) || !isfinite(hw_pos) || !isfinite(hh_pos) || !isfinite(hh_neg) ||
+        fabsf(hw_neg + hw_pos) > 0.01f * fabsf(hw_pos) ||
+        fabsf(hh_pos + hh_neg) > 0.01f * fabsf(hh_pos) ||
+        fabsf(hw_pos) < 1.0f || fabsf(hw_pos) > 100000.0f ||
+        fabsf(hh_pos) < 1.0f || fabsf(hh_pos) > 100000.0f) {
+        g_st.ortho_bad++;
+        if (!g_st.ortho_bad_logged) {
+            g_st.ortho_bad_logged = 1;
+            UW_LOG("[RED] ortho: asymmetric or out-of-range object %p (halfW -%g/+%g, halfH +%g/-%g), not recorded",
+                   x0, (double)hw_neg, (double)hw_pos, (double)hh_pos, (double)hh_neg);
+        }
+        orig(x0, x1, x2, x3, x4, x5, x6, x7, d0, d1, d2, d3, d4, d5, d6, d7);
+        return;
+    }
+    // LR: the return address into the game code that called this vtable slot.
+    // The same call site reads the same value every frame and across
+    // sessions, because it is a code offset, not a heap address. Stored as an
+    // offset from the module base (the raw address is kept when it falls
+    // outside the module, so the log still shows it).
+    uintptr_t lr = (uintptr_t)__builtin_return_address(0);
+    uintptr_t lr_off = (lr >= g_st.mod_base && lr < g_st.mod_base + g_st.mod_size)
+                       ? lr - g_st.mod_base : lr;
+    uw_ortho_record((uintptr_t)x0, hw_pos, hh_pos, lr_off);
+    // Widen mode: widen this object's box if it is the map camera. The
+    // helper is the single gate (mode + degraded + filter); in record/off
+    // it returns 0 without touching a field.
+    (void)uw_ortho_widen(x0, hw_pos, hh_pos, lr_off);
+    orig(x0, x1, x2, x3, x4, x5, x6, x7, d0, d1, d2, d3, d4, d5, d6, d7);
+}
+
+// Neighbour check, the perspective scan's rule: at least two of the four
+// adjacent slots must be valid in-module pointers (a vtable is a run of
+// them). Boundary-guarded the same way.
+static int uw_ortho_count_valid_neighbours(uintptr_t p) {
+    uintptr_t lo = g_st.mod_base, hi = g_st.mod_base + g_st.mod_size;
+    int good = 0;
+    if (p - lo >= 8 && uw_is_vtable_entry(*(uintptr_t *)(p - 8))) good++;
+    if (p - lo >= 16 && uw_is_vtable_entry(*(uintptr_t *)(p - 16))) good++;
+    if (p + 16 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 8))) good++;
+    if (p + 24 <= hi && uw_is_vtable_entry(*(uintptr_t *)(p + 16))) good++;
+    return good;
+}
+
+// Gate 1 (build gate): the three functions' head bytes must match the 3.0
+// binary's disassembly. calcMatrix and getAspect share the first word
+// (both `ldp s0,s1,[x0,#0xa8]`), so both words are compared.
+static int uw_ortho_heads_ok(void) {
+    struct { uint32_t off, w0, w1; const char *name; } fns[3] = {
+        { UW_ORTHO_CALC_MATRIX_OFF, UW_ORTHO_CALC_HEAD0, UW_ORTHO_CALC_HEAD1, "calcMatrix" },
+        { UW_ORTHO_DISC_OFF, UW_ORTHO_DISC_HEAD0, UW_ORTHO_DISC_HEAD1, "discriminator" },
+        { UW_ORTHO_GETASPECT_OFF, UW_ORTHO_GETASP_HEAD0, UW_ORTHO_GETASP_HEAD1, "getAspect" },
+    };
+    for (int i = 0; i < 3; i++) {
+        uint32_t off = fns[i].off;
+        if ((uint64_t)off + 8 > g_st.mod_size) {
+            UW_LOG("[RED] ortho: function %s at +%#x is outside the module, hook not installed", fns[i].name, off);
+            return 0;
+        }
+        uint32_t got0 = *(uint32_t *)(g_st.mod_base + off);
+        uint32_t got1 = *(uint32_t *)(g_st.mod_base + off + 4);
+        if (got0 != fns[i].w0 || got1 != fns[i].w1) {
+            UW_LOG("[RED] ortho: function bytes mismatch at +%#x (%s): got %#x %#x, want %#x %#x - other build? hook not installed",
+                   off, fns[i].name, got0, got1, fns[i].w0, fns[i].w1);
+            return 0;
+        }
+    }
+    return 1;
+}
+
+typedef struct {
+    uintptr_t slot;
+    int neigh, disc, aspect, center, s14;
+} uw_ortho_hit_t;
+
+static int uw_ortho_install(uintptr_t slot) {
+    void *orig = *(void **)slot;
+    g_st.ortho_orig_fn = orig;
+    if (uw_write_slot((void **)slot, (void *)uw_trampoline_ortho) != 0) {
+        UW_LOG("[RED] ortho: hook failed at slot %p", (void *)slot);
+        g_st.ortho_orig_fn = NULL;
+        return -1;
+    }
+    if (*(void **)slot != (void *)uw_trampoline_ortho) {
+        UW_LOG("[RED] ortho: slot %p did not hold the trampoline after install", (void *)slot);
+        g_st.ortho_orig_fn = NULL;
+        return -1;
+    }
+    g_st.ortho_slot = slot;
+    g_st.ortho_hooked = 1;
+    uw_record_hook_slot(slot);
+    UW_LOG("ortho: hooked calcMatrix slot at %p, orig %p", (void *)slot, orig);
+    return 0;
+}
+
+// The scan (ortho-hook-design.md §1-§2): six gates in order, and any failure
+// means no hook. The scan always runs to the end of the module: an early exit
+// would hide a second slot holding the same value, and the ">1 hit" rule is
+// the safety core. Installs only when exactly one slot holds calcMatrix AND
+// that one passes the neighbour + fingerprint gates; a second hit of any kind
+// (even one that fails the gates) is a layout anomaly and blocks the install.
+static int uw_scan_hook_ortho_calcmatrix(void) {
+    // Gate 0: the mode switch and the module range.
+    if (g_st.ortho_mode == 0) { UW_LOG("ortho: disabled (DM_UW_ORTHO_MODE=off)"); return -1; }
+    if (!g_st.inited || !g_st.mod_base || !g_st.mod_size) {
+        UW_LOG("[RED] ortho: no module range, hook not installed");
+        return -1;
+    }
+    // Gate 1: the build gate (function-head bytes), before any scan.
+    if (!uw_ortho_heads_ok()) return -1;
+    uintptr_t target = g_st.mod_base + UW_ORTHO_CALC_MATRIX_OFF;
+    uintptr_t lo = g_st.mod_base, hi = g_st.mod_base + g_st.mod_size;
+    uw_ortho_hit_t hits[8];
+    int n_hits = 0, n_validated = 0;
+    uintptr_t validated_slot = 0;
+    uw_ortho_hit_t validated = { 0, 0, 0, 0, 0, 0 };
+    for (uintptr_t p = lo; p + 8 <= hi; p += 8) {
+        if (*(uintptr_t *)p != target) continue;   // only the value counts, never the address
+        uw_ortho_hit_t h;
+        h.slot = p;
+        h.neigh = uw_ortho_count_valid_neighbours(p);   // gate 3
+        // Gate 4 (fingerprint, relative to the hit: independent of the
+        // one-slot ambiguity — the discriminator is always the slot before
+        // calcMatrix, getAspect always four slots before). Reads are
+        // boundary-guarded; an unreadable slot fails the gate.
+        h.disc = 0; h.aspect = 0; h.center = 0; h.s14 = 0;
+        if (p - lo >= 8) h.disc = (*(uintptr_t *)(p - 8) == g_st.mod_base + UW_ORTHO_DISC_OFF);
+        if (p - lo >= 0x20) h.aspect = (*(uintptr_t *)(p - 0x20) == g_st.mod_base + UW_ORTHO_GETASPECT_OFF);
+        if (p - lo >= 0x18) h.center = (*(uintptr_t *)(p - 0x18) == g_st.mod_base + UW_ORTHO_GETCENTER_OFF);
+        if (p + 16 <= hi) h.s14 = (*(uintptr_t *)(p + 8) == g_st.mod_base + UW_ORTHO_SLOT14_OFF);
+        if (n_hits < 8) hits[n_hits] = h;
+        n_hits++;
+        if (h.neigh >= 2 && h.disc && h.aspect) {   // hard gates: neighbours + fingerprint
+            n_validated++;
+            validated_slot = p;
+            validated = h;
+        } else {
+            UW_LOG("[RED] ortho: candidate slot %p rejected (neigh %d/4, disc %d, aspect %d, center %d, s14 %d)",
+                   (void *)p, h.neigh, h.disc, h.aspect, h.center, h.s14);
+        }
+    }
+    UW_LOG("ortho scan: %d slots hold calcMatrix, %d validated", n_hits, n_validated);
+    if (n_hits == 0) {
+        UW_LOG("[RED] ortho: no slot holds calcMatrix (base+%#x); hook not installed", UW_ORTHO_CALC_MATRIX_OFF);
+        return -1;
+    }
+    if (n_hits != 1 || n_validated != 1) {
+        // More than one hit, or the single hit failed its gates: never pick one.
+        for (int i = 0; i < n_hits && i < 8; i++)
+            UW_LOG("[RED] ortho: hit slot %p (neigh %d/4, disc %d, aspect %d, center %d, s14 %d)",
+                   (void *)hits[i].slot, hits[i].neigh, hits[i].disc, hits[i].aspect, hits[i].center, hits[i].s14);
+        UW_LOG("[RED] ortho: %d slots hold calcMatrix, %d validated, not installing", n_hits, n_validated);
+        return -1;
+    }
+    // Exactly one hit, validated. The static candidates are log labels only:
+    // which hypothesis won says nothing about whether to install.
+    const char *hyp = "";
+    if (validated_slot == g_st.mod_base + UW_ORTHO_CAND_SHIFT) hyp = " (candidate 0x13541d0: uniform -8 shift wins)";
+    else if (validated_slot == g_st.mod_base + UW_ORTHO_CAND_PACK) hyp = " (candidate 0x13541c8: 15-slot packing wins)";
+    else hyp = " (matches neither static candidate: new layout, trust the scan)";
+    UW_LOG("ortho: validated calcMatrix slot at %p%s (neigh %d/4, disc %d, aspect %d, center %d, s14 %d)",
+           (void *)validated_slot, hyp, validated.neigh, validated.disc, validated.aspect, validated.center, validated.s14);
+    // Gate 5, advisory only: the global slots that hold (table start - 8).
+    // Either read matching either expectation corroborates one hypothesis;
+    // a miss never blocks the install (the global area may have shifted too).
+    if (UW_ORTHO_GLOBAL_A + 8 <= g_st.mod_size && UW_ORTHO_GLOBAL_B + 8 <= g_st.mod_size) {
+        uintptr_t ga = *(uintptr_t *)(g_st.mod_base + UW_ORTHO_GLOBAL_A);
+        uintptr_t gb = *(uintptr_t *)(g_st.mod_base + UW_ORTHO_GLOBAL_B);
+        uintptr_t exp_shift = g_st.mod_base + UW_ORTHO_GLOBEXP_SHIFT;
+        uintptr_t exp_pack = g_st.mod_base + UW_ORTHO_GLOBEXP_PACK;
+        const char *which = NULL;
+        if (ga == exp_shift || gb == exp_shift) which = "shift";
+        else if (ga == exp_pack || gb == exp_pack) which = "pack";
+        if (which)
+            UW_LOG("ortho: global B-8 corroborated: %s (globals %#llx %#llx)", which,
+                   (unsigned long long)ga, (unsigned long long)gb);
+        else
+            UW_LOG("[RED] ortho: global B-8 pointer %#llx / %#llx does not match table start %#llx / %#llx (advisory only)",
+                   (unsigned long long)ga, (unsigned long long)gb,
+                   (unsigned long long)exp_shift, (unsigned long long)exp_pack);
+    } else {
+        UW_LOG("[RED] ortho: global slots outside the module, advisory skipped (advisory only)");
+    }
+    // Walk-back diagnostic (log only, not a gate): from the slot, walk back
+    // over valid pointers; the 3.0 layout stops after 13 slots at the empty
+    // slot between the tables, so the start should be the table's slot 0.
+    {
+        uintptr_t start = validated_slot;
+        int back = 0;
+        while (start > lo && back < 64 && uw_is_vtable_entry(*(uintptr_t *)(start - 8))) { start -= 8; back++; }
+        UW_LOG("ortho: table walk-back from %p: %d slots to %p (slot %llu)",
+               (void *)validated_slot, back, (void *)start,
+               (unsigned long long)((validated_slot - start) / 8));
+    }
+    return uw_ortho_install(validated_slot);   // gate 6: the write
+}
