--- /dev/null
+++ b/dm/games/0100000000010000/hud_calc.c
@@ -0,0 +1,367 @@
+// hud_calc.c -- Super Mario Odyssey HUD move / resize + full-screen UI hook (0113).
+//
+// The game draws its HUD (compass, life, coins, moons) and its full-screen menus
+// (the PauseMenu settings screen, the WorldMap map screen) with Nintendo's nn::ui2d
+// Layout / Pane system: every pane's Pane::Calculate (main+0x909494, the vtable's
+// slot 19) recomputes its global matrix (pane+0x70, a 3x4 row-major matrix, the
+// translation at +0x7c / +0x8c) and then calculates its children. This function runs
+// from a rewriter cut at Pane::Calculate+0x13c (main+0x9095d0), after the pane's own
+// global matrix is final and before its children's, so moving a container carries its
+// children with it. It edits only that pane's global matrix: a translation moves it,
+// a scale about its centre (from its size at +0x50 / +0x54 and its origin byte at
+// +0x5b) resizes it. It never writes an object field, never accumulates (the
+// transform is always re-derived from the stored original matrix), and never fights
+// the game's own animation (when the game recomputes the matrix, the stored original
+// follows it). The layout space is y-up with its origin at the parent's centre
+// (confirmed by disassembly of the local matrix helper at main+0x9096d0, which adds
+// +parent_h/2 for a top origin and -parent_h/2 for a bottom one, and by the
+// duo_anchor anchors: a bottom widget sits at a negative y, a top one at a
+// positive y), so a positive dy moves a pane UP, and a drag down the screen is a
+// negative dy; the HUD editor (DmGamepad.m) negates the drag's y for this.
+//
+// Two things ride on this one hook:
+//
+//  1. The four HUD widgets (compass, life, coins, moons), matched by pane name, are
+//     moved / resized by the player's own settings (the gear menu's "HUD 设置").
+//     Life has no locked pane name yet (see fix-0113-notes.md): its slot is reserved
+//     and its settings are stored by the panel, but no pane is matched for it here.
+//  2. Full-screen layout roots (the PauseMenu settings screen, the WorldMap map
+//     screen, and any other full-screen layout) are stretched to the screen shape,
+//     because they are built on the game's 1280x720 layout while the main HUD is
+//     built on the wider layout the screen shape asks for (1560 wide at 2.167). The
+//     stretch is automatic, from DM_SCREEN_ASPECT, not a player setting. Two rules,
+//     told apart by the root's own size: a standard root (about 1280x720) is widened
+//     / heightened to the screen shape's layout, so the PauseMenu fills the screen;
+//     an oversized root (clearly larger than 1280x720, the WorldMap's, which
+//     overflows on every side while its 3D landmass keeps its proportions) is shrunk
+//     uniformly to fit inside the screen shape's layout, keeping its proportions.
+//     A layout root is recognised structurally -- it has no parent pane -- and by its
+//     full-screen size, not by its name alone (the name is "RootPane" by nn::ui2d
+//     convention, but the romfs .bflyt that would confirm it is not on this host, so
+//     the name is only logged, never required). The map's 3D part (WorldMapCamera) is
+//     NOT handled here: a camera projection is not a Pane, and it needs its own hook
+//     -- but it does not need one, see fix-0113-notes.md (the UW vtable scan already
+//     widens every calcMatrix, and the 3D landmass keeps its proportions).
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-asynchronous-unwind-tables -c
+// (the same flags the engine's duo_anchor.c uses, but with gcc; clang's
+// -target arm64-apple-macos is not installed on this host). The words of the
+// resulting __text are embedded in patches.py as HUD_WORDS. This file takes
+// everything through its arguments -- no static data, no literal pool, no external
+// calls -- so the emitted words are position-independent and relocation-free and
+// can be dropped into the rewriter's patch area verbatim:
+//   x0 = the pane (nn::ui2d::Pane *), x1 = params (state page + 0x200: 12 floats,
+//   dx / dy / scale per HUD element, then a u32 generation at +48, then the root
+//   scale root_sx at +52 and root_sy at +56), x2 = HUD table (state page + 0x300:
+//   one 120-byte entry per HUD element), x3 = log buffer (state page + 0x1000: a
+//   u32 count, then 64 entries of 52 bytes). The root table lives at state page
+//   + 0x500 (8 entries of 120 bytes, derived here as table + 0x200). Element order:
+//   0 compass, 1 life, 2 coins, 3 moons. The state page starts zeroed, so a table
+//   entry with pane == 0 is unused and a generation of 0 means "never applied".
+//   A zeroed scale (k, root_sx, root_sy all 0 before the host writes) reads as 1,
+//   so an unwritten state page is a no-op, never a collapse.
+//
+// The log buffer records, deduped by pane address and name, every pane in the
+// screen's top strip and every full-screen layout root it meets (name, position,
+// size, which HUD element it matched if any, and the pane's address), so one run's
+// log.txt shows the real pane names -- which layout is "RootPane", and whether the
+// PauseMenu / WorldMap roots are the ones this hook scaled.
+
+typedef unsigned int u32;
+typedef unsigned long uintptr_t;
+
+#define HUD_N 4
+#define HUD_NAME_MAX 24
+#define HUD_ENTRY 120          // bytes per table entry (HUD table and root table)
+#define HUD_ROOT_MAX 8
+#define HUD_LOG_MAX 64
+#define HUD_LOG_ENTRY 52       // 24 name + 4 tx + 4 ty + 4 w + 4 h + 4 matched + 8 address
+#define HUD_MATCH_NONE 0xffffffffu
+#define HUD_MATCH_ROOT 0xfffffffeu
+
+// The first four bytes of each target name, as a little-endian u32: a fast reject
+// before the full compare. "Comp" (CompassArea), "Coin" (CoinCounter), "Moon" (MoonNum).
+#define HUD_P_COMP 0x706d6f43u
+#define HUD_P_COIN 0x6e696f43u
+#define HUD_P_MOON 0x6e6f6f4du
+// The rest of each name as little-endian u32s, NUL included, so the full compare
+// needs no string literal: a literal would sit in .rodata and the code would load
+// its address with an adrp (a relocation), and the embedded words carry no literal
+// pool. "CompassArea": bytes 4-7 "assA", 8-11 "rea\0"; "CoinCounter": "Coun",
+// "ter\0"; "MoonNum": bytes 4-7 "Num\0" (8 bytes: no third word to compare).
+#define HUD_C_COMP1 0x41737361u
+#define HUD_C_COMP2 0x00616572u
+#define HUD_C_COIN1 0x6e756f43u
+#define HUD_C_COIN2 0x00726574u
+#define HUD_C_MOON1 0x006d754eu
+
+// Bounded compare of a pane name (at most 24 bytes, stops at NUL) against a name
+// already recorded in the log buffer (both are runtime data, never a literal).
+static inline __attribute__((always_inline)) int hud_name_eq(const char *name, const char *target) {
+    for (int i = 0; i < HUD_NAME_MAX; i++) {
+        if (name[i] != target[i]) return 0;
+        if (name[i] == 0) return 1;
+    }
+    return 0;
+}
+
+static inline __attribute__((always_inline)) float hud_clamp_k(float k) {
+    // A scale outside [0.2, 3.0], or not a number, is the settings panel's bug, not
+    // a request: fall back to 1 (no resize). A zero scale is not a request either:
+    // the state page starts zeroed, so an unwritten slot reads as 0 and must mean
+    // identity, never a collapse. The NaN test is k != k (a NaN is not equal to
+    // itself); a negative scale would mirror the widget, which nobody asked for.
+    if (k == 0.0f || k != k) return 1.0f;
+    if (k < 0.2f) return 0.2f;
+    if (k > 3.0f) return 3.0f;
+    return k;
+}
+
+static inline __attribute__((always_inline)) float hud_clamp_root(float s) {
+    // The root stretch, from the screen shape: 1 is 16:9 (no stretch). A zero or
+    // non-number is an unwritten state page, so identity; outside [0.5, 2.0] is a
+    // host bug, so clamp. The screen's widest (2.2) asks for 2.2 / (16/9) = 1.24,
+    // and its tallest (1.3) for (16/9) / 1.3 = 1.37.
+    if (s == 0.0f || s != s) return 1.0f;
+    if (s < 0.5f) return 0.5f;
+    if (s > 2.0f) return 2.0f;
+    return s;
+}
+
+// Scale orig about the pane's centre, then move by (dx, dy) in layout units, into
+// mod. sx scales the x row, sy the y row (a HUD widget passes sx == sy == k; a
+// layout root passes the screen shape's sx / sy with dx == dy == 0). The centre is
+// the pane's middle passed through its own matrix. The middle is found from the
+// pane's origin (the byte at +0x5b, confirmed by disassembly of the local matrix
+// helper at main+0x9096d0: bits 4-5 the horizontal origin, 1 left, 2 right; bits
+// 6-7 the vertical origin, 1 top, 2 bottom; 0 is the centre either way) and its
+// size at +0x50 / +0x54: the centre is the origin plus half the size towards the
+// middle (the layout is y-up, the origin at the parent's centre, so a top
+// origin's centre is half the height below it, a left origin's half the width
+// to its right). A pane with no usable size scales about its translation (its
+// origin), which is the same thing for a point-sized pane. The third row (depth)
+// is left alone: this is a 2D widget, and scaling its depth would change its
+// draw order.
+static inline __attribute__((always_inline)) void hud_xform(const float *orig, float *mod, float dx, float dy,
+                      float sx, float sy, float w, float h, unsigned char origin) {
+    float cx, cy;
+    if (w > 0.0f && w < 100000.0f && h > 0.0f && h < 100000.0f) {
+        float ox = ((origin >> 4) & 3) == 1 ? w * 0.5f : ((origin >> 4) & 3) == 2 ? -w * 0.5f : 0.0f;
+        float oy = ((origin >> 6) & 3) == 1 ? -h * 0.5f : ((origin >> 6) & 3) == 2 ? h * 0.5f : 0.0f;
+        cx = orig[0] * ox + orig[1] * oy + orig[3];
+        cy = orig[4] * ox + orig[5] * oy + orig[7];
+    } else {
+        cx = orig[3];
+        cy = orig[7];
+    }
+    for (int i = 0; i < 3; i++) { mod[i] = orig[i] * sx; mod[4 + i] = orig[4 + i] * sy; }
+    mod[3] = cx + (orig[3] - cx) * sx + dx;
+    mod[7] = cy + (orig[7] - cy) * sy + dy;
+    for (int i = 8; i < 12; i++) mod[i] = orig[i];
+}
+
+void hud_calc(void *pane, const float *params, void *table, void *logbuf) {
+    if (!pane || !params || !table) return;
+    const char *name = (const char *)pane + 0xb8;
+
+    // Which HUD element is this pane, by its name's words: the first four bytes,
+    // then the rest (the NUL included, so a longer name with the same prefix is
+    // rejected). Element 1 (life) has no locked name: it never matches here.
+    int idx = -1;
+    {
+        const u32 *nw = (const u32 *)name;
+        if (nw[0] == HUD_P_COMP && nw[1] == HUD_C_COMP1 && nw[2] == HUD_C_COMP2) idx = 0;
+        else if (nw[0] == HUD_P_COIN && nw[1] == HUD_C_COIN1 && nw[2] == HUD_C_COIN2) idx = 2;
+        else if (nw[0] == HUD_P_MOON && nw[1] == HUD_C_MOON1) idx = 3;
+    }
+
+    // The pane's current global matrix (as the game computed it), its size, its
+    // origin (the pivot's place in its own rectangle, +0x5b), and its parent. A
+    // layout root has no parent: it is the pane Layout::Calculate hands in, not
+    // a child of another pane.
+    const float *g = (const float *)pane + 0x70 / 4;
+    float tx = g[3], ty = g[7];
+    float w = *(const float *)((const char *)pane + 0x50);
+    float h = *(const float *)((const char *)pane + 0x54);
+    unsigned char origin = *(const unsigned char *)((const char *)pane + 0x5b);
+    void *parent = *(void **)((const char *)pane + 0x18);
+
+    // A full-screen layout root (the PauseMenu settings screen, the WorldMap map
+    // screen, any other full-screen layout): no parent, and a full-screen size. The
+    // size test is the engine's own full-screen rule (loader.c dm_fps_state_apply,
+    // the duo_anchor anc values: a pane 1270 wide and 710 tall or larger is a
+    // full-screen pane; a looser width once stretched a half-width side panel past
+    // its bars). A HUD widget's own root is excluded by name (idx >= 0): it takes
+    // the player's settings, never the root stretch, so it is never stretched twice.
+    // Small widget roots are excluded by size: they are not full-screen layouts.
+    int is_root = (parent == 0 && idx < 0 && w >= 1270.0f && h >= 710.0f);
+
+    // Calibration log: every pane in the screen's top strip, and every full-screen
+    // layout root, deduped by pane address and name, so one run's log.txt shows the
+    // real pane names (which layout is "RootPane", which root the hook scaled) and
+    // the positions and sizes they had. The top strip is the HUD's row (ty < 150
+    // layout units); full-screen backgrounds (w >= 1200) and unnamed panes are not
+    // HUD widgets, but a full-screen root is logged by its own rule below. Capped
+    // at 64 entries; once full the scan stops (the count check is the only
+    // per-pane cost after that).
+    if (logbuf) {
+        u32 *count = (u32 *)logbuf;
+        int want = 0;
+        u32 matched = HUD_MATCH_NONE;
+        if (is_root) { want = 1; matched = HUD_MATCH_ROOT; }
+        else if (*count < HUD_LOG_MAX && ty < 150.0f && ty > -50.0f && w > 0.0f && w < 1200.0f && name[0]) { want = 1; matched = idx < 0 ? HUD_MATCH_NONE : (u32)idx; }
+        if (want && *count < HUD_LOG_MAX) {
+            char *entries = (char *)logbuf + 4;
+            int found = 0;
+            for (u32 e = 0; e < *count; e++) {
+                char *en = entries + e * HUD_LOG_ENTRY;
+                if (*(uintptr_t *)(en + 44) == (uintptr_t)pane && hud_name_eq(en, name)) { found = 1; break; }
+            }
+            if (!found) {
+                char *dst = entries + (*count) * HUD_LOG_ENTRY;
+                for (int i = 0; i < HUD_NAME_MAX; i++) {
+                    dst[i] = name[i];
+                    if (!name[i]) break;
+                }
+                // A slot the loop above did not write keeps the previous entry's
+                // bytes only if the name is shorter: zero the tail past the NUL so
+                // a stale name can never be read back.
+                for (int i = 0; i < HUD_NAME_MAX; i++) if (!dst[i]) { for (int j = i + 1; j < HUD_NAME_MAX; j++) dst[j] = 0; break; }
+                *(float *)(dst + 24) = tx;
+                *(float *)(dst + 28) = ty;
+                *(float *)(dst + 32) = w;
+                *(float *)(dst + 36) = h;
+                *(u32 *)(dst + 40) = matched;
+                *(uintptr_t *)(dst + 44) = (uintptr_t)pane;
+                (*count)++;
+            }
+        }
+    }
+
+    if (idx >= 0) {
+        // A HUD widget: the player's own settings (dx, dy, scale) and the
+        // generation the host bumped on every write, so a settings change is
+        // applied even when the game did not recompute the matrix this frame (a
+        // static widget's matrix stays put).
+        float dx = params[idx * 3 + 0];
+        float dy = params[idx * 3 + 1];
+        float k = hud_clamp_k(params[idx * 3 + 2]);
+        u32 gen = ((const u32 *)params)[12];
+
+        // The per-element entry: the pane, its original matrix (as the game
+        // computed it), the modified matrix (the original + this transform), and
+        // the generation the modified matrix was computed from.
+        char *ent = (char *)table + idx * HUD_ENTRY;
+        uintptr_t *e_pane = (uintptr_t *)(ent + 0);
+        float *e_orig = (float *)(ent + 8);
+        float *e_mod = (float *)(ent + 56);
+        u32 *e_gen = (u32 *)(ent + 104);
+        if (*e_pane != (uintptr_t)pane) {   // first sighting, or the layout reloaded
+            *e_pane = (uintptr_t)pane;
+            *(u32 *)(ent + 108) = (u32)idx;
+            *(u32 *)(ent + 112) = 1u;
+            *e_gen = 0;   // force a recompute below (the stored modified matrix is stale)
+        }
+
+        // Did the game recompute the matrix since the last frame? Compare the
+        // current matrix against the stored modified one: if they differ, the game
+        // wrote a new original (an animation, a parent that moved, the layout
+        // reloading), so the stored original follows it. If they are the same, the
+        // game left our modified matrix alone, and only a settings change (a new
+        // generation) needs a recompute.
+        int recomputed = 0;
+        {
+            const u32 *cur = (const u32 *)g;
+            u32 *mod = (u32 *)e_mod;
+            for (int i = 0; i < 12; i++) if (cur[i] != mod[i]) { recomputed = 1; break; }
+        }
+        if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g[i];
+        if (!recomputed && *e_gen == gen) return;   // already correct: nothing to do
+        hud_xform(e_orig, e_mod, dx, dy, k, k, w, h, origin);
+        *e_gen = gen;
+
+        // Write the modified matrix back to the pane. Its children are calculated
+        // after this hook, so they inherit the moved / resized parent.
+        float *dst = (float *)pane + 0x70 / 4;
+        for (int i = 0; i < 12; i++) dst[i] = e_mod[i];
+        return;
+    }
+
+    if (is_root) {
+        // A full-screen layout root: the screen shape's stretch, about the pane's
+        // centre. Two rules, told apart by the root's own size, because the two
+        // full-screen layouts need opposite directions (measured on the iPhone,
+        // 2026-11-11: the PauseMenu is centred and narrow, ~88% of the screen wide
+        // with black pillars left and right; the WorldMap overflows on every side,
+        // its right yellow panel and its top kingdom name cut off, while its 3D
+        // landmass keeps its proportions):
+        //   - a standard root (about 1280x720, the game's UI layout size) is
+        //     WIDENED / HEIGHTENED to the screen shape's layout (root_sx / root_sy,
+        //     from DM_SCREEN_ASPECT, written by the host): 1560x720 at 2.167, so
+        //     the PauseMenu fills the screen the way the main HUD already does.
+        //   - an oversized root (clearly larger than 1280x720, the WorldMap's) is
+        //     SHRUNK to fit inside the screen shape's layout, uniformly, so it
+        //     keeps its proportions and nothing is cut off: s = min(layout width
+        //     / w, layout height / h), clamped to [0.2, 1]. The layout size is
+        //     recovered from the stretch (root_sx x 1280, root_sy x 720). No player
+        //     setting: both are automatic, and both are identity at 16:9 for a
+        //     standard root (sx == sy == 1) and a no-op for an oversized root that
+        //     already fits (s == 1).
+        float sx, sy;
+        if (w <= 1400.0f && h <= 800.0f) {   // standard root: fill the screen shape
+            sx = hud_clamp_root(params[13]);
+            sy = hud_clamp_root(params[14]);
+        } else {   // oversized root (the map): shrink uniformly to fit, never grow
+            float lw = hud_clamp_root(params[13]) * 1280.0f;
+            float lh = hud_clamp_root(params[14]) * 720.0f;
+            float s1 = lw / w, s2 = lh / h;
+            float s = s1 < s2 ? s1 : s2;
+            if (s > 1.0f) s = 1.0f;
+            if (s < 0.2f) s = 0.2f;
+            if (s != s) s = 1.0f;   // not a number: an unwritten state page
+            sx = s;
+            sy = s;
+        }
+        if (sx == 1.0f && sy == 1.0f) return;   // 16:9 standard root, or an oversized root that already fits: nothing to do
+
+        // The root table (state page + 0x500, derived from the HUD table's base):
+        // one entry per root pane, found by pane pointer, so two layouts whose
+        // roots share the "RootPane" name still get their own entries.
+        char *rtable = (char *)table + 0x200;
+        char *ent = 0;
+        for (int i = 0; i < HUD_ROOT_MAX; i++) {
+            char *e = rtable + i * HUD_ENTRY;
+            if (*(uintptr_t *)(e + 0) == (uintptr_t)pane) { ent = e; break; }
+            if (!ent && *(u32 *)(e + 112) == 0) ent = e;   // first free slot
+        }
+        if (!ent) return;   // no free slot: leave the root alone, never grow the table
+        uintptr_t *e_pane = (uintptr_t *)(ent + 0);
+        float *e_orig = (float *)(ent + 8);
+        float *e_mod = (float *)(ent + 56);
+        float *e_sx = (float *)(ent + 104);
+        float *e_sy = (float *)(ent + 108);
+        if (*e_pane != (uintptr_t)pane) {   // first sighting, or the slot was reused
+            *e_pane = (uintptr_t)pane;
+            *(u32 *)(ent + 112) = 1u;
+            *e_sx = 0.0f;   // force a recompute below (the stored scale is stale)
+            *e_sy = 0.0f;
+        }
+        int recomputed = 0;
+        {
+            const u32 *cur = (const u32 *)g;
+            u32 *mod = (u32 *)e_mod;
+            for (int i = 0; i < 12; i++) if (cur[i] != mod[i]) { recomputed = 1; break; }
+        }
+        if (recomputed) for (int i = 0; i < 12; i++) e_orig[i] = g[i];
+        // A changed screen shape needs a recompute even when the game did not
+        // recompute the matrix (the root is static, its matrix stays put).
+        if (!recomputed && *e_sx == sx && *e_sy == sy) return;
+        hud_xform(e_orig, e_mod, 0.0f, 0.0f, sx, sy, w, h, origin);
+        *e_sx = sx;
+        *e_sy = sy;
+        float *dst = (float *)pane + 0x70 / 4;
+        for (int i = 0; i < 12; i++) dst[i] = e_mod[i];
+        return;
+    }
+}
