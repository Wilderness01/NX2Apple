From c6c0945a92e9b1e89f8f75d09ecd8d86ca1d6f2d Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Tue, 17 Nov 2026 21:52:23 +0800
Subject: [PATCH] 0178: launcher background is the red world map (Metro
 Kingdom), rendered from the game's own map texture
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Replace the 0173 title-screen frame (red map + Mario + logo) with a
high-definition render of the game's red world map itself: the 2048x2048
map texture (LayoutData/Map.szs, CmImageWorld01), tinted Odyssey red and
rendered as a perspective globe with Metro Kingdom centred (2796x1290).
The kingdom-name labels are not in the texture (the game draws them live),
so the render has the landmasses and grid only — no baked-in logo, no
virtual buttons, no menu. Lighter scrim (0.28, was 0.40) and left grade
(0.30, was 0.42) so the red map stays visible behind the hero text.
---
 dm/ios/Sources/Launcher.swift                 |  13 +++++++------
 .../LauncherBackground/launcher_title_bg.jpg  | Bin 154679 -> 147532 bytes
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
index 4207a2a..2f1cfef 100644
--- a/dm/ios/Sources/Launcher.swift
+++ b/dm/ios/Sources/Launcher.swift
@@ -178,7 +178,7 @@ private func dmSettingIcon(_ env: String) -> String? {
     }
 }
 
-/// Liquid Glass for the launcher's panels (0171): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the title-screen art (0173) — red world map, Mario — dimmed by a scrim, so the glass has colour to work with and the white text stays legible.
+/// Liquid Glass for the launcher's panels (0171): iOS 26 native .glassEffect, regular; below iOS 26 a translucent material fill. The deployment target is iOS 26, so the fallback is dead code kept for the pattern's sake — the same ladder the pad's discs use (0111: real UIGlassEffect on 26+, vector disc below). Layered, not flat: a soft inner highlight along the top edge and a gentle drop shadow give the card depth; the corner radius is a little larger (32) for the game's rounded, playful shapes. Glass needs something behind it to refract: the red world-map render (0178) — Metro Kingdom, drawn from the game's own map texture — dimmed by a scrim, so the glass has colour to work with and the white text stays legible.
 private extension View {
     @ViewBuilder func dmGlassCard(cornerRadius: CGFloat = 32) -> some View {
         Group {
@@ -204,7 +204,7 @@ private func dmLauncherTitleImage() -> UIImage? {
     UIImage(named: "launcher_title_bg", in: Bundle(for: LauncherModel.self), compatibleWith: nil)
 }
 
-/// The title-screen backdrop (0173): the art above, two layers — the same art blurred to fill the screen (its own red tones at the edges, so no flat bars on any aspect: iPhone 19.5:9, iPad 4:3) with the sharp art fitted on top — under a dark scrim, so the whole launcher speaks the title screen's language instead of the 0171 plain navy. If the art is ever missing from the bundle, the 0171 navy-and-glows backdrop is the fallback — the launcher never shows a bare screen.
+/// The red-map backdrop (0178): the art above is a high-definition render of the game's own red world map (Metro Kingdom centred), drawn from the map texture in LayoutData/Map.szs — it replaces the 0173 title-screen frame (red map + Mario + logo). Two layers — the same art blurred to fill the screen (its own red tones at the edges, so no flat bars on any aspect: iPhone 19.5:9, iPad 4:3) with the sharp art fitted on top — under a lighter scrim than 0173's, so the red map stays visible instead of going muddy. If the art is ever missing from the bundle, the 0171 navy-and-glows backdrop is the fallback — the launcher never shows a bare screen.
 private struct LauncherBackdrop: View {
     var body: some View {
         ZStack {
@@ -219,7 +219,7 @@ private struct LauncherBackdrop: View {
                 Image(uiImage: art)
                     .resizable()
                     .scaledToFit()
-                Color.black.opacity(0.40)   // scrim: the art is bright red; the white-on-glass text needs the darkening
+                Color.black.opacity(0.28)   // scrim (0178): lighter than 0173's 0.40 — the red map must stay visible, not go muddy; the white-on-glass text still gets its darkening
             } else {
                 Color(red: 0.04, green: 0.06, blue: 0.11)
                 RadialGradient(colors: [odysseyRed.opacity(0.30), .clear], center: .topLeading, startRadius: 0, endRadius: 620)
@@ -473,9 +473,10 @@ private struct LauncherView: View {
             let contentWidth = geometry.size.width - 40 - insets.leading - insets.trailing
             ZStack {
                 LauncherBackdrop()
-                // (0176) the Diablo mood: the title art is bright red, so a left-to-right dark grade
-                // (deepest behind the hero text) plus a bottom grade for the tagline, over the 0173 scrim.
-                LinearGradient(colors: [.black.opacity(0.42), .black.opacity(0.12)], startPoint: .leading, endPoint: .trailing)
+                // (0176) the Diablo mood: the red map is bright, so a left-to-right dark grade
+                // (deepest behind the hero text) plus a bottom grade for the tagline, over the 0178 scrim.
+                // (0178) the left grade is 0.30, not 0176's 0.42 — the map must show through behind the title.
+                LinearGradient(colors: [.black.opacity(0.30), .black.opacity(0.12)], startPoint: .leading, endPoint: .trailing)
                     .ignoresSafeArea()
                 LinearGradient(colors: [.clear, .black.opacity(0.30)], startPoint: .top, endPoint: .bottom)
                     .ignoresSafeArea()
