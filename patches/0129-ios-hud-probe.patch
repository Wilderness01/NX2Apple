+// The HUD probe buffer (0129, diagnostic only): the rewriter's hud_probe
+// stub writes compact binary records into the frame-step state page at
+// +0x3300 (the hud_edge table ends there; the state page is 0x4000 bytes,
+// so +0x3300..+0x4000 is free). Layout, matching hud_probe.c:
+//   +0x00: u32 magic ("PRBE"), +0x04: u32 enabled (DM_HUD_PROBE=1),
+//   +0x08: u32 rec_count, +0x0C: u32 seen_count, +0x10: u32 aspect_logged,
+//   +0x14: u32 rec_cap, +0x18: u32 seen_cap, +0x1C: u32 reserved;
+//   +0x20: seen-table, 256 x u64 pane addresses;
+//   +0x820: record buffer, 13 records of 96 bytes.
+// A record (96 bytes): +0 u32 type (0 pane, 1 edge-decision, 2 aspect),
+// +4/+8 pane address (lo/hi), +12 char name[20], +32 char pname[20],
+// +52..+76 seven floats v0..v6, +80..+92 four u32 w0..w3.
+//   pane: v0=w, v1=h, v2=gx, v3=gy, v4=gsx, v5=gsy, w0=origin, w1=flags,
+//     w2/w3=paddr lo/hi.
+//   edge-decision: v0=tdx, v1=tdy, v2=tk, v3=pm_dx, v4=pm_dy, v5=final_m3,
+//     v6=final_m7, w0=idx, w1=slot, w2=hidden,
+//     w3=parent_hidden | has_parent<<1 | pm_sentinel<<2.
+//   aspect: v0=aspect, v1=edge.
+#define HUD_PROBE_OFF 0x3300
+#define HUD_PROBE_MAGIC 0x50524245u
+#define HUD_PROBE_REC_OFF 0x820
+#define HUD_PROBE_REC_SIZE 96
+#define HUD_PROBE_REC_CAP 13
+
+static int g_hud_probe_enabled = -1;   // -1 = not checked yet
+
+// Drain the probe buffer into the log, once per present. Called from
+// dm_hud_manual_frame_tick (which runs once per present) so it runs even
+// when the DM_HUD_* settings did not change. The stub only appends while
+// there is room and the host resets the count after logging, so a record
+// is logged exactly once. The enabled flag is set from DM_HUD_PROBE every
+// present, so the stub starts as soon as the variable is present.
+static void dm_hud_probe_tick(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    if (g_hud_probe_enabled < 0) {
+        const char *e = getenv("DM_HUD_PROBE");
+        g_hud_probe_enabled = (e && e[0] == '1' && e[1] == '\0') ? 1 : 0;
+    }
+    uint8_t *pb = st + HUD_PROBE_OFF;
+    uint32_t *hdr = (uint32_t *)pb;
+    hdr[1] = (uint32_t)g_hud_probe_enabled;   // enabled flag for the stub
+    if (!g_hud_probe_enabled) return;
+    if (hdr[0] != HUD_PROBE_MAGIC) return;   // stub has not initialised yet
+    uint32_t rc = hdr[2];
+    if (rc == 0) return;
+    if (rc > HUD_PROBE_REC_CAP) rc = HUD_PROBE_REC_CAP;
+    for (uint32_t i = 0; i < rc; i++) {
+        char *rec = (char *)pb + HUD_PROBE_REC_OFF + i * HUD_PROBE_REC_SIZE;
+        uint32_t type = *(uint32_t *)(rec + 0);
+        uint32_t alo = *(uint32_t *)(rec + 4);
+        uint32_t ahi = *(uint32_t *)(rec + 8);
+        char *name = rec + 12;
+        char *pname = rec + 32;
+        name[19] = '\0'; pname[19] = '\0';   // the stub terminates, this is belt and braces
+        if (type == 0) {
+            float w = *(float *)(rec + 52);
+            float h = *(float *)(rec + 56);
+            float gx = *(float *)(rec + 60);
+            float gy = *(float *)(rec + 64);
+            float gsx = *(float *)(rec + 68);
+            float gsy = *(float *)(rec + 72);
+            uint32_t origin = *(uint32_t *)(rec + 80);
+            uint32_t flags = *(uint32_t *)(rec + 84);
+            uint32_t plo = *(uint32_t *)(rec + 88);
+            uint32_t phi = *(uint32_t *)(rec + 92);
+            LOG("[hudprobe] pane '%s' addr=0x%08x%08x parent='%s' paddr=0x%08x%08x size=%.0fx%.0f origin=0x%02x flags=0x%04x global=(%.1f,%.1f) gscale=(%.3f,%.3f)",
+                name, ahi, alo, pname, phi, plo, w, h, origin & 0xffu, flags & 0xffffu, gx, gy, gsx, gsy);
+        } else if (type == 1) {
+            float tdx = *(float *)(rec + 52);
+            float tdy = *(float *)(rec + 56);
+            float tk = *(float *)(rec + 60);
+            float pmdx = *(float *)(rec + 64);
+            float pmdy = *(float *)(rec + 68);
+            float fm3 = *(float *)(rec + 72);
+            float fm7 = *(float *)(rec + 76);
+            uint32_t idx = *(uint32_t *)(rec + 80);
+            uint32_t slot = *(uint32_t *)(rec + 84);
+            uint32_t hidden = *(uint32_t *)(rec + 88);
+            uint32_t w3 = *(uint32_t *)(rec + 92);
+            uint32_t parent_hidden = w3 & 1u;
+            uint32_t has_parent = (w3 >> 1) & 1u;
+            uint32_t pm_sentinel = (w3 >> 2) & 1u;
+            LOG("[hudprobe] edge-decision pane '%s' idx=%d slot=%d tdx=%.1f tdy=%.1f tk=%.2f hidden=%d parent_hidden=%d has_parent=%d pm_dx=%.1f pm_dy=%.1f final_m3=%.1f final_m7=%.1f pm_sentinel=%d",
+                name, (int)idx, (int)slot, tdx, tdy, tk, (int)hidden, (int)parent_hidden, (int)has_parent, pmdx, pmdy, fm3, fm7, (int)pm_sentinel);
+        } else if (type == 2) {
+            float aspect = *(float *)(rec + 52);
+            float edge = *(float *)(rec + 56);
+            LOG("[hudprobe] aspect=%.4f edge=%.1f", aspect, edge);
+        }
+    }
+    hdr[2] = 0;   // reset the record count; the stub appends from 0 again
+}
