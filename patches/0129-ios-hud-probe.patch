From fef84a9c584a9b42948fd992926fcfd6055f7dbe Mon Sep 17 00:00:00 2001
From: verify <verify@example.invalid>
Date: Sat, 14 Nov 2026 01:07:04 +0000
Subject: [PATCH] 0129: diagnostic-only HUD probe (logs pane names,
 aspect/edge, and hud_edge decisions)

V1.3.18's HUD is one edge (140) from where 0128 should have put it, and
log-35 ruled hiding out as the trigger, so the prime suspect is that
hud_edge reads edge=0 (the aspect not reaching it, or out of range). This
probe logs, per pane on first sighting (gated by DM_HUD_PROBE=1):

- the pane's name, parent, size, origin, flags and global matrix;
- the aspect and the edge exactly as hud_edge reads and computes them
  (state +0x58), the direct test of the edge=0 hypothesis;
- for every pane hud_edge matched, the decision it took: element index,
  slot, tdx/tdy/tk, hidden, the parent's table entry (and whether it is
  a fresh sentinel), and the translation actually in the pane matrix.

It moves no pane and changes no behaviour: hud_probe.c writes compact
binary records into a probe buffer at state +0x3300 (after the hud_edge
table; the state page is 0x4000 bytes), and hud_manual.c's
dm_hud_probe_tick formats them into [hudprobe] log lines once per
present. Deduped per pane address (256), 13 records per flush, first
sighting only. Deleted after use, never shipped.
---
 dm/games/0100000000010000/hud_probe.c | 333 ++++++++++++++++++++++++++
 dm/games/0100000000010000/patches.py  |  68 +++++-
 dm/host/hud_manual.c                  |  95 ++++++++
 3 files changed, 495 insertions(+), 1 deletion(-)
 create mode 100644 dm/games/0100000000010000/hud_probe.c

diff --git a/dm/games/0100000000010000/hud_probe.c b/dm/games/0100000000010000/hud_probe.c
new file mode 100644
index 0000000..311fa8a
--- /dev/null
+++ b/dm/games/0100000000010000/hud_probe.c
@@ -0,0 +1,333 @@
+// hud_probe.c -- diagnostic probe (0129). Adds logging only; changes no HUD behavior.
+//
+// The user authorised this probe ("directly do the probe") after V1.3.18
+// (0128) still showed a broken HUD on device: the coin/regional numbers do
+// not render at all, and the compass/hints do not reach the edge. A
+// user-side control test ruled hiding OUT as the trigger (log-35: hidden
+// mask 0x11 -> 0x00, numbers still missing), so the prime hypothesis is
+// that hud_edge reads edge = 0 (the aspect never reaches it, or it is out
+// of range), so the manual base is 0 and tdx degenerates to the old
+// manual_dx -- which matches the diagnosis that the icons sit exactly one
+// edge (140) away from where 0128 should have put them.
+//
+// This probe answers, from the device, in one log:
+//   1. every pane's name, parent, size, origin, flags and global matrix
+//      (first sighting only) -- to identify the moon dots and the visible
+//      hints text, whose real pane names are still unknown (TxtGuide01 is
+//      disproven; the dots have no name in any dump so far);
+//   2. the aspect and the edge exactly as hud_edge reads/computes them
+//      (from the aspect_ptr hud_edge is passed, state +0x58 -- NOT the
+//      screen-shape code, which already says 140 but reads a different
+//      path) -- the direct test of the edge = 0 hypothesis;
+//   3. for every pane hud_edge matched, the decision it actually took:
+//      element index, slot, tdx/tdy/tk, hidden, the parent's table entry
+//      (pm_dx/pm_dy, whether the parent entry is a fresh sentinel) and
+//      the translation actually written back to the pane matrix
+//      (final_m3/final_m7) -- so a corrupted number-pane matrix, a stale
+//      parent, or an off-screen push is visible, not guessed.
+//
+// How it works: the rewriter's two Pane::Calculate cuts call this stub
+// after hud_edge (same arguments, plus the probe buffer). The stub writes
+// compact binary records into a probe buffer in the frame-step state page
+// (state +0x3300, 3328 bytes: a 32-byte header, a 256-address seen-table,
+// and 13 records of 96 bytes). The host (hud_manual.c,
+// dm_hud_probe_tick, once per present) formats the records into
+// "[hudprobe] ..." log lines and resets the record count. The stub never
+// writes text and never calls a log function: it only reads pane memory
+// and writes the probe buffer, so it cannot disturb the game. It is gated
+// by the environment variable DM_HUD_PROBE=1 (the host sets the buffer's
+// enabled flag from it; the stub returns immediately when the flag is 0).
+// Dedup is by pane address (first sighting only, 256 addresses); a full
+// record buffer just defers (the pane stays un-seen and retries next
+// frame), and the host flushes every present, so a 5-second stand-still
+// logs every pane. Delete after use; never ship.
+//
+// All probe-buffer accesses are volatile: the buffer is shared with the
+// host (which sets the enabled flag and drains the records), so the
+// compiler must emit each access exactly as written -- and, as a side
+// effect, it cannot vectorise the header initialisation or combine
+// adjacent stores into a literal-pool load, which would break the
+// relocation-free requirement below.
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-asynchronous-unwind-tables -c
+// (same flags as hud_edge.c). The function takes everything through its
+// arguments -- no static data, no literal pool, no external calls -- so
+// the emitted words are position-independent and relocation-free and can be
+// dropped into the rewriter's patch area verbatim:
+//   x0 = the pane (nn::ui2d::Pane *), x1 = the aspect (a pointer to state
+//   page + 0x58), x2 = the edge table (state page + 0x300), x3 = the probe
+//   buffer (state page + 0x3300).
+
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef unsigned long uintptr_t;
+
+// The probe buffer (state + 0x3300, 3328 bytes: the frame-step state page
+// is 0x4000 bytes and the hud_edge table ends at +0x3300, so +0x3300..+0x4000
+// is free). Header 32 bytes, seen-table 256 x 8 bytes, record buffer
+// 13 x 96 bytes: 32 + 2048 + 1248 = 3328, exactly the free region.
+#define HUD_PROBE_MAGIC 0x50524245u   // "PRBE"
+#define HUD_PROBE_HDR_SIZE 32
+#define HUD_PROBE_SEEN_CAP 256
+#define HUD_PROBE_REC_CAP 13
+#define HUD_PROBE_REC_SIZE 96
+// Header offsets (relative to probe_buf).
+#define HP_MAGIC 0
+#define HP_ENABLED 4
+#define HP_REC_COUNT 8
+#define HP_SEEN_COUNT 12
+#define HP_ASPECT_LOGGED 16
+#define HP_REC_CAP 20
+#define HP_SEEN_CAP 24
+#define HP_RESERVED 28
+// Seen-table at +32 (256 x 8 = 2048 bytes, ends +2080); record buffer at
+// +2080 (13 x 96 = 1248 bytes, ends +3328).
+#define HP_SEEN_OFF 32
+#define HP_REC_OFF 2080
+
+// Record types.
+#define HP_REC_PANE 0
+#define HP_REC_EDGE 1
+#define HP_REC_ASPECT 2
+// Record field offsets (relative to the record start, 96 bytes total).
+#define HP_R_TYPE 0
+#define HP_R_ADDR_LO 4
+#define HP_R_ADDR_HI 8
+#define HP_R_NAME 12        // char[20]
+#define HP_R_PNAME 32       // char[20]
+#define HP_R_V0 52
+#define HP_R_V1 56
+#define HP_R_V2 60
+#define HP_R_V3 64
+#define HP_R_V4 68
+#define HP_R_V5 72
+#define HP_R_V6 76
+#define HP_R_W0 80
+#define HP_R_W1 84
+#define HP_R_W2 88
+#define HP_R_W3 92
+
+// The hud_edge table (must match hud_edge.c): 96 entries of 128 bytes,
+// sixteen slots per element; entry +0 the pane, +104/+108/+112 the applied
+// dx/dy/k, +116 the hidden flag, +120 the element index, +124 the valid flag.
+#define HUD_EDGE_N 6
+#define HUD_EDGE_ENTRY 128
+#define HUD_EDGE_SLOTS_PER_ELEM 16
+
+// Store a u32 / float into the probe buffer (volatile: one access, exactly
+// as written -- no vectorising, no combining, no literal pool).
+static inline __attribute__((always_inline)) void hp_put_u32(volatile char *base, int off, u32 v) {
+    *(volatile u32 *)(base + off) = v;
+}
+static inline __attribute__((always_inline)) void hp_put_f32(volatile char *base, int off, float v) {
+    *(volatile float *)(base + off) = v;
+}
+
+// Copy a pane name (a C string) into dst, at most max-1 chars, always
+// NUL-terminated. The source is read byte by byte so a short or
+// unterminated name cannot run past the buffer.
+static inline __attribute__((always_inline)) void hud_probe_copy_name(volatile char *dst, const char *src, int max) {
+    int i = 0;
+    if (src) {
+        for (; i < max - 1; i++) {
+            char c = src[i];
+            if (c == 0) break;
+            dst[i] = c;
+        }
+    }
+    dst[i] = 0;
+}
+
+// Find the hud_edge table entry for a pane (the same linear scan
+// hud_edge.c uses). Returns 0 when the pane has no entry (never matched,
+// or its slot was reclaimed).
+static inline __attribute__((always_inline)) char *hud_probe_find_entry(void *table, void *pane) {
+    for (int i = 0; i < HUD_EDGE_N * HUD_EDGE_SLOTS_PER_ELEM; i++) {
+        char *e = (char *)table + i * HUD_EDGE_ENTRY;
+        if (*(u32 *)(e + 124) != 0 && *(uintptr_t *)(e + 0) == (uintptr_t)pane) return e;
+    }
+    return 0;
+}
+
+// The edge offset from an aspect, exactly as hud_edge.c computes it:
+// valid aspects are 1.3 to 2.2; anything else is 16:9 (edge 0). Clamped
+// to +/-200.
+static inline __attribute__((always_inline)) float hud_probe_edge(float aspect) {
+    float edge = 0.0f;
+    if (aspect >= 1.3f && aspect <= 2.2f) {
+        edge = 640.0f * (aspect / 1.7777778f - 1.0f);
+        if (edge > 200.0f) edge = 200.0f;
+        if (edge < -200.0f) edge = -200.0f;
+    }
+    return edge;
+}
+
+void hud_probe(void *pane, const float *aspect_ptr, void *table, void *probe_buf) {
+    if (!pane || !aspect_ptr || !table || !probe_buf) return;
+    volatile u32 *hdr = (volatile u32 *)probe_buf;
+    // Initialise the header the first time (the state page starts zeroed).
+    // The enabled flag is left 0 here; the host sets it from DM_HUD_PROBE.
+    if (hdr[HP_MAGIC / 4] != HUD_PROBE_MAGIC) {
+        hdr[HP_MAGIC / 4] = HUD_PROBE_MAGIC;
+        hdr[HP_ENABLED / 4] = 0;
+        hdr[HP_REC_COUNT / 4] = 0;
+        hdr[HP_SEEN_COUNT / 4] = 0;
+        hdr[HP_ASPECT_LOGGED / 4] = 0;
+        hdr[HP_REC_CAP / 4] = HUD_PROBE_REC_CAP;
+        hdr[HP_SEEN_CAP / 4] = HUD_PROBE_SEEN_CAP;
+        hdr[HP_RESERVED / 4] = 0;
+    }
+    if (hdr[HP_ENABLED / 4] == 0) return;   // DM_HUD_PROBE != 1: do nothing
+
+    // Flags bit 7 is set by Pane::Calculate's epilogue, so it tells whether
+    // this pane has ever calculated (same guard hud_edge.c uses). On a
+    // pane's very first frame its matrix is still zero; skip it -- the
+    // +0x13c cut catches it after the game computes it, and the entry cut
+    // catches it from the next frame on. Logging a zero matrix would
+    // misidentify the pane's position.
+    unsigned short pflags = *(const unsigned short *)((const char *)pane + 0x58);
+    if (!(pflags & 0x80u)) return;
+
+    // The aspect / edge summary, once, from the aspect_ptr hud_edge itself
+    // is passed (state +0x58) -- not the screen-shape code. This is the
+    // direct test of the edge = 0 hypothesis: if hud_edge reads a valid
+    // aspect the edge here is 140 on iPhone 19.5:9; if it reads 0 or an
+    // out-of-range aspect the edge here is 0.
+    if (hdr[HP_ASPECT_LOGGED / 4] == 0) {
+        u32 rc = hdr[HP_REC_COUNT / 4];
+        if (rc < HUD_PROBE_REC_CAP) {
+            float aspect = *aspect_ptr;
+            float edge = hud_probe_edge(aspect);
+            volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+            hp_put_u32(rec, HP_R_TYPE, HP_REC_ASPECT);
+            hp_put_u32(rec, HP_R_ADDR_LO, 0);
+            hp_put_u32(rec, HP_R_ADDR_HI, 0);
+            for (int i = 0; i < 20; i++) { rec[HP_R_NAME + i] = 0; rec[HP_R_PNAME + i] = 0; }
+            hp_put_f32(rec, HP_R_V0, aspect);
+            hp_put_f32(rec, HP_R_V1, edge);
+            hp_put_f32(rec, HP_R_V2, 0.0f);
+            hp_put_f32(rec, HP_R_V3, 0.0f);
+            hp_put_f32(rec, HP_R_V4, 0.0f);
+            hp_put_f32(rec, HP_R_V5, 0.0f);
+            hp_put_f32(rec, HP_R_V6, 0.0f);
+            hp_put_u32(rec, HP_R_W0, 0);
+            hp_put_u32(rec, HP_R_W1, 0);
+            hp_put_u32(rec, HP_R_W2, 0);
+            hp_put_u32(rec, HP_R_W3, 0);
+            hdr[HP_REC_COUNT / 4] = rc + 1;
+            hdr[HP_ASPECT_LOGGED / 4] = 1;
+        }
+        // No room: leave aspect_logged clear so it retries next call.
+    }
+
+    // Dedup by pane address (first sighting only). A pane the hook sees
+    // again (the entry cut and the +0x13c cut both visit it, and every
+    // frame after) is skipped.
+    volatile u64 *seen = (volatile u64 *)((char *)probe_buf + HP_SEEN_OFF);
+    u32 sc = hdr[HP_SEEN_COUNT / 4];
+    for (u32 i = 0; i < sc; i++) {
+        if (seen[i] == (uintptr_t)pane) return;
+    }
+    if (sc >= HUD_PROBE_SEEN_CAP) return;   // seen-table full: stop, do not flood
+
+    // Is this pane matched by hud_edge (does it have a table entry)? The
+    // entry gives the element index, the slot, and the transform hud_edge
+    // actually applied -- read from the table, never recomputed here, so
+    // the decision logged is the decision taken.
+    char *ent = hud_probe_find_entry(table, pane);
+    int matched = ent != 0;
+    int idx = -1, slot = -1;
+    if (matched) {
+        idx = (int)(*(u32 *)(ent + 120));
+        int entry_index = (int)(((uintptr_t)ent - (uintptr_t)table) / HUD_EDGE_ENTRY);
+        slot = (entry_index - idx) / HUD_EDGE_N;
+    }
+    // How many records: one pane record, plus one edge-decision record
+    // when matched. Both must fit, or neither is written and the pane
+    // stays un-seen (it retries next frame, when the host has flushed).
+    int need = matched ? 2 : 1;
+    u32 rc = hdr[HP_REC_COUNT / 4];
+    if (rc + (u32)need > HUD_PROBE_REC_CAP) return;
+
+    // The pane's own fields (offsets confirmed in hud_edge.c): name +0xb8,
+    // parent +0x18 (parent name via the parent's +0xb8), size +0x50/+0x54,
+    // origin +0x5b, flags +0x58, global matrix +0x70 (m[3]/m[7]
+    // translation, m[0]/m[5] scale).
+    void *parent = *(void **)((const char *)pane + 0x18);
+    int parent_ok = parent != 0 && (((uintptr_t)parent & 7u) == 0);
+    const float *g = (const float *)((const char *)pane + 0x70);
+    {
+        volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+        hp_put_u32(rec, HP_R_TYPE, HP_REC_PANE);
+        hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+        hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+        hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+        if (parent_ok) hud_probe_copy_name(rec + HP_R_PNAME, (const char *)parent + 0xb8, 20);
+        else rec[HP_R_PNAME] = 0;
+        hp_put_f32(rec, HP_R_V0, *(const float *)((const char *)pane + 0x50));   // w
+        hp_put_f32(rec, HP_R_V1, *(const float *)((const char *)pane + 0x54));   // h
+        hp_put_f32(rec, HP_R_V2, g[3]);   // global x
+        hp_put_f32(rec, HP_R_V3, g[7]);   // global y
+        hp_put_f32(rec, HP_R_V4, g[0]);   // global sx
+        hp_put_f32(rec, HP_R_V5, g[5]);   // global sy
+        hp_put_f32(rec, HP_R_V6, 0.0f);
+        hp_put_u32(rec, HP_R_W0, (u32)(*(const unsigned char *)((const char *)pane + 0x5b)));   // origin
+        hp_put_u32(rec, HP_R_W1, (u32)(*(const unsigned short *)((const char *)pane + 0x58)));  // flags
+        hp_put_u32(rec, HP_R_W2, (u32)(uintptr_t)parent);   // paddr low
+        hp_put_u32(rec, HP_R_W3, (u32)((uintptr_t)parent >> 32));   // paddr high
+        rc++;
+    }
+
+    // The edge decision, for a matched pane only: the element index and
+    // slot (from the entry), the transform hud_edge applied (from the
+    // entry's stored dx/dy/k/hidden), the parent's table entry (its
+    // applied dx/dy, whether it is hidden, and whether its entry is the
+    // fresh 1e30f sentinel -- a stale parent is visible here), and the
+    // translation actually in the pane matrix now (final_m3/final_m7 --
+    // hud_edge already wrote the modified matrix back to the pane, so
+    // this is where the pane really renders, including any +10000 push).
+    if (matched) {
+        float tdx = *(const float *)(ent + 104);
+        float tdy = *(const float *)(ent + 108);
+        float tk = *(const float *)(ent + 112);
+        u32 hidden = *(const u32 *)(ent + 116);
+        float pm_dx = 0.0f, pm_dy = 0.0f;
+        int pm_hidden = 0, has_parent = 0, pm_sentinel = 0;
+        if (parent_ok) {
+            char *pe = hud_probe_find_entry(table, parent);
+            if (pe) {
+                has_parent = 1;
+                pm_dx = *(const float *)(pe + 104);
+                pm_dy = *(const float *)(pe + 108);
+                pm_hidden = (*(const u32 *)(pe + 116) != 0);
+                pm_sentinel = (*(const float *)(pe + 104) == 1e30f);
+            }
+        }
+        volatile char *rec = (volatile char *)probe_buf + HP_REC_OFF + rc * HUD_PROBE_REC_SIZE;
+        hp_put_u32(rec, HP_R_TYPE, HP_REC_EDGE);
+        hp_put_u32(rec, HP_R_ADDR_LO, (u32)(uintptr_t)pane);
+        hp_put_u32(rec, HP_R_ADDR_HI, (u32)((uintptr_t)pane >> 32));
+        hud_probe_copy_name(rec + HP_R_NAME, (const char *)pane + 0xb8, 20);
+        if (parent_ok) hud_probe_copy_name(rec + HP_R_PNAME, (const char *)parent + 0xb8, 20);
+        else rec[HP_R_PNAME] = 0;
+        hp_put_f32(rec, HP_R_V0, tdx);
+        hp_put_f32(rec, HP_R_V1, tdy);
+        hp_put_f32(rec, HP_R_V2, tk);
+        hp_put_f32(rec, HP_R_V3, pm_dx);
+        hp_put_f32(rec, HP_R_V4, pm_dy);
+        hp_put_f32(rec, HP_R_V5, g[3]);   // final_m3 (translation now in the pane matrix)
+        hp_put_f32(rec, HP_R_V6, g[7]);   // final_m7
+        hp_put_u32(rec, HP_R_W0, (u32)idx);
+        hp_put_u32(rec, HP_R_W1, (u32)slot);
+        hp_put_u32(rec, HP_R_W2, hidden);
+        hp_put_u32(rec, HP_R_W3, (u32)(pm_hidden | (has_parent << 1) | (pm_sentinel << 2)));
+        rc++;
+    }
+
+    hdr[HP_REC_COUNT / 4] = rc;
+    // Mark seen only after both records were written, so a deferred pane
+    // (buffer full) retries next frame instead of being lost.
+    seen[sc] = (uintptr_t)pane;
+    hdr[HP_SEEN_COUNT / 4] = sc + 1;
+}
