diff --git a/dm/host/hle_cheats.c b/dm/host/hle_cheats.c
index 0c2be26..c704406 100644
--- a/dm/host/hle_cheats.c
+++ b/dm/host/hle_cheats.c
@@ -1653,7 +1653,7 @@ static void costume_override_present(void) {
 #define INGAME_BUILD_ID      "b424be150a8e7d78701cbe7a439d9ebf"  // NSO build id, first 16 bytes hex (1.4.1 main, BUILD_141)
 #define INGAME_SEND_MSG      0x75cbd0ull   // generic send-message function
 #define INGAME_CHANGE_STR    0xe6ec60ull   // "ChangeClothes" rodata string
-#define INGAME_SCENE_VT      0x12c4dc8ull  // StageScene main vtable
+#define INGAME_SCENE_SUB_VT  0x12c4e40ull  // StageScene sub-object vtable ([scene+0x10]; RTTI "10StageScene", shared across kingdoms)
 #define INGAME_SLOT_LO       0x12c5d90ull  // first scene nerve slot (.data vaddr)
 #define INGAME_SLOT_HI       0x12c5f80ull  // end of the scene nerve-slot run (exclusive)
 #define INGAME_NERVE_LO      0x12c4ee8ull  // first scene nerve object
@@ -1686,15 +1686,22 @@ static int ingame_build_ok(void) {
     return bid && strncmp(bid, INGAME_BUILD_ID, 32) == 0;
 }
 
-// Scene validity, checked before every use of the pinned scene: the vtable
-// is the StageScene vtable, [scene+0x08] is the keeper, the keeper's owner
-// is this scene (bidirectional), both slots are scene nerve slots, and the
-// keeper tail is 0. A freed/reused scene fails the vtable or the owner
-// link, so a stale pin is never called through.
+// Scene validity, checked before every use of the pinned scene: the
+// sub-object vtable is the StageScene class vtable, [scene+0x08] is the
+// keeper, the keeper's owner is this scene (bidirectional), both slots are
+// scene nerve slots, and the keeper tail is 0. A freed/reused scene fails
+// the vtable or the owner link, so a stale pin is never called through.
+// 0249 (log-e7763d1d): the old check read the StageScene MAIN vtable
+// (0x12c4dc8, Sand Kingdom: [3] is the Sand stage init 0x46e7a0), so a
+// scene from any other kingdom failed validity and the pick was silently
+// dropped. The sub-object at scene+0x10 is INLINE (its vtable pointer
+// lives at [scene+0x10]) and its vtable is the StageScene class vtable
+// (RELA: +0x48 "10StageScene", +0x50 al::Scene class info), shared by
+// every kingdom -- so validity reads that one instead.
 static int ingame_scene_valid(uint64_t scene, uint64_t base) {
     if (!scene || !base) return 0;
-    uint64_t vt = 0, keeper = 0, link = 0, cur = 0, nxt = 0, tail = 0;
-    if (mem_read(scene, 8, &vt) != 0 || vt != base + INGAME_SCENE_VT) return 0;
+    uint64_t subvt = 0, keeper = 0, link = 0, cur = 0, nxt = 0, tail = 0;
+    if (mem_read(scene + 0x10, 8, &subvt) != 0 || subvt != base + INGAME_SCENE_SUB_VT) return 0;
     if (mem_read(scene + 0x08, 8, &keeper) != 0 || !keeper) return 0;
     if (mem_read(keeper + 0x00, 8, &link) != 0 || link != scene) return 0;
     if (mem_read(keeper + 0x08, 8, &cur) != 0) return 0;
@@ -1785,6 +1792,20 @@ static uint64_t ingame_scene_scan(uint64_t base) {
             if (ingame_keeper_test(k, base, hb, hopen, &o)) {
                 matched++;
                 if (ingame_scene_valid(o, base)) scene = o;
+                else {
+                    // 0249: say what the scene actually is, so the next log
+                    // settles whether the run was in a kingdom at all (the
+                    // log-e7763d1d question: title screen vs. another
+                    // kingdom). One line per scan (the thread re-scans every
+                    // ~60 s), not per frame: ingame_scene_valid itself stays
+                    // silent, it also runs on every presented frame.
+                    uint64_t mvt = 0, svt = 0;
+                    (void)mem_read(o, 8, &mvt);
+                    (void)mem_read(o + 0x10, 8, &svt);
+                    LOG("[dm] 0249: scene %#llx rejected: main vt %#llx, sub vt %#llx (want sub %#llx)",
+                        (unsigned long long)o, (unsigned long long)mvt,
+                        (unsigned long long)svt, (unsigned long long)(base + INGAME_SCENE_SUB_VT));
+                }
             }
         }
     }
diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index bb5c7bd..2a481c8 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -881,6 +881,22 @@ static const char *dm_char_nonbody_cores[] = {
     "PeachHeadShort", "PeachSkirt", "PonchoGuitar", "PonchoPoncho",
     "SpaceHelmet",
 };
+
+// 0249: whether the delayed redirect (0246) presses this file to the
+// character default. Only an ordinary BODY file (part == "", a core that
+// is neither a named form nor a non-body core) is pressed: the aborting
+// SARC at kingdom entry is the body file, and pressing any other file
+// breaks its loader's by-name lookup (log-5b04d0b5: MarioHigh.szs ->
+// Mario.szs, the High loader wants MarioHigh.bfres, NULL+0x28 at
+// 0x6ad530). Decided from the ORIGINAL core, before core_len is zeroed.
+static int dm_costume_delay_presses(const char *part, const char *core, size_t core_len) {
+    if (!dm_costume_delay_redirect() || part[0]) return 0;
+    if ((core_len == 4 && !memcmp(core, "High", 4)) ||
+        (core_len == 8 && !memcmp(core, "Mechanic", 8))) return 0;
+    for (size_t i = 0; i < sizeof dm_char_nonbody_cores / sizeof *dm_char_nonbody_cores; i++)
+        if (core_len == strlen(dm_char_nonbody_cores[i]) && !memcmp(core, dm_char_nonbody_cores[i], core_len)) return 0;
+    return 1;
+}
 static int dm_char_redirect(const char *p, char *out, size_t n) {
     // The path checks come first, so a player-model open is logged even when
     // no character is picked: the log then proves the game opens the file at
@@ -952,7 +968,15 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
     // FrameHeap (0240 line). Forcing the core to empty makes this file a
     // default part, so the redirect below can only name the character's
     // default part (small files); the character swap itself is untouched.
-    if (dm_costume_delay_redirect()) core_len = 0;
+    // 0249 (log-5b04d0b5): press ONLY an ordinary body file. 0246 pressed
+    // every file, so MarioHigh.szs became Mario.szs and the High loader
+    // looked MarioHigh.bfres up by name inside it -> NULL -> 0x6ad530
+    // (log-62 Mechanic, same class). A named form (High/Mechanic) keeps
+    // its own core by the rule below; a part-less non-body core (0216)
+    // has no slot counterpart at all; a part file (Head/Cap/Hand/...)
+    // is small, never the aborting SARC.
+    int delay_press = dm_costume_delay_presses(part, core, core_len);
+    if (delay_press) core_len = 0;
     // The overlay lives on the mount the game named (h_fs_MountRom attaches
     // DM_ROMFS_OVERLAY to the MountRom name, i.e. "content"); there is no
     // "rom" mount on device, so a lookup for a mount named "rom" finds
@@ -1008,10 +1032,12 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
     // A set value names the costume to force ("default" = the character's own
     // default part); unset follows the save, with the adapted-or-default rule.
     const char *slot = !strcmp(part, "Cap") ? cap : clothes;
-    // 0246: with the delayed redirect on, the slot is forced to "default"
-    // (with core_len forced to 0 above, the only candidate the redirect
-    // can name is the character's default part).
-    if (dm_costume_delay_redirect()) slot = "default";
+    // 0246/0249: with the delayed redirect pressing THIS file, the slot is
+    // forced to "default" (with core_len forced to 0 above, the only
+    // candidate the redirect can name is the character's default part).
+    // A file the gate did not press keeps its own slot (High/Mechanic keep
+    // the same-core rule, part files keep the pick).
+    if (delay_press) slot = "default";
     // 0218 (log-85) / 0220: the slot must never redirect a cap file to a
     // stock costume cap. The cap loader looks the cap model up by name
     // ("MarioCap") inside the cap file, like the High/Mechanic loaders
