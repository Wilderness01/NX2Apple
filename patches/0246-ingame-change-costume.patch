diff --git a/dm/ios/Sources/InGameCostumePicker.swift b/dm/ios/Sources/InGameCostumePicker.swift
new file mode 100644
index 0000000..bf90c92
--- /dev/null
+++ b/dm/ios/Sources/InGameCostumePicker.swift
@@ -0,0 +1,71 @@
+import SwiftUI
+import UIKit
+
+// The in-game costume picker (0246): the launcher's CharacterPickerView,
+// presented over the running game from the in-game menu's "换装" row
+// (GameMenu.swift -> dm_costume_open_picker()). A tap in the picker writes
+// DmCharSelect.* and pushes the pick to the host at once (Launcher.swift
+// select(): dm_char_select_apply_saved() + dm_costume_apply_now()); the host
+// applies the costume on the next presented frame (SaveData write +
+// ChangeClothes). A character change takes effect at the next kingdom
+// entry (the fs redirect reads the updated environment). Closing the
+// picker returns to the game; the launcher is untouched.
+//
+// Presentation follows HudPadEditor (dm_hud_pad_open_editor): main queue,
+// key window, modal over the root view controller. The scale formula is
+// the launcher's (Launcher.swift:1414).
+
+private var dmCostumePickerController: DmHostingController<InGameCostumePickerView>?
+
+/// GameMenu.swift calls this (C entry point, declared in DmGameMenu.h).
+func dm_costume_open_picker() {
+    DispatchQueue.main.async {
+        guard dmCostumePickerController == nil else { return }  // already open
+        var window: UIWindow?
+        for scene in UIApplication.shared.connectedScenes {
+            guard let ws = scene as? UIWindowScene else { continue }
+            if let w = ws.windows.first(where: { $0.isKeyWindow }) { window = w; break }
+        }
+        window = window ?? UIApplication.shared.keyWindow
+        guard let w = window, let root = w.rootViewController else { return }
+        let picker = DmHostingController(rootView: InGameCostumePickerView())
+        picker.modalPresentationStyle = .fullScreen
+        dmCostumePickerController = picker
+        root.present(picker, animated: true)
+    }
+}
+
+private struct InGameCostumePickerView: View {
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        GeometryReader { geo in
+            let scale = min(max(geo.size.width / 932, 0.5), 1.6)
+            ZStack {
+                // The game is behind the picker; a dim backdrop keeps the
+                // picker readable without hiding the game entirely.
+                Color.black.opacity(0.45).ignoresSafeArea()
+                VStack(spacing: 12) {
+                    HStack {
+                        Text("换装")
+                            .font(.system(size: 22, weight: .bold))
+                            .foregroundStyle(.white)
+                        Spacer()
+                        Button("完成") { dismiss() }
+                            .font(.system(size: 17, weight: .semibold))
+                            .foregroundStyle(.white)
+                            .padding(.horizontal, 16)
+                            .padding(.vertical, 8)
+                            .background(Color.white.opacity(0.15))
+                            .clipShape(Capsule())
+                    }
+                    .padding(.horizontal, 20)
+                    CharacterPickerView(scale: scale)
+                    Spacer()
+                }
+                .padding(.top, 16)
+            }
+        }
+        .onDisappear { dmCostumePickerController = nil }
+    }
+}
