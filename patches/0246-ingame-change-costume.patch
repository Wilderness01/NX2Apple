index 54be0ac..10e85ec 100644
--- a/dm/host/hle_cheats.c
+++ b/dm/host/hle_cheats.c
@@ -1605,7 +1605,427 @@
         }
         return;
     }
-    costume_override_write(obj);
+    // 0246: while a non-default costume pick is active, the pick is applied
+    // in-game (write + ChangeClothes), not at kingdom entry. Do not write
+    // it into SaveData here, or the next kingdom entry would load the big
+    // costume SARC into the FrameHeap and abort (0240 line) -- and the
+    // write would undo 0246's revert after every ChangeClothes.
+    if (!dm_costume_delay_redirect())
