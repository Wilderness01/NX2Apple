+    costume_write_buf(sd + COSTUME_BUF_CAP, rev_p, 1);
+    snprintf(g_0246_last_cap, sizeof g_0246_last_cap, "%s", g_0246_want_cap);
+    snprintf(g_0246_last_clo, sizeof g_0246_last_clo, "%s", g_0246_want_clo);
+    atomic_store(&g_0246_applied_scene, scene);
+    atomic_store(&g_0246_pending, 0);
