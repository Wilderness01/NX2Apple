+}
+
+// ---- 0246: in-game costume change (ChangeClothes message + SaveData write + delayed redirect) ----
+// The launcher pick (0226) only takes effect at kingdom entry, and a
+// non-default (big) costume SARC loaded there aborts in the FrameHeap
+// (0240 line: the allocator's grow virtual function aborts by design).
+// 0246 applies the pick AFTER entry, where the game changes costume by a
+// registry lookup with zero file opens (REPORT-0245-INGAME-CHANGE-WORKAROUND),
+// so no SARC is loaded and nothing aborts. The flow per pick is:
+//   (1) write the new names into the TRUE SaveData object's inline buffers
+//       (0226's write, but only after the object is pinned -- see below);
+//   (2) call the game's own send function 0x75cbd0(scene+0x10,
+//       "ChangeClothes", 0...) -- the trigger pinned by log-6a204394
+//       (run 2, 340 s: exactly 1 keeper MATCH, ChangeClothes FOUND in the
+//       handler table). The handler re-reads SaveData and applies the
+//       costume. Sending without writing re-applies the CURRENT costume.
+//   (3) revert SaveData to the names it held before the write, so the next
+//       kingdom entry loads the small default SARC, never the big one.
+// The pick is driven by the DM_CHAR_* environment (the launcher writes it
+// at startup, the in-game picker writes it on tap); the per-frame code
+// below derives the flag and the pending pick from it, so both places
+// agree and the latest pick wins. A CHARACTER pick (DM_CHAR_SELECT) is
+// not changed in-game -- it still applies at the next kingdom entry
+// through the fs redirect, which the delayed redirect leaves alone.
+// Fail-safes (every one returns without writing or calling, never a crash):
+// a missing scene, an unpinned SaveData, a handler table without
+// ChangeClothes (the send itself is a silent no-op then), a build-ID
+// mismatch. The host calls the game's own function with its own NULL
+// guards (0x75cbd0 returns silently on every NULL step, and zeroes s0
+// and x2-x7 itself before the tail-call, so a plain C call with
+// (scene+0x10, "ChangeClothes") is the whole convention).
+// What is NOT pinned (device run decides): whether the ChangeClothes
+// handler rebuilds the model safely on the Presentation Thread (the
+// present hook is where this runs). The allocator is locked and the
+// rebuild allocates a new model rather than mutating in place
+// (REPORT-0245-REBUILD), and the game's own shop change runs the same
+// code while rendering continues; if the device run shows otherwise,
+// the fallback is a rewriter cut on a main-thread per-frame function.
+#define INGAME_BUILD_ID      "de3a640000b0a200cced760001000000"  // NSO build id, first 16 bytes hex
+#define INGAME_SEND_MSG      0x75cbd0ull   // generic send-message function
+#define INGAME_CHANGE_STR    0xe6ec60ull   // "ChangeClothes" rodata string
+#define INGAME_SCENE_VT      0x12c4dc8ull  // StageScene main vtable
+#define INGAME_SLOT_LO       0x12c5d90ull  // first scene nerve slot (.data vaddr)
+#define INGAME_SLOT_HI       0x12c5f80ull  // end of the scene nerve-slot run (exclusive)
+#define INGAME_NERVE_LO      0x12c4ee8ull  // first scene nerve object
+#define INGAME_NERVE_HI      0x12c5d00ull  // end of the scene nerve-object run (exclusive)
+#define INGAME_CLOSET_OFF    0x188u        // [scene+0x188] = closet (stage init 0x46fbb4)
+#define INGAME_ENTRY_OFF     0x20u         // [closet+0x20] = "Closet" entry (ctor 0x47f268)
+#define INGAME_ENTRY_SCAN    0x200u        // qwords scanned in the entry for the SaveData pointer
+#define INGAME_SCAN_HIT_MAX  256           // slot-value hits collected per run
+#define INGAME_SCAN_CAND_MAX 512           // keeper candidates tested per run
+#define INGAME_STATE_MAX     0x1000000     // largest plausible keeper state
+
+static _Atomic int g_0246_delay_redirect;   // 1 while a non-default costume pick is active
+static _Atomic uint64_t g_0246_scene;       // pinned StageScene (0 = none)
+static _Atomic uint64_t g_0246_savedata;    // pinned SaveData object (0 = none)
+static _Atomic int g_0246_pending;          // a pick awaits write+trigger
+static _Atomic int g_0246_scan_started;     // the scene scan thread was started
+static _Atomic int g_0246_scan_running;     // a scene scan is running now
+static char g_0246_want_cap[64], g_0246_want_clo[64];   // the pick to apply
+static char g_0246_last_cap[64], g_0246_last_clo[64];   // the pick last applied
+static _Atomic uint64_t g_0246_applied_scene;  // the scene the pick was last applied to
+
+// The delayed-redirect flag, read by dm_char_redirect (hle_fs.c). 1 while a
+// non-default costume pick is active: the costume redirect is suppressed at
+// kingdom entry so the game loads the small default files.
+int dm_costume_delay_redirect(void) { return atomic_load(&g_0246_delay_redirect); }
+
+// Fixed addresses run only on the NSO build they were found in (house rule).
+static int ingame_build_ok(void) {
+    const char *bid = dm_main_build();
+    return bid && strncmp(bid, INGAME_BUILD_ID, 32) == 0;
+}
+
+// Scene validity, checked before every use of the pinned scene: the vtable
+// is the StageScene vtable, [scene+0x08] is the keeper, the keeper's owner
+// is this scene (bidirectional), both slots are scene nerve slots, and the
+// keeper tail is 0. A freed/reused scene fails the vtable or the owner
+// link, so a stale pin is never called through.
+static int ingame_scene_valid(uint64_t scene, uint64_t base) {
+    if (!scene || !base) return 0;
+    uint64_t vt = 0, keeper = 0, link = 0, cur = 0, nxt = 0, tail = 0;
+    if (mem_read(scene, 8, &vt) != 0 || vt != base + INGAME_SCENE_VT) return 0;
+    if (mem_read(scene + 0x08, 8, &keeper) != 0 || !keeper) return 0;
+    if (mem_read(keeper + 0x00, 8, &link) != 0 || link != scene) return 0;
+    if (mem_read(keeper + 0x08, 8, &cur) != 0) return 0;
+    if (mem_read(keeper + 0x10, 8, &nxt) != 0) return 0;
+    if (cur < base + INGAME_SLOT_LO || cur >= base + INGAME_SLOT_HI) return 0;
+    if (nxt < base + INGAME_SLOT_LO || nxt >= base + INGAME_SLOT_HI) return 0;
+    if (mem_read(keeper + 0x28, 8, &tail) != 0 || tail != 0) return 0;
+    return 1;
+}
+
+// Test one candidate keeper K against the scene-keeper signature (the
+// 0245-dump Stage 2, without the chain dump). Returns 1 on MATCH and
+// fills *owner with the scene.
+static int ingame_keeper_test(uint64_t k, uint64_t base, uint64_t hb, size_t hopen, uint64_t *owner) {
+    uint64_t v = 0, o = 0, cur = 0, nxt = 0, del = 0, tail = 0, link = 0;
+    int32_t state = 0;
+    *owner = 0;
+    if (mem_read(k + 0x00, 8, &o) != 0) return 0;
+    if (mem_read(k + 0x08, 8, &cur) != 0) return 0;
+    if (mem_read(k + 0x10, 8, &nxt) != 0) return 0;
+    if (mem_read(k + 0x18, 4, &v) != 0) return 0;
+    state = (int32_t)(uint32_t)v;
+    if (mem_read(k + 0x20, 8, &del) != 0) return 0;
+    if (mem_read(k + 0x28, 8, &tail) != 0) return 0;
+    if (!(o >= hb && hopen && o - hb < hopen)) return 0;   // owner-not-heap
+    if (mem_read(o + 0x08, 8, &link) != 0 || link != k) return 0;  // owner-link-mismatch
+    int cur_ok = 0, next_ok = 0;
+    uint64_t nerve = 0;
+    if (cur >= base + INGAME_SLOT_LO && cur < base + INGAME_SLOT_HI &&
+        mem_read(cur, 8, &nerve) == 0 &&
+        nerve >= base + INGAME_NERVE_LO && nerve < base + INGAME_NERVE_HI)
+        cur_ok = 1;
+    if (nxt >= base + INGAME_SLOT_LO && nxt < base + INGAME_SLOT_HI &&
+        mem_read(nxt, 8, &nerve) == 0 &&
+        nerve >= base + INGAME_NERVE_LO && nerve < base + INGAME_NERVE_HI)
+        next_ok = 1;
+    if (!cur_ok && !next_ok) return 0;
+    if (state != -1 && (state < 0 || state > INGAME_STATE_MAX)) return 0;
+    if (del != 0 && !(del >= hb && hopen && del - hb < hopen)) return 0;
+    if (tail != 0) return 0;
+    *owner = o;
+    return 1;
+}
+
+// One scene scan pass: walk the guest heap for scene nerve-slot values and
+// test the keeper candidates (the 0245-dump Stage 1+2). Returns the pinned
+// scene, or 0. The same chunk machine as the 0226 scans (1 MB chunks,
+// 15-byte overhang so a value straddling a boundary is still found).
+static uint64_t ingame_scene_scan(uint64_t base) {
+    uint64_t hb = 0; size_t hopen = 0;
+    dm_guest_heap_range(&hb, &hopen);
+    if (!hb || !hopen) return 0;
+    const size_t CH = 1u << 20, OV = 15;
+    uint8_t *chunk = malloc(CH + OV);
+    if (!chunk) return 0;
+    uint64_t hits[INGAME_SCAN_HIT_MAX];
+    int nhit = 0, total = 0;
+    uint64_t slo = base + INGAME_SLOT_LO, shi = base + INGAME_SLOT_HI;
+    for (size_t off = 0; off < hopen; off += CH) {
+        size_t n = hopen - off < CH ? hopen - off : CH;
+        size_t want = n + OV < hopen - off ? n + OV : hopen - off;
+        vm_size_t got = 0;
+        if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)want, (vm_address_t)(uintptr_t)chunk, &got) || got != want) {
+            if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)n, (vm_address_t)(uintptr_t)chunk, &got) || got != n)
+                continue;   // unmapped chunk (heap grew/shrank): skip it
+            want = n;
+        }
+        for (size_t i = 0; i + 8 <= want && i < n; i += 8) {
+            uint64_t val;
+            memcpy(&val, chunk + i, 8);
+            if (val >= slo && val < shi) {
+                total++;
+                if (nhit < INGAME_SCAN_HIT_MAX) hits[nhit++] = hb + off + i;
+            }
+        }
+    }
+    uint64_t seen[INGAME_SCAN_CAND_MAX];
+    int nseen = 0, matched = 0;
+    uint64_t scene = 0;
+    for (int i = 0; i < nhit && !scene; i++) {
+        for (int w = 0; w < 2 && !scene; w++) {
+            uint64_t k = hits[i] - (w == 0 ? 0x08u : 0x10u);
+            int dup = 0;
+            for (int j = 0; j < nseen; j++) if (seen[j] == k) { dup = 1; break; }
+            if (dup) continue;
+            if (nseen < INGAME_SCAN_CAND_MAX) seen[nseen++] = k;
+            uint64_t o = 0;
+            if (ingame_keeper_test(k, base, hb, hopen, &o)) {
+                matched++;
+                if (ingame_scene_valid(o, base)) scene = o;
+            }
+        }
+    }
+    LOG("[dm] 0246: scene scan: %d slot-value hit(s), %d keeper match(es)%s",
+        total, matched, scene ? "" : " (no scene pinned)");
+    if (scene)
+        LOG("[dm] 0246: scene pinned %#llx", (unsigned long long)scene);
+    free(chunk);
+    return scene;
+}
+
+// Background scene scan thread: re-scan every ~60 s while no scene is
+// pinned (or the pinned one went invalid, e.g. a kingdom change), so the
+// pick is applied in the new kingdom too. arg is the main module base.
+static void *ingame_scene_thread(void *arg) {
+    uint64_t base = (uint64_t)(uintptr_t)arg;
+    for (;;) {
+        uint64_t pinned = atomic_load(&g_0246_scene);
+        if (!pinned || !ingame_scene_valid(pinned, base)) {
+            uint64_t scene = ingame_scene_scan(base);
+            if (scene) atomic_store(&g_0246_scene, scene);
+        }
+        sleep(60);
+    }
+    return NULL;
+}
+
+static void ingame_scene_start(uint64_t base) {
+    if (atomic_load(&g_0246_scan_started)) return;
+    atomic_store(&g_0246_scan_started, 1);
+    pthread_t th; pthread_attr_t a; pthread_attr_init(&a); pthread_attr_setdetachstate(&a, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&th, &a, ingame_scene_thread, (void *)(uintptr_t)base)) {
+        LOG("[RED] 0246: cannot start scene scan thread");
+        atomic_store(&g_0246_scan_started, 0);
+    }
+    pthread_attr_destroy(&a);
+}
+
+// Collect the SaveData-shaped objects that pass the strict 0226 signature
+// for the given names (the heap walk of costume_heap_scan, but returning
+// the list instead of only a count, so the closet chain can pick among
+// them). Returns the number of full matches (0..max).
+static int ingame_savedata_candidates(const char *exp_c, const char *exp_p, uint64_t exp_vt,
+                                      uint64_t *out, int max) {
+    uint64_t hb = 0; size_t hopen = 0;
+    dm_guest_heap_range(&hb, &hopen);
+    if (!hb || !hopen) return -1;
+    const size_t CH = 1u << 20, OV = 15;
+    uint8_t *chunk = malloc(CH + OV);
+    if (!chunk) return -1;
+    uint64_t hits[2][COSTUME_HEAP_HIT_MAX];
+    int nhit[2] = { 0, 0 };
+    for (int s = 0; s < 2; s++) {
+        const char *name = s == 0 ? exp_c : exp_p; size_t nl = strlen(name);
+        for (size_t off = 0; off < hopen; off += CH) {
+            size_t n = hopen - off < CH ? hopen - off : CH;
+            size_t want = n + OV < hopen - off ? n + OV : hopen - off;
+            vm_size_t got = 0;
+            if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)want, (vm_address_t)(uintptr_t)chunk, &got) || got != want) {
+                if (vm_read_overwrite(mach_task_self(), (vm_address_t)(hb + off), (vm_size_t)n, (vm_address_t)(uintptr_t)chunk, &got) || got != n)
+                    continue;
+                want = n;
+            }
+            for (size_t i = 0; i + nl + 1 <= want && i < n; ) {
+                uint8_t *p = memchr(chunk + i, (unsigned char)name[0], want - i);
+                if (!p) break;
+                i = (size_t)(p - chunk);
+                if (i < n && i + nl + 1 <= want && !memcmp(p, name, nl) && p[nl] == 0) {
+                    if (nhit[s] < COSTUME_HEAP_HIT_MAX) hits[s][nhit[s]++] = hb + off + i;
+                    i += nl + 1;
+                } else i++;
+            }
+        }
+    }
+    int nmatch = 0;
+    uint64_t seen[2 * COSTUME_HEAP_HIT_MAX]; int nseen = 0;
+    for (int s = 0; s < 2; s++) {
+        for (int i = 0; i < nhit[s]; i++) {
+            uint64_t o = hits[s][i] - (s == 0 ? COSTUME_BUF_CLOTHES : COSTUME_BUF_CAP);
+            int dup = 0;
+            for (int k = 0; k < nseen; k++) if (seen[k] == o) { dup = 1; break; }
+            if (dup) continue;
+            if (nseen < 2 * COSTUME_HEAP_HIT_MAX) seen[nseen++] = o;
+            costume_fields_t f;
+            if (costume_object_test(o, exp_c, exp_p, exp_vt, &f) && nmatch < max)
+                out[nmatch++] = o;
+        }
+    }
+    free(chunk);
+    return nmatch;
+}
+
+// Pin the TRUE SaveData object. The 0226 heap scan alone yields 5 matches
+// when the current names are the defaults ("Mario"/"Mario": every
+// default-initialised SaveData-shaped object holds them), so it cannot
+// pick. The closet chain disambiguates: scene -> [scene+0x188] = closet
+// (stage init 0x46fbb4) -> [closet+0x20] = the "Closet" entry (ctor
+// 0x47f268) -> the entry holds a pointer to the SaveData the game's own
+// Wear getters read ([x0+0x20] in 0x4d67f0/0x4d6840). The entry's exact
+// field is UNPINNED, so instead of assuming an offset, the entry's qwords
+// are scanned for a pointer equal to one of the scan matches: exactly one
+// such candidate, passing the strict signature, is the SaveData. Anything
+// else (0 or >1) returns 0 and nothing is written.
+static uint64_t ingame_savedata_locate(uint64_t scene, uint64_t base, const char *exp_c, const char *exp_p) {
+    uint64_t g748 = 0;
+    if (mem_read(base + COSTUME_VT_GLOBAL, 8, &g748) != 0 || !g748) return 0;
+    uint64_t cands[8];
+    int n = ingame_savedata_candidates(exp_c, exp_p, g748 + 0x10, cands, 8);
+    if (n < 0) return 0;
+    if (n == 1) return cands[0];
+    if (n == 0) return 0;
+    if (!ingame_scene_valid(scene, base)) return 0;
+    uint64_t closet = 0, entry = 0;
+    if (mem_read(scene + INGAME_CLOSET_OFF, 8, &closet) != 0 || !closet) return 0;
+    if (mem_read(closet + INGAME_ENTRY_OFF, 8, &entry) != 0 || !entry) return 0;
+    uint64_t found = 0; int nfound = 0;
+    for (size_t off = 0; off < INGAME_ENTRY_SCAN; off += 8) {
+        uint64_t q = 0;
+        if (guest_page_read(entry + off, (uint8_t *)&q, 8) != 0) break;
+        for (int i = 0; i < n; i++)
+            if (q == cands[i]) { nfound++; found = cands[i]; }
+    }
+    if (nfound != 1) {
+        LOG("[dm] 0246: SaveData locate: %d scan match(es), closet chain matched %d -- not writing", n, nfound);
+        return 0;
+    }
+    LOG("[dm] 0246: SaveData pinned %#llx via the closet chain (%d scan match(es))",
+        (unsigned long long)found, n);
+    return found;
+}
+
+// The host immediate-apply entry, called from Swift (GameMenu / the in-game
+// picker) after the tap writes UserDefaults and setenv's DM_CHAR_*.
+// It only arms the pick; the write+trigger runs on the next presented
+// frame, where the scene and the SaveData are verified first.
+void dm_costume_apply_now(void) {
+    if (!ingame_build_ok()) return;
+    char cap[64], clo[64];
+    if (!costume_pick_target(getenv("DM_CHAR_CAP"), 1, cap, sizeof cap)) cap[0] = 0;
+    if (!costume_pick_target(getenv("DM_CHAR_CLOTHES"), 0, clo, sizeof clo)) clo[0] = 0;
+    if (!cap[0] && !clo[0]) return;   // no pick: follow the save
+    if (!cap[0]) snprintf(cap, sizeof cap, "Mario");
+    if (!clo[0]) snprintf(clo, sizeof clo, "Mario");
+    snprintf(g_0246_want_cap, sizeof g_0246_want_cap, "%s", cap);
+    snprintf(g_0246_want_clo, sizeof g_0246_want_clo, "%s", clo);
+    int nondefault = strcmp(cap, "Mario") != 0 || strcmp(clo, "Mario") != 0;
+    atomic_store(&g_0246_delay_redirect, nondefault ? 1 : 0);
+    atomic_store(&g_0246_pending, 1);
+}
+
+// Per presented frame: derive the flag and the pending pick from the
+// DM_CHAR_* environment (so the launcher pick, set at startup, is picked
+// up too), then, when a pick is pending, write it into SaveData, send
+// ChangeClothes, and revert SaveData. Runs for Odyssey only.
+static void ingame_change_present(void) {
+    int smo = atomic_load(&g_costume_smo);
+    if (smo < 0) {
+        smo = dm_profile() && dm_profile()->program_id == COSTUME_SMO_PROGRAM ? 1 : 0;
+        atomic_store(&g_costume_smo, smo);
+        if (!smo) return;
+    } else if (!smo) return;
+    if (!ingame_build_ok()) return;
+    uint64_t base = 0;
+    if (g_main_mod) base = (uint64_t)(uintptr_t)g_main_mod->base;
+    if (!base) return;
+    static uint64_t frame;
+    frame++;
+    if (frame >= COSTUME_FRAME_BACKSTOP) ingame_scene_start(base);
+    // Derive the pick from the environment every frame: the launcher pick
+    // (set at startup) and the in-game pick (set on tap) both flow here.
+    char cap[64], clo[64];
+    int has_cap = costume_pick_target(getenv("DM_CHAR_CAP"), 1, cap, sizeof cap);
+    int has_clo = costume_pick_target(getenv("DM_CHAR_CLOTHES"), 0, clo, sizeof clo);
+    int nondefault = (has_cap && strcmp(cap, "Mario") != 0) || (has_clo && strcmp(clo, "Mario") != 0);
+    atomic_store(&g_0246_delay_redirect, nondefault ? 1 : 0);
+    if (nondefault) {
+        if (!has_cap) snprintf(cap, sizeof cap, "Mario");
+        if (!has_clo) snprintf(clo, sizeof clo, "Mario");
+        uint64_t scene = atomic_load(&g_0246_scene);
+        // Re-arm when the pick changed, or when the scene changed (a new
+        // kingdom loads the default costume, so the pick must be applied
+        // again there), or when the Swift tap armed it explicitly.
+        int changed = strcmp(cap, g_0246_last_cap) != 0 || strcmp(clo, g_0246_last_clo) != 0;
+        int new_scene = scene && scene != atomic_load(&g_0246_applied_scene);
+        if (changed || new_scene || atomic_load(&g_0246_pending)) {
+            snprintf(g_0246_want_cap, sizeof g_0246_want_cap, "%s", cap);
+            snprintf(g_0246_want_clo, sizeof g_0246_want_clo, "%s", clo);
+            atomic_store(&g_0246_pending, 1);
+        }
+    }
+    if (!atomic_load(&g_0246_pending)) return;
+    uint64_t scene = atomic_load(&g_0246_scene);
+    if (!ingame_scene_valid(scene, base)) { atomic_store(&g_0246_pending, 0); return; }
+    // The SaveData object, pinned once per session (it does not move).
+    uint64_t sd = atomic_load(&g_0246_savedata);
+    if (!sd) {
+        // The current in-memory names are the revert target's source: read
+        // them from the save file when available, else from the env default.
+        char cur_c[64], cur_p[64];
+        if (!costume_save_read(cur_p, sizeof cur_p, cur_c, sizeof cur_c)) {
+            snprintf(cur_c, sizeof cur_c, "Mario");
+            snprintf(cur_p, sizeof cur_p, "Mario");
+        }
+        sd = ingame_savedata_locate(scene, base, cur_c, cur_p);
+        if (!sd) { atomic_store(&g_0246_pending, 0); return; }
