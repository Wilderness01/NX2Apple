From e947faa75c20ea409331047381fef0fd2c8d540a Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Fri, 13 Nov 2026 00:46:02 +0000
Subject: [PATCH 1/2] 0126: HUD edge anchor slots 8 -> 16 per element (fix
 V1.3.16 drift)

log-20 shows TEN panes matching coins (two TxtCounterSh + two TxtCounter
+ two PicIconSh + two PicIcon + two TxtTotalShine, two Counter groups);
eight slots thrashed, so a reclaimed slot re-derived the original matrix
from an already-modified one and the offset drifted -140/frame until the
coin numbers 0904/023 were off-screen (V1.3.16, log-32). Sixteen slots
give every observed pane its own entry. Host test section K reproduces
the drift on 8 slots (second TxtCounterSh/TxtCounter reach -4100 after
30 frames) and passes on 16.
---
 dm/games/0100000000010000/hud_edge.c | 14 +++---
 dm/games/0100000000010000/patches.py | 72 ++++++++++++++--------------
 2 files changed, 43 insertions(+), 43 deletions(-)

diff --git a/dm/games/0100000000010000/hud_edge.c b/dm/games/0100000000010000/hud_edge.c
index 3166e84..42fb47e 100644
--- a/dm/games/0100000000010000/hud_edge.c
+++ b/dm/games/0100000000010000/hud_edge.c
@@ -1,4 +1,4 @@
-// hud_edge.c -- Super Mario Odyssey HUD edge anchor + launcher manual settings (0118 + 0119 + 0120 + 0123).
+// hud_edge.c -- Super Mario Odyssey HUD edge anchor + launcher manual settings (0118 + 0119 + 0120 + 0123 + 0126).
 //
 // The game's HUD (coins, moons, compass, lives, hints) is laid out for a 1280x720
 // (16:9) screen, so on a wider screen (iPhone 19.5:9) it sits inset from the
@@ -58,7 +58,7 @@
 // it never reads a pane name and never decides a match.
 //
 // A moved pane's original matrix is stored in a small table (state +0x300,
-// 40 128-byte entries, eight per element -- up to eight layout instances can
+// 80 128-byte entries, sixteen per element -- up to sixteen layout instances can
 // match the same element) and the modified matrix is always re-derived from that
 // original, so a fixed offset never accumulates into a drift, and a game
 // recompute (an animation, a count change, a layout reload) is followed by
@@ -132,7 +132,7 @@ typedef unsigned long uintptr_t;
 
 #define HUD_EDGE_N 5
 #define HUD_EDGE_ENTRY 128         // bytes per table entry
-#define HUD_EDGE_SLOTS_PER_ELEM 8  // table slots per HUD element: up to eight layout instances can match the same element (log-28 shows two TxtCounterSh + two TxtCounter matching coins; two slots thrashed and the re-init re-derived the original from an already-modified matrix, so the offset drifted off-screen -- 0120)
+#define HUD_EDGE_SLOTS_PER_ELEM 16  // table slots per HUD element: up to sixteen layout instances can match the same element (log-20 shows TEN panes matching coins -- 2x TxtCounterSh + 2x TxtCounter + 2x PicIconSh + 2x PicIcon + 2x TxtTotalShine, two Counter groups; eight slots thrashed and the re-init re-derived the original from an already-modified matrix, so the offset drifted off-screen -- 0126; 0120 raised it 2 -> 8 for the four number panes alone)
 
 // The manual settings block (state +0x200), as the host writes it.
 #define HUD_MANUAL_FLOATS 15       // dx, dy, k per element (5 elements)
@@ -262,7 +262,7 @@ static inline __attribute__((always_inline)) void hud_edge_xform(const float *or
     hud_edge_xform_c(orig, mod, dx, dy, sx, sy, cx, cy);
 }
 
-// Find the table entry for a pane (a linear scan over the whole table: 40
+// Find the table entry for a pane (a linear scan over the whole table: 80
 // entries, no pointer chasing). Returns 0 when the pane has no entry (it
 // was never matched, or its slot was reclaimed).
 static inline __attribute__((always_inline)) char *hud_edge_find_entry(void *table, void *pane) {
@@ -544,9 +544,9 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // hud_edge_unparent -- so the original is the layout's own matrix and
     // does not depend on what the parent did), the modified matrix (the
     // original + this transform), and the transform the modified matrix was
-    // computed from. Eight slots per element (idx + s * HUD_EDGE_N): up to
-    // eight layout instances can match the same element, and one slot per
-    // element cannot hold them all (0120). The stored transform is compared
+    // computed from. Sixteen slots per element (idx + s * HUD_EDGE_N): up to
+    // sixteen layout instances can match the same element, and one slot per
+    // element cannot hold them all (0120, 0126). The stored transform is compared
     // against the target below, so a settings change or an aspect change
     // re-applies instead of being ignored, and a manual element is not
     // re-derived from the automatic offset.
