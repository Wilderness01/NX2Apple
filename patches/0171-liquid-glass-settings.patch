+/// A leading icon for a menu row (0171): by the setting's env key, so the icon matches what the row does. Rows without a mapping get none. SF Symbols; the menu draws them in its own tint, and a toggle's checkmark is the system's (on iOS 26 it shares the leading slot — see the report's device check).
+private func gameMenuRowIcon(_ env: String) -> UIImage? {
+    switch env {
+    case "DM_RUMBLE": return UIImage(systemName: "iphone.radiowaves.left.and.right")   // Game rumble
+    case "DM_TOUCH_HAPTICS": return UIImage(systemName: "hand.tap")   // Touch feedback
+    case "DM_SHOW_FPS": return UIImage(systemName: "speedometer")   // Frame-rate counter
+    case "DM_PICTURE_FIT": return UIImage(systemName: "photo")   // Picture: fill or fit
+    case "DM_OPMODE": return UIImage(systemName: "tv")   // Console mode: docked is the TV
+    case "DM_SCREEN_ASPECT": return UIImage(systemName: "aspectratio")   // Picture shape
+    case "DM_PRESENT_UPSCALE": return UIImage(systemName: "sparkles")   // Upscaling
+    case "DM_LANG": return UIImage(systemName: "globe")   // Game language
+    default: return nil
+    }
+}
+
 private func gameMenuRow(_ m: LauncherModel, _ s: Setting) -> UIMenuElement {
     let now = m.values[s.env] ?? s.def, fixed = m.fixed.contains(s.env)
     let attributes: UIMenuElement.Attributes = fixed ? .disabled : []
     func pick(_ v: String) { m.choose(s, v); _ = dm_setting_live(s.env, v) }
     if s.kind == "toggle" {
-        let a = UIAction(title: s.label, attributes: attributes, state: now == s.onValue ? .on : .off) { _ in pick(now == s.onValue ? s.offValue : s.onValue) }
+        let a = UIAction(title: s.label, image: gameMenuRowIcon(s.env), attributes: attributes, state: now == s.onValue ? .on : .off) { _ in pick(now == s.onValue ? s.offValue : s.onValue) }
         if fixed { a.subtitle = LauncherText.text("ui.setInEnvTxt", "Set in env.txt") }
         return a
     }
     let options = s.options ?? []
     let current = options.first { $0[0] == now }?[1] ?? now
     let actions = options.map { o in UIAction(title: o[1], attributes: attributes, state: o[0] == now ? .on : .off) { _ in pick(o[0]) } }
-    return UIMenu(title: s.label, subtitle: fixed ? "\(current), \(LauncherText.text("ui.setInEnvTxtInline", "set in env.txt"))" : nil, options: .singleSelection, children: actions)
+    return UIMenu(title: s.label, subtitle: fixed ? "\(current), \(LauncherText.text("ui.setInEnvTxtInline", "set in env.txt"))" : nil, image: gameMenuRowIcon(s.env), options: .singleSelection, children: actions)
 }
diff --git a/dm/ios/Sources/Launcher.swift b/dm/ios/Sources/Launcher.swift
