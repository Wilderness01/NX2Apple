-                        HStack {
-                            Button(action: { selected = el }) {
-                                HStack {
-                                    Text(el.name)
-                                    Spacer()
-                                    Text(statusLine(el))
-                                        .font(.subheadline)
-                                        .foregroundStyle(.secondary)
-                                    if selected == el {
-                                        Image(systemName: "checkmark")
-                                            .foregroundStyle(.blue)
+            GeometryReader { outer in
+                let preview = previewSize(container: outer.size)
+                ScrollView {
+                    VStack(alignment: .leading, spacing: 16) {
+                        // The preview: a dark backdrop (the game is behind the
+                        // sheet) with the five elements on it, draggable.
+                        GeometryReader { geo in
+                            let pv = geo.size
+                            let unit = pv.width / 100
+                            let sizes = HudElement.allCases.reduce(into: [HudElement: CGSize]()) { m, el in
+                                m[el] = HudElement.previewSize(el, k: settings.effective(el)?.k ?? 1, unit: unit)
+                            }
+                            ZStack {
+                                Color(red: 0.08, green: 0.10, blue: 0.09)
+                                ForEach(HudElement.displayOrder) { el in
+                                    let s = settings.effective(el)
+                                    let hidden = s?.hidden == true
+                                    let frame = elementFrame(el, preview: pv, sizes: sizes)
+                                    HudElementPreview(el: el, k: s?.k ?? 1, unit: unit)
+                                        .opacity(hidden ? 0.38 : 1)
+                                        .saturation(hidden ? 0.35 : 1)
+                                        .overlay {
+                                            if selected == el {
+                                                RoundedRectangle(cornerRadius: 8)
+                                                    .stroke(Color.white.opacity(0.85), lineWidth: 2)
+                                                    .padding(-1.5)
+                                            }
+                                        }
+                                        .position(x: frame.midX, y: frame.midY)
+                                        .offset(el == selected ? dragOffset : .zero)
+                                        .onTapGesture { selected = el }
+                                        .gesture(
+                                            DragGesture().onChanged { v in
+                                                selected = el; dragOffset = v.translation
+                                            }.onEnded { v in
+                                                let scX = 1280 / max(1, pv.width)
+                                                let scY = 720 / max(1, pv.height)
+                                                var n = cur(el)
+                                                n.dx += Double(v.translation.width) * scX
+                                                n.dy -= Double(v.translation.height) * scY
+                                                update(el, n)
+                                                dragOffset = .zero
+                                            }
+                                        )
+                                }
+                            }
+                            .clipShape(RoundedRectangle(cornerRadius: 18))
+                        }
+                        .frame(width: preview.width, height: preview.height)
+                        .frame(maxWidth: .infinity)
+                        // The selected element: tap a chip to pick it, then the
+                        // size slider, the eye toggle and the per-element reset.
+                        HStack(spacing: 8) {
+                            ForEach(HudElement.displayOrder) { el in
+                                Button(action: { selected = el }) {
+                                    HStack(spacing: 4) {
+                                        Text(el.name).font(.system(size: 13, weight: .semibold))
+                                        Image(systemName: cur(el).hidden ? "eye.slash" : "eye")
+                                            .font(.system(size: 11))
+                                            .foregroundStyle(cur(el).hidden ? .red : .blue)
                                     }
+                                    .padding(.horizontal, 10).padding(.vertical, 6)
+                                    .background(selected == el ? Color.blue.opacity(0.18) : Color.secondary.opacity(0.12))
+                                    .cornerRadius(8)
+                                }
+                                .buttonStyle(.plain)
+                            }
+                        }
+                        .frame(maxWidth: .infinity)
+                        VStack(alignment: .leading, spacing: 12) {
+                            let s = cur(selected)
+                            HStack {
+                                Text("大小")
+                                Slider(value: Binding(
+                                    get: { s.k },
+                                    set: { v in var n = s; n.k = v; update(selected, n) }
+                                ), in: 0.6...1.8, step: 0.05)
+                                Text("\(Int(s.k * 100))%").frame(width: 52, alignment: .trailing)
+                            }
+                            HStack {
+                                Text(statusLine(selected))
+                                    .font(.subheadline).foregroundStyle(.secondary)
+                                Spacer()
+                                Button(action: {
+                                    var n = cur(selected); n.hidden.toggle(); update(selected, n)
+                                }) {
+                                    Label(cur(selected).hidden ? "显示" : "隐藏", systemImage: cur(selected).hidden ? "eye" : "eye.slash")
                                 }
+                                .buttonStyle(.plain)
+                                Button("恢复 \(selected.name) 默认") {
+                                    settings.set(selected, nil)
+                                    settings.applyOneToEnvironment(selected)
+                                }
+                                .foregroundStyle(.red)
                             }
