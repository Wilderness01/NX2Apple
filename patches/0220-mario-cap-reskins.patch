diff --git a/dm/host/hle_fs.c b/dm/host/hle_fs.c
index 9c83caa..970cd97 100644
--- a/dm/host/hle_fs.c
+++ b/dm/host/hle_fs.c
@@ -990,19 +990,24 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
     // A set value names the costume to force ("default" = the character's own
     // default part); unset follows the save, with the adapted-or-default rule.
     const char *slot = !strcmp(part, "Cap") ? cap : clothes;
-    // 0218 (log-85): the slot must not apply to cap files. The cap loader
-    // looks the cap model up by name ("MarioCap") inside the cap file, like
-    // the High/Mechanic loaders (log-60/62). Every costume cap's FMDL is
-    // named after itself (MarioClownCap, MarioHarietCap, ...) and costume
-    // caps lack the CheckpointFlagWarp bymls the original MarioCap.szs has,
-    // so a slot redirect makes the lookup return NULL, the cap sub-object
-    // at [x21+0x50] is never created, and the checkpoint-warp parameter
-    // copy faults on NULL+8 at main+0x66d6d8 (log-84/85, same pc). The
-    // character's own cap files (PeachCap/CityMayorCap/ToadCap in the
-    // overlay) ARE safe -- their FMDL is "MarioCap" with the full byml
-    // set -- so the character swap (ch + "Cap", built by the else branch
-    // below) must keep working; only the slot is disabled here.
-    if (!strcmp(part, "Cap")) slot = NULL;
+    // 0218 (log-85) / 0220: the slot must never redirect a cap file to a
+    // stock costume cap. The cap loader looks the cap model up by name
+    // ("MarioCap") inside the cap file, like the High/Mechanic loaders
+    // (log-60/62). Every costume cap's FMDL is named after itself
+    // (MarioClownCap, MarioHarietCap, ...) and costume caps lack the
+    // CheckpointFlagWarp bymls the original MarioCap.szs has, so a slot
+    // redirect makes the lookup return NULL, the cap sub-object at
+    // [x21+0x50] is never created, and the checkpoint-warp parameter copy
+    // faults on NULL+8 at main+0x66d6d8 (log-84/85, same pc). 0220 restores
+    // the pick by mapping the cap slot to a MarioCap reskin (one per
+    // launcher cap, named <Cap>R -- e.g. MarioClownCapR.szs -- FMDL
+    // "MarioCap" with the full byml set) in the base-file branch below;
+    // the is_family branch still takes no slot candidate for Cap (the
+    // loader asks for the costume cap name by name there, so ANY redirect
+    // is broken). The character's own cap files (PeachCap/CityMayorCap/
+    // ToadCap in the overlay) ARE safe -- their FMDL is "MarioCap" with
+    // the full byml set -- so the character swap (ch + "Cap") keeps
+    // working.
     char cand[2][256];
     int ncand = 0;
     if (is_family) {
@@ -1027,7 +1032,13 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
         // loop below skips a candidate that names the file already asked
         // for (for Mario the same core IS that file), and accepts a target
         // the mount's image holds as well as the overlay.
-        if (!is_named_form) {
+        // 0218 (log-85): no slot candidate for a costume cap file. The
+        // cap loader asks for the costume cap's own name by name
+        // ("MarioExplorerCap"), so ANY redirect to a different cap file
+        // is broken here; the same-core fallback below still applies
+        // (for Mario it names the file already asked for and is skipped,
+        // so the file is kept).
+        if (!is_named_form && strcmp(part, "Cap")) {
             if (slot && !strncmp(slot, "Mario", 5) && slot[5]) {
                 snprintf(cand[ncand], sizeof cand[0], "%s%s%s", ch, slot + 5, part); ncand++;
             } else if (slot && !strcmp(slot, "default")) {
@@ -1038,7 +1049,20 @@ static int dm_char_redirect(const char *p, char *out, size_t n) {
     } else if (slot && !strcmp(slot, "default")) {
         snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
     } else if (slot && !strncmp(slot, "Mario", 5) && slot[5]) {
-        snprintf(cand[ncand], sizeof cand[0], "%s%s%s", ch, slot + 5, part); ncand++;
+        // 0220: a cap slot maps to the MarioCap reskin (<Cap>R, e.g.
+        // MarioClownCapR.szs), NOT to the stock costume cap -- the reskin
+        // is the file that contains a "MarioCap" model with the full
+        // CheckpointFlagWarp byml set. The reskin lives under a distinct
+        // name so the direct save-equipped path (which asks for
+        // MarioClownCap.szs by name) still loads the RomFS original. If
+        // the reskin is not found, the next candidate is the character
+        // default ("MarioCap" for Mario = the stem, self-skipped), so the
+        // file is kept -- the 0218 behavior, never a crash.
+        if (!strcmp(part, "Cap"))
+            snprintf(cand[ncand], sizeof cand[0], "%s%s%sR", ch, slot + 5, part);
+        else
+            snprintf(cand[ncand], sizeof cand[0], "%s%s%s", ch, slot + 5, part);
+        ncand++;
         snprintf(cand[ncand], sizeof cand[0], "%s%s", ch, part); ncand++;
     } else if (core_len) {
         snprintf(cand[ncand], sizeof cand[0], "%s%.*s%s", ch, (int)core_len, core, part); ncand++;
