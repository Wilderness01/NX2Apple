From: seedds <seedds@gmail.com>
Date: Mon, 16 Nov 2026 03:00:23 +0000
Subject: [PATCH] 0152: shrink the self-guard window 0x100 -> 0x20 so the four
 counters match; log every match and skip to the probe buffer

---
 dm/games/0100000000010000/hud_runtime.c | 339 +++++++++++++++++++++++-
 dm/games/0100000000010000/patches.py    | 168 +++++++-----
 2 files changed, 432 insertions(+), 75 deletions(-)

diff --git a/dm/games/0100000000010000/hud_runtime.c b/dm/games/0100000000010000/hud_runtime.c
index 8dcc218..c057e48 100644
--- a/dm/games/0100000000010000/hud_runtime.c
+++ b/dm/games/0100000000010000/hud_runtime.c
@@ -1,4 +1,12 @@
-// hud_runtime.c -- Super Mario Odyssey in-game HUD editor runtime (0137 + 0142 + 0147).
+// hud_runtime.c -- Super Mario Odyssey in-game HUD editor runtime (0137 + 0142 + 0147 + 0152).
+// (0152) The 0x100 self-guard window is 0x20 (see hud_edge_child_self):
+// the loader allocates a layout's panes consecutively in .bflyt file
+// order, ~0xe0 apart, so a child one pane after its parent was skipped
+// as "self" and the matcher never matched the four counters (#67
+// no-change, REPORT-HUD-67-NOCHANGE.md R1). This file also logs every
+// match and skip into the probe buffer (state +0x3300) when the host
+// enables it (DM_HUD_PROBE=1), so one device test shows exactly what the
+// matcher did -- see the (0152) block before hud_edge.
 // (History: this file started as a copy of hud_edge.c, the 0118 HUD edge anchor;
 // the 0118 auto-edge code is deleted -- the edge anchor now lives in the
 // 0136/0143 .bflyt overlay, and this file applies ONLY manual deltas.)
@@ -417,16 +425,28 @@ static inline __attribute__((always_inline)) char *hud_edge_find_entry(void *tab
 //  (b) a list node is checked (non-NULL, 8-byte aligned, >= 0x10000) before
 //      child = node - 8 is computed from it;
 //  (c) a child that is the pane itself, or lies inside the pane's own
-//      first 0x100 bytes, is never treated as a pane.
+//      first 0x20 bytes, is never treated as a pane.
 static inline __attribute__((always_inline)) int hud_edge_node_ok(void *node) {
     uintptr_t v = (uintptr_t)node;
     return v != 0 && (v & 7u) == 0 && v >= 0x10000;
 }
 
+// (0152) The window is 0x20, not 0x100: a real child pane can never live
+// within 0x20 bytes after its parent -- the Pane struct alone is >=0xd0
+// bytes (its name ends at +0xd0) -- so the only "self" a child can be is
+// the pane itself (offset 0, caught by the child == p check above). The
+// 0x100 window was the #67 no-change bug (REPORT-HUD-67-NOCHANGE.md R1):
+// the loader allocates a layout's panes consecutively in .bflyt file
+// order, ~0xe0 bytes apart, so a child one pane after its parent (Life /
+// Add / Shine, one pane after All in CounterLife / CounterCoin /
+// CounterCollectCoin / CounterShine) sat at parent+~0xe0 < parent+0x100
+// and was skipped as "self" -- the matcher never matched the four
+// counters, so all three cuts no-op'd for them, while the compass's
+// PicMap (two panes after All, ~0x1c0) escaped the window and worked.
 static inline __attribute__((always_inline)) int hud_edge_child_self(void *p, void *child) {
     if (child == p) return 1;
     if ((uintptr_t)child <= (uintptr_t)p) return 0;
-    return (uintptr_t)child - (uintptr_t)p < 0x100;
+    return (uintptr_t)child - (uintptr_t)p < 0x20;
 }
 
 // The DFS stack: ONE array of {pane, depth} entries (the v8 fix for the
@@ -560,6 +580,203 @@ static inline __attribute__((always_inline)) int hud_edge_capture_tx(void *pane,
     return 0;
 }
 
+// (0152) Per-element diagnostic logging, through the existing probe
+// buffer (hud_probe.c / hud_manual.c dm_hud_probe_tick): the runtime
+// writes 96-byte records into the frame-step state page at +0x3300 and
+// the host drains them once per present into "[hudprobe] ..." log lines.
+// The runtime never calls LOG/fprintf -- it is compiled freestanding
+// into a relocation-free word table -- so the probe buffer is the ONLY
+// path for runtime data to reach the device log. Gated by the host's
+// enabled flag (DM_HUD_PROBE=1, set by dm_hud_probe_tick every present;
+// the flag is 0 until the first present, so a first-frame match is logged
+// one frame late, not lost -- see the retry flag below).
+// Buffer layout (hud_probe.c): 32-byte header (magic "PRBE" 0x50524245
+// at +0, enabled at +4, rec_count at +8, seen_count at +12,
+// aspect_logged at +16, rec_cap at +20, seen_cap at +24), seen-table
+// 256 x u64 at +32, record buffer 13 x 96 bytes at +2080. A record:
+// type +0 (u32), addr lo/hi +4/+8, name +12 (char[20]), pname +32
+// (char[20]), v0..v6 +52..+76 (7 floats), w0..w3 +80..+92 (4 u32s).
+// Match records reuse type 1 (edge-decision), skip records type 0
+// (pane), so the existing drain prints them with no host change -- but
+// the drain's labels for v3/v4 and w3 are repurposed here (documented
+// below); read the values, not the labels.
+//   type 1 (match): name = the pane name ("All"); v0=tdx, v1=tdy,
+//     v2=tk; v3=final local x (+0x30 after the write), v4=final local y
+//     (+0x34 after the write); v5=final global m[3], v6=final global
+//     m[7]; w0=idx, w1=slot, w2=hidden; w3 bits: bit0 = the pane's +0xa0
+//     was NULL, bit1 = e_lm0 was captured, bit2 = this is a restore
+//     (the pane was written back to its original) rather than an apply.
+//     (The drain prints v3/v4 as pm_dx/pm_dy and w3 as
+//     parent_hidden/has_parent/pm_sentinel; those labels are wrong for
+//     this record -- the parent compensation is always 0 for a HUD All,
+//     its parent being an unmatched RootPane, so nothing is lost.)
+//   type 0 (skip): name = the pane name ("All"); pname = the first two
+//     child names joined by '/' for a matcher miss (the drain prints it
+//     as parent='...'), or the parent name for a bit-7 skip; v0/v1 = 0,
+//     v2=local tx, v3=local ty, v4=global m[3], v5=global m[7];
+//     w0 = the skip reason (1 = bit-7 guard, 2 = no match), w1 = the
+//     pane flags (+0x58), w2/w3 = the parent address lo/hi.
+// Logging is ON CHANGE only (first match, value change, hide/show
+// transition, first sighting of a skip), never every frame: a match is
+// logged once, when the write block runs, and the entry's e_orig[8]
+// (a slot the local never uses, zeroed on first sighting) records
+// whether it was logged (1.0 = logged, 0.0 = still owed); the early
+// return below does not fire while a log is owed and logging is on, so
+// a pending log forces a re-run of the write block (an idempotent
+// re-write) while logging is on, and the fast path is unchanged when
+// logging is off. A skip is logged once per pane (the seen-table, keyed
+// by pane address, dedups it). Hot-path cost when logging is off: one
+// branch per call (the enabled-flag load in hud_log_begin). No
+// allocation: the records go to the pre-allocated state-page buffer.
+// All probe-buffer accesses are volatile (shared with the host; also
+// prevents literal-pool loads, as in hud_probe.c).
+#define HUD_LOG_MAGIC 0x50524245u   // "PRBE"
+#define HUD_LOG_REC_CAP 13
+#define HUD_LOG_REC_SIZE 96
+#define HUD_LOG_SEEN_CAP 256
+#define HUD_LOG_SEEN_OFF 32
+#define HUD_LOG_REC_OFF 2080
+#define HUD_LOG_REC_MATCH 1   // match record (edge-decision)
+#define HUD_LOG_REC_SKIP 0    // skip record (pane)
+#define HUD_LOG_SKIP_BIT7 1
+#define HUD_LOG_SKIP_NOMATCH 2
+// e_orig[8]: 1.0 once this entry's current match has been logged,
+// 0.0 while a log is still owed (a free slot: the local never reads
+// [8..11], they are zeroed on first sighting).
+#define HUD_LOG_DONE_SLOT 8
+
+// The probe buffer for this table (table + 0x3000 = state + 0x3300).
+// Returns 0 when the probe is not enabled, so the caller logs nothing.
+// Initialises the header when the magic is absent (the state page starts
+// zeroed); the enabled word is never written here -- the host owns it.
+static inline __attribute__((always_inline)) volatile char *hud_log_begin(void *table) {
+    volatile char *pb = (volatile char *)table + 0x3000;
+    volatile u32 *hdr = (volatile u32 *)pb;
+    if (hdr[0] != HUD_LOG_MAGIC) {
+        hdr[0] = HUD_LOG_MAGIC;
+        hdr[2] = 0;
+        hdr[3] = 0;
+        hdr[4] = 0;
+        hdr[5] = HUD_LOG_REC_CAP;
+        hdr[6] = HUD_LOG_SEEN_CAP;
+        hdr[7] = 0;
+    }
+    if (hdr[1] != 1) return 0;
+    return pb;
+}
+// Mark a pane as seen (the skip dedup). Returns 1 when the pane is newly
+// added (the caller should log it), 0 when it was already seen or the
+// seen-table is full.
+static inline __attribute__((always_inline)) int hud_log_mark_seen(volatile char *pb, void *pane) {
+    volatile u32 *hdr = (volatile u32 *)pb;
+    volatile uintptr_t *seen = (volatile uintptr_t *)(pb + HUD_LOG_SEEN_OFF);
+    u32 sc = hdr[3];
+    for (u32 i = 0; i < sc; i++) {
+        if (seen[i] == (uintptr_t)pane) return 0;
+    }
+    if (sc >= HUD_LOG_SEEN_CAP) return 0;
+    seen[sc] = (uintptr_t)pane;
+    hdr[3] = sc + 1;
+    return 1;
+}
+// Copy a pane name (a C string) into dst, at most max-1 chars, always
+// NUL-terminated. Same as hud_probe.c's hud_probe_copy_name.
+static inline __attribute__((always_inline)) void hud_log_copy_name(volatile char *dst, const char *src, int max) {
+    int i = 0;
+    if (src) {
+        for (; i < max - 1; i++) {
+            char c = src[i];
+            if (c == 0) break;
+            dst[i] = c;
+        }
+    }
+    dst[i] = 0;
+}
+// Write a type-1 match record. Returns 1 on success, 0 when the buffer
+// is full (the caller keeps the log owed and retries next frame). The
+// record count is raised only AFTER the record is fully written, as in
+// hud_probe.c, so the host never drains a half-written record.
+static inline __attribute__((always_inline)) int hud_log_match(volatile char *pb, void *pane, int idx, int slot, float tdx, float tdy, float tk, int hidden, float fx, float fy, float gx, float gy, u32 w3) {
+    volatile u32 *hdr = (volatile u32 *)pb;
+    u32 rc = hdr[2];
+    if (rc >= HUD_LOG_REC_CAP) return 0;
+    volatile char *rec = pb + HUD_LOG_REC_OFF + rc * HUD_LOG_REC_SIZE;
+    *(volatile u32 *)(rec + 0) = HUD_LOG_REC_MATCH;
+    *(volatile u32 *)(rec + 4) = (u32)(uintptr_t)pane;
+    *(volatile u32 *)(rec + 8) = (u32)((uintptr_t)pane >> 32);
+    hud_log_copy_name(rec + 12, (const char *)pane + 0xb8, 20);
+    {
+        void *parent = *(void **)((const char *)pane + 0x18);
+        if (parent && !((uintptr_t)parent & 7u)) hud_log_copy_name(rec + 32, (const char *)parent + 0xb8, 20);
+        else rec[32] = 0;
+    }
+    *(volatile float *)(rec + 52) = tdx;
+    *(volatile float *)(rec + 56) = tdy;
+    *(volatile float *)(rec + 60) = tk;
+    *(volatile float *)(rec + 64) = fx;
+    *(volatile float *)(rec + 68) = fy;
+    *(volatile float *)(rec + 72) = gx;
+    *(volatile float *)(rec + 76) = gy;
+    *(volatile u32 *)(rec + 80) = (u32)idx;
+    *(volatile u32 *)(rec + 84) = (u32)slot;
+    *(volatile u32 *)(rec + 88) = (u32)hidden;
+    *(volatile u32 *)(rec + 92) = w3;
+    hdr[2] = rc + 1;
+    return 1;
+}
+// Write a type-0 skip record. pname is the parent name (bit-7 skip) or
+// the child names joined by '/' (matcher miss). Returns 1 on success,
+// 0 when the buffer is full.
+static inline __attribute__((always_inline)) int hud_log_skip(volatile char *pb, void *pane, const char *pname, float lx, float ly, float gx, float gy, u32 reason, u32 flags, void *parent) {
+    volatile u32 *hdr = (volatile u32 *)pb;
+    u32 rc = hdr[2];
+    if (rc >= HUD_LOG_REC_CAP) return 0;
+    volatile char *rec = pb + HUD_LOG_REC_OFF + rc * HUD_LOG_REC_SIZE;
+    *(volatile u32 *)(rec + 0) = HUD_LOG_REC_SKIP;
+    *(volatile u32 *)(rec + 4) = (u32)(uintptr_t)pane;
+    *(volatile u32 *)(rec + 8) = (u32)((uintptr_t)pane >> 32);
+    hud_log_copy_name(rec + 12, (const char *)pane + 0xb8, 20);
+    hud_log_copy_name(rec + 32, pname, 20);
+    *(volatile float *)(rec + 52) = 0.0f;
+    *(volatile float *)(rec + 56) = 0.0f;
+    *(volatile float *)(rec + 60) = lx;
+    *(volatile float *)(rec + 64) = ly;
+    *(volatile float *)(rec + 68) = gx;
+    *(volatile float *)(rec + 72) = gy;
+    *(volatile float *)(rec + 76) = 0.0f;
+    *(volatile u32 *)(rec + 80) = reason;
+    *(volatile u32 *)(rec + 84) = flags;
+    *(volatile u32 *)(rec + 88) = (u32)(uintptr_t)parent;
+    *(volatile u32 *)(rec + 92) = (u32)((uintptr_t)parent >> 32);
+    hdr[2] = rc + 1;
+    return 1;
+}
+// The first two direct child names of a pane, joined by '/', into dst
+// (at most max-1 chars, NUL-terminated). The list is walked RAW -- no
+// hud_edge_child_self -- because this is the matcher-miss diagnostic and
+// the guard is what is being diagnosed. Bounded to 16 children; a bad
+// node or an unaligned child ends the walk.
+static inline __attribute__((always_inline)) void hud_log_child_names(char *dst, void *pane, int max) {
+    int ci = 0;
+    void *head = (char *)pane + 0x20;
+    void *node = *(void **)((const char *)pane + 0x28);
+    int nchild = 0;
+    for (int i = 0; i < 16; i++) {
+        if (!node || node == head) break;
+        if (!hud_edge_node_ok(node)) break;
+        void *child = (char *)node - 8;
+        if (((uintptr_t)child & 7u) != 0) break;
+        if (nchild < 2) {
+            if (nchild == 1 && ci < max - 1) dst[ci++] = '/';
+            const char *cn = (const char *)child + 0xb8;
+            for (int j = 0; j < max - 1 && cn[j] && ci < max - 1; j++) dst[ci++] = cn[j];
+        }
+        nchild++;
+        node = *(void **)((const char *)child + 0x10);
+    }
+    dst[ci] = 0;
+}
+
 void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *params) {
     if (!pane || !aspect_ptr || !table) return;
     // (0147) The aspect is no longer read: the edge anchor lives in the
@@ -570,6 +787,15 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // the stub passes it, and still NULL-checked above.
     (void)aspect_ptr;
 
+    // (0152) The probe buffer, when the host enabled it (DM_HUD_PROBE=1).
+    // log_on is 0 when the probe is off, so every logging call below is
+    // a single branch when off. hud_log_begin initialises the header
+    // (the magic) when it is absent -- the host never writes the magic,
+    // only the enabled flag -- so the first call here is what lets the
+    // host drain anything at all.
+    volatile char *log_pb = hud_log_begin(table);
+    int log_on = log_pb != 0;
+
     // The manual settings (state +0x200; a NULL params pointer, or an
     // unwritten block, reads as no manual setting and nothing hidden).
     u32 manual_mask = 0, hidden_mask = 0;
@@ -654,12 +880,46 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
             }
         }
     }
-    if (idx < 0) return;   // not a HUD element: leave it alone
+    if (idx < 0) {
+        // (0152) An "All" pane that matched nothing: log it once, with
+        // its first two child names, so a matcher miss is identifiable
+        // on device (which child the matcher expected, and which it
+        // actually saw). Non-"All" panes are never logged here -- the
+        // game has hundreds of them, and a miss on a non-"All" is not
+        // a matcher failure.
+        if (log_on && nw[0] == HUD_E_ALL0 && hud_log_mark_seen(log_pb, pane)) {
+            char cnames[20];
+            void *lpar = *(void **)((const char *)pane + 0x18);
+            hud_log_child_names(cnames, pane, 20);
+            hud_log_skip(log_pb, pane, cnames,
+                *(const float *)((const char *)pane + 0x30),
+                *(const float *)((const char *)pane + 0x34),
+                *(const float *)((const char *)pane + 0x70 + 12),
+                *(const float *)((const char *)pane + 0x70 + 28),
+                HUD_LOG_SKIP_NOMATCH, (u32)pflags, lpar);
+        }
+        return;   // not a HUD element: leave it alone
+    }
 
     // (0151) S2, continued: the bit-7 guard, moved here from above the
     // matcher. Unmatched panes already returned; a matched pane with an
     // entry is never skipped, so a hidden pane can be re-shown.
-    if (!(pflags & 0x80u) && !hud_edge_find_entry(table, pane)) return;
+    if (!(pflags & 0x80u) && !hud_edge_find_entry(table, pane)) {
+        // (0152) A matched pane skipped by the bit-7 guard (never
+        // calculated): log it once, so a first-frame skip is visible.
+        if (log_on && hud_log_mark_seen(log_pb, pane)) {
+            void *lpar = *(void **)((const char *)pane + 0x18);
+            const char *lpar_name = 0;
+            if (lpar && !((uintptr_t)lpar & 7u)) lpar_name = (const char *)lpar + 0xb8;
+            hud_log_skip(log_pb, pane, lpar_name,
+                *(const float *)((const char *)pane + 0x30),
+                *(const float *)((const char *)pane + 0x34),
+                *(const float *)((const char *)pane + 0x70 + 12),
+                *(const float *)((const char *)pane + 0x70 + 28),
+                HUD_LOG_SKIP_BIT7, (u32)pflags, lpar);
+        }
+        return;
+    }
 
     // What this element should be, this frame. (0137) The runtime applies
     // ONLY the editor's manual adjustments on top of whatever base the
@@ -741,6 +1001,23 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
                 o_orig[HUD_GDX_SLOT] = 0.0f;
                 o_orig[HUD_GDY_SLOT] = 0.0f;
                 o_orig[HUD_GK_SLOT] = 1.0f;
+                // (0152) Log the restore, best-effort: the pane was
+                // written back to its original (a manual setting was
+                // just cleared). The entry is released just below, so a
+                // deferred log is not retried here.
+                if (log_on) {
+                    float *rlm = *(float **)((const char *)pane + 0xa0);
+                    u32 rw3 = 4u;   // bit2: a restore, not an apply
+                    if (!rlm) rw3 |= 1u;
+                    if (o_orig[HUD_LM0_SLOT] == 1.0f) rw3 |= 2u;
+                    int rslot = (int)(((uintptr_t)old - (uintptr_t)table) / HUD_EDGE_ENTRY);
+                    rslot = (rslot - idx) / HUD_EDGE_N;
+                    hud_log_match(log_pb, pane, idx, rslot, 0.0f, 0.0f, 1.0f, hidden,
+                        *(const float *)((const char *)pane + 0x30),
+                        *(const float *)((const char *)pane + 0x34),
+                        *(const float *)((const char *)pane + 0x70 + 12),
+                        *(const float *)((const char *)pane + 0x70 + 28), rw3);
+                }
             }
             if (!hidden) {
                 *(uintptr_t *)(old + 0) = 0;
@@ -997,8 +1274,22 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
         // e_mod and e_lm0 are left alone; the write below re-applies the
         // shift to the local matrix and +0x70.
     }
+    // (0152) The early return also fires only when the match has been
+    // logged (or logging is off): a pending log forces a re-run of the
+    // write block below, so a first-frame match deferred by a disabled
+    // probe is logged one frame late instead of lost.
     if (!recomputed && *e_dx == edx && *e_dy == edy && *e_k == ek && *e_hidden == (u32)hidden
-        && e_orig[HUD_GDX_SLOT] == tdx && e_orig[HUD_GDY_SLOT] == tdy && e_orig[HUD_GK_SLOT] == tk) return;   // already correct: nothing to do (0142: the absolute target must match too -- a parent move can leave the compensated delta unchanged while the absolute target moved)
+        && e_orig[HUD_GDX_SLOT] == tdx && e_orig[HUD_GDY_SLOT] == tdy && e_orig[HUD_GK_SLOT] == tk
+        && (e_orig[HUD_LOG_DONE_SLOT] != 0.0f || !log_on)) return;   // already correct: nothing to do (0142: the absolute target must match too -- a parent move can leave the compensated delta unchanged while the absolute target moved)
+
+    // (0152) Whether this write changes the value: the target differs
+    // from the last written absolute target, or the hidden flag differs.
+    // Captured here, before the stores below update them. The log at the
+    // end of the block uses this, so a re-apply of an unchanged target
+    // (the third cut, after the driver's refresh wipes the shift every
+    // frame) does not spam a record per frame.
+    int target_changed = (e_orig[HUD_GDX_SLOT] != tdx || e_orig[HUD_GDY_SLOT] != tdy ||
+                          e_orig[HUD_GK_SLOT] != tk || *e_hidden != (u32)hidden);
 
     // The local shift is always re-derived from the stored original, so a
     // fixed offset cannot drift: local = original local + effective delta,
@@ -1089,4 +1380,40 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     // from the moved parent on the same frame.
     *(unsigned short *)((char *)pane + 0x58) |= 0x10u;
     hud_edge_mark_dirty(pane);
+
+    // (0152) Log the match, but ONLY when the value changed (the target
+    // differs from the last written absolute target -- target_changed,
+    // captured above before the stores updated it) or a log is owed
+    // (e_orig[8] == 0: the first match, a probe that was off, or a full
+    // buffer). The write block re-runs every frame for a pane the game
+    // wipes and re-applies (the third cut, after the driver's refresh),
+    // so logging on every write would spam one record per frame per
+    // element; a re-apply of an unchanged, already-logged target logs
+    // nothing. When logging is off the flag is left 0.0 (owed), and the
+    // early return's !log_on clause keeps the fast path unchanged.
+    {
+        int log_owed = (e_orig[HUD_LOG_DONE_SLOT] == 0.0f);
+        if (log_on && (target_changed || log_owed)) {
+            float *alm = *(float **)((const char *)pane + 0xa0);
+            u32 w3 = 0;
+            if (!alm) w3 |= 1u;   // +0xa0 was NULL
+            if (e_orig[HUD_LM0_SLOT] == 1.0f) w3 |= 2u;   // e_lm0 captured
+            // bit2 (restore) is 0 here: this is an apply, not a restore.
+            int slot = (int)(((uintptr_t)ent - (uintptr_t)table) / HUD_EDGE_ENTRY);
+            slot = (slot - idx) / HUD_EDGE_N;
+            if (hud_log_match(log_pb, pane, idx, slot, tdx, tdy, tk, hidden,
+                    *(const float *)((const char *)pane + 0x30),
+                    *(const float *)((const char *)pane + 0x34),
