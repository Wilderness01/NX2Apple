+// ---------- Shop probe (0164, diagnostic only) ----------
+// The guest stub (shop_probe.c, the confirm-branch cut at 0x442664) writes
+// one dump per shop confirm into the frame-step state page at +0x3300
+// (the HUD probe buffer region; the HUD probe stub is not in this build,
+// so the region is free -- this drain keys on its own magic "SHPB", and
+// dm_hud_probe_tick keys on "PRBE", so the two never interact).
+// Layout: +0x00 u32 magic "SHPB", +0x04 u32 len (dump bytes, 0 = empty),
+// +0x08 u32 fire count, +0x0C u32 reserved; +0x10 the dump (0x460 bytes):
+//   +0x00 u64 x19 (shop sub-object), +0x08 u64 list ([x19+0x18]),
+//   +0x10 u64 list_arg (list+0x20), +0x18 u64 A (selected UI object),
+//   +0x20 u64 x22 (0x50a5c0 return), +0x28 u64 objB (0: holder unpinned),
+//   +0x30 u32 objB_count, +0x38 u64 objB_array, +0x40 u64 src,
+//   +0x48 u32 src_count, +0x50 u64 src_array, +0x58 u64 reserved,
+//   +0x60 A bytes 0x00-0x7F, +0xE0 x22 bytes 0x00-0x7F,
+//   +0x160 x19 bytes 0x00-0xFF, +0x260 list bytes 0x00-0x1FF.
+// The host logs the dump once per present and resets len, so the stub can
+// fire again on the next confirm. The hex lines carry a region label
+// (ptrs/A/x22/x19/list) so the reader knows which window a byte came
+// from; pointer values resolve offline against the NSO's string table.
+// Delete after use; never ship.
+#define SHOP_PROBE_OFF 0x3300
+#define SHOP_PROBE_MAGIC 0x53485042u   // "SHPB"
+#define SHOP_PROBE_LEN 0x460
+static void dm_shop_probe_tick(void) {
+    uint8_t *st = dm_fps_state;
+    if (!st) return;
+    uint8_t *pb = st + SHOP_PROBE_OFF;
+    uint32_t *hdr = (uint32_t *)pb;
+    if (hdr[0] != SHOP_PROBE_MAGIC) return;   // the stub has not fired yet
+    uint32_t len = hdr[1];
+    if (len == 0) return;   // nothing to drain
+    if (len > SHOP_PROBE_LEN) len = SHOP_PROBE_LEN;
+    uint32_t fire = hdr[2];
+    uint8_t *d = pb + 0x10;
+    uint64_t x19 = *(uint64_t *)(d + 0x00);
+    uint64_t list = *(uint64_t *)(d + 0x08);
+    uint64_t list_arg = *(uint64_t *)(d + 0x10);
+    uint64_t a = *(uint64_t *)(d + 0x18);
+    uint64_t x22 = *(uint64_t *)(d + 0x20);
+    LOG("[shop] probe #%u x19=0x%llx list=0x%llx list+0x20=0x%llx A=0x%llx x22=0x%llx objB=0 src=0",
+        fire, (unsigned long long)x19, (unsigned long long)list,
+        (unsigned long long)list_arg, (unsigned long long)a, (unsigned long long)x22);
+    for (uint32_t off = 0; off < len; off += 64) {
+        uint32_t n = len - off;
+        if (n > 64) n = 64;
+        const char *region = off < 0x60 ? "ptrs" : off < 0xe0 ? "A" : off < 0x160 ? "x22" : off < 0x260 ? "x19" : "list";
+        char hex[129];
+        for (uint32_t k = 0; k < n; k++) {
+            unsigned char b = d[off + k];
+            hex[2 * k] = "0123456789abcdef"[b >> 4];
+            hex[2 * k + 1] = "0123456789abcdef"[b & 0xf];
+        }
+        hex[2 * n] = '\0';
+        LOG("[shop] hex %s off=0x%03x bytes=%u hex=%s", region, off, n, hex);
+    }
+    hdr[1] = 0;   // reset: the stub may fire again on the next confirm
+}
