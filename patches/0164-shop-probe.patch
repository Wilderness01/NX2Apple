+# (0164) The shop probe: one FRAME_STEP cut at the router confirm branch
+# 0x442664 (NrvHelloNewItem's real handler 0x442560, confirm branch
+# ~0x442664-0x44266c: after the 0x4f4f90 == 1 check, 0x4f76b0 and 0x30b4c0,
+# the router sets the nerve to NrvSelectDecideEnd). At that point x19 is
+# the ShopStateInShop sub-object, [x19+0x18] is the list object and
+# [x19+0x18]+0x20 is the argument 0x50a5c0 takes; the player's "confirm
+# selection" decision has just been made. The trampoline saves the live
+# registers (x0 = the 0x30b4c0 result, x30 = the return address, x19 = the
+# shop sub-object; x1 is about to be overwritten by the replaced adrp),
+# calls shop_probe(x19, state page), restores, re-executes the replaced
+# adrp+addi (x1 = 0x12bc9a8, NrvSelectDecideEnd -- the adrp is PC-relative,
+# so it is re-synthesised with ADRP+ADDI from the trampoline's own PC, not
+# copied verbatim) and branches back to 0x44266c (the b #0x442890). The
+# game's own confirm flow is untouched: the stub returns void, writes only
+# the probe buffer (state +0x3300), and never suppresses the buy. The host
+# (hud_manual.c, dm_shop_probe_tick, once per present) drains the buffer
+# into "[shop] ..." log lines and resets it, so the stub can fire again
+# on the next confirm.
+def _shop_probe_frame_step(ctx):
+    here, emit, fs_site, fs_put, FS_STATE_OFF = ctx.here, ctx.emit, ctx.site, ctx.put, ctx.state
+    probe_code = here()
+    hx = ''.join(SHOP_PROBE_WORDS)
+    for i in range(0, len(hx), 8):
+        emit(int(hx[i:i + 8], 16))
+    # The router confirm branch at 0x442664: `adrp x1, #0x12bc000`.
+    # x0 (the 0x30b4c0 result) and x30 (the return address into the
+    # router's caller) are saved across the bl: the stub clobbers x0 and
+    # the bl clobbers x30. x19 (the shop sub-object) is passed to the stub
+    # and saved too; x1 is about to be overwritten by the replaced adrp.
+    # The replaced adrp+addi are NOT PC-relative-safe to re-execute
+    # verbatim (adrp computes from the PC), so they are re-synthesised:
+    # ADRP from the trampoline's PC to the 0x12bc000 page, ADDI 0x9a8.
+    # The branch back is to the hook site + 8 (0x44266c), skipping both
+    # replaced instructions; the flags do not matter (the branch is
+    # unconditional and the stub leaves no flag dependency behind).
+    fs_site(0x442664, 'c17300d0')
+    sstart = here()
+    emit(STP_PRE(0, 30, 31, -16))              # stp x0, x30, [sp, #-16]! (live: the 0x30b4c0 result, the return address)
+    emit(STP_PRE(19, 1, 31, -16))              # stp x19, x1, [sp, #-16]! (live: the shop sub-object; x1 is about to be overwritten)
+    emit(0xaa1303e0)                            # mov x0, x19 (the shop sub-object -> probe arg 0)
+    emit(ADRP(1, here(), FS_STATE_OFF))         # x1 = state page (probe arg 1; the stub adds SHOP_PROBE_OFF 0x3300 itself)
+    emit(B(here(), probe_code) | 0x80000000)     # bl shop_probe
+    emit(LDP_POST(19, 1, 31, 16))               # ldp x19, x1, [sp], #16
+    emit(LDP_POST(0, 30, 31, 16))               # ldp x0, x30, [sp], #16
+    emit(ADRP(1, here(), 0x12bc9a8))            # x1 = 0x12bc000 page (the replaced adrp, re-synthesised)
+    emit(ADDI(1, 1, 0x9a8))                     # x1 = 0x12bc9a8 (the replaced addi; NrvSelectDecideEnd)
+    emit(B(here(), 0x44266c))                   # back to the hook site + 8
+    fs_put(0x442664, [B(0x442664, sstart)], 'Shop confirm branch: the shop probe (shop_probe.c) dumps the shop structure at confirm time, game flow untouched')
+
 def _frame_step_141(ctx):
