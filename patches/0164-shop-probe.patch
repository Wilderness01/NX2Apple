+++ b/dm/games/0100000000010000/shop_probe.c
@@ -0,0 +1,187 @@
+// shop_probe.c -- diagnostic probe (0164). Adds logging only; changes no game behavior.
+//
+// The user authorised one probe build after static tracing hit a wall:
+// the ItemName field offset is still open (REPORT-CHAR-INGAME-S6-ITEMNAME.md).
+// The 0x50a5c0/x22 route does not lead to ItemName (x22 is a UI-layer
+// item-data object; its typeinfos are runtime-constructed in BSS), the UI
+// object's +0x150 is an animation name (not ItemName, proved), and ItemName
+// lives in the BYML/source layer, read by hash -- so no static xref path
+// exists. This probe dumps, at shop-confirm time, everything reachable
+// from the confirm branch so the ItemName string (or the Object B pointer
+// that leads to it) can be read out of the device log.
+//
+// Hook site: the router confirm branch at 0x442664 (NrvHelloNewItem's real
+// handler 0x442560; NSO vaddr). At that point x19 is the ShopStateInShop
+// sub-object, [x19+0x18] is the list object, and [x19+0x18]+0x20 is the
+// argument 0x50a5c0 takes. The trampoline (patches.py) saves the live
+// registers, calls this stub with (x19, state page), restores, re-executes
+// the replaced adrp+addi (x1 = 0x12bc9a8, NrvSelectDecideEnd) and returns
+// to 0x44266c. The game's own confirm flow is untouched: the stub returns
+// void, writes only the probe buffer, and never suppresses the buy.
+//
+// What is dumped (see the host drain in hud_manual.c, dm_shop_probe_tick):
+//   x19, list = [x19+0x18], list_arg = list+0x20,
+//   A = vtable[0](list_arg) (the selected list-item UI object),
+//   x22 = 0x50a5c0(list_arg) (replicated inline: NULL when *(A+0x70) < 0,
+//     else *(vtable(*(A+0x68)) + 0x138)),
+//   0x80 bytes of A, 0x80 bytes of x22 (pointer values resolve offline
+//     against the NSO's string table -- that is how a name field is found),
+//   0x100 bytes of the shop sub-object (x19) and 0x200 bytes of the list
+//     object. Object B's holder offset is still unpinned statically, so
+//     its pointer is NOT read directly: it must live in one of those two
+//     windows (it is stored in the shop state or the list object), and
+//     the log reader identifies it there by shape (an object whose +0x18
+//     is a small count and whose +0x20 points at a 0x20-strided array
+//     whose entries' +0x00 include A). The objB/src fields in the dump
+//     are therefore zero, documented, and not read.
+// Every pointer is NULL-guarded before it is dereferenced; a NULL anywhere
+// yields a zero field / zero-filled window, never a fault. The stub fires
+// once per shop confirm; if the host has not drained the previous dump
+// (len != 0) the call returns without writing, so a dump is never torn.
+//
+// Compiled with: aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin
+//   -fno-stack-protector -fno-jump-tables -fno-unwind-tables
+//   -fno-asynchronous-unwind-tables -c,
+//   objcopy -O binary --only-section=.text (never plain -O binary: the
+//   0131 .eh_frame lesson). The function takes everything through its
+//   arguments -- no static data, no literal pool, no external calls -- so
+//   the emitted words are position-independent and relocation-free and can
+//   be dropped into the rewriter's patch area verbatim:
+//   x0 = the shop sub-object (x19 at the hook site), x1 = the state page.
+//   Delete after use; never ship.
+
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef unsigned long uintptr_t;
+
+// The probe buffer (state + 0x3300, 3328 bytes: the frame-step state page
+// is 0x4000 bytes and the hud_edge table ends at +0x3060, so +0x3300 is
+// past it; the HUD probe buffer lives at the same offset, but its stub is
+// not in this build and its drain keys on its own magic "PRBE", so the two
+// never interact). Header 16 bytes, dump 0x460 bytes: 0x470 total.
+#define SHOP_PROBE_OFF 0x3300
+#define SHOP_PROBE_MAGIC 0x53485042u   // "SHPB"
+#define SHOP_PROBE_DUMP_LEN 0x460
+// Header offsets (relative to probe_buf).
+#define SP_MAGIC 0
+#define SP_LEN 4
+#define SP_FIRE 8
+#define SP_RESERVED 12
+// Dump offsets (relative to probe_buf + 0x10).
+#define SP_D_X19 0x00
+#define SP_D_LIST 0x08
+#define SP_D_LIST_ARG 0x10
+#define SP_D_A 0x18
+#define SP_D_X22 0x20
+#define SP_D_OBJB 0x28
+#define SP_D_OBJB_COUNT 0x30
+#define SP_D_OBJB_ARRAY 0x38
+#define SP_D_SRC 0x40
+#define SP_D_SRC_COUNT 0x48
+#define SP_D_SRC_ARRAY 0x50
+#define SP_D_RESERVED 0x58
+#define SP_D_A_BYTES 0x60        // 0x80 bytes
+#define SP_D_X22_BYTES 0xe0      // 0x80 bytes
+#define SP_D_X19_BYTES 0x160     // 0x100 bytes
+#define SP_D_LIST_BYTES 0x260    // 0x200 bytes
+#define SP_D_A_LEN 0x80
+#define SP_D_X22_LEN 0x80
+#define SP_D_X19_LEN 0x100
+#define SP_D_LIST_LEN 0x200
+
+// Store a u64 / u32 into the probe buffer (volatile: one access, exactly
+// as written -- no vectorising, no combining; the buffer is shared with
+// the host, which sets nothing here but drains the dump).
+static inline __attribute__((always_inline)) void sp_put_u64(volatile char *base, int off, u64 v) {
+    *(volatile u64 *)(base + off) = v;
+}
+static inline __attribute__((always_inline)) void sp_put_u32(volatile char *base, int off, u32 v) {
+    *(volatile u32 *)(base + off) = v;
+}
+
+// Copy n bytes from game memory into the probe buffer, one byte at a time
+// (volatile on both sides: no vectorising, no widening, no reading past
+// the window). A NULL source fills with zeros.
+static inline __attribute__((always_inline)) void sp_copy_bytes(volatile char *dst, const void *src, int n) {
+    const volatile unsigned char *s = (const volatile unsigned char *)src;
+    for (int i = 0; i < n; i++) dst[i] = src ? s[i] : 0;
+}
+
+// A = vtable[0](list_arg): the selected list-item UI object. This is the
+// first step 0x50a5c0 takes (ldr x8,[x0]; ldr x8,[x8]; blr x8). Every
+// pointer is guarded; a NULL anywhere yields NULL, never a fault.
+static inline __attribute__((always_inline)) void *sp_get_a(void *list_arg) {
+    if (!list_arg) return 0;
+    void *vt = (void *)*(volatile void **)list_arg;
+    if (!vt) return 0;
+    typedef void *(*get_t)(void *);
+    get_t f = *(volatile get_t *)vt;
+    if (!f) return 0;
+    return f(list_arg);
+}
+
+// x22 = 0x50a5c0(list_arg), replicated inline (no call into the game, so
+// no calling-convention risk): NULL when *(A+0x70) < 0 (the float gate),
+// else *(vtable(*(A+0x68)) + 0x138) -- vtable entry #39 of the sub-object
+// at *(A+0x68). Verified against the 0x50a5c0 disassembly
+// (REPORT-CHAR-INGAME-S6-ITEMNAME.md §1.1).
+static inline __attribute__((always_inline)) void *sp_get_x22(void *a) {
+    if (!a) return 0;
+    float g = *(volatile float *)((char *)a + 0x70);
+    if (!(g >= 0.0f)) return 0;   // gate: < 0 (or NaN) -> NULL, as fcmp + b.ge
+    void *sub = (void *)*(volatile void **)((char *)a + 0x68);
+    if (!sub) return 0;
+    void *subt = (void *)*(volatile void **)sub;
+    if (!subt) return 0;
+    return (void *)*(volatile void **)((char *)subt + 0x138);
+}
+
+void shop_probe(void *shop_sub, unsigned char *state) {
+    if (!shop_sub || !state) return;
+    volatile char *buf = (volatile char *)state + SHOP_PROBE_OFF;
+    volatile u32 *hdr = (volatile u32 *)buf;
+    // Initialise the header the first time (the state page starts zeroed).
+    if (hdr[SP_MAGIC / 4] != SHOP_PROBE_MAGIC) {
+        hdr[SP_MAGIC / 4] = SHOP_PROBE_MAGIC;
+        hdr[SP_LEN / 4] = 0;
+        hdr[SP_FIRE / 4] = 0;
+        hdr[SP_RESERVED / 4] = 0;
+    }
+    // The host has not drained the previous dump yet: return without
+    // writing, so a dump is never torn or overwritten mid-read.
+    if (hdr[SP_LEN / 4] != 0) return;
+    volatile char *d = buf + 0x10;
+
+    void *x19 = shop_sub;
+    void *list = (void *)*(volatile void **)((char *)x19 + 0x18);
+    void *list_arg = list ? (char *)list + 0x20 : 0;
+    void *a = sp_get_a(list_arg);
+    void *x22 = sp_get_x22(a);
+
+    // Pointer block. Object B and the source container are zero: their
+    // holder offsets are unpinned (see the header comment) -- the reader
+    // finds Object B in the x19/list windows below by shape.
+    sp_put_u64(d, SP_D_X19, (u64)(uintptr_t)x19);
+    sp_put_u64(d, SP_D_LIST, (u64)(uintptr_t)list);
+    sp_put_u64(d, SP_D_LIST_ARG, (u64)(uintptr_t)list_arg);
+    sp_put_u64(d, SP_D_A, (u64)(uintptr_t)a);
+    sp_put_u64(d, SP_D_X22, (u64)(uintptr_t)x22);
+    sp_put_u64(d, SP_D_OBJB, 0);
+    sp_put_u32(d, SP_D_OBJB_COUNT, 0);
+    sp_put_u32(d, SP_D_OBJB_COUNT + 4, 0);
+    sp_put_u64(d, SP_D_OBJB_ARRAY, 0);
+    sp_put_u64(d, SP_D_SRC, 0);
+    sp_put_u32(d, SP_D_SRC_COUNT, 0);
+    sp_put_u32(d, SP_D_SRC_COUNT + 4, 0);
+    sp_put_u64(d, SP_D_SRC_ARRAY, 0);
+    sp_put_u64(d, SP_D_RESERVED, 0);
+    // Byte windows (NULL sources fill with zeros).
+    sp_copy_bytes(d + SP_D_A_BYTES, a, SP_D_A_LEN);
+    sp_copy_bytes(d + SP_D_X22_BYTES, x22, SP_D_X22_LEN);
+    sp_copy_bytes(d + SP_D_X19_BYTES, x19, SP_D_X19_LEN);
+    sp_copy_bytes(d + SP_D_LIST_BYTES, list, SP_D_LIST_LEN);
+    // Publish: fire count first, length last -- the host only reads the
+    // dump once len is non-zero, so it can never see a partial dump.
+    hdr[SP_FIRE / 4] = hdr[SP_FIRE / 4] + 1;
+    hdr[SP_LEN / 4] = SHOP_PROBE_DUMP_LEN;
+}
