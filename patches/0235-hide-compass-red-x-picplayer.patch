From 74685feb5033efaaa5727854695f6080c772211a Mon Sep 17 00:00:00 2001
From: seedds <seedds@gmail.com>
Date: Sun, 22 Nov 2026 00:43:56 +0000
Subject: [PATCH] 0235: hide the compass red X (PicPlayer) by clearing its
 visible bit

The red X at the centre of the compass dial is PicPlayer, the player
marker in the MapMiniPlayer layout. Identified by elimination from the
.bflyt: the compass has exactly five content panes -- PicBase (dark base),
PicMap (dial), TxtNorth ("N"), PicView (red view-cone arc, code-confirmed)
and PicPlayer (red, at the centre). The .bflyt lists PicPlayer as 20x52
at (0,0) with the red "MyIconMapMiniArrow" texture; the full-screen map
(MapPlayer) never has a bare "PicPlayer" (its markers are PicPlayer00 /
PicPlayer01 / PicPlayerBalloon), so the exact name is compass-only.

The hide clears flags bit 0 at +0x58 -- the same TRUE hide the 0137
element hide uses, not an off-screen move -- and marks the pane dirty
(bit 4). It runs on every Calculate and returns before the matcher, so
the game cannot re-show it and PicPlayer needs no table entry. The dial
(PicMap), needle (PicView), "N" (TxtNorth) and dark base (PicBase) are
untouched; only the red X goes. (Deliberate user-requested hide, not a
root-cause fix.)

Host verification: mock 12/12 (fail-before on the unmodified runtime
reproduces PicPlayer visible; pass-after hides it, leaves PicPlayer00 /
PicPlayer01 / PicPlayerBalloon / PicView / PicMap / All untouched, and is
idempotent). Baseline recompile of the unmodified hud_runtime.c with the
ARM 13.2.1 toolchain reproduces the current HUD_RUNTIME_WORDS exactly
(1491 words, first f100003f); the 0235 build is 1504 words, first word
unchanged, all words decode as valid ARM64 (capstone).
---
 dm/games/0100000000010000/hud_runtime.c |  27 ++++
 dm/games/0100000000010000/patches.py    | 204 ++++++++++++------------
 2 files changed, 130 insertions(+), 101 deletions(-)

diff --git a/dm/games/0100000000010000/hud_runtime.c b/dm/games/0100000000010000/hud_runtime.c
index 2563358c..2df4f796 100644
--- a/dm/games/0100000000010000/hud_runtime.c
+++ b/dm/games/0100000000010000/hud_runtime.c
@@ -372,6 +372,14 @@ typedef unsigned long uintptr_t;
 // does not match the full-screen map.
 #define HUD_E_PICVIEW0 0x56636950u
 #define HUD_E_PICVIEW1 0x00776569u
+// (0235) "PicPlayer": "PicP", "laye", "r\0\0\0" -- the red X (the
+// black-circle red X) at the centre of the compass dial, in the
+// MapMiniPlayer layout. The full-screen map (MapPlayer) never has a bare
+// "PicPlayer" (its player markers are PicPlayer00 / PicPlayer01 /
+// PicPlayerBalloon), so the exact name is compass-only.
+#define HUD_E_PICPLAYER0 0x50636950u
+#define HUD_E_PICPLAYER1 0x6579616cu
+#define HUD_E_PICPLAYER2 0x00000072u
 // "Shine": "Shin", "e\0\0\0".
 #define HUD_E_SHINE0 0x6e696853u
 #define HUD_E_SHINE1 0x00000065u
@@ -838,6 +846,25 @@ void hud_edge(void *pane, const float *aspect_ptr, void *table, const float *par
     const char *name = (const char *)pane + 0xb8;
     const u32 *nw = (const u32 *)name;
 
+    // (0235) Hide the compass red X: the pane named exactly "PicPlayer"
+    // (MapMiniPlayer's player marker, the black-circle red X at the centre
+    // of the compass dial) is hidden by clearing its visible bit (flags
+    // bit 0 at +0x58) -- the same TRUE hide the 0137 element hide uses,
+    // not an off-screen move. It runs on every Calculate, so the game
+    // cannot re-show it, and it returns here: PicPlayer needs no table
+    // entry, no manual delta, and no matcher (it is a content pane, not
+    // an 'All'). The exact name is compass-only: the full-screen map
+    // (MapPlayer) has PicPlayer00 / PicPlayer01 / PicPlayerBalloon, never
+    // a bare "PicPlayer", so its player markers are untouched. The dial
+    // (PicMap), needle (PicView), "N" (TxtNorth) and dark base (PicBase)
+    // are untouched -- only the red X goes. (Deliberate user-requested
+    // hide, not a root-cause fix: the user asked for the red X removed.)
+    if (hud_edge_words_eq(nw, HUD_E_PICPLAYER0, HUD_E_PICPLAYER1, HUD_E_PICPLAYER2, 0, 3)) {
+        *(unsigned short *)((char *)pane + 0x58) &= (unsigned short)~0x0001u;
+        *(unsigned short *)((char *)pane + 0x58) |= 0x10u;   // dirty: recompose
+        return;
+    }
+
     // (0147) Which HUD element is this pane, by LAYOUT, not by name alone.
     // Only a layout's 'All' container is ever matched -- the display side.
     // A content pane ('TxtCounterSh'/'TxtCounter'/'TxtIconSh'/'TxtIcon'
diff --git a/dm/games/0100000000010000/patches.py b/dm/games/0100000000010000/patches.py
index e6ccac01..f980eccd 100644
--- a/dm/games/0100000000010000/patches.py
+++ b/dm/games/0100000000010000/patches.py
@@ -18,7 +18,8 @@ CUTS = {BUILD_141: []}
 
 # hud_runtime, compiled from hud_runtime.c (0137 in-game editor runtime, 0147
 # layout-aware matcher + restore to the .bflyt base, 0150 local-matrix write,
-# 0151 third cut + bit-7-guard move + PicView matcher)
+# 0151 third cut + bit-7-guard move + PicView matcher, 0235 PicPlayer
+# compass-red-X hide)
 # with aarch64-linux-gnu-gcc -O2 -ffreestanding -fno-builtin -fno-stack-protector
 # -fno-jump-tables -fno-unwind-tables -fno-asynchronous-unwind-tables -c,
 # and objcopy -O binary --only-section=.text (never plain -O binary: the
@@ -41,106 +42,107 @@ CUTS = {BUILD_141: []}
 # an All with a PicView child as compass (MapMiniPlayer's red needle --
 # #66 S3).
