+// ---- The element handles ----
+// One handle per element: a translucent rounded box with the element's
+// name. The handles are not interactive themselves: the editor view
+// hit-tests them in its touch methods (DmGamepad.m's way), so a drag that
+// starts on a handle is one gesture from tap to move.
+- (void)buildHandles {
+    for (int i = 0; i < kHudPadCount; i++) {
+        UIView *h = [[UIView alloc] init];
+        h.backgroundColor = [[UIColor whiteColor] colorWithAlphaComponent:0.12];
+        h.layer.cornerRadius = 10;
+        h.layer.borderColor = [[UIColor whiteColor] colorWithAlphaComponent:0.35].CGColor; h.layer.borderWidth = 1;
+        h.userInteractionEnabled = NO;
+        h.hidden = YES;
+        UILabel *name = [[UILabel alloc] init];
+        name.text = kHudPadNames[i]; name.textColor = UIColor.whiteColor; name.font = [UIFont boldSystemFontOfSize:13]; name.textAlignment = NSTextAlignmentCenter;
+        name.backgroundColor = [UIColor clearColor];
+        [h addSubview:name];
+        _handles[i] = h;
+        [self addSubview:h];
+    }
+    if (_highlight) [self.layer addSublayer:_highlight];   // the ring sits above the handle layers (a re-add moves it to the top)
+}
+- (void)layoutHandles {   // each handle sits on its element now (anchor + manual offset, scaled by k), a hidden one dimmed so it stays tappable
+    for (int i = 0; i < kHudPadCount; i++) {
+        UIView *h = _handles[i];
+        if (!h) continue;
+        CGSize s = [self handleSize:i];
+        CGPoint c = [self clampHandleCentre:[self handleCentre:i] size:s];
+        h.frame = CGRectMake(c.x - s.width / 2, c.y - s.height / 2, s.width, s.height);
+        h.alpha = _hidden[i] ? 0.35 : 1;   // 0146: a hidden element shows dimmed while the editor is open, so it can be tapped to unhide it
+        UILabel *name = (UILabel *)[h.subviews firstObject];
+        name.frame = h.bounds;
+    }
+    [self layoutHighlight];
+}
+- (void)layoutHighlight {   // the ring around the selected handle while the editor is open
+    if (!_highlight) return;
+    BOOL show = !_editBar.hidden;
+    _highlight.hidden = !show;
+    if (!show) return;
+    UIView *h = _handles[_selected];
+    if (!h) { _highlight.hidden = YES; return; }
+    CGRect r = CGRectInset(h.frame, -4, -4);
+    [CATransaction begin]; [CATransaction setDisableActions:YES];
+    _highlight.frame = r;
+    CGMutablePathRef path = CGPathCreateWithRoundedRect(CGRectMake(0, 0, r.size.width, r.size.height), 12, 12, NULL);
+    _highlight.path = path;
+    CGPathRelease(path);
+    [CATransaction commit];
+}
+
+// ---- Selection, slider, eye ----
+- (void)selectElement:(int)i {   // tap a handle in the editor: it becomes the one the slider tunes
+    if (i < 0 || i >= kHudPadCount) return;
+    _selected = i;
+    _editSlider.value = _k[i];
+    [self updateEditEye];   // 0146: the eye for this element
+    [self updateHint];
+    [self layoutHandles];   // refreshes the highlight ring
+}
+- (void)updateHint {
+    UILabel *hint = (UILabel *)[_editBar viewWithTag:304];
+    hint.text = [NSString stringWithFormat:@"当前：%@ · %d%%%@\n拖动元素可以移动位置 · 拖动面板可以移动面板",
+                 kHudPadNames[_selected], (int)lround(_k[_selected] * 100), _hidden[_selected] ? @" · 已隐藏" : @""];
+}
+- (void)editSliderChanged:(UISlider *)s {   // the size slider: resize the selected element only, live
+    _k[_selected] = fmin(fmax(s.value, kHudPadKMin), kHudPadKMax);
+    [self applyElement:_selected];
+    [self layoutHandles];
+    [self updateHint];
+}
+// 0146: the eye toggle for the selected element: eye (shown) or eye.slash (hidden, red).
+- (void)updateEditEye {
+    if (!_editEye) return;
+    BOOL hidden = _hidden[_selected];
+    [_editEye setImage:[UIImage systemImageNamed:hidden ? @"eye.slash" : @"eye"] forState:UIControlStateNormal];
+    _editEye.tintColor = hidden ? UIColor.systemRedColor : UIColor.whiteColor;
+}
+- (void)editEyeTapped:(UIButton *)b {   // 0146: hide / show the selected element
+    (void)b;
+    _hidden[_selected] = !_hidden[_selected];
+    [self applyElement:_selected];
+    [self layoutHandles];   // the element hides at once, or shows dimmed so it stays tappable
+    [self updateEditEye];
