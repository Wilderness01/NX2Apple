+// HudPadEditor.h -- the in-game HUD editor (0148).
+//
+// The pad-style HUD editor: the in-game menu's "HUD 设置" opens it over the
+// running game (the game keeps running behind it). Five elements, each its
+// own: compass (0), lives (1), coins icon + number (2), moons (3), regional
+// coins hexagon + number (5). Hints (4) and the white bar are not in the
+// editor: they are permanently hidden in the overlay, not editable.
+//
+// See HudPadEditor.m for the layout, the drag conversion and the migration.
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+void dm_hud_pad_open_editor(void);   // GameMenu.swift: the in-game menu's "HUD 设置" opens the pad-style HUD editor
+void dm_hud_pad_apply_saved(void);   // Launcher.swift: before the game starts, the saved DmHudPad.* settings go into the DM_HUD_* environment
+#ifdef __cplusplus
+}
+#endif
+
+#import <UIKit/UIKit.h>
+
+// The editor itself: a full-screen transparent overlay on the key window.
+// The game shows through it; the five element handles and the settings bar
+// sit on top of the picture. Created by dm_hud_pad_open_editor, removed by
+// Done (closeEditor).
+@interface HudPadEditor : UIView <UIGestureRecognizerDelegate>
+- (void)openEditor;   // read the saved settings, apply them live, show the bar and the handles
+- (void)closeEditor;   // Done: save the settings and remove the editor
+@end
