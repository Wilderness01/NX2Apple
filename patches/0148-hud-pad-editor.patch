+        }
+    }
+}
+- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)t {   // a slider or a button keeps its own touch; the bar's background, title and hint start a drag
+    (void)g;
+    return ![t.view isKindOfClass:[UIControl class]];
+}
