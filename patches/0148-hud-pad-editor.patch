-// The coin icon (mockup SVG, 100x100 viewBox): a dark disc with a thick white
-// ring, a thin inner white ring, and a dark vertical bar in the middle.
-private struct CoinIcon: View {
-    let size: CGFloat
-    var body: some View {
-        ZStack {
-            Circle().fill(Color(red: 8 / 255, green: 12 / 255, blue: 16 / 255).opacity(0.38))
-                .frame(width: 0.82 * size, height: 0.82 * size)
-            Circle().stroke(Color.white, lineWidth: 0.11 * size)
-                .frame(width: 0.82 * size, height: 0.82 * size)
-            Circle().stroke(Color.white.opacity(0.92), lineWidth: 0.035 * size)
-                .frame(width: 0.56 * size, height: 0.56 * size)
-            RoundedRectangle(cornerRadius: 0.065 * size)
-                .fill(Color(red: 16 / 255, green: 21 / 255, blue: 28 / 255))
