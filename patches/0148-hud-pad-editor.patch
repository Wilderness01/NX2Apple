diff --git a/dm/ios/Sources/HudEditor.swift b/dm/ios/Sources/HudEditor.swift
deleted file mode 100644
index 5025d30..0000000
--- a/dm/ios/Sources/HudEditor.swift
+++ /dev/null
@@ -1,1045 +0,0 @@
-// HudEditor.swift -- the launcher HUD editor (0123). The settings screen
-// shows a game preview (the bundled forest photo, the six HUD elements) at the
-// device's screen shape, and each element can be dragged, resized (60%-180%) or
-// hidden. A manual setting wins over the auto edge anchor (0118); an element with
-// no manual setting keeps the auto edge. Hidden in the editor means hidden in
-// the game. The settings are kept in UserDefaults and, when the game starts,
-// written to the DM_HUD_* environment variables (HudSettings). The game reads
-// them through the host (dm/host/hud_manual.c -> state page +0x200 -> hud_edge.c).
-// The four preview shapes are iPhone 19.5:9, iPhone Duo 1.43:1, iPad 4:3 and 16:9;
-// the default is the device's own shape.
-//
-// The preview is a port of mockup.html (the design the player approved): the
-// background is the bundled photo for the aspect (Sources/HudBackgrounds/*.jpg,
-// the mockup's own art), the stage has the same thick black rounded device frame,
-// the six elements are drawn with the mockup's shapes and colours, and their
-// default positions are the mockup's defaultPos formula (edge-anchored fractions
-// of the preview, measured from the elements' em-sized boxes). Element sizes
-// scale with the preview width (u = preview.width / 100, the mockup's em), so the
-// proportions hold on every shape.
-//
-// NOTE (0123): the 0119 basePoint + autoEdgeDx mechanism is gone. One base point
-// per element cannot reproduce defaultPos on all four shapes: the coins centre
-// would need base.x = 170 for 16:9 but 347 for the iPhone shape (after the -140
-// edge shift), and the Duo shape would need no shift at all. The default
-// position is therefore computed from defaultPos directly; the stored manual
-// setting is still an offset (dx, dy, in layout points) from that default, so
-// drag / resize / hide and the DM_HUD_* strings are unchanged.
-import SwiftUI
-import UIKit
-import Foundation
-
-// One element's manual setting: an offset (dx, dy) in layout points (1280x720
-// space, y up, from the element's default position), a size multiplier k, and
-// whether the element is hidden. Encoded as "dx,dy,k,hidden" (dx, dy whole
-// points, k two decimals, hidden 1 / 0): the same string the host parses from
-// the DM_HUD_* environment variable, so the launcher and the host agree.
-struct HudElementSetting: Equatable {
-    var dx, dy, k: Double
-    var hidden: Bool
-    var encoded: String { "\(Int(dx.rounded())),\(Int(dy.rounded())),\(String(format: "%.2f", k)),\(hidden ? 1 : 0)" }
-    static func decode(_ s: String) -> HudElementSetting? {
-        let p = s.split(separator: ",")
-        guard p.count == 4, let dx = Double(p[0]), let dy = Double(p[1]), let k = Double(p[2]), let h = Int(p[3]) else { return nil }
-        return HudElementSetting(dx: dx, dy: dy, k: k, hidden: h != 0)
-    }
-}
-
-// The six HUD elements, in the game's fixed order (hud_edge.c, hud_manual.c,
-// patches.py). The raw values must never change: saved settings and the state
-// page are keyed by them. Display order in the editor (mockup.html META) is
-// coins, regional coins, moons, lives, hints, compass -- see displayOrder, not rawValue.
-//
-// Grouping (the player's call, 0127: the two kinds of coins are separate
-// groups now): coins = only the coin icon + 0896; regional coins = only the
-// hexagon icon + 020; moons = only the two rows of dots below (its own unit).
-// The white bar under the counts is GONE from the editor (0127): it has no
-// matching pane in the game (a texture, it cannot move), so it is not drawn
-// and belongs to no group. The old 0119 moons-falls-back-to-coins rule is
-// gone: each group has its own setting.
-enum HudElement: Int, CaseIterable, Identifiable {
-    case compass = 0, lives, coins, moons, hints, regional
-    var id: Int { rawValue }
-    var env: String {
-        switch self {
-        case .compass: return "DM_HUD_COMPASS"
-        case .lives: return "DM_HUD_LIFE"
-        case .coins: return "DM_HUD_COINS"
-        case .moons: return "DM_HUD_MOONS"
-        case .hints: return "DM_HUD_HINTS"
-        case .regional: return "DM_HUD_REGIONAL"
-        }
-    }
-    var name: String {
-        switch self {
-        case .compass: return "指南针"
-        case .lives: return "生命"
-        case .coins: return "金币"
-        case .moons: return "月亮"
-        case .hints: return "菜单 / 地图提示词"
-        case .regional: return "地区金币"
-        }
-    }
-    // The name on the selected element's tag (mockup.html: the hints tag reads
-    // "菜单 / 地图", not the full list name).
-    var tagName: String { self == .hints ? "菜单 / 地图" : name }
-    var key: String { "DmHudManual.\(rawValue)" }   // UserDefaults key, one per element
-    // Display order in the editor list and the preview (mockup.html META).
-    // 0144: the hints element is gone from the editor (the user 2026-11-15
-    // 20:40: the "+ menu / - map" hints are hidden in the overlay and not
-    // shown); the .hints case stays in the enum so the raw values and the
-    // UserDefaults keys of the other elements do not shift.
-    static var displayOrder: [HudElement] { [.coins, .regional, .moons, .lives, .compass] }
-
-    // The element's rendered size in preview points at scale k, mirroring
-    // mockup.html's em sizing (u = preview.width / 100; coins/moons use a
-    // 3.3u font, hints a 2.05u font, life a 6.6u square, compass a 6.9u square).
-    // The .hud padding (.16em vertical, .30em horizontal) is included; life and
-    // compass have no font-size in the mockup, so their .1em padding (~2pt) is
-    // left out. The digit widths are estimates (SF Rounded Heavy, ~0.62em per
-    // digit plus .045em tracking): the same estimates are used by the drawing
-    // code below, so the two agree.
-    static func previewSize(_ el: HudElement, k: Double, unit u: CGFloat) -> CGSize {
-        switch el {
-        case .coins:
-            // Coin icon 1.08em + .34em + "0896" 2.60em = 4.02em; height 1.08em
-            // (icons only -- the hexagon + 020 are the regional-coins element
-            // now, and the white bar is gone, 0127); plus .30em / .16em padding.
-            let em = 3.3 * u * CGFloat(k)
-            return CGSize(width: 4.62 * em, height: 1.40 * em)
-        case .regional:
-            // Hexagon icon 1.08em + .34em + "020" 1.95em = 3.37em; height
-            // 1.08em (icons only); plus .30em / .16em padding. The hexagon
-            // drawing is identical to the old coins view (0127 moves it, it
-            // does not redraw it).
-            let em = 3.3 * u * CGFloat(k)
-            return CGSize(width: 3.97 * em, height: 1.40 * em)
-        case .moons:
-            // Row 1: 8 filled dots .46em + 2 empty dots .40em, 9 gaps .30em =
-            // 7.18em; row 2: 6 empty dots = 3.90em; plus .10em left padding.
-            // Height: two .50em rows + .22em gap = 1.22em; plus padding.
-            let em = 3.3 * u * CGFloat(k)
-            return CGSize(width: 7.88 * em, height: 1.54 * em)
-        case .lives:
-            let s = 6.6 * u * CGFloat(k)
-            return CGSize(width: s, height: s)
-        case .hints:
-            // Row: key 1.30em + gap .42em + two full-width characters 2.00em =
-            // 3.72em; height: two 1.30em keys + .30em gap = 2.90em; plus padding.
-            let em = 2.05 * u * CGFloat(k)
-            return CGSize(width: 4.32 * em, height: 3.22 * em)
-        case .compass:
-            let s = 6.9 * u * CGFloat(k)
-            return CGSize(width: s, height: s)
-        }
-    }
-
-    // The element's default top-left corner in preview points: mockup.html's
-    // defaultPos (mx = 1.8% of W, my = 5% of H, gap = 1.2% of W; the
-    // coins-to-regional and regional-to-moons gaps are 2.2% of H). Left: coins
-    // on top, regional coins under it, moons under that. Right: lives on top,
-    // hints under it, compass under that, centred on the lives column.
-    // `sizes` holds every element's previewSize at its own k.
-    static func defaultTopLeft(_ el: HudElement, preview: CGSize, sizes: [HudElement: CGSize]) -> CGPoint {
-        let W = preview.width, H = preview.height
-        let mx = W * 0.018, my = H * 0.05, gap = W * 0.012
-        let coins = sizes[.coins] ?? .zero, regional = sizes[.regional] ?? .zero
-        let lives = sizes[.lives] ?? .zero
-        let hints = sizes[.hints] ?? .zero, compass = sizes[.compass] ?? .zero
-        switch el {
-        case .coins: return CGPoint(x: mx, y: my)
-        case .regional: return CGPoint(x: mx, y: my + coins.height + H * 0.022)
-        case .moons: return CGPoint(x: mx, y: my + coins.height + H * 0.022 + regional.height + H * 0.022)
-        case .lives: return CGPoint(x: W - mx - lives.width, y: my)
-        case .hints: return CGPoint(x: W - mx - hints.width, y: my + lives.height + gap * 0.8)
-        case .compass: return CGPoint(x: W - mx - lives.width / 2 - compass.width / 2,
-                                      y: my + lives.height + gap * 0.8 + hints.height + gap * 0.9)
-        }
-    }
-}
-
-// The four preview shapes. The default is the device's own shape.
-enum HudAspect: CaseIterable, Identifiable {
-    case phone, duo, pad, wide
-    var id: Self { self }
-    var name: String {
-        switch self { case .phone: return "iPhone 19.5:9"; case .duo: return "iPhone Duo 1.43:1"; case .pad: return "iPad 4:3"; case .wide: return "16:9" }
-    }
-    var ratio: Double {
-        switch self { case .phone: return 2.167; case .duo: return 1.429; case .pad: return 1.333; case .wide: return 1.778 }
-    }
-    // The bundled background photo (dm/ios/Sources/HudBackgrounds/). The
-    // photos are the mockup's own art, and their ratios match these shapes:
-    // iphone 1920x886 (2.167), duo 1830x1280 (1.430), ipad 1706x1280 (1.333),
-    // 16:9 1920x1080 (1.778).
-    var imageName: String {
-        switch self { case .phone: return "hud_bg_iphone"; case .duo: return "hud_bg_duo"; case .pad: return "hud_bg_ipad"; case .wide: return "hud_bg_169" }
-    }
-    // The layout size for the shape (loader.c dm_fps_state_apply's rule: wider
-    // than 16:9 keeps the height (720) and widens; taller keeps the width (1280)
-    // and grows taller). Used only to convert a drag (preview points) into a
-    // manual offset (layout points) and back.
-    var layout: CGSize {
-        if ratio > 1.78 { return CGSize(width: 720 * ratio, height: 720) }
-        if ratio < 1.77 { return CGSize(width: 1280, height: 1280 / ratio) }
-        return CGSize(width: 1280, height: 720)
-    }
-    static func device() -> HudAspect {
-        let s = UIScreen.main.bounds.size
-        let r = max(s.width, s.height) / max(1, min(s.width, s.height))
-        // The closest of the four shapes (the phone is 2.167, the Duo 1.429, the iPad 1.333, 16:9 is 1.778).
-        return [phone, duo, pad, wide].min(by: { abs($0.ratio - r) < abs($1.ratio - r) }) ?? .phone
-    }
-}
-
-final class HudSettings: ObservableObject {
-    // One setting per element; a missing key means "no manual setting" (auto edge).
-    @Published private(set) var values: [HudElement: HudElementSetting] = [:]
-    private let defaults: UserDefaults
-    init(defaults: UserDefaults = .standard) {
-        self.defaults = defaults
-        for e in HudElement.allCases {
-            if let s = (defaults.string(forKey: e.key)).flatMap(HudElementSetting.decode) { values[e] = s }
-        }
-    }
-    // The setting that applies to an element (nil = auto edge). Each element,
-    // moons included, stands on its own: there is no cross-element fallback.
-    func effective(_ e: HudElement) -> HudElementSetting? { values[e] }
-    func isManual(_ e: HudElement) -> Bool { effective(e) != nil }
-    // Whether the element was moved or resized (the mockup's "manual" flag for
-    // the list and the tag): a hidden-only setting still reads as 自动贴边,
-    // with 已隐藏 on the side.
-    func isTransformed(_ e: HudElement) -> Bool {
-        guard let s = effective(e) else { return false }
-        return s.dx != 0 || s.dy != 0 || s.k != 1
-    }
-    func set(_ e: HudElement, _ s: HudElementSetting?) {
-        if let s { values[e] = s; defaults.set(s.encoded, forKey: e.key) }
-        else { values.removeValue(forKey: e); defaults.removeObject(forKey: e.key) }
-    }
-    func resetAll() { for e in HudElement.allCases { set(e, nil) } }
-    var anyManual: Bool { HudElement.allCases.contains { effective($0) != nil } }
-    // Before the game starts: every element with a manual setting goes into the
-    // environment (the host copies it to the state page); an element with no
-    // manual setting is unset, so the game keeps its auto edge anchor. A hidden
-    // element's hidden flag (1) is in the same string.
-    func applyToEnvironment() {
-        for e in HudElement.allCases {
-            if let s = effective(e) {
-                setenv(e.env, s.encoded, 1)
-                fputs("launcher: \(e.env)=\(s.encoded) (HUD editor)\n", stderr)
-            } else {
-                unsetenv(e.env)
-            }
-        }
-    }
-    // (0137) In-game editor: push ONE element's current setting into the
-    // environment right now, so the host (which re-reads the env vars every
-    // present) applies it on the next frame -- the slider moves the HUD in
-    // the running game, no restart. An element with no manual setting is
-    // unset, so the game keeps its overlay base position.
-    func applyOneToEnvironment(_ e: HudElement) {
-        if let s = effective(e) {
-            setenv(e.env, s.encoded, 1)
-        } else {
-            unsetenv(e.env)
-        }
-    }
-}
