-    var body: some View {
-        Group {
-            if filled {
-                ZStack {
-                    Circle().fill(Color.white)
-                    Circle().fill(Color(red: 22 / 255, green: 99 / 255, blue: 255 / 255))
-                        .offset(x: -0.18 * em, y: 0.03 * em)
