+}
+
+// ---- Handle touches ----
+// The handle under a point, or -1. Handles can overlap (coins and regional
+// share a strip on the left), so among the handles covering the point the
+// one whose centre is nearest wins.
+- (int)handleAt:(CGPoint)p {
+    int best = -1; CGFloat bestD = 0;
+    for (int i = 0; i < kHudPadCount; i++) {
+        UIView *h = _handles[i];
+        if (!h || h.hidden) continue;
+        if (!CGRectContainsPoint(h.frame, p)) continue;
+        CGFloat d = hypot(p.x - CGRectGetMidX(h.frame), p.y - CGRectGetMidY(h.frame));
+        if (best < 0 || d < bestD) { best = i; bestD = d; }
+    }
+    return best;
+}
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    (void)event;
+    if (_dragTouch) return;   // one drag at a time
+    UITouch *t = [touches anyObject];
+    if (!t) return;
+    CGPoint p = [t locationInView:self];
+    int e = [self handleAt:p];
+    if (e < 0) return;   // a tap on empty picture does nothing (and stays inside the editor: the pad underneath gets no press while editing)
+    [self selectElement:e];   // a tap selects the handle (the drag below still starts, as before)
+    _dragTouch = t; _dragElem = e;
+    CGPoint cur = [self handleCentre:e];
+    _dragGrab = CGPointMake(p.x - cur.x, p.y - cur.y);   // the finger's offset from the handle's centre
+}
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    (void)event;
+    UITouch *t = [touches anyObject];
+    if (!t || t != _dragTouch) return;
+    CGPoint p = [t locationInView:self];
+    CGSize hs = [self handleSize:_dragElem];
+    CGPoint c = CGPointMake(p.x - _dragGrab.x, p.y - _dragGrab.y);   // the handle's new centre, the finger's offset kept
+    c = [self clampHandleCentre:c size:hs];   // stay fully on screen
+    CGPoint sc = [self dragScale];   // view points -> layout points
+    CGPoint a = [self anchorViewCentre:_dragElem];
+    _dx[_dragElem] = fmin(fmax((c.x - a.x) * sc.x, -640), 640);
+    _dy[_dragElem] = fmin(fmax(-(c.y - a.y) * sc.y, -360), 360);
+    [self applyElement:_dragElem];   // live: the next frame shows the move
+    [self layoutHandles];
+}
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    (void)event;
+    UITouch *t = [touches anyObject];
+    if (t && t == _dragTouch) _dragTouch = nil;
+}
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
+    (void)event;
+    UITouch *t = [touches anyObject];
+    if (t && t == _dragTouch) _dragTouch = nil;
+}
