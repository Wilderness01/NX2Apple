+    hint.text = @"当前：指南针\n拖动元素可以移动位置 · 拖动面板可以移动面板"; hint.textColor = UIColor.whiteColor; hint.font = [UIFont systemFontOfSize:12]; hint.textAlignment = NSTextAlignmentCenter;
+    [_editBar addSubview:hint];
