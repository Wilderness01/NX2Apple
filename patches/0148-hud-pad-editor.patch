+// ---- Open / close ----
+- (void)openEditor {   // the in-game menu's "HUD 设置": show the editor over the running game
+    hudPadMigrate();   // first open: the old DmHudManual.* keys go, so they can never empty the capture textures again
+    [self loadSaved];
+    [self applyAll];   // the saved values go live at once, so the editor shows what the game shows
+    _editBar.hidden = NO;
+    for (int i = 0; i < kHudPadCount; i++) _handles[i].hidden = NO;
+    [self selectElement:0];   // the compass is selected by default, so the slider always has a target
+    [self setNeedsLayout];
+    fputs("hud editor: opened (HUD 设置已打开，拖动元素改位置，大小滑块 0.6-1.8，眼睛隐藏/显示)\n", stderr);
+}
+- (void)closeEditor {   // Done: save the settings and go back to playing (the env vars stay set, so a hidden element stays hidden)
+    [self save];
+    g_editor = nil;
+    [self removeFromSuperview];
+}
+@end
+
+// The in-game menu's "HUD 设置": put the editor over the running game.
+// Mirrors the quit prompt's presentation (front_ios.m) and the old
+// in-game editor: walk to the key window and add the editor to it, so
+// it sits above the game and the gamepad.
+void dm_hud_pad_open_editor(void) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (g_editor) return;   // already open
+        UIWindow *w = nil;
+        for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
+            if (![s isKindOfClass:[UIWindowScene class]]) continue;
+            for (UIWindow *win in ((UIWindowScene *)s).windows) if (win.isKeyWindow) { w = win; break; }
+            if (w) break;
+        }
+        if (!w) w = [UIApplication sharedApplication].keyWindow;
+        if (!w) return;
+        HudPadEditor *e = [[HudPadEditor alloc] initWithFrame:w.bounds];
+        e.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+        g_editor = e;
+        [w addSubview:e];
+        [e openEditor];
+    });
+}
+
+// Launcher.swift: before the game starts, the saved DmHudPad.* settings
+// go into the DM_HUD_* environment (the old launcher's applyToEnvironment
+// did this for DmHudManual.*). The old keys are deleted here too, so a
+// launch never re-applies the log-49 values that emptied the capture
+// textures. A default element is unset, so the game keeps its overlay base.
+void dm_hud_pad_apply_saved(void) {
+    hudPadMigrate();
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    for (int i = 0; i < kHudPadCount; i++) {
+        double x, y, k; BOOL h;
+        NSString *s = [d stringForKey:hudPadKey(i)];
+        if (hudPadDecode(s, &x, &y, &k, &h) && !hudPadIsDefault(x, y, k, h)) {
+            setenv(kHudPadEnv[i], hudPadEncode(x, y, k, h).UTF8String, 1);
+            fputs("launcher: ", stderr); fputs(kHudPadEnv[i], stderr);
+            fprintf(stderr, "=%s (HUD editor)\n", hudPadEncode(x, y, k, h).UTF8String);
+        } else {
+            unsetenv(kHudPadEnv[i]);
+        }
+    }
+}
