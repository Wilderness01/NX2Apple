-    // The element's frame in preview points: the mockup's default position,
-    // the manual offset (design points -> preview points, y flipped), clamped
-    // inside the preview like the mockup does. (0144: the offset is design
-    // space, so it scales by preview.width/1280 and preview.height/720, not
-    // by the layout size.)
-    private func elementFrame(_ el: HudElement, preview: CGSize, layout: CGSize, sizes: [HudElement: CGSize]) -> CGRect {
-        let size = sizes[el] ?? .zero
-        var origin = HudElement.defaultTopLeft(el, preview: preview, sizes: sizes)
-        if let s = effectiveSetting(el) {
-            origin.x += CGFloat(s.dx) * preview.width / 1280
-            origin.y -= CGFloat(s.dy) * preview.height / 720
-        }
-        let x = min(max(origin.x, 0), max(0, preview.width - size.width))
-        let y = min(max(origin.y, 0), max(0, preview.height - size.height))
-        return CGRect(origin: CGPoint(x: x, y: y), size: size)
-    }
