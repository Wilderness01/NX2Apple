-    private func effectiveSetting(_ el: HudElement) -> HudElementSetting? { settings.effective(el) }
-    // 0144: the manual offset is in the 1280x720 DESIGN space (hud_manual.c
-    // reads dx/dy in that space), not the layout space. The preview is a view
-    // of the LAYOUT (phone 1560x720, iPad 1280x960), so converting a preview
-    // drag with the layout width made the phone's dx 1560/1280 = 22% too large
-    // (log-49: drags of a few hundred preview points became dx 300-600 and
-    // pushed the number panes off-screen) and the iPad's dy 1280/960 = 33%
-    // too large. The design-space scales are 1280/preview.width (x) and
-    // 720/preview.height (y); the y scale equals the old layout scale on the
-    // phone (same aspect), so only the phone's dx and the iPad's dy change.
-    private func dragScale(preview: CGSize) -> CGSize {
