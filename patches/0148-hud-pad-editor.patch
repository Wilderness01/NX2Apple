-// The mockup's text shadow (.num, .hint-row): a dark 1px outline in four
-// directions plus a soft drop shadow.
-private extension View {
-    func hudTextShadow(size: CGFloat) -> some View {
-        let dark = Color(red: 19 / 255, green: 26 / 255, blue: 21 / 255)
-        return self
-            .shadow(color: dark, radius: 0, x: size * 0.05, y: size * 0.05)
-            .shadow(color: dark, radius: 0, x: -size * 0.05, y: size * 0.05)
-            .shadow(color: dark, radius: 0, x: size * 0.05, y: -size * 0.05)
-            .shadow(color: dark, radius: 0, x: -size * 0.05, y: -size * 0.05)
-            .shadow(color: .black.opacity(0.4), radius: size * 0.16, x: 0, y: size * 0.1)
-    }
-}
