+++ b/dm/ios/Sources/HudPadEditor.m
@@ -0,0 +1,533 @@
+// HudPadEditor.m -- the in-game HUD editor (0148).
+//
+// The pad-style HUD editor (REPORT-HUD-REDO.md D.5): no SwiftUI, no popup.
+// It copies the button editor's structure (DmGamepad.m): a settings bar at
+// the top (title, size slider, eye toggle, Done, hint line) that drags by
+// its title or blank area, and the elements themselves as handles on the
+// game picture -- tap one to select it, drag it to move it. The game keeps
+// running behind the editor; every change goes live at once through the
+// DM_HUD_* environment (hud_manual.c re-reads getenv every present, so the
+// next frame shows it).
+//
+// Elements (the DM_HUD_* index is the raw value; hints (4) is not here):
+//   0 compass 指南针, 1 lives 生命, 2 coins 金币 (icon + number together),
+//   3 moons 月亮 (the dots row on its own), 5 regional 地区金币 (hexagon
+//   icon + number together). A hidden element shows dimmed (0.35) while the
+//   editor is open, so it can still be tapped to unhide it (0146's rule);
+//   once the editor closes it is fully hidden.
+//
+// Anchor rectangles (REPORT-HUD-REDO.md B.5), in chain space: X right, Y
+// up, origin at the layout centre. The layout is the device's own shape
+// (phone 1560x720, iPad 1280x960, 16:9 1280x720 -- the same rule as
+// (the old launcher preview's layout rule): the anchor's layout point is (layoutW/2 + chainX,
+// layoutH/2 - chainY), and the manual offset (dx, dy) adds to it in design
+// points. The moons row is thin (25 layout points tall), so its handle is
+// widened to 44 tall to stay grabbable; every handle is at least 44x44
+// view points.
+//
+// Drag conversion: the drag is measured in view points and converted to
+// the layout space the DM_HUD_* strings use (the layout is the device's
+// own shape: 1560x720 on the phone, 1280x960 on the iPad), because the
+// runtime adds dx 1:1 to the layout points:
+//   dragScale = layoutW / view.width, layoutH / view.height
+// (Verified values: a 100pt drag on a 350pt-wide phone-layout view is dx
+// 446; on the full-screen game view of an iPhone 15 Pro Max in landscape,
+// 932pt wide, 100pt -> dx 167 -- and 167 layout points render as exactly
+// 100 view points, so the element follows the finger 1:1. 0144 used the
+// 1280x720 design space instead, which on the phone made the element move
+// only 82% as far as the finger.) The handle position uses the exact
+// inverse (dx * view.width / layoutW), so the handle stays under the
+// finger while it is dragged.
+//
+// Persistence: one UserDefaults key per element, DmHudPad.<rawValue>, value
+// "dx,dy,k,hidden" (the same string the host parses). "完成" saves; opening
+// reads. An element at its default (0, 0, 1, shown) has no key and its
+// DM_HUD_* variable is unset, so the runtime leaves it on the overlay base
+// position and writes nothing for it (D.1: no manual value, no write).
+//
+// Migration (R1): the old keys DmHudManual.<rawValue> (6 of them) hold the
+// log-49 drag values, which emptied the coins/regional capture textures at
+// launch. They are deleted when the editor first opens AND when the saved
+// settings are applied at launch, so the old values can never reach the
+// runtime again.
+//
+// The text is Chinese: the user asked for the settings panel in Chinese
+// (the rest of the repository is English).
+#import "HudPadEditor.h"
+#import <Foundation/Foundation.h>
+#import <QuartzCore/QuartzCore.h>
+#import <math.h>
+#import <stdio.h>
+#import <stdlib.h>
+#import <string.h>
+
+enum { kHudPadCount = 5 };   // the editor's elements (DM_HUD_* indices 0, 1, 2, 3, 5; 4 = hints is not edited)
+static const int kHudPadElem[kHudPadCount] = {0, 1, 2, 3, 5};
+static const char *const kHudPadEnv[kHudPadCount] = {"DM_HUD_COMPASS", "DM_HUD_LIFE", "DM_HUD_COINS", "DM_HUD_MOONS", "DM_HUD_REGIONAL"};
+static NSString *const kHudPadNames[kHudPadCount] = {@"指南针", @"生命", @"金币", @"月亮", @"地区金币"};
+// Anchor rectangles, chain space (centre x, centre y, width, height):
+//   compass: PicMap 88x88 centred on All (696,157); lives: PicIcon 128x128
+//   centred on All (696,284); coins: icon+number bbox x 22..182 y 16..122
+//   in 1560x720 layout; regional: x 147..307 y 9..116; moons: dots row
+//   x 46..158 y 98..123, handle widened to 44 tall so it can be grabbed.
+static const double kHudPadAnchor[kHudPadCount][4] = {
+    {696, 157, 88, 88},
+    {696, 284, 128, 128},
+    {-678, 291, 160, 106},
+    {-678, 249.5, 112, 44},
+    {-553, 297.5, 160, 107},
+};
+static const double kHudPadKMin = 0.6, kHudPadKMax = 1.8;   // the size slider's range (hud_manual.c clamps k to the same)
+
+// One element's manual setting, encoded as "dx,dy,k,hidden" (dx, dy whole
+// points, k two decimals, hidden 1 / 0): the same string the host parses
+// from the DM_HUD_* environment variable, so the editor and the host agree.
+static NSString *hudPadEncode(double dx, double dy, double k, BOOL hidden) {
+    return [NSString stringWithFormat:@"%d,%d,%.2f,%d", (int)lround(dx), (int)lround(dy), k, hidden ? 1 : 0];
+}
+static BOOL hudPadDecode(NSString *s, double *dx, double *dy, double *k, BOOL *hidden) {
+    if (!s) return NO;
+    double x, y, kk; int h;
+    if (sscanf(s.UTF8String, "%lf,%lf,%lf,%d", &x, &y, &kk, &h) != 4) return NO;
+    *dx = fmin(fmax(x, -640), 640); *dy = fmin(fmax(y, -360), 360);   // hud_manual.c clamps dx/dy to the same
+    *k = (kk > 0) ? fmin(fmax(kk, kHudPadKMin), kHudPadKMax) : 1;
+    *hidden = h != 0;
+    return YES;
+}
+static BOOL hudPadIsDefault(double dx, double dy, double k, BOOL hidden) {
+    return dx == 0 && dy == 0 && k == 1 && !hidden;
+}
+static NSString *hudPadKey(int i) { return [NSString stringWithFormat:@"DmHudPad.%d", kHudPadElem[i]]; }
+
+// 0148: drop the old DmHudManual.* keys (6 of them, log-49's drag values):
+// they emptied the coins/regional capture textures at launch (R1), so they
+// must never reach the runtime again. Called on first open and on launch apply.
+static void hudPadMigrate(void) {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    for (int r = 0; r < 6; r++) [d removeObjectForKey:[NSString stringWithFormat:@"DmHudManual.%d", r]];
+}
+
+// The layout size for the view's shape (the old launcher preview's rule): wider
+// than 16:9 keeps the height (720) and widens; taller keeps the width
+// (1280) and grows taller; 16:9 is 1280x720.
+static CGSize hudPadLayoutSize(CGSize view) {
+    CGFloat w = fmax(view.width, 1), h = fmax(view.height, 1);
+    CGFloat ratio = fmax(w, h) / fmax(1, fmin(w, h));
+    if (ratio > 1.78) return CGSizeMake(720 * ratio, 720);
+    if (ratio < 1.77) return CGSizeMake(1280, 1280 / ratio);
+    return CGSizeMake(1280, 720);
+}
+
+static HudPadEditor *g_editor;   // the open editor, if any (one at a time)
+
+@implementation HudPadEditor {
+    UIView *_editBar;              // the settings bar (hidden until the editor opens)
+    UISlider *_editSlider;         // the selected element's size, 0.6-1.8, live
+    UIButton *_editEye;            // 0146: the eye toggle for the selected element (tag 306)
+    UIView *_handles[kHudPadCount];   // one overlay handle per element (non-interactive: the view hit-tests them itself)
+    CAShapeLayer *_highlight;      // the ring around the selected handle (layoutEditHighlight's shape)
+    int _selected;                 // the element the slider and the eye tune (editor order 0..4)
+    double _dx[kHudPadCount], _dy[kHudPadCount], _k[kHudPadCount];   // the manual offsets (design points) and sizes
+    BOOL _hidden[kHudPadCount];    // the elements the player hid
+    CGPoint _panelPos;             // the bar's centre fraction (DmHudPadPanelPos), so it stays where it was dragged to
+    BOOL _panelDragging;           // a bar drag is in progress: the layout leaves its frame alone (0116)
+    UITouch *_dragTouch;           // the touch dragging a handle now, if any
+    int _dragElem;                 // the handle that touch is dragging
+    CGPoint _dragGrab;             // the finger's offset from the dragged handle's centre
+}
+
+- (instancetype)initWithFrame:(CGRect)frame {
+    self = [super initWithFrame:frame];
+    if (!self) return nil;
+    self.backgroundColor = [UIColor clearColor];   // the game shows through; only the bar and the handles cover it
+    _selected = 0;
+    for (int i = 0; i < kHudPadCount; i++) { _dx[i] = 0; _dy[i] = 0; _k[i] = 1; _hidden[i] = NO; }
+    [self loadPanelPos];
+    [self buildEditBar];
+    [self buildHandles];
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    [self layoutEditBar];
+    [self layoutHandles];
+    [self bringSubviewToFront:_editBar];   // the bar stays above the handles
+}
+
+// ---- Saved settings ----
+// Read the saved settings in (no key = the default: overlay base position,
+// shown). Called when the editor opens.
+- (void)loadSaved {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    for (int i = 0; i < kHudPadCount; i++) {
+        _dx[i] = 0; _dy[i] = 0; _k[i] = 1; _hidden[i] = NO;
+        double x, y, k; BOOL h;
+        if (hudPadDecode([d stringForKey:hudPadKey(i)], &x, &y, &k, &h)) { _dx[i] = x; _dy[i] = y; _k[i] = k; _hidden[i] = h; }
+    }
+}
+// Done: save. A default element has no key (and no DM_HUD_* variable), so
+// the runtime leaves it on the overlay base position.
+- (void)save {
+    NSUserDefaults *d = [NSUserDefaults standardUserDefaults];
+    for (int i = 0; i < kHudPadCount; i++) {
+        if (hudPadIsDefault(_dx[i], _dy[i], _k[i], _hidden[i])) [d removeObjectForKey:hudPadKey(i)];
+        else [d setObject:hudPadEncode(_dx[i], _dy[i], _k[i], _hidden[i]) forKey:hudPadKey(i)];
+    }
+    fputs("hud editor: saved DmHudPad.* (HUD 设置已保存)\n", stderr);
+}
+
+// ---- Live channel ----
+// Push one element into the environment right now, so the host (which
+// re-reads the env vars every present) applies it on the next frame. A
+// default element is unset, so the game keeps its overlay base position.
+- (void)applyElement:(int)i {
+    if (hudPadIsDefault(_dx[i], _dy[i], _k[i], _hidden[i])) unsetenv(kHudPadEnv[i]);
+    else setenv(kHudPadEnv[i], hudPadEncode(_dx[i], _dy[i], _k[i], _hidden[i]).UTF8String, 1);
+}
+- (void)applyAll {
+    for (int i = 0; i < kHudPadCount; i++) [self applyElement:i];
+}
+
+// ---- Geometry ----
+// A drag in view points becomes a layout-space offset: the runtime adds
+// dx 1:1 to the layout points, so the scale is the layout size over the
+// view bounds. The preview here is the game view itself.
+- (CGPoint)dragScale {
+    CGSize L = hudPadLayoutSize(self.bounds.size);
+    return CGPointMake(L.width / fmax(1, self.bounds.size.width), L.height / fmax(1, self.bounds.size.height));
+}
+// The anchor's view point, before the manual offset: the layout point
+// (layoutW/2 + chainX, layoutH/2 - chainY) scaled to the view.
+- (CGPoint)anchorViewCentre:(int)i {
+    CGSize v = self.bounds.size, L = hudPadLayoutSize(v);
+    return CGPointMake((L.width / 2 + kHudPadAnchor[i][0]) * v.width / L.width,
+                       (L.height / 2 - kHudPadAnchor[i][1]) * v.height / L.height);
+}
+// The handle's centre now: the anchor plus the manual offset, converted
+// back to view points with the exact inverse of dragScale, so the handle
+// stays under the finger while it is dragged.
+- (CGPoint)handleCentre:(int)i {
+    CGPoint a = [self anchorViewCentre:i];
+    CGSize L = hudPadLayoutSize(self.bounds.size);
+    return CGPointMake(a.x + _dx[i] * self.bounds.size.width / L.width,
+                       a.y - _dy[i] * self.bounds.size.height / L.height);
+}
+// The handle's size in view points: the anchor rect, scaled by k and by
+// the layout-to-view scale, at least 44x44 so it stays grabbable.
+- (CGSize)handleSize:(int)i {
+    CGSize v = self.bounds.size, L = hudPadLayoutSize(v);
+    return CGSizeMake(fmax(kHudPadAnchor[i][2] * _k[i] * v.width / L.width, 44),
+                      fmax(kHudPadAnchor[i][3] * _k[i] * v.height / L.height, 44));
+}
+- (CGPoint)clampHandleCentre:(CGPoint)c size:(CGSize)s {   // the handle stays fully on screen, so an off-screen anchor (iPad) stays reachable
+    CGFloat W = self.bounds.size.width, H = self.bounds.size.height, m = 4;
+    CGFloat loX = s.width / 2 + m, hiX = W - s.width / 2 - m, loY = s.height / 2 + m, hiY = H - s.height / 2 - m;
+    if (hiX < loX) c.x = W / 2; else c.x = fmin(fmax(c.x, loX), hiX);
+    if (hiY < loY) c.y = H / 2; else c.y = fmin(fmax(c.y, loY), hiY);
+    return c;
+}
+
+// ---- The settings bar (buildEditBar's shape, without the glass slider) ----
+// The bar's stored position (DmHudPadPanelPos): the centre fraction, so it
+// stays where it was dragged to. It opens at the bottom centre, clear of
+// the HUD row at the top.
+static NSString *const kHudPadPanelPosKey = @"DmHudPadPanelPos";
+static const CGFloat kHudPadPanelDefault[2] = {0.50, 0.82};
+- (void)loadPanelPos {
+    _panelPos = CGPointMake(kHudPadPanelDefault[0], kHudPadPanelDefault[1]);
+    NSDictionary *d = [NSUserDefaults.standardUserDefaults dictionaryForKey:kHudPadPanelPosKey];
+    NSArray *v = [d isKindOfClass:[NSDictionary class]] ? d[@"hud"] : nil;
+    if ([v isKindOfClass:[NSArray class]] && v.count == 2 && [v[0] isKindOfClass:[NSNumber class]] && [v[1] isKindOfClass:[NSNumber class]])
+        _panelPos = CGPointMake(fmin(fmax([v[0] doubleValue], 0), 1), fmin(fmax([v[1] doubleValue], 0), 1));
+}
+- (void)savePanelPos {
